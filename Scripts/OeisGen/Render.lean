/-!
Renders the `Defs.lean` / `Data.lean` skeletons for a single OEIS sequence.

Everything is emitted as `sorry`, because at this stage we do not yet know whether a
sequence will end up with a computable definition or a propositional one.
-/

namespace Oeis.Gen

/-- Shape of the index type, derived from the OEIS offset. -/
inductive ArgKind where
  | /-- offset `0`. -/ nat
  | /-- offset `1`. -/ pnat
  | /-- offset `k ≥ 2`. -/ natSub (k : Int)
  | /-- offset `k < 0`. -/ intSub (k : Int)
  deriving Inhabited

/-- The data the generator needs about one sequence. -/
structure SeqInfo where
  name : String
  title : String
  offset : Int
  terms : Array String
  /-- `tabl`/`tabf` sequences are really two-argument; for now they get a flattened API. -/
  isFlat : Bool
  deriving Inhabited

namespace SeqInfo

def argKind (s : SeqInfo) : ArgKind :=
  if s.offset == 0 then .nat
  else if s.offset == 1 then .pnat
  else if s.offset > 1 then .natSub s.offset
  else .intSub s.offset

def retTypeStr (s : SeqInfo) : String :=
  if s.terms.any (fun t => t.startsWith "-") then "Int" else "Nat"

/-- `A000123` ↦ `A000`. -/
def bucket (s : SeqInfo) : String := (s.name.take 4).toString

end SeqInfo

namespace ArgKind

/-- `fn : Nat → ret` is pointless when the index type is an `Int` subtype. -/
def hasFn : ArgKind → Bool
  | .intSub _ => false
  | _ => true

def typeStr : ArgKind → String
  | .nat => "Nat"
  | .pnat => "PNat"
  | .natSub k => "{n : Nat // " ++ toString k ++ " ≤ n}"
  | .intSub k => "{n : Int // " ++ toString k ++ " ≤ n}"

/-- How to write the index inside the sequence's own argument type, given `n : Nat`/`Int`. -/
def valOf : ArgKind → String
  | .nat => "n"
  | _ => "n.val"

end ArgKind

/-- Declaration names, which gain a `flat` / `flat_` prefix for `tabl`/`tabf` sequences. -/
structure Names where
  main : String
  argType : String
  retType : String
  offset : String
  fn : String
  fz : String
  prop : String
  data : String
  propCorrect : String
  fnEq : String
  fzEq : String
  fnEqFz : String
  dataEq : String
  dataEqFn : String
  dataEqFz : String

def namesFor (s : SeqInfo) : Names :=
  if s.isFlat then
    { main := "flat", argType := "flatArgType", retType := "flatRetType", offset := "flatOffset"
      fn := "flatFn", fz := "flatFz", prop := "flatProp", data := "flatData"
      propCorrect := "flat_prop_correct", fnEq := "flat_fn_eq", fzEq := "flat_fz_eq"
      fnEqFz := "flat_fn_eq_fz", dataEq := "flat_data_eq", dataEqFn := "flat_data_eq_fn"
      dataEqFz := "flat_data_eq_fz" }
  else
    { main := s.name, argType := "argType", retType := "retType", offset := "offset"
      fn := "fn", fz := "fz", prop := "prop", data := "data"
      propCorrect := "prop_correct", fnEq := "fn_eq", fzEq := "fz_eq"
      fnEqFz := "fn_eq_fz", dataEq := "data_eq", dataEqFn := "data_eq_fn"
      dataEqFz := "data_eq_fz" }

/-- OEIS titles are free text and may contain doc-comment delimiters, which we must break up. -/
def sanitizeDoc (s : String) : String :=
  String.intercalate "/ -" ((String.intercalate "- /" (s.splitOn "-/")).splitOn "/-")

private partial def chunkList (n : Nat) (xs : List String) : List (List String) :=
  match xs with
  | [] => []
  | _ => xs.take n :: chunkList n (xs.drop n)

private def renderTermList (terms : Array String) : String :=
  let groups := (chunkList 10 terms.toList).map (String.intercalate ", ")
  "[" ++ String.intercalate ",\n    " groups ++ "]"

private def fileHeader (s : SeqInfo) (extra : String) : String :=
  "/-!\n# " ++ s.name ++ "\n\n" ++ sanitizeDoc s.title ++ "\n\n" ++ extra ++
  "\nSkeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.\n-/\n"

/-- Contents of `<out>/<bucket>/<name>/Defs.lean`. -/
def renderDefs (s : SeqInfo) : String :=
  let N := namesFor s
  let ak := s.argKind
  let ns := s.name
  let ret := s.retTypeStr
  let off := toString s.offset
  let qual := fun (n : String) => if s.isFlat then n else ns ++ "." ++ n
  let mainDecl :=
    "/-- " ++ sanitizeDoc s.title ++ " -/\n" ++
    "def " ++ (if s.isFlat then N.main else ns) ++ " : " ++
      qual N.argType ++ " → " ++ qual N.retType ++ " := sorry\n"
  let coherence :=
    match ak with
    | .nat =>
      "/-- `" ++ N.fn ++ "` agrees with the main definition. -/\n" ++
      "theorem " ++ N.fnEq ++ " (n : Nat) : " ++ N.fn ++ " n = " ++ N.main ++ " n := sorry\n\n" ++
      "/-- `" ++ N.fz ++ "` agrees with the main definition on the domain. -/\n" ++
      "theorem " ++ N.fzEq ++ " (n : Int) (h : 0 ≤ n) : " ++
        N.fz ++ " n = " ++ N.main ++ " n.toNat := sorry\n\n" ++
      "/-- `" ++ N.fn ++ "` and `" ++ N.fz ++ "` agree on the overlapping domain. -/\n" ++
      "theorem " ++ N.fnEqFz ++ " (n : Nat) : " ++ N.fn ++ " n = " ++ N.fz ++ " (n : Int) := sorry\n"
    | .pnat =>
      "/-- `" ++ N.fn ++ "` agrees with the main definition. -/\n" ++
      "theorem " ++ N.fnEq ++ " (n : Nat) (h : 0 < n) : " ++
        N.fn ++ " n = " ++ N.main ++ " ⟨n, h⟩ := sorry\n\n" ++
      "/-- `" ++ N.fz ++ "` agrees with the main definition on the domain. -/\n" ++
      "theorem " ++ N.fzEq ++ " (n : Int) (h : 1 ≤ n) : " ++
        N.fz ++ " n = " ++ N.main ++ " ⟨n.toNat, by omega⟩ := sorry\n\n" ++
      "/-- `" ++ N.fn ++ "` and `" ++ N.fz ++ "` agree on the overlapping domain. -/\n" ++
      "theorem " ++ N.fnEqFz ++ " (n : Nat) (h : 0 < n) : " ++
        N.fn ++ " n = " ++ N.fz ++ " (n : Int) := sorry\n"
    | .natSub k =>
      let ks := toString k
      "/-- `" ++ N.fn ++ "` agrees with the main definition. -/\n" ++
      "theorem " ++ N.fnEq ++ " (n : Nat) (h : " ++ ks ++ " ≤ n) : " ++
        N.fn ++ " n = " ++ N.main ++ " ⟨n, h⟩ := sorry\n\n" ++
      "/-- `" ++ N.fz ++ "` agrees with the main definition on the domain. -/\n" ++
      "theorem " ++ N.fzEq ++ " (n : Int) (h : " ++ ks ++ " ≤ n) : " ++
        N.fz ++ " n = " ++ N.main ++ " ⟨n.toNat, by omega⟩ := sorry\n\n" ++
      "/-- `" ++ N.fn ++ "` and `" ++ N.fz ++ "` agree on the overlapping domain. -/\n" ++
      "theorem " ++ N.fnEqFz ++ " (n : Nat) (h : " ++ ks ++ " ≤ n) : " ++
        N.fn ++ " n = " ++ N.fz ++ " (n : Int) := sorry\n"
    | .intSub k =>
      let ks := toString k
      "/-- `" ++ N.fz ++ "` agrees with the main definition on the domain. -/\n" ++
      "theorem " ++ N.fzEq ++ " (n : Int) (h : " ++ ks ++ " ≤ n) : " ++
        N.fz ++ " n = " ++ N.main ++ " ⟨n, h⟩ := sorry\n"
  let fnDecl :=
    if ak.hasFn then
      "/-- `" ++ N.main ++ "` as a total function on `Nat`; junk value outside the domain. -/\n" ++
      "def " ++ N.fn ++ " : Nat → " ++ N.retType ++ " := sorry\n\n"
    else ""
  String.join [
    "import Mathlib.Tactic\n",
    "import Mathlib.Data.PNat.Defs\n\n",
    fileHeader s ("OEIS offset `" ++ off ++ "`.\n"),
    "\nnamespace ", ns, "\n\n",
    "/-- Index type of `", N.main, "` (OEIS offset `", off, "`). -/\n",
    "abbrev ", N.argType, " : Type := ", ak.typeStr, "\n\n",
    "/-- Value type of `", N.main, "`. -/\n",
    "abbrev ", N.retType, " : Type := ", ret, "\n\n",
    "/-- OEIS offset: the index of the first known term. -/\n",
    "abbrev ", N.offset, " : Int := ", off, "\n\n",
    if s.isFlat then mainDecl ++ "\n" else "",
    "end ", ns, "\n\n",
    if s.isFlat then "" else mainDecl ++ "\n",
    "namespace ", ns, "\n\n",
    "/-- Relation that defines `", N.main, "`. -/\n",
    "def ", N.prop, " : ", N.argType, " → ", N.retType, " → Prop := sorry\n\n",
    fnDecl,
    "/-- `", N.main, "` as a total function on `Int`; junk value outside the domain.\n",
    "Always used when composing sequences. -/\n",
    "def ", N.fz, " : Int → ", N.retType, " := sorry\n\n",
    "/-- The main definition satisfies its defining relation. -/\n",
    "theorem ", N.propCorrect, " (n : ", N.argType, ") : ",
      N.prop, " n (", N.main, " n) := sorry\n\n",
    coherence,
    "\nend ", ns, "\n"
  ]

/-- Contents of `<out>/<bucket>/<name>/Data.lean`. -/
def renderData (libName : String) (s : SeqInfo) : String :=
  let N := namesFor s
  let ak := s.argKind
  let ns := s.name
  let len := s.terms.size
  let off := s.offset
  let val := ak.valOf
  -- `terms[i]` is the value at index `offset + i`.
  let upper := toString (off + Int.ofNat len)
  let idxMain :=
    match ak with
    | .nat => "n"
    | .pnat => val ++ " - 1"
    | .natSub k => val ++ " - " ++ toString k
    | .intSub k => "(" ++ val ++ " - (" ++ toString k ++ ")).toNat"
  let boundMain :=
    match ak with
    | .nat => "n < " ++ upper
    | _ => val ++ " < " ++ upper
  let fnThm :=
    if ak.hasFn then
      let (dom, idx) :=
        match ak with
        | .nat => ("", "n")
        | .pnat => ("(h0 : 0 < n) ", "n - 1")
        | .natSub k => ("(h0 : " ++ toString k ++ " ≤ n) ", "n - " ++ toString k)
        | .intSub _ => ("", "n")
      "/-- `" ++ N.fn ++ "` agrees with `" ++ N.data ++ "` on the known range. -/\n" ++
      "@[simp]\ntheorem " ++ N.dataEqFn ++ " (n : Nat) " ++ dom ++
        "(h : n < " ++ upper ++ ") : " ++
        N.fn ++ " n = " ++ N.data ++ "[" ++ idx ++ "]! := sorry\n\n"
    else ""
  let fzIdx :=
    match ak with
    | .nat => "n.toNat"
    | .pnat => "n.toNat - 1"
    | .natSub k => "n.toNat - " ++ toString k
    | .intSub k => "(n - (" ++ toString k ++ ")).toNat"
  let fzDom :=
    match ak with
    | .nat => "0 ≤ n"
    | .pnat => "1 ≤ n"
    | .natSub k => toString k ++ " ≤ n"
    | .intSub k => toString k ++ " ≤ n"
  String.join [
    "import ", libName, ".", s.bucket, ".", ns, ".Defs\n\n",
    fileHeader s ("The " ++ toString len ++ " terms known to OEIS, indexed from `" ++
      toString off ++ "`.\n"),
    "\nnamespace ", ns, "\n\n",
    "/-- Known terms of `", N.main, "`, starting at index `", toString off, "`. -/\n",
    "def ", N.data, " : List ", N.retType, " :=\n  ", renderTermList s.terms, "\n\n",
    "/-- `", N.main, "` agrees with `", N.data, "` on the known range. -/\n",
    "@[simp]\ntheorem ", N.dataEq, " (n : ", N.argType, ") (h : ", boundMain, ") : ",
      N.main, " n = ", N.data, "[", idxMain, "]! := sorry\n\n",
    fnThm,
    "/-- `", N.fz, "` agrees with `", N.data, "` on the known range. -/\n",
    "@[simp]\ntheorem ", N.dataEqFz, " (n : Int) (h0 : ", fzDom, ") (h : n < ", upper, ") : ",
      N.fz, " n = ", N.data, "[", fzIdx, "]! := sorry\n",
    "\nend ", ns, "\n"
  ]

end Oeis.Gen
