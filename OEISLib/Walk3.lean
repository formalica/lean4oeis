import Mathlib.Tactic

/-!
# Walks in the first octant of `Z^3`

Generic parameterized library behind the OEIS template

> Number of walks within `N^3` (the first octant of `Z^3`) starting at `(0,0,0)` and
> consisting of `n` steps taken from `{...}`

(~3250 sequences, Bostan–Kauers 2008). Everything is parameterized by a step set given
as `steps : List Pnt`; a concrete sequence only supplies its step vectors. Duplicate
entries would double-count, exactly like duplicate summands do in the Wolfram program;
the template never produces duplicates.

Two definitions are provided:

* `count steps n` — the *high-level* definition: the number of length-`n` walks from the
  origin whose every step lies in `steps` and which never leave the closed octant. It is
  generated by listing all endpoints (`walkEnds`).
* `aux steps p n` / `countDp steps n` — the *low-level* counting code, a direct
  transcription of the Wolfram program shipped in the `%t` section of those sequences:

  ```wolfram
  aux[i_, j_, k_, n_] := Which[Min[i, j, k, n] < 0 || Max[i, j, k] > n, 0,
    n == 0, KroneckerDelta[i, j, k, n], True,
    aux[i, j, k, n] = Sum[aux[... - s ..., -1 + n], {s in steps}]];
  Table[Sum[aux[i, j, k, n], {i, 0, n}, {j, 0, n}, {k, 0, n}], {n, 0, 10}]
  ```

`countDp_eq_count` proves both definitions equal whenever every step lies in `unitCube`,
i.e. has coordinates in `{-1, 0, 1}` — true for every sequence of the template (the bound
is what makes the `Max[i,j,k] > n` pruning of `aux` value-preserving).
-/

namespace OEISLib

open scoped BigOperators

namespace Walk3

/-! ## Basic definitions -/

/-- A lattice point of `Z^3`. -/
abbrev Pnt := Int × Int × Int

/-- `p` lies in the closed first octant `N^3`. -/
def InOctant (p : Pnt) : Prop :=
  0 ≤ p.1 ∧ 0 ≤ p.2.1 ∧ 0 ≤ p.2.2

instance instDecidableInOctant (p : Pnt) : Decidable (InOctant p) :=
  inferInstanceAs (Decidable (0 ≤ p.1 ∧ 0 ≤ p.2.1 ∧ 0 ≤ p.2.2))

/-- Boolean version of `InOctant`, used inside list filters. -/
def inOctant (p : Pnt) : Bool := decide (InOctant p)

theorem inOctant_eq_true {p : Pnt} : inOctant p = true ↔ InOctant p :=
  decide_eq_true_iff

/-- Sum of `f` over a list (mathlib's `List.sum` has no function argument). -/
def sumWith {α M : Type*} [AddCommMonoid M] (f : α → M) (l : List α) : M := (l.map f).sum

theorem sumWith_nil {α M : Type*} [AddCommMonoid M] (f : α → M) : sumWith f [] = 0 := rfl

theorem sumWith_cons {α M : Type*} [AddCommMonoid M] (f : α → M) (a : α) (l : List α) :
    sumWith f (a :: l) = f a + sumWith f l := rfl

theorem sumWith_zero_const {α M : Type*} [AddCommMonoid M] (l : List α) :
    sumWith (fun _ => (0 : M)) l = 0 := by
  induction l with
  | nil => rfl
  | cons a l ih => rw [sumWith_cons, ih, add_zero]

theorem sumWith_congr {α M : Type*} [AddCommMonoid M] (l : List α) {f g : α → M}
    (h : ∀ x ∈ l, f x = g x) : sumWith f l = sumWith g l := by
  induction l with
  | nil => rfl
  | cons a l ih =>
    rw [sumWith_cons, sumWith_cons, h a (List.mem_cons_self ..),
      ih fun x hx => h x (List.mem_cons_of_mem _ hx)]

theorem pnt_add_sub (q s : Pnt) : q + s - s = q := by
  apply Prod.ext
  · change q.1 + s.1 - s.1 = q.1
    omega
  · apply Prod.ext
    · change q.2.1 + s.2.1 - s.2.1 = q.2.1
      omega
    · change q.2.2 + s.2.2 - s.2.2 = q.2.2
      omega

theorem pnt_sub_add (q s : Pnt) : q - s + s = q := by
  rw [← pnt_add_sub q s]
  simp

/-- The cube of step vectors with all coordinates in `{-1,0,1}`. Every step set occurring
in the template is contained in it. -/
def unitCube : Finset Pnt :=
  ({-1, 0, 1} : Finset Int) ×ˢ ({-1, 0, 1} : Finset Int) ×ˢ ({-1, 0, 1} : Finset Int)

theorem neg_one_le_and_le_of_mem_three (x : Int)
    (h : x ∈ ({(-1 : Int), 0, 1} : Finset Int)) : -1 ≤ x ∧ x ≤ 1 := by
  rcases Finset.mem_insert.1 h with h' | h'
  · omega
  rcases Finset.mem_insert.1 h' with h'' | h''
  · omega
  · have hx := Finset.mem_singleton.1 h''
    omega

theorem mem_unitCube_bound {s : Pnt} (h : s ∈ unitCube) :
    s.1 ≤ 1 ∧ s.2.1 ≤ 1 ∧ s.2.2 ≤ 1 := by
  have h1 := Finset.mem_product.1 h
  have h2 := Finset.mem_product.1 h1.2
  exact ⟨(neg_one_le_and_le_of_mem_three _ h1.1).2, (neg_one_le_and_le_of_mem_three _ h2.1).2,
    (neg_one_le_and_le_of_mem_three _ h2.2).2⟩

/-! ## High-level definition -/

/-- Endpoints of all `n`-step walks that start at the origin and never leave the octant. -/
def walkEnds (S : List Pnt) : Nat → List Pnt
  | 0 => [(0, 0, 0)]
  | n + 1 =>
      ((walkEnds S n).flatMap fun q => S.map (fun s => q + s)).filter inOctant

/-- **High-level definition**: number of `n`-step walks within `N^3` starting at the
origin, taking every step from `S`. -/
def count (S : List Pnt) (n : Nat) : Nat := (walkEnds S n).length

theorem mem_walkEnds_octant {S : List Pnt} {n : Nat} {q : Pnt} (h : q ∈ walkEnds S n) :
    InOctant q := by
  induction n generalizing q with
  | zero =>
    have hq : q = (0, 0, 0) := by simpa [walkEnds] using h
    subst hq
    exact ⟨le_refl 0, le_refl 0, le_refl 0⟩
  | succ n ih =>
    rcases List.mem_filter.1 h with ⟨-, hin⟩
    exact inOctant_eq_true.1 hin

/-- Every endpoint of an `n`-step walk has coordinates bounded by `n` — this is what makes
the pruning `Max[i,j,k] > n` in the low-level code value-preserving. -/
theorem mem_walkEnds_coord_le {S : List Pnt} (hS : ∀ s ∈ S, s ∈ unitCube) {n : Nat}
    {q : Pnt} (h : q ∈ walkEnds S n) : q.1 ≤ n ∧ q.2.1 ≤ n ∧ q.2.2 ≤ n := by
  induction n generalizing q with
  | zero =>
    have hq : q = (0, 0, 0) := by simpa [walkEnds] using h
    subst hq
    exact ⟨le_refl 0, le_refl 0, le_refl 0⟩
  | succ n ih =>
    rcases List.mem_filter.1 h with ⟨hm, -⟩
    rcases List.mem_flatMap.1 hm with ⟨r, hr, hx⟩
    rcases List.mem_map.1 hx with ⟨s, hs, hseq⟩
    have hb := mem_unitCube_bound (hS s hs)
    have hr := ih hr
    have hx1 : q.1 = r.1 + s.1 := by rw [← hseq]; rfl
    have hx2 : q.2.1 = r.2.1 + s.2.1 := by rw [← hseq]; rfl
    have hx3 : q.2.2 = r.2.2 + s.2.2 := by rw [← hseq]; rfl
    omega

/-! ## Low-level definition (transcription of the Wolfram code) -/

/-- Number of `n`-step octant walks from the origin ending at `p`.

Transcription of the Mathematica `aux` recursion:
`Which[Min[i,j,k,n] < 0 || Max[i,j,k] > n, 0, n == 0, KroneckerDelta[i,j,k,n], True,
aux[i,j,k,n] = Sum over steps]`. The `Min < 0` test is vacuous here because the argument
`n` is a `Nat`; the negated step vector appears because the Wolfram recursion walks
backwards from `p`. -/
def aux (S : List Pnt) (p : Pnt) : Nat → Nat
  | 0 => if p = (0, 0, 0) then 1 else 0
  | n + 1 =>
      if ¬ InOctant p ∨ n + 1 < p.1 ∨ n + 1 < p.2.1 ∨ n + 1 < p.2.2 then 0
      else sumWith (fun s => aux S (p - s) n) S

/-- The index box `[0,n]` used by `countDp`, as a finset of integers. -/
def boxRange (n : Nat) : Finset Int :=
  (Finset.range (n + 1)).image fun m : Nat => (m : Int)

theorem mem_boxRange {m : Int} {n : Nat} : m ∈ boxRange n ↔ 0 ≤ m ∧ m ≤ n := by
  constructor
  · intro hmem
    obtain ⟨k, hk, hkm⟩ := Finset.mem_image.1 hmem
    simp only [Finset.mem_range] at hk
    subst hkm
    omega
  · rintro ⟨h0, h1⟩
    rw [boxRange, Finset.mem_image]
    exact ⟨m.toNat, Finset.mem_range.2 (by omega), by omega⟩

/-- Low-level count: sum of `aux` over the box `[0,n]^3`, i.e. the value of
`Table[Sum[aux[i,j,k,n], {i,0,n}, {j,0,n}, {k,0,n}], {n,...}]`. -/
def countDp (S : List Pnt) (n : Nat) : Nat :=
  ∑ p ∈ boxRange n ×ˢ (boxRange n ×ˢ boxRange n), aux S p n

/-! ## Counting helpers -/

theorem sumWith_add {α M : Type*} [AddCommMonoid M] (f g : α → M) (l : List α) :
    sumWith (fun x => f x + g x) l = sumWith f l + sumWith g l := by
  induction l with
  | nil => simp [sumWith]
  | cons a l ih => rw [sumWith_cons, sumWith_cons, sumWith_cons, ih]; abel

theorem sumWith_comm {α γ M : Type*} [AddCommMonoid M] (l : List α) (S : List γ)
    (g : α → γ → M) :
    sumWith (fun a => sumWith (fun b => g a b) S) l =
      sumWith (fun b => sumWith (fun a => g a b) l) S := by
  induction l with
  | nil =>
    rw [sumWith_congr S (fun b _ => sumWith_nil (fun a => g a b)), sumWith_zero_const]
    rfl
  | cons a l ih =>
    rw [sumWith_cons, ih]
    simp only [sumWith_cons, sumWith_add]

theorem countP_flatMap {α β : Type*} (Q : β → Bool) (l : List α) (f : α → List β) :
    (l.flatMap f).countP Q = sumWith (fun a => (f a).countP Q) l := by
  induction l with
  | nil => rfl
  | cons a l ih => rw [List.flatMap_cons, List.countP_append, sumWith_cons, ih]

theorem countP_eq_sumWith {α : Type*} (l : List α) (Q : α → Bool) :
    l.countP Q = sumWith (fun x => if Q x then 1 else 0) l := by
  induction l with
  | nil => rfl
  | cons a l ih =>
    rw [List.countP_cons, sumWith_cons, ih, Nat.add_comm]

theorem countP_eq_zero_of_forall_ne {α : Type*} [DecidableEq α] (l : List α) (p : α)
    (h : ∀ x ∈ l, x ≠ p) : l.countP (fun q => decide (q = p)) = 0 := by
  induction l with
  | nil => rfl
  | cons a l ih =>
    rw [List.countP_cons, ih (fun x hx => h x (List.mem_cons_of_mem _ hx))]
    have ha := h a (List.mem_cons_self ..)
    by_cases hp : a = p
    · exact absurd hp ha
    · simp [hp]

theorem length_eq_sum_countP {ι : Type*} [DecidableEq ι] (box : Finset ι) (l : List ι)
    (h : ∀ q ∈ l, q ∈ box) :
    l.length = box.sum fun p => l.countP (fun q => decide (q = p)) := by
  induction l with
  | nil => simp
  | cons a l ih =>
    have ha : a ∈ box := h a (List.mem_cons_self ..)
    have hsub : ∀ q ∈ l, q ∈ box := fun q hq => h q (List.mem_cons_of_mem _ hq)
    rw [List.length_cons, ih hsub]
    simp only [List.countP_cons, decide_eq_true_eq]
    rw [Finset.sum_add_distrib, Finset.sum_ite_eq box a fun _ => (1 : Nat), if_pos ha]

/-! ## The two definitions agree -/

/-- `aux S p n` counts exactly the `n`-step octant walks from the origin ending at `p`. -/
theorem aux_eq_countP (S : List Pnt) (hS : ∀ s ∈ S, s ∈ unitCube) (p : Pnt) (n : Nat) :
    aux S p n = (walkEnds S n).countP (fun q => decide (q = p)) := by
  induction n generalizing p with
  | zero =>
    change (if p = (0, 0, 0) then 1 else 0) = _
    rw [walkEnds, List.countP_cons, List.countP_nil]
    by_cases hp : p = (0, 0, 0)
    · subst hp
      rfl
    · rw [if_neg hp]
      have hd : ¬(((0, 0, 0) : Pnt) = p) := fun h => hp h.symm
      rw [decide_eq_false_iff_not.2 hd]
      rfl
  | succ n ih =>
    simp only [aux, walkEnds]
    split
    · -- pruned branch: no walk can end at `p`
      rename_i hprune
      symm
      apply countP_eq_zero_of_forall_ne
      intro x hx hxep
      subst hxep
      have hxw : x ∈ walkEnds S (n + 1) := by
        change x ∈ ((walkEnds S n).flatMap fun q => S.map (fun s => q + s)).filter inOctant
        exact hx
      rcases hprune with hout | h1 | h2 | h3
      · exact absurd (inOctant_eq_true.1 (List.mem_filter.1 hx).2) hout
      · have h := (mem_walkEnds_coord_le hS hxw).1
        omega
      · have h := (mem_walkEnds_coord_le hS hxw).2.1
        omega
      · have h := (mem_walkEnds_coord_le hS hxw).2.2
        omega
    · rename_i hkeep
      push Not at hkeep
      obtain ⟨hoct, -, -, -⟩ := hkeep
      -- inside the octant the octant-filter is redundant
      have hred : ∀ x : Pnt, (decide (x = p) && inOctant x) = decide (x = p) := by
        intro x
        by_cases hx : x = p
        · subst hx
          rw [inOctant_eq_true.2 hoct, Bool.and_true]
        · rw [decide_eq_false_iff_not.2 hx]
          rfl
      rw [List.countP_filter, countP_flatMap]
      simp only [hred]
      have hstep : ∀ q : Pnt,
          (S.map (fun t => q + t)).countP (fun x => decide (x = p))
            = S.countP (fun t => decide (q + t = p)) := fun q =>
        List.countP_map (p := fun x => decide (x = p)) (f := fun t => q + t) (l := S)
      simp only [hstep]
      simp only [countP_eq_sumWith]
      rw [sumWith_comm]
      refine sumWith_congr S fun s _ => ?_
      rw [ih (p - s), countP_eq_sumWith]
      have hpt : ∀ q : Pnt, decide (q + s = p) = decide (q = p - s) := by
        intro q
        by_cases hq : q = p - s
        · subst hq
          have hw := pnt_sub_add p s
          simp [hw]
        · have hn : ¬ (q + s = p) := by
            intro hc
            have hw := pnt_add_sub q s
            rw [hc] at hw
            exact hq hw.symm
          simp [hq, hn]
      exact sumWith_congr _ fun q _ =>
        congrArg (fun d : Bool => if d = true then (1 : Nat) else 0) (hpt q).symm

/-- Summing `aux` over the box `[0,n]^3` counts every endpoint exactly once. -/
theorem countDp_eq_length (S : List Pnt) (hS : ∀ s ∈ S, s ∈ unitCube) (n : Nat) :
    countDp S n = (walkEnds S n).length := by
  have hmem : ∀ q ∈ walkEnds S n, q ∈ boxRange n ×ˢ (boxRange n ×ˢ boxRange n) := by
    intro q hq
    have h1 := mem_walkEnds_octant hq
    have h2 := mem_walkEnds_coord_le hS hq
    exact Finset.mem_product.2 ⟨mem_boxRange.2 ⟨h1.1, h2.1⟩,
      Finset.mem_product.2 ⟨mem_boxRange.2 ⟨h1.2.1, h2.2.1⟩,
        mem_boxRange.2 ⟨h1.2.2, h2.2.2⟩⟩⟩
  rw [countDp, Finset.sum_congr rfl fun p _ => aux_eq_countP S hS p n,
    length_eq_sum_countP _ _ hmem]

/-- **The formula equality**: the low-level dynamic-programming count equals the high-level
walk count, provided every step has coordinates in `{-1,0,1}`. -/
theorem countDp_eq_count (S : List Pnt) (hS : ∀ s ∈ S, s ∈ unitCube) (n : Nat) :
    countDp S n = count S n := by
  rw [countDp_eq_length S hS n]
  rfl

end Walk3

end OEISLib
