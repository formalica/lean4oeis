def flatData : List flatRetType :=
  [1, 2, 4, 6, 8, 12, 30, 16, 24, 36,
    60, 210, 32, 48, 72, 120, 180, 420, 2310, 64,
    96, 144, 240, 216, 360, 840, 900, 1260, 4620, 30030,
    128, 192, 288, 480, 432, 720, 1680, 1080, 1800, 2520,
    9240, 6300, 13860, 60060, 510510, 256, 384, 576, 960, 864,
