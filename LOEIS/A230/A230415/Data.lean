import LOEIS.A230.A230415.Defs

set_option linter.unusedVariables false

/-!
# A230415

Square array T(i,j) giving the number of differing digits in the factorial base representations of i and j, for i >= 0, j >= 0, read by antidiagonals.

The 120 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A230415

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [0, 1, 1, 1, 0, 1, 2, 2, 2, 2,
    1, 1, 0, 1, 1, 2, 2, 1, 1, 2,
    2, 1, 1, 1, 0, 1, 1, 1, 2, 2,
    2, 2, 2, 2, 2, 2, 2, 1, 2, 1,
    0, 1, 2, 1, 2, 3, 3, 3, 3, 1,
    1, 3, 3, 3, 3, 2, 2, 1, 2, 2,
    0, 2, 2, 1, 2, 2, 3, 3, 2, 2,
    3, 3, 3, 3, 2, 2, 3, 3, 1, 2,
    2, 1, 2, 2, 0, 2, 2, 1, 2, 2,
    1, 2, 2, 3, 3, 3, 3, 1, 1, 3,
    3, 3, 3, 2, 2, 2, 1, 2, 2, 1,
    2, 1, 0, 1, 2, 1, 2, 2, 1, 2]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 120) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 120) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 120) : flatFz n = flatData[n.toNat]! := sorry

end A230415
