/-!
# A230417

Lower triangular region of A230415, a triangular table read by rows: T(n, k) tells in how many digit positions the factorial base representations (A007623) of n and k differ, where (n, k) = (0,0), (1,0), (1,1), (2,0), (2,1), (2,2), ..., n >= 0 and (0 <= k <= n).

The 120 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A230417

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [0, 1, 0, 1, 2, 0, 2, 1, 1, 0,
    1, 2, 1, 2, 0, 2, 1, 2, 1, 1,
    0, 1, 2, 2, 3, 2, 3, 0, 2, 1,
    3, 2, 3, 2, 1, 0, 2, 3, 1, 2,
    2, 3, 1, 2, 0, 3, 2, 2, 1, 3,
    2, 2, 1, 1, 0, 2, 3, 2, 3, 1,
    2, 1, 2, 1, 2, 0, 3, 2, 3, 2,
    2, 1, 2, 1, 2, 1, 1, 0, 1, 2,
    2, 3, 2, 3, 1, 2, 2, 3, 2, 3,
    0, 2, 1, 3, 2, 3, 2, 2, 1, 3,
    2, 3, 2, 1, 0, 2, 3, 1, 2, 2,
    3, 2, 3, 1, 2, 2, 3, 1, 2, 0]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 120) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 120) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 120) : flatFz n = flatData[n.toNat]! := sorry

end A230417
