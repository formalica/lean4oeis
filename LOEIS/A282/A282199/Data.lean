import LOEIS.A282.A282199.Defs

set_option linter.unusedVariables false

/-!
# A282199

Binary representation of the x-axis, from the left edge to the origin, of the n-th stage of growth of the two-dimensional cellular automaton defined by "Rule 433", based on the 5-celled von Neumann neighborhood.

The 21 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A282199

/-- Known terms of `A282199`, starting at index `0`. -/
def data : List retType :=
  [1, 0, 101, 10, 10001, 100, 1010101, 111110, 100010111, 1011100,
    10100110001, 1100010100, 1000101011101, 10110110110, 101011001001011, 11111000000110, 10001011011110101, 101101100011110, 1010011011101000011, 110000100111011000,
    100010110100001110011]

/-- `A282199` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 21) : A282199 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 21) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 21) : fz n = data[n.toNat]! := sorry

end A282199
