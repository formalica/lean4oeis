def data : List retType :=
  [1, 1, 111, 100, 11101, 10111, 1111100, 1000101, 111010111, 101111100,
    11111000101, 10001010111, 1110101111100, 1011111000101, 111110001010111, 100010101111100, 11101011111000101, 10111110001010111, 1111100010101111100, 1000101011111000101]

/-- `A282103` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 20) : A282103 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 20) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 20) : fz n = data[n.toNat]! := sorry

end A282103
