import LOEIS.A152.A152013.Defs

set_option linter.unusedVariables false

/-!
# A152013

Indices of Fibonacci numbers having at least two distinct primitive prime factors.

The 62 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A152013

/-- Known terms of `A152013`, starting at index `1`. -/
def data : List retType :=
  [19, 27, 31, 37, 41, 44, 46, 49, 50, 53,
    55, 57, 58, 59, 61, 64, 67, 68, 69, 70,
    71, 73, 77, 78, 79, 80, 81, 84, 85, 86,
    87, 88, 89, 90, 91, 92, 95, 96, 97, 99,
    100, 101, 102, 103, 104, 107, 109, 110, 113, 114,
    115, 116, 117, 118, 120, 126, 127, 128, 129, 130,
    133, 134]

/-- `A152013` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 63) : A152013 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 63) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 63) : fz n = data[n.toNat - 1]! := sorry

end A152013
