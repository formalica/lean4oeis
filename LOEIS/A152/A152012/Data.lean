import LOEIS.A152.A152012.Defs

set_option linter.unusedVariables false

/-!
# A152012

Indices of Fibonacci numbers having exactly one primitive prime factor.

The 67 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A152012

/-- Known terms of `A152012`, starting at index `1`. -/
def data : List retType :=
  [3, 4, 5, 7, 8, 9, 10, 11, 13, 14,
    15, 16, 17, 18, 20, 21, 22, 23, 24, 25,
    26, 28, 29, 30, 32, 33, 34, 35, 36, 38,
    39, 40, 42, 43, 45, 47, 48, 51, 52, 54,
    56, 60, 62, 63, 65, 66, 72, 74, 75, 76,
    82, 83, 93, 94, 98, 105, 106, 108, 111, 112,
    119, 121, 122, 123, 124, 125, 131]

/-- `A152012` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 68) : A152012 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 68) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 68) : fz n = data[n.toNat - 1]! := sorry

end A152012
