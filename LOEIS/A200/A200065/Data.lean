import LOEIS.A200.A200065.Defs

set_option linter.unusedVariables false

/-!
# A200065

Start with n, concatenate its trivial divisors, and repeat until a prime is reached. a(n) = 0 if no prime is ever reached.

The 32 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A200065

/-- Known terms of `A200065`, starting at index `1`. -/
def data : List retType :=
  [0, 0, 13, 0, 0, 0, 17, 0, 19, 0,
    1111111111111111111, 0, 113, 0, 0, 0, 1117, 0, 11119, 0,
    111121, 0, 1123, 0, 0, 0, 127, 0, 1129, 0,
    131, 0]

/-- `A200065` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 33) : A200065 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 33) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 33) : fz n = data[n.toNat - 1]! := sorry

end A200065
