import LOEIS.A305.A305753.Defs

set_option linter.unusedVariables false

/-!
# A305753

A base-3/2 sorted Fibonacci sequence that starts with a(0) = 0 and a(1) = 1. The terms are interpreted as numbers written in base 3/2. To get a(n+2), add a(n) and a(n+1), write the result in base 3/2 and sort the "digits" into increasing order, omitting all zeros.

The 31 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A305753

/-- Known terms of `A305753`, starting at index `0`. -/
def data : List retType :=
  [0, 1, 1, 2, 2, 12, 12, 112, 112, 1112,
    1112, 11112, 11112, 111112, 111112, 1111112, 1111112, 11111112, 11111112, 111111112,
    111111112, 1111111112, 1111111112, 11111111112, 11111111112, 111111111112, 111111111112, 1111111111112, 1111111111112, 11111111111112,
    11111111111112]

/-- `A305753` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 31) : A305753 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 31) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 31) : fz n = data[n.toNat]! := sorry

end A305753
