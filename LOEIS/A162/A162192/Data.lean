import LOEIS.A162.A162192.Defs

set_option linter.unusedVariables false

/-!
# A162192

Triangle read by rows in which row n lists the divisors of n, prime(n), the consecutive composites that are greater than prime(n), and prime (n+1), but row 0 is formed by 1 and 2.

The 68 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A162192

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, 2, 1, 2, 3, 1, 2, 3, 4, 5,
    1, 3, 5, 6, 7, 1, 2, 4, 7, 8,
    9, 10, 11, 1, 5, 11, 12, 13, 1, 2,
    3, 6, 13, 14, 15, 16, 17, 1, 7, 17,
    18, 19, 1, 2, 4, 8, 19, 20, 21, 22,
    23, 1, 3, 9, 23, 24, 25, 26, 27, 28,
    29, 1, 2, 5, 10, 29, 30, 31]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 68) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 68) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 68) : flatFz n = flatData[n.toNat]! := sorry

end A162192
