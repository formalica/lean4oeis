import LOEIS.A077.A077321.Defs

set_option linter.unusedVariables false

/-!
# A077321

Rearrange primes so as to form a triangle in which n-th row contains the n smallest primes == 1 (mod n) which have not occurred earlier.

The 59 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A077321

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [2, 3, 5, 7, 13, 19, 17, 29, 37, 41,
    11, 31, 61, 71, 101, 43, 67, 73, 79, 97,
    103, 113, 127, 197, 211, 239, 281, 337, 89, 137,
    193, 233, 241, 257, 313, 353, 109, 163, 181, 199,
    271, 307, 379, 397, 433, 131, 151, 191, 251, 311,
    331, 401, 421, 431, 461, 23, 419, 463, 617]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 60) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 60) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 60) : flatFz n = flatData[n.toNat - 1]! := sorry

end A077321
