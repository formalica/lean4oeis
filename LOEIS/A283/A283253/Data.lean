import LOEIS.A283.A283253.Defs

set_option linter.unusedVariables false

/-!
# A283253

Binary representation of the x-axis, from the origin to the right edge, of the n-th stage of growth of the two-dimensional cellular automaton defined by "Rule 605", based on the 5-celled von Neumann neighborhood.

The 20 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A283253

/-- Known terms of `A283253`, starting at index `0`. -/
def data : List retType :=
  [1, 1, 1, 1101, 11001, 111101, 1111001, 11011101, 110011001, 1111111101,
    11101111001, 111111011101, 1011100011001, 1111111111101, 1110101111001, 1111110111011101, 10111000100011001, 11101110111111101, 11011101101111001, 11111101010111011101]

/-- `A283253` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 20) : A283253 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 20) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 20) : fz n = data[n.toNat]! := sorry

end A283253
