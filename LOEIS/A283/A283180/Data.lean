def data : List retType :=
  [1, 0, 110, 1000, 110, 110000, 1001110, 1101000, 110, 1111110000,
    10010001110, 11011101000, 1010000110, 11100011110000, 100111010001110, 110101011101000, 10000010000110, 111011110001110000, 1000010011100001110, 1110000010011101000,
    11111010010000110]

/-- `A283180` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 21) : A283180 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 21) : fn n = data[n]! := sorry

