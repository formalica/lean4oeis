import LOEIS.A283.A283192.Defs

set_option linter.unusedVariables false

/-!
# A283192

Lexicographically earliest sequence of distinct terms such that the derived sequence s(n)=CarrylessSum{k=1..n}a(k) contains only distinct terms, where CarrylessSum is the analog of summation for carryless addition.

The 67 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A283192

/-- Known terms of `A283192`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 3, 4, 5, 7, 6, 9, 10, 8,
    11, 12, 13, 14, 15, 16, 17, 18, 20, 19,
    22, 21, 23, 28, 24, 25, 26, 29, 30, 27,
    31, 32, 33, 35, 34, 36, 38, 37, 41, 40,
    39, 42, 44, 52, 45, 43, 46, 47, 54, 48,
    51, 55, 56, 49, 67, 62, 50, 53, 61, 58,
    57, 63, 64, 71, 59, 66, 65]

/-- `A283192` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 68) : A283192 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 68) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 68) : fz n = data[n.toNat - 1]! := sorry

end A283192
