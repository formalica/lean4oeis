import LOEIS.A283.A283252.Defs

set_option linter.unusedVariables false

/-!
# A283252

Binary representation of the x-axis, from the left edge to the origin, of the n-th stage of growth of the two-dimensional cellular automaton defined by "Rule 605", based on the 5-celled von Neumann neighborhood.

The 20 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A283252

/-- Known terms of `A283252`, starting at index `0`. -/
def data : List retType :=
  [1, 10, 100, 1011, 10011, 101111, 1001111, 10111011, 100110011, 1011111111,
    10011110111, 101110111111, 1001100011101, 10111111111110, 100111101011100, 1011101110111111, 10011000100011101, 101111111011101110, 1001111011011101100, 10111011101010111111]

/-- `A283252` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 20) : A283252 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 20) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 20) : fz n = data[n.toNat]! := sorry

end A283252
