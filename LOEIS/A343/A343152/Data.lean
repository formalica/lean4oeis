import LOEIS.A343.A343152.Defs

set_option linter.unusedVariables false

/-!
# A343152

Reverse the order of all but the most significant bits in the maximal Fibonacci expansion of n.

The 67 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A343152

/-- Known terms of `A343152`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 3, 4, 6, 5, 7, 8, 11, 10,
    9, 12, 16, 14, 19, 13, 18, 17, 15, 20,
    21, 29, 27, 24, 32, 26, 23, 31, 22, 30,
    28, 25, 33, 42, 37, 50, 35, 48, 45, 40,
    53, 34, 47, 44, 39, 52, 43, 38, 51, 36,
    49, 46, 41, 54, 55, 76, 71, 63, 84, 69,
