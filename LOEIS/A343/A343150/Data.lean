import LOEIS.A343.A343150.Defs

set_option linter.unusedVariables false

/-!
# A343150

Reverse the order of all but the most significant bits in the minimal Fibonacci expansion of n.

The 67 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A343150

/-- Known terms of `A343150`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 3, 4, 5, 7, 6, 8, 11, 10,
    9, 12, 13, 18, 16, 15, 20, 14, 19, 17,
    21, 29, 26, 24, 32, 23, 31, 28, 22, 30,
    27, 25, 33, 34, 47, 42, 39, 52, 37, 50,
    45, 36, 49, 44, 41, 54, 35, 48, 43, 40,
    53, 38, 51, 46, 55, 76, 68, 63, 84, 60,
    81, 73, 58, 79, 71, 66, 87]

/-- `A343150` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 68) : A343150 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 68) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 68) : fz n = data[n.toNat - 1]! := sorry

end A343150
