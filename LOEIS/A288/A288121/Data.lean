import LOEIS.A288.A288121.Defs

set_option linter.unusedVariables false

/-!
# A288121

Binary representation of the diagonal from the corner to the origin of the n-th stage of growth of the two-dimensional cellular automaton defined by "Rule 422", based on the 5-celled von Neumann neighborhood.

The 33 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A288121

/-- Known terms of `A288121`, starting at index `0`. -/
def data : List retType :=
  [1, 1, 0, 0, 11, 11, 11, 11, 1111, 1111,
    1111, 1111, 1111, 1111, 1111, 1111, 11111111, 11111111, 11111111, 11111111,
    11111111, 11111111, 11111111, 11111111, 11111111, 11111111, 11111111, 11111111, 11111111, 11111111,
    11111111, 11111111, 1111111111111111]

/-- `A288121` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 33) : A288121 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 33) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 33) : fz n = data[n.toNat]! := sorry

end A288121
