import LOEIS.A288.A288012.Defs

set_option linter.unusedVariables false

/-!
# A288012

Binary representation of the diagonal from the corner to the origin of the n-th stage of growth of the two-dimensional cellular automaton defined by "Rule 398", based on the 5-celled von Neumann neighborhood.

The 35 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A288012

/-- Known terms of `A288012`, starting at index `0`. -/
def data : List retType :=
  [1, 1, 0, 1, 10, 0, 0, 0, 1100, 0,
    1000, 100, 0, 1100, 0, 100, 11111000, 100, 11001000, 110100,
    1000, 11000100, 1011000, 1000100, 1000000, 1000100, 1000000, 101000100, 1000000, 1000100,
    101000000, 1000100, 1111100001000000, 101000100, 1111100001000000]

/-- `A288012` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 35) : A288012 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 35) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 35) : fz n = data[n.toNat]! := sorry

end A288012
