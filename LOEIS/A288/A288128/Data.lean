import LOEIS.A288.A288128.Defs

set_option linter.unusedVariables false

/-!
# A288128

Binary representation of the diagonal from the origin to the corner of the n-th stage of growth of the two-dimensional cellular automaton defined by "Rule 425", based on the 5-celled von Neumann neighborhood.

The 21 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A288128

/-- Known terms of `A288128`, starting at index `0`. -/
def data : List retType :=
  [1, 1, 110, 11, 10100, 10111, 1011000, 1001111, 100010000, 111011111,
    11011100000, 1000111111, 1000101000000, 1110101111111, 110110110000000, 10010011111111, 10000000100000000, 11111110111111111, 1100000111000000000, 111110001111111111,
    101000101010000000000]

/-- `A288128` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 21) : A288128 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 21) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 21) : fz n = data[n.toNat]! := sorry

end A288128
