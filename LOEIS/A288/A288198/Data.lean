/-!
# A288198

Binary representation of the diagonal from the corner to the origin of the n-th stage of growth of the two-dimensional cellular automaton defined by "Rule 433", based on the 5-celled von Neumann neighborhood.

The 23 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A288198

/-- Known terms of `A288198`, starting at index `0`. -/
def data : List retType :=
  [1, 10, 11, 1100, 11, 111110, 1111, 11110110, 1111, 1111110000,
    11111, 111111101010, 11111, 11111111101110, 11011111, 1111111101110100, 10011011, 111111111101101110, 111110001, 11111111111010001110,
    111110101, 1111111111111011111010, 1111010101]

/-- `A288198` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 23) : A288198 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 23) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 23) : fz n = data[n.toNat]! := sorry

end A288198
