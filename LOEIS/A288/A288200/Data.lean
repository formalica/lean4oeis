import LOEIS.A288.A288200.Defs

set_option linter.unusedVariables false

/-!
# A288200

Binary representation of the diagonal from the origin to the corner of the n-th stage of growth of the two-dimensional cellular automaton defined by "Rule 433", based on the 5-celled von Neumann neighborhood.

The 21 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A288200

/-- Known terms of `A288200`, starting at index `0`. -/
def data : List retType :=
  [1, 1, 110, 11, 11000, 11111, 1111000, 1101111, 111100000, 111111,
    11111000000, 10101111111, 1111100000000, 1110111111111, 111110110000000, 10111011111111, 11011001000000000, 11101101111111111, 1000111110000000000, 1110001011111111111,
    101011111000000000000]

/-- `A288200` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 21) : A288200 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 21) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 21) : fz n = data[n.toNat]! := sorry

end A288200
