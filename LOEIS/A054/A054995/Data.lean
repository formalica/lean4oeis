import LOEIS.A054.A054995.Defs

set_option linter.unusedVariables false

/-!
# A054995

A version of Josephus problem: a(n) is the surviving integer under the following elimination process. Arrange 1,2,3,...,n in a circle, increasing clockwise. Starting with i=1, delete the integer two places clockwise from i. Repeat, counting two places from the next undeleted integer, until only one integer remains.

The 78 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A054995

/-- Known terms of `A054995`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 2, 1, 4, 1, 4, 7, 1, 4,
    7, 10, 13, 2, 5, 8, 11, 14, 17, 20,
    2, 5, 8, 11, 14, 17, 20, 23, 26, 29,
    1, 4, 7, 10, 13, 16, 19, 22, 25, 28,
    31, 34, 37, 40, 43, 46, 2, 5, 8, 11,
    14, 17, 20, 23, 26, 29, 32, 35, 38, 41,
    44, 47, 50, 53, 56, 59, 62, 65, 68, 1,
    4, 7, 10, 13, 16, 19, 22, 25]

/-- `A054995` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 79) : A054995 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 79) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 79) : fz n = data[n.toNat - 1]! := sorry

end A054995
