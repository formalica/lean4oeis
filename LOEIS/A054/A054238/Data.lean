import LOEIS.A054.A054238.Defs

set_option linter.unusedVariables false

/-!
# A054238

Array read by downward antidiagonals: T(i,j) = bits of binary expansion of i interleaved with that of j.

The 70 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A054238

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [0, 1, 2, 4, 3, 8, 5, 6, 9, 10,
    16, 7, 12, 11, 32, 17, 18, 13, 14, 33,
    34, 20, 19, 24, 15, 36, 35, 40, 21, 22,
