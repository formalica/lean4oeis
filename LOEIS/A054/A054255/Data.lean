import LOEIS.A054.A054255.Defs

set_option linter.unusedVariables false

/-!
# A054255

Triangle T(n,k) (n >= 1, 0<=k<=n) giving number of preferential arrangements of n things beginning with k (transposed, then read by rows).

The 45 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A054255

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 2, 2, 5, 6, 6, 18, 25, 26,
    24, 84, 134, 149, 150, 120, 480, 870, 1050, 1081,
    1082, 720, 3240, 6600, 8700, 9302, 9365, 9366, 5040, 25200,
    57120, 82320, 92526, 94458, 94585, 94586, 40320, 221760, 554400, 871920,
    1038744, 1085364, 1091414, 1091669, 1091670]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 46) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 46) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 46) : flatFz n = flatData[n.toNat - 1]! := sorry

end A054255
