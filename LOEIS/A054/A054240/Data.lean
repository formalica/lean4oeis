import LOEIS.A054.A054240.Defs

set_option linter.unusedVariables false

/-!
# A054240

Bit-interleaved number addition table; like binary addition but carries shift 2 instead of 1; addition base sqrt(2).

The 82 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A054240

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [0, 1, 1, 2, 4, 2, 3, 3, 3, 3,
    4, 6, 8, 6, 4, 5, 5, 9, 9, 5,
    5, 6, 16, 6, 12, 6, 16, 6, 7, 7,
    7, 7, 7, 7, 7, 7, 8, 18, 12, 18,
    16, 18, 12, 18, 8, 9, 9, 13, 13, 17,
    17, 13, 13, 9, 9, 10, 12, 10, 24, 18,
    20, 18, 24, 10, 12, 10, 11, 11, 11, 11,
    19, 19, 19, 19, 11, 11, 11, 11, 12, 14,
    32, 14]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 82) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 82) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 82) : flatFz n = flatData[n.toNat]! := sorry

end A054240
