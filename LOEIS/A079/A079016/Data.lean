/-!
# A079016

Suppose p and q = p+12 are primes. Define the difference pattern of (p,q) to be the successive differences of the primes in the range p to q. There are 14 possible difference patterns, namely [12], [2,10], [4,8], [6,6], [8,4], [10,2], [2,4,6], [2,6,4], [4,2,6], [4,6,2], [6,2,4], [6,4,2], [2,4,2,4] and [4,2,4,2]. Sequence gives smallest value of p for each difference pattern, sorted by magnitude.

The 14 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A079016

/-- Known terms of `A079016`, starting at index `1`. -/
def data : List retType :=
  [5, 7, 17, 19, 29, 31, 47, 67, 89, 137,
    139, 199, 397, 1601]

/-- `A079016` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 15) : A079016 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 15) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 15) : fz n = data[n.toNat - 1]! := sorry

end A079016
