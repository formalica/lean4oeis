/-!
# A079017

Suppose p and q = p+14 are primes. Define the difference pattern of (p,q) to be the successive differences of the primes in the range p to q. There are 15 possible difference patterns, namely [14], [2,12], [6,8], [8,6], [12,2], [2,4,8], [2,6,6], [2,10,2], [6,2,6], [6,6,2], [8,4,2], [2,4,6,2], [2,6,4,2], [2,2,4,2,4], [2,4,2,4,2]. Sequence gives smallest value of p for each difference pattern, sorted by magnitude.

The 15 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A079017

/-- Known terms of `A079017`, starting at index `1`. -/
def data : List retType :=
  [3, 5, 17, 23, 29, 47, 83, 89, 113, 137,
    149, 197, 359, 509, 1997]

/-- `A079017` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 16) : A079017 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 16) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 16) : fz n = data[n.toNat - 1]! := sorry

end A079017
