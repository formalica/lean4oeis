import LOEIS.A340.A340255.Defs

set_option linter.unusedVariables false

/-!
# A340255

Lexicographically earliest sequence of distinct nonnegative terms such that for any n >= 0, a(n+1) is obtained by altering the leftmost digit (which is not a leading zero) in the factorial base representation of a(n) or if this is not possible by altering the rightmost leading zero in the factorial base representation of a(n).

The 66 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A340255

/-- Known terms of `A340255`, starting at index `0`. -/
def data : List retType :=
  [0, 1, 3, 5, 4, 2, 8, 14, 20, 18,
    6, 12, 16, 10, 22, 23, 11, 17, 13, 7,
    19, 21, 9, 15, 39, 63, 87, 111, 99, 27,
    51, 75, 81, 33, 57, 105, 117, 45, 69, 93,
    91, 43, 67, 115, 97, 25, 49, 73, 79, 31,
    55, 103, 109, 37, 61, 85, 89, 41, 65, 113,
    101, 29, 53, 77, 83, 35]

/-- `A340255` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 66) : A340255 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 66) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 66) : fz n = data[n.toNat]! := sorry

end A340255
