import LOEIS.A340.A340300.Defs

set_option linter.unusedVariables false

/-!
# A340300

a(n) is the number of iterations for n to reach 1 under the following scheme. If k == 0 (mod 3), then k -> k/3, if k == 1 (mod 3) k -> 2k, and if k == 2 (mod 3) add the middle two divisors of k and divide the result by 3.

The 105 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A340300

/-- Known terms of `A340300`, starting at index `1`. -/
def data : List retType :=
  [0, 1, 1, 3, 2, 2, 3, 2, 2, 3,
    4, 4, 4, 2, 3, 5, 3, 3, 5, 2,
    4, 4, 3, 3, 4, 3, 3, 4, 4, 4,
    6, 4, 5, 5, 4, 5, 6, 4, 5, 4,
    3, 3, 5, 3, 4, 4, 6, 6, 5, 3,
    4, 5, 4, 4, 5, 3, 6, 6, 3, 3,
    6, 5, 5, 4, 3, 5, 5, 4, 4, 4,
    4, 4, 6, 5, 5, 4, 3, 4, 5, 3,
    4, 5, 5, 5, 4, 4, 5, 4, 5, 5,
    4, 3, 7, 5, 3, 5, 7, 4, 6, 5,
    6, 6, 6, 4, 5]

/-- `A340300` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 106) : A340300 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 106) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 106) : fz n = data[n.toNat - 1]! := sorry

end A340300
