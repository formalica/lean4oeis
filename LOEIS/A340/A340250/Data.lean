import LOEIS.A340.A340250.Defs

set_option linter.unusedVariables false

/-!
# A340250

Lexicographically earliest sequence of distinct nonnegative terms such that for any n >= 0, a(n+1) is obtained by inverting the leftmost binary digit (which is not a leading zero) in a(n) or if this is not possible by inverting the rightmost leading binary zero in a(n).

The 67 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A340250

/-- Known terms of `A340250`, starting at index `0`. -/
def data : List retType :=
  [0, 1, 3, 2, 6, 4, 5, 7, 15, 11,
    9, 13, 12, 8, 10, 14, 30, 22, 18, 26,
    24, 16, 20, 28, 29, 21, 17, 25, 27, 19,
    23, 31, 63, 47, 39, 55, 51, 35, 43, 59,
    57, 41, 33, 49, 53, 37, 45, 61, 60, 44,
    36, 52, 48, 32, 40, 56, 58, 42, 34, 50,
    54, 38, 46, 62, 126, 94, 78]

/-- `A340250` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 67) : A340250 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 67) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 67) : fz n = data[n.toNat]! := sorry

end A340250
