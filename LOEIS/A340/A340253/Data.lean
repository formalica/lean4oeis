import LOEIS.A340.A340253.Defs

set_option linter.unusedVariables false

/-!
# A340253

Lexicographically earliest sequence of distinct nonnegative terms such that for any n >= 0, a(n+1) is obtained by altering the leftmost ternary digit (which is not a leading zero) in a(n) or if this is not possible by altering the rightmost ternary leading zero in a(n).

The 68 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A340253

/-- Known terms of `A340253`, starting at index `0`. -/
def data : List retType :=
  [0, 1, 2, 5, 8, 6, 3, 4, 7, 16,
    25, 19, 10, 13, 22, 21, 12, 9, 18, 24,
    15, 17, 26, 20, 11, 14, 23, 50, 77, 59,
    32, 41, 68, 65, 38, 29, 56, 74, 47, 53,
    80, 62, 35, 44, 71, 69, 42, 33, 60, 78,
    51, 45, 72, 54, 27, 36, 63, 66, 39, 30,
    57, 75, 48, 49, 76, 58, 31, 40]

/-- `A340253` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 68) : A340253 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 68) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 68) : fz n = data[n.toNat]! := sorry

end A340253
