/-!
# A340059

Limiting sequence when we start with positive integers and at step n >= 1, a(n) >= 1, subtract from the term at position n + a(n) the value A000005(a(n)). If no value a(n) at position n, take a(n) = n - A000005(n).

The 63 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A340059

/-- Known terms of `A340059`, starting at index `1`. -/
def data : List retType :=
  [1, 1, 2, 1, 2, 2, 5, 6, 6, 6,
    9, 10, 11, 10, 11, 12, 15, 12, 17, 17,
    17, 18, 21, 18, 22, 24, 23, 22, 27, 24,
    29, 28, 29, 30, 31, 34, 35, 36, 35, 32,
    39, 36, 41, 40, 39, 42, 43, 38, 46, 36,
    47, 46, 51, 46, 51, 52, 53, 54, 57, 58,
    59, 60, 57]

/-- `A340059` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 64) : A340059 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 64) : fn n = data[n - 1]! := sorry

