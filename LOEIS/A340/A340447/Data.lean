import LOEIS.A340.A340447.Defs

set_option linter.unusedVariables false

/-!
# A340447

Lexicographically earliest sequence of distinct nonnegative integers such that for any n >= 0, a(n) XOR a(n+1) is a Fibonacci number as small as possible (where XOR denotes the bitwise XOR operator).

The 67 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A340447

/-- Known terms of `A340447`, starting at index `0`. -/
def data : List retType :=
  [0, 1, 3, 2, 7, 6, 4, 5, 13, 12,
    14, 15, 10, 11, 9, 8, 29, 28, 30, 31,
    26, 27, 25, 24, 16, 17, 19, 18, 23, 22,
    20, 21, 55, 54, 52, 53, 48, 49, 51, 50,
    58, 59, 57, 56, 61, 60, 62, 63, 42, 43,
    41, 40, 45, 44, 46, 47, 39, 38, 36, 37,
    32, 33, 35, 34, 123, 122, 120]

/-- `A340447` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 67) : A340447 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 67) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 67) : fz n = data[n.toNat]! := sorry

end A340447
