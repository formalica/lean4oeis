import LOEIS.A340.A340666.Defs

set_option linter.unusedVariables false

/-!
# A340666

A(n,k) is derived from n by replacing each 0 in its binary representation with a string of k 0's; square array A(n,k), n>=0, k>=0, read by antidiagonals.

The 78 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A340666

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [0, 0, 1, 0, 1, 1, 0, 1, 2, 3,
    0, 1, 4, 3, 1, 0, 1, 8, 3, 4,
    3, 0, 1, 16, 3, 16, 5, 3, 0, 1,
    32, 3, 64, 9, 6, 7, 0, 1, 64, 3,
    256, 17, 12, 7, 1, 0, 1, 128, 3, 1024,
    33, 24, 7, 8, 3, 0, 1, 256, 3, 4096,
    65, 48, 7, 64, 9, 3, 0, 1, 512, 3,
    16384, 129, 96, 7, 512, 33, 10, 7]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 78) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 78) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 78) : flatFz n = flatData[n.toNat]! := sorry

end A340666
