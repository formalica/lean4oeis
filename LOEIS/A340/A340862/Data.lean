import LOEIS.A340.A340862.Defs

set_option linter.unusedVariables false

/-!
# A340862

Number of times the number n turns up in pseudo-Fibonacci sequences starting with [k, 1] (with k >= 1), excluding the starting terms.

The 88 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A340862

/-- Known terms of `A340862`, starting at index `1`. -/
def data : List retType :=
  [0, 1, 2, 2, 3, 2, 3, 3, 3, 2,
    4, 2, 4, 3, 3, 2, 4, 3, 3, 3,
    4, 2, 5, 2, 3, 3, 3, 3, 5, 2,
    3, 3, 4, 3, 4, 2, 4, 4, 3, 2,
    4, 2, 4, 3, 4, 2, 5, 3, 3, 3,
    3, 2, 6, 2, 4, 3, 3, 3, 4, 3,
    4, 3, 4, 2, 4, 2, 3, 4, 4, 2,
    4, 2, 5, 3, 3, 3, 5, 3, 3, 3,
    3, 2, 5, 2, 4, 4, 3, 3]

/-- `A340862` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 89) : A340862 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 89) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 89) : fz n = data[n.toNat - 1]! := sorry

end A340862
