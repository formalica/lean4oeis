import LOEIS.A340.A340351.Defs

set_option linter.unusedVariables false

/-!
# A340351

Square array, read by descending antidiagonals, where row n gives all solutions k > 0 to A000120(k)=A000120(k*n), A000120 is the Hamming weight.

The 80 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A340351

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 1, 3, 2, 3, 4, 3, 6, 1,
    5, 4, 7, 2, 7, 6, 5, 12, 3, 14,
    3, 7, 6, 14, 4, 15, 6, 7, 8, 7,
    15, 5, 27, 7, 14, 1, 9, 8, 24, 6,
    28, 12, 15, 2, 15, 10, 9, 28, 7, 30,
    14, 19, 3, 30, 7, 11, 10, 30, 8, 31,
    15, 28, 4, 31, 14, 3, 12, 11, 31, 9,
    39, 24, 30, 5, 43, 15, 6, 3, 13, 12]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 81) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 81) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 81) : flatFz n = flatData[n.toNat - 1]! := sorry

end A340351
