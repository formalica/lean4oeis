import LOEIS.A358.A358085.Defs

set_option linter.unusedVariables false

/-!
# A358085

Inventory of positions ordered by binary lengths of terms, as an irregular table; the first row contains 1, subsequent rows contains the 1-based positions of terms with binary length 1, followed by positions of terms with binary length 2, 3, etc. in prior rows flattened.

The 64 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A358085

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 2, 1, 2, 3, 4, 1, 2,
    3, 5, 4, 6, 7, 8, 1, 2, 3, 5,
    9, 4, 6, 7, 10, 11, 8, 12, 13, 14,
    15, 16, 1, 2, 3, 5, 9, 17, 4, 6,
    7, 10, 11, 18, 19, 8, 12, 13, 14, 15,
    20, 22, 23, 24, 16, 21, 25, 26, 27, 28,
    29, 30, 31, 32]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 65) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 65) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 65) : flatFz n = flatData[n.toNat - 1]! := sorry

end A358085
