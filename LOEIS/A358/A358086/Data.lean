import LOEIS.A358.A358086.Defs

set_option linter.unusedVariables false

/-!
# A358086

Inventory of positions ordered by odd parts of terms, as an irregular table; the first row contains 1, subsequent rows contains the 1-based positions of terms with odd part 1, followed by positions of terms with odd part 3, 5, etc. in prior rows flattened.

The 64 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A358086

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 2, 1, 2, 3, 4, 1, 2,
    3, 4, 5, 6, 8, 7, 1, 2, 3, 4,
    5, 6, 8, 9, 10, 12, 15, 7, 11, 14,
    13, 16, 1, 2, 3, 4, 5, 6, 8, 9,
    10, 12, 15, 17, 18, 20, 23, 32, 7, 11,
    14, 19, 22, 26, 13, 21, 25, 16, 28, 30,
    24, 29, 31, 27]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 65) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 65) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 65) : flatFz n = flatData[n.toNat - 1]! := sorry

end A358086
