import LOEIS.A358.A358120.Defs

set_option linter.unusedVariables false

/-!
# A358120

Partial inventory of positions as an irregular table; rows 1 and 2 contain 1, for n > 2, row n contains the 1-based positions of 1's, followed by the positions of 2's, 3's, etc. in rows n-1 and n-2 flattened.

The 88 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A358120

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 2, 1, 3, 2, 1, 4, 3,
    5, 2, 1, 6, 5, 8, 3, 7, 2, 4,
    1, 9, 7, 13, 5, 11, 8, 10, 3, 12,
    2, 6, 4, 1, 14, 11, 20, 9, 18, 13,
    21, 5, 16, 12, 15, 3, 19, 7, 17, 2,
    8, 6, 10, 4, 1, 22, 17, 32, 13, 30,
    21, 34, 9, 26, 19, 33, 15, 24, 18, 28,
    5, 23, 20, 29, 3, 27, 11, 31, 7, 25,
    2, 12, 10, 16, 6, 14, 4, 8]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 89) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 89) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 89) : flatFz n = flatData[n.toNat - 1]! := sorry

end A358120
