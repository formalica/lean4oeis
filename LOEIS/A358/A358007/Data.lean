/-- `A358007` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 141) : A358007 n = data[n.val - 53]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 53 ≤ n) (h : n < 141) : fn n = data[n - 53]! := sorry

