import LOEIS.A376.A376181.Defs

set_option linter.unusedVariables false

/-!
# A376181

Array read by antidiagonals: Start from 1 and thereafter add gnomons of terms for each t >= 2 with width a(t-1).

The 100 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A376181

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 2, 3, 2, 3, 3, 3, 3, 3,
    4, 3, 3, 3, 4, 4, 4, 3, 3, 4,
    4, 5, 4, 4, 3, 4, 4, 5, 5, 5,
    4, 4, 4, 4, 5, 5, 5, 5, 5, 4,
    4, 4, 5, 5, 5, 6, 5, 5, 5, 4,
    4, 5, 5, 5, 6, 6, 6, 5, 5, 5,
    4, 5, 5, 5, 6, 6, 7, 6, 6, 5,
    5, 5, 5, 5, 5, 6, 6, 7, 7, 7,
    6, 6, 5, 5, 5, 5, 5, 6, 6, 7,
    7, 7, 7, 7, 6, 6, 5, 5, 5, 5]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 101) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 101) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 101) : flatFz n = flatData[n.toNat - 1]! := sorry

end A376181
