set_option linter.unusedVariables false

/-!
# A156284

From every interval (2^(m-1), 2^m), m >= 3, we remove primes p for which 2^m-p is a prime that was not removed for smaller values of m; the sequence gives all remaining odd primes.

The 41 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A156284

/-- Known terms of `A156284`, starting at index `1`. -/
def data : List retType :=
  [3, 7, 11, 17, 19, 23, 31, 37, 43, 59,
    67, 71, 73, 79, 83, 89, 101, 103, 107, 113,
    127, 131, 137, 139, 151, 157, 163, 179, 181, 191,
    193, 199, 211, 223, 227, 229, 241, 251, 257, 263,
    269]

/-- `A156284` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 42) : A156284 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 42) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 42) : fz n = data[n.toNat - 1]! := sorry

end A156284
