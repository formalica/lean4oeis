import LOEIS.A156.A156281.Defs

set_option linter.unusedVariables false

/-!
# A156281

Irregular table with the coefficient [x^k] of Product_{j=1..n} (x^j - (1-x^j)/(1-x)) in row n, column 0<=k.

The 92 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A156281

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, -1, 1, 1, 0, -2, 1, -1, -1, 1,
    2, 1, -3, 1, 1, 2, 1, -1, -4, -2,
    0, 3, 3, -4, 1, -1, -3, -4, -3, 1,
    5, 8, 5, -1, -4, -5, -3, 3, 6, -5,
    1, 1, 4, 8, 11, 10, 5, -5, -15, -19,
    -17, -7, 5, 13, 9, 7, -1, -7, -8, 1,
    10, -6, 1, -1, -5, -13, -24, -34, -39, -34,
    -17, 9, 38, 59, 63, 50, 26, -6, -28, -36,
    -25, -9, 2, 13, 17, 8, -5, -14, -4, 15,
    -7, 1]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 92) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 92) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 92) : flatFz n = flatData[n.toNat]! := sorry

end A156281
