/-- `A156144` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 94) : A156144 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 94) : fn n = data[n - 1]! := sorry

