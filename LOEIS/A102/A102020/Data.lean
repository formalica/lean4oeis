import LOEIS.A102.A102020.Defs

set_option linter.unusedVariables false

/-!
# A102020

Indices of primes in sequence defined by A(0) = 17, A(n) = 10*A(n-1) - 13 for n > 0.

The 15 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A102020

/-- Known terms of `A102020`, starting at index `1`. -/
def data : List retType :=
  [0, 1, 4, 6, 18, 19, 27, 57, 249, 396,
    7590, 32715, 70977, 83586, 140692]

/-- `A102020` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 16) : A102020 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 16) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 16) : fz n = data[n.toNat - 1]! := sorry

end A102020
