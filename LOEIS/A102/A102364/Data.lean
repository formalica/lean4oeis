/-- `A102364` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 87) : A102364 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 87) : fn n = data[n]! := sorry

