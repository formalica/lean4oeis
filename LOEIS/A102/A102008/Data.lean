set_option linter.unusedVariables false

/-!
# A102008

Indices of primes in sequence defined by A(0) = 19, A(n) = 10*A(n-1) - 81 for n > 0.

The 26 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A102008

/-- Known terms of `A102008`, starting at index `1`. -/
def data : List retType :=
  [0, 1, 2, 3, 8, 17, 21, 44, 48, 55,
    68, 145, 201, 271, 2729, 2840, 4561, 31809, 43185, 48108,
    92690, 237669, 400309, 482705, 831775, 1036182]

/-- `A102008` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 27) : A102008 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 27) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 27) : fz n = data[n.toNat - 1]! := sorry

end A102008
