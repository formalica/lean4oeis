import LOEIS.A102.A102010.Defs

set_option linter.unusedVariables false

/-!
# A102010

Indices of primes in sequence defined by A(0) = 17, A(n) = 10*A(n-1) - 43 for n > 0.

The 14 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A102010

/-- Known terms of `A102010`, starting at index `1`. -/
def data : List retType :=
  [0, 1, 3, 13, 24, 31, 55, 61, 810, 811,
    1083, 2532, 11923, 49551]

/-- `A102010` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 15) : A102010 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 15) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 15) : fz n = data[n.toNat - 1]! := sorry

end A102010
