import LOEIS.A368.A368053.Defs

set_option linter.unusedVariables false

/-!
# A368053

Array read by descending antidiagonals, where row n=0 lists the natural numbers. Each new row n=1,2,... is found by taking the number n in the previous row and "leaping" it over the next n terms to its right, while reversing the order of the skipped terms. (see example).

The 91 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A368053

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 2, 3, 1, 3, 4, 3, 1, 4,
    5, 4, 2, 2, 5, 6, 5, 4, 1, 3,
    6, 7, 6, 5, 3, 1, 4, 7, 8, 7,
    6, 5, 2, 2, 5, 8, 9, 8, 7, 6,
    4, 1, 3, 6, 9, 10, 9, 8, 7, 6,
    3, 1, 4, 7, 10, 11, 10, 9, 8, 7,
    5, 2, 2, 5, 8, 11, 12, 11, 10, 9,
    8, 7, 4, 1, 3, 6, 9, 12, 13, 12,
    11, 10, 9, 8, 6, 3, 1, 4, 7, 10,
    13]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 92) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 92) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 92) : flatFz n = flatData[n.toNat - 1]! := sorry

end A368053
