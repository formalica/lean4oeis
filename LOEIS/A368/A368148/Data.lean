import LOEIS.A368.A368148.Defs

set_option linter.unusedVariables false

/-!
# A368148

Square array A(n, k), n, k > 0, read and filled in the greedy way by upwards antidiagonals such that A(n, k) corresponds to the size of the connected component (relative to the Von Neumann neighborhood) of terms equal to A(n, k) including the position (n, k).

The 91 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A368148

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 2, 2, 1, 2, 1, 3, 3, 1,
    2, 2, 3, 2, 2, 2, 1, 2, 2, 1,
    2, 1, 3, 3, 1, 3, 3, 1, 2, 2,
    3, 2, 2, 3, 2, 2, 2, 1, 2, 2,
    1, 2, 2, 1, 2, 1, 3, 3, 1, 3,
    3, 1, 3, 3, 1, 2, 2, 3, 2, 2,
    3, 2, 2, 3, 2, 2, 2, 1, 2, 2,
    1, 2, 2, 1, 2, 2, 1, 2, 1, 3,
    3, 1, 3, 3, 1, 3, 3, 1, 3, 3,
    1]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 92) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 92) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 92) : flatFz n = flatData[n.toNat - 1]! := sorry

end A368148
