    314222, 1362798, 3459950, 11848558, 78957422, 615828334, 1689570158, 10279504750, 44639243118, 113358719854,
    663114533742, 2862137789294, 20454323833710, 301929300544366, 1427829207386990, 3679629021072238]

/-- `A133155` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 27) : A133155 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
