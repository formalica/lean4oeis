import LOEIS.A165.A165303.Defs

set_option linter.unusedVariables false

/-!
# A165303

a(n) is the smallest number not already in the sequence, such that the concatenation of all a(n) displays the periodic digit string 1, 2, 3, 4, 5 (and repeat).

The 39 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A165303

/-- Known terms of `A165303`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 3, 4, 5, 12, 34, 51, 23, 45,
    123, 451, 234, 512, 345, 1234, 5123, 4512, 3451, 2345,
    12345, 123451, 23451, 234512, 34512, 345123, 45123, 451234, 51234, 512345,
    1234512, 3451234, 5123451, 2345123, 4512345, 12345123, 45123451, 23451234, 51234512]

/-- `A165303` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 40) : A165303 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 40) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 40) : fz n = data[n.toNat - 1]! := sorry

end A165303
