/-!
# A165302

a(n) is the smallest number not already in the sequence, such that the concatenation of all a(n) displays the periodic digit string 1, 2, 3, 4 (and repeat).

The 36 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A165302

/-- Known terms of `A165302`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 3, 4, 12, 34, 123, 41, 23, 412,
    341, 234, 1234, 12341, 2341, 23412, 3412, 34123, 4123, 41234,
    123412, 341234, 1234123, 412341, 234123, 4123412, 3412341, 2341234, 12341234, 123412341,
    23412341, 234123412, 34123412, 341234123, 41234123, 412341234]

/-- `A165302` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 37) : A165302 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 37) : fn n = data[n - 1]! := sorry

