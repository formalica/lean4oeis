import LOEIS.A205.A205443.Defs

set_option linter.unusedVariables false

/-!
# A205443

The index j<k such that n divides s(k)-s(j) for some j, where s(j)=Fibonacci(2j-1), and k is the least index for which such a j exists.

The 60 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A205443

/-- Known terms of `A205443`, starting at index `1`. -/
def data : List retType :=
  [1, 1, 2, 1, 5, 1, 4, 3, 6, 4,
    2, 1, 7, 3, 10, 2, 9, 6, 4, 4,
    4, 1, 12, 6, 25, 6, 18, 3, 3, 9,
    7, 2, 1, 9, 20, 6, 19, 4, 14, 15,
    10, 3, 22, 1, 30, 12, 8, 6, 28, 24,
    18, 6, 27, 18, 5, 12, 3, 1, 14, 9]

/-- `A205443` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 61) : A205443 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 61) : fn n = data[n - 1]! := sorry

