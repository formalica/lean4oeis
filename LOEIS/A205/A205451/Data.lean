import LOEIS.A205.A205451.Defs

set_option linter.unusedVariables false

/-!
# A205451

The index j<k such that n divides s(k)-s(j) for some j, where s(j)=Fibonacci(2j), and k is the least index for which such a j exists.

The 60 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A205451

/-- Known terms of `A205451`, starting at index `1`. -/
def data : List retType :=
  [1, 1, 2, 1, 2, 2, 1, 3, 2, 1,
    1, 2, 3, 5, 2, 3, 4, 2, 1, 1,
    4, 2, 5, 2, 12, 2, 1, 3, 1, 4,
    1, 3, 2, 4, 1, 6, 9, 1, 2, 6,
    4, 4, 10, 1, 4, 5, 3, 6, 2, 11,
    2, 2, 13, 1, 5, 3, 2, 1, 1, 2]

/-- `A205451` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 61) : A205451 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 61) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 61) : fz n = data[n.toNat - 1]! := sorry

end A205451
