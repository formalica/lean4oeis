import LOEIS.A103.A103575.Defs

set_option linter.unusedVariables false

/-!
# A103575

Write the natural numbers as an infinite sequence of digits; starting at the left, cut into the smallest pieces so that each piece is a prime.

The 7 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A103575

/-- Known terms of `A103575`, starting at index `1`. -/
def data : List retType :=
  [12345678910111, 2, 13, 14151617, 181, 920212223242526272829303132333435363738394041424344454647484950515253, 5]

/-- `A103575` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 8) : A103575 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 8) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 8) : fz n = data[n.toNat - 1]! := sorry

end A103575
