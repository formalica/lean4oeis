set_option linter.unusedVariables false

/-!
# A130111

Rearrangement of positive integers such that each five terms sum up to a perfect square.

The 75 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A130111

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 3, 4, 6, 5, 7, 8, 9, 20,
    10, 11, 12, 13, 18, 14, 15, 16, 17, 19,
    21, 22, 23, 24, 31, 25, 26, 27, 28, 38,
    29, 30, 32, 33, 45, 34, 35, 36, 37, 54,
