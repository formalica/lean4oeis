import LOEIS.A130.A130180.Defs

set_option linter.unusedVariables false

/-!
# A130180

Number of numbers k > 1 such that (sum of digits of k^n)*(sum of digits of k^(n+1)) = k.

The 80 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A130180

/-- Known terms of `A130180`, starting at index `1`. -/
def data : List retType :=
