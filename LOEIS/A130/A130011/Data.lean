import LOEIS.A130.A130011.Defs

set_option linter.unusedVariables false

/-!
# A130011

A self-describing sequence. Pick any integer n in the sequence; this n says: "There are n terms in the sequence that are <= 3n". This sequence is the slowest increasing one with this property.

The 27 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A130011

/-- Known terms of `A130011`, starting at index `1`. -/
def data : List retType :=
  [1, 4, 5, 12, 15, 16, 17, 18, 19, 20,
    21, 36, 37, 38, 45, 48, 51, 54, 57, 60,
    63, 64, 65, 66, 67, 68, 69]

/-- `A130011` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 28) : A130011 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 28) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 28) : fz n = data[n.toNat - 1]! := sorry

end A130011
