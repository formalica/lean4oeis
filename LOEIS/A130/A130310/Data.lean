import LOEIS.A130.A130310.Defs

set_option linter.unusedVariables false

/-!
# A130310

Minimal (or "greedy") Lucas representation of n, in which L(0) = 2 and L(2) = 3 are not allowed in the same representation (hence the correct representation of the integer 5 is 1010 rather than 101). A binary system of integers with Lucas numbers (A000032) as a base.

The 34 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A130310

/-- Known terms of `A130310`, starting at index `0`. -/
def data : List retType :=
  [0, 10, 1, 100, 1000, 1010, 1001, 10000, 10010, 10001,
    10100, 100000, 100010, 100001, 100100, 101000, 101010, 101001, 1000000, 1000010,
    1000001, 1000100, 1001000, 1001010, 1001001, 1010000, 1010010, 1010001, 1010100, 10000000,
    10000010, 10000001, 10000100, 10001000]

/-- `A130310` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 34) : A130310 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 34) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 34) : fz n = data[n.toNat]! := sorry

end A130310
