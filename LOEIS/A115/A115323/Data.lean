import LOEIS.A115.A115323.Defs

set_option linter.unusedVariables false

/-!
# A115323

Triangle, read by rows, where row n+1 is formed by sorting, in ascending order, the result of the convolution of row n (consisting of 2n+1 terms) with [1,1,1].

The 74 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A115323

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 1, 1, 1, 2, 2, 3, 1,
    2, 3, 4, 5, 5, 7, 1, 3, 6, 7,
    9, 12, 12, 14, 17, 1, 4, 10, 16, 17,
    22, 28, 31, 33, 38, 43, 1, 5, 15, 30,
    43, 43, 55, 67, 81, 81, 92, 102, 114, 1,
    6, 21, 50, 88, 114, 116, 141, 165, 203, 216,
    229, 254, 275, 308, 1, 7, 28, 77, 159, 252,
    308, 318, 371, 422]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 74) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 74) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 74) : flatFz n = flatData[n.toNat]! := sorry

end A115323
