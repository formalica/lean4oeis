/-!
# A115992

Number of non-attacking queens that can be placed on a "hyper-chessboard" = hypercube of size 3, dimension n. That is, the size of the largest subset S of {0,1,2}^n such that for each pair (x0,y0,...), (x1,y1,...) of distinct elements of S, the absolute differences vector (|x1-x0|, |y1-y0|, ...) has at least two distinct non-null coordinates.

The 9 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A115992

/-- Known terms of `A115992`, starting at index `0`. -/
def data : List retType :=
  [1, 1, 2, 4, 6, 11, 19, 32, 52]

/-- `A115992` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 9) : A115992 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 9) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 9) : fz n = data[n.toNat]! := sorry

end A115992
