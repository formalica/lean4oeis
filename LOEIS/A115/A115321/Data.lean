import LOEIS.A115.A115321.Defs

set_option linter.unusedVariables false

/-!
# A115321

Triangle read by rows. Let L(m,n) = largest integer such that if each symbol in an m X n array appears at most L(m,n) times, then the array must have a transversal. Values are shown in this order: L(m,n), n>=2, m=2, 3, ..., n-1, n.

The 18 terms known to OEIS, indexed from `2`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A115321

/-- Known terms of `flat`, starting at index `2`. -/
def flatData : List flatRetType :=
  [1, 5, 2, 7, 3, 3, 9, 7, 4, 3,
    11, 8, 5, 5, 4, 13, 10, 8]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 20) : flat n = flatData[n.val - 2]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 2 ≤ n) (h : n < 20) : flatFn n = flatData[n - 2]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 2 ≤ n) (h : n < 20) : flatFz n = flatData[n.toNat - 2]! := sorry

end A115321
