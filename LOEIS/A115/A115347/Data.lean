import LOEIS.A115.A115347.Defs

set_option linter.unusedVariables false

/-!
# A115347

Fibonacci primes that are also primes when their digits are reversed.

The 5 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A115347

/-- Known terms of `A115347`, starting at index `1`. -/
def data : List retType :=
  [2, 3, 5, 13, 1597]

/-- `A115347` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 6) : A115347 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 6) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 6) : fz n = data[n.toNat - 1]! := sorry

end A115347
