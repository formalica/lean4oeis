import LOEIS.A115.A115570.Defs

set_option linter.unusedVariables false

/-!
# A115570

Array read by rows: row n (n>= 1) gives the Betti numbers for the n-th element of the Weyl group of type A3 (in Goresky's standard ordering).

The 96 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A115570

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 1, 1, 1, 1, 1, 2, 1,
    1, 2, 1, 1, 2, 1, 1, 2, 1, 1,
    2, 1, 1, 2, 2, 1, 1, 3, 3, 1,
    1, 3, 3, 1, 1, 3, 3, 1, 1, 2,
    2, 1, 1, 3, 3, 1, 1, 3, 4, 3,
    1, 1, 3, 4, 3, 1, 1, 3, 4, 3,
    1, 1, 3, 5, 4, 1, 1, 3, 4, 3,
    1, 1, 3, 5, 5, 3, 1, 1, 3, 5,
    6, 4, 1, 1, 3, 5, 5, 3, 1, 1,
    3, 5, 6, 5, 3, 1]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 97) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 97) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 97) : flatFz n = flatData[n.toNat - 1]! := sorry

end A115570
