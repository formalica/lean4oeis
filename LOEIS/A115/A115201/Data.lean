import LOEIS.A115.A115201.Defs

set_option linter.unusedVariables false

/-!
# A115201

Number of even parts of partitions of n in the Abramowitz-Stegun (A-St) order.

The 81 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A115201

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [0, 1, 0, 0, 1, 0, 1, 0, 2, 1,
    0, 0, 1, 1, 0, 2, 1, 0, 1, 0,
    2, 0, 1, 1, 3, 0, 2, 1, 0, 0,
    1, 1, 1, 0, 2, 0, 2, 1, 1, 3,
    0, 2, 1, 0, 1, 0, 2, 0, 2, 1,
    1, 1, 3, 1, 0, 2, 0, 2, 4, 1,
    1, 3, 0, 2, 1, 0, 0, 1, 1, 1,
    1, 0, 2, 0, 2, 2, 2, 0, 1, 1,
    1]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 81) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 81) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 81) : flatFz n = flatData[n.toNat]! := sorry

end A115201
