set_option linter.unusedVariables false

/-!
# A066334

Binary string which equals n when 1's, 2's, 4's and 8's bits have weights 1, 2, 4, 2 respectively, while the other bits have their usual weights. -1 if no such string exists.

The 52 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A066334

/-- Known terms of `A066334`, starting at index `0`. -/
def data : List retType :=
  [0, 1, 10, 11, 100, 101, 110, 111, 1110, 1111,
    -1, -1, -1, -1, -1, -1, 10000, 10001, 10010, 10011,
    10100, 10101, 10110, 10111, 11110, 11111, -1, -1, -1, -1,
    -1, -1, 100000, 100001, 100010, 100011, 100100, 100101, 100110, 100111,
    101110, 101111, -1, -1, -1, -1, -1, -1, 110000, 110001,
    110010, 110011]

/-- `A066334` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 52) : A066334 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 52) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
