    1110, -1, -1, -1, -1, 10001, 10000, 10010, 10101, 10100,
    10110, 11001, 11000, 11010, 11101, 11100, 11110, -1, -1, -1,
    -1, 100001, 100000, 100010, 100101, 100100, 100110, 101001, 101000, 101010,
