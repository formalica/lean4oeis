import LOEIS.A308.A308406.Defs

set_option linter.unusedVariables false

/-!
# A308406

Lexicographically earliest sequence of distinct terms such that reading one-by-one the central digit of each term is the same as reading one-by-one the successive digits of the sequence itself.

The 56 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A308406

/-- Known terms of `A308406`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 3, 4, 5, 6, 7, 8, 9, 110,
    111, 100, 112, 113, 114, 115, 101, 102, 116, 117,
    120, 118, 119, 130, 210, 211, 140, 212, 213, 150,
    214, 103, 215, 216, 104, 121, 217, 218, 160, 219,
    310, 170, 311, 122, 105, 312, 313, 180, 314, 315,
