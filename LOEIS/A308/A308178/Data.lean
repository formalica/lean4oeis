import LOEIS.A308.A308178.Defs

set_option linter.unusedVariables false

/-!
# A308178

Scan an infinite 45-degree triangular chessboard (cells (x,y) with 0 <= y <= x) by upwards antidiagonals, filling in each cell with the smallest nonnegative number already placed that cannot be seen by a chess queen at (x,y); sequence gives numbers along the successive antidiagonals.

The 80 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A308178

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [0, 1, 2, 3, 3, 0, 4, 1, 5, 5,
    2, 4, 6, 7, 0, 2, 7, 4, 1, 3,
    8, 5, 2, 4, 1, 9, 6, 3, 0, 2,
    10, 11, 7, 1, 3, 6, 11, 8, 10, 9,
    4, 5, 12, 9, 6, 8, 0, 10, 7, 13,
    10, 12, 5, 6, 11, 8, 14, 15, 8, 7,
    9, 3, 5, 11, 15, 12, 9, 6, 8, 0,
    13, 10, 16, 13, 11, 12, 5, 1, 14, 7]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 80) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 80) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 80) : flatFz n = flatData[n.toNat]! := sorry

end A308178
