import LOEIS.A308.A308776.Defs

set_option linter.unusedVariables false

/-!
# A308776

Counterclockwise square spiral of distinct positive integers constructed by greedy algorithm, such that for k = 1..5, every term equal to k mod 5 (except k itself) is vertically or horizontally adjacent to a cell already holding a value equal to k mod 5.

The 67 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A308776

/-- Known terms of `A308776`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 3, 4, 5, 6, 11, 16, 7, 12,
    17, 8, 13, 18, 9, 10, 15, 20, 21, 26,
    31, 36, 41, 22, 27, 32, 37, 42, 23, 28,
    33, 38, 43, 14, 19, 24, 29, 25, 30, 35,
    40, 45, 50, 46, 51, 56, 47, 52, 57, 62,
    67, 72, 77, 48, 53, 58, 63, 68, 73, 78,
    34, 39, 44, 49, 54, 59, 55]

/-- `A308776` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 68) : A308776 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
