import LOEIS.A289.A289281.Defs

set_option linter.unusedVariables false

/-!
# A289281

Square array whose rows m >= 2 hold the limit under iterations of the morphism { x -> (x, ..., x+k-1) if k|x ; x -> x+1 otherwise }, starting with (0); read by falling antidiagonals.

The 132 terms known to OEIS, indexed from `2`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A289281

/-- Known terms of `flat`, starting at index `2`. -/
def flatData : List flatRetType :=
  [0, 1, 0, 2, 1, 0, 2, 2, 1, 0,
    3, 2, 2, 1, 0, 2, 3, 3, 2, 1,
    0, 3, 3, 2, 3, 2, 1, 0, 4, 3,
    3, 4, 3, 2, 1, 0, 2, 4, 4, 2,
    4, 3, 2, 1, 0, 3, 5, 3, 3, 5,
    4, 3, 2, 1, 0, 4, 3, 4, 4, 2,
    5, 4, 3, 2, 1, 0, 4, 4, 4, 5,
    3, 6, 5, 4, 3, 2, 1, 0, 5, 5,
    5, 3, 4, 2, 6, 5, 4, 3, 2, 1,
    0, 2, 3, 6, 4, 5, 3, 7, 6, 5,
    4, 3, 2, 1, 0, 3, 4, 7, 5, 6,
    4, 2, 7, 6, 5, 4, 3, 2, 1, 0,
    4, 5, 4, 5, 3, 5, 3, 8, 7, 6,
    5, 4]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 134) : flat n = flatData[n.val - 2]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 2 ≤ n) (h : n < 134) : flatFn n = flatData[n - 2]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 2 ≤ n) (h : n < 134) : flatFz n = flatData[n.toNat - 2]! := sorry

end A289281
