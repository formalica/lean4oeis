-/

namespace A366191

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [0, 1, 1, 1, 1, 2, 1, 3, 1, 4,
    2, 3, 1, 5, 1, 6, 2, 5, 3, 4,
    1, 7, 3, 5, 1, 8, 2, 7, 4, 5,
