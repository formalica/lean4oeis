import LOEIS.A348.A348136.Defs

set_option linter.unusedVariables false

/-!
# A348136

Irregular triangle read by rows T(n,k) in which row n lists the first digit of every term of the trajectory of n in Collatz problem including the trajectory [1, 4, 2, 1] for n = 1.

The 105 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A348136

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 4, 2, 1, 2, 1, 3, 1, 5, 1,
    8, 4, 2, 1, 4, 2, 1, 5, 1, 8,
    4, 2, 1, 6, 3, 1, 5, 1, 8, 4,
    2, 1, 7, 2, 1, 3, 1, 5, 2, 1,
    4, 2, 1, 5, 1, 8, 4, 2, 1, 8,
    4, 2, 1, 9, 2, 1, 7, 2, 1, 3,
    1, 5, 2, 1, 4, 2, 1, 5, 1, 8,
    4, 2, 1, 1, 5, 1, 8, 4, 2, 1,
    1, 3, 1, 5, 2, 1, 4, 2, 1, 5,
    1, 8, 4, 2, 1, 1, 6, 3, 1, 5,
    1, 8, 4, 2, 1]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 106) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 106) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 106) : flatFz n = flatData[n.toNat - 1]! := sorry

end A348136
