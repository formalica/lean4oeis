import LOEIS.A348.A348328.Defs

set_option linter.unusedVariables false

/-!
# A348328

Records inventory sequence: Record the number of record terms seen thus far, then the number of zero terms, then number of 1's, then 2's, etc until recording another zero term, at which point the count is repeated, as above.

The 122 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A348328

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [0, 1, 1, 2, 1, 0, 3, 2, 3, 2,
    2, 0, 4, 3, 3, 4, 4, 3, 0, 5,
    4, 3, 4, 6, 5, 2, 1, 0, 7, 5,
    4, 5, 6, 6, 4, 3, 1, 0, 8, 6,
    5, 5, 7, 7, 6, 5, 3, 1, 0, 9,
    7, 6, 5, 8, 7, 8, 6, 5, 3, 1,
    0, 10, 8, 7, 5, 9, 7, 10, 7, 8,
    5, 2, 2, 0, 11, 9, 7, 7, 9, 7,
    11, 7, 12, 5, 4, 2, 2, 1, 0, 13,
    10, 8, 9, 9, 8, 12, 7, 13, 7, 6,
    3, 2, 2, 2, 0, 14, 11, 8, 12, 10,
    8, 12, 8, 14, 10, 6, 5, 3, 4, 2,
    2, 0]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 122) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
