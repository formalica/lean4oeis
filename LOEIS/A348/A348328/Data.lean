/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 122) : flatFz n = flatData[n.toNat]! := sorry

end A348328
