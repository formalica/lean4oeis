    3, 1, 2, 1, 2, 1, 2]

/-- `A348168` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 88) : A348168 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
