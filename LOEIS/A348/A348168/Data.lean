  [1, 1, 1, 1, 2, 2, 1, 2, 4, 1,
    2, 3, 2, 1, 6, 2, 2, 2, 1, 2,
    1, 2, 2, 2, 1, 4, 2, 8, 1, 4,
    2, 2, 1, 1, 5, 2, 1, 2, 2, 2,
    1, 4, 6, 2, 2, 5, 8, 7, 2, 1,
