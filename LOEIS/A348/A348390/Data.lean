    4, 5, 6, 7, 8, 1, 4, 6, 8, 1,
    6, 1, 2, 8, 1, 1, 2, 3, 1, 1,
    2, 4]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 84) : flat n = flatData[n.val - 2]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
