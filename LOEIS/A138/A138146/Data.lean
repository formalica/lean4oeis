/-!
# A138146

Palindromes with 2n-1 digits formed from the reflected decimal expansion of the concatenation of 1, 1, 1 and infinite 0's.

The 12 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A138146

/-- Known terms of `A138146`, starting at index `1`. -/
def data : List retType :=
  [1, 111, 11111, 1110111, 111000111, 11100000111, 1110000000111, 111000000000111, 11100000000000111, 1110000000000000111,
    111000000000000000111, 11100000000000000000111]

/-- `A138146` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 13) : A138146 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 13) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 13) : fz n = data[n.toNat - 1]! := sorry

end A138146
