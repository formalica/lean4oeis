import LOEIS.A031.A031111.Defs

set_option linter.unusedVariables false

/-!
# A031111

Write the (n+1)st Fibonacci number in base 9 and juxtapose.

The 90 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A031111

/-- Known terms of `A031111`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 3, 5, 8, 1, 4, 2, 3, 3,
    7, 6, 1, 1, 0, 8, 1, 7, 0, 2,
    7, 8, 4, 5, 8, 7, 4, 7, 1, 3,
    1, 6, 2, 1, 6, 4, 3, 4, 8, 1,
    5, 6, 5, 5, 1, 0, 2, 4, 6, 1,
    6, 0, 1, 2, 2, 6, 2, 5, 8, 4,
    3, 2, 7, 1, 7, 0, 5, 4, 0, 1,
    2, 3, 8, 2, 1, 2, 0, 4, 4, 6,
    1, 3, 2, 8, 3, 8, 2, 5, 3, 3]

/-- `A031111` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 91) : A031111 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 91) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 91) : fz n = data[n.toNat - 1]! := sorry

end A031111
