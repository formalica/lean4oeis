import LOEIS.A240.A240222.Defs

set_option linter.unusedVariables false

/-!
# A240222

Rectangular array giving all start values M(n, k), k >= 1, for Collatz sequences following the pattern (udd)^(n-1) ud, n >= 1, read by antidiagonals.

The 63 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A240222

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 3, 1, 5, 9, 1, 7, 17, 33, 1,
    9, 25, 65, 129, 1, 11, 33, 97, 257, 513,
    1, 13, 41, 129, 385, 1025, 2049, 1, 15, 49,
    161, 513, 1537, 4097, 8193, 1, 17, 57, 193, 641,
    2049, 6145, 16385, 32769, 1, 19, 65, 225, 769, 2561,
    8193, 24577, 65537, 131073, 1, 21, 73, 257, 897, 3073,
    10241, 32769, 98305]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 64) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 64) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 64) : flatFz n = flatData[n.toNat - 1]! := sorry

end A240222
