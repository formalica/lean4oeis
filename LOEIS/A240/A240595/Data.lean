import LOEIS.A240.A240595.Defs

set_option linter.unusedVariables false

/-!
# A240595

Look-and-Say table, where in row(n+1) the sorted list of distinct terms of row(n) is preceded by the list of numbers of their occurrences.

The 86 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A240595

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 2, 1, 1, 1, 1, 2, 3,
    1, 1, 2, 2, 1, 1, 1, 2, 3, 3,
    2, 1, 1, 2, 3, 2, 2, 2, 1, 2,
    3, 1, 4, 1, 1, 2, 3, 3, 1, 1,
    1, 1, 2, 3, 4, 4, 1, 2, 1, 1,
    2, 3, 4, 3, 2, 1, 2, 1, 2, 3,
    4, 2, 3, 2, 1, 1, 2, 3, 4, 2,
    3, 2, 1, 1, 2, 3, 4, 2, 3, 2,
    1, 1, 2, 3, 4, 2]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 87) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 87) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 87) : flatFz n = flatData[n.toNat - 1]! := sorry

end A240595
