import LOEIS.A240.A240224.Defs

set_option linter.unusedVariables false

/-!
# A240224

Irregular triangular array read by rows: row n gives a list of the partitions of n into distinct Fibonacci numbers. The order of the partitions is like in Abramowitz-Stegun.

The 108 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A240224

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 3, 2, 1, 3, 1, 5, 3, 2,
    5, 1, 3, 2, 1, 5, 2, 8, 5, 3,
    5, 2, 1, 8, 1, 5, 3, 1, 8, 2,
    5, 3, 2, 8, 3, 8, 2, 1, 5, 3,
    2, 1, 8, 3, 1, 13, 8, 5, 8, 3,
    2, 13, 1, 8, 5, 1, 8, 3, 2, 1,
    13, 2, 8, 5, 2, 13, 3, 13, 2, 1,
    8, 5, 3, 8, 5, 2, 1, 13, 3, 1,
    8, 5, 3, 1, 13, 5, 13, 3, 2, 8,
    5, 3, 2, 13, 5, 1, 13, 3, 2, 1,
    8, 5, 3, 2, 1, 13, 5, 2]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 109) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 109) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 109) : flatFz n = flatData[n.toNat - 1]! := sorry

end A240224
