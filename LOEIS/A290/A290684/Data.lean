import LOEIS.A290.A290684.Defs

set_option linter.unusedVariables false

/-!
# A290684

Binary representation of the diagonal from the corner to the origin of the n-th stage of growth of the two-dimensional cellular automaton defined by "Rule 934", based on the 5-celled von Neumann neighborhood.

The 32 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A290684

/-- Known terms of `A290684`, starting at index `0`. -/
def data : List retType :=
  [1, 1, 1, 1, 1, 1, 1, 1, 1101, 1101,
    1101, 1101, 1101, 1101, 1101, 1101, 10001111, 10001111, 10001111, 10001111,
    10001111, 10001111, 10001111, 10001111, 1011101111, 1011101111, 1011101111, 1011101111, 11011101111, 11011101111,
    11011101111, 11011101111]

/-- `A290684` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 32) : A290684 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 32) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 32) : fz n = data[n.toNat]! := sorry

end A290684
