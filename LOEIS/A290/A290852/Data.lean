import LOEIS.A290.A290852.Defs

set_option linter.unusedVariables false

/-!
# A290852

Binary representation of the diagonal from the corner to the origin of the n-th stage of growth of the two-dimensional cellular automaton defined by "Rule 998", based on the 5-celled von Neumann neighborhood.

The 31 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A290852

/-- Known terms of `A290852`, starting at index `0`. -/
def data : List retType :=
  [1, 1, 1, 1, 1, 1, 1, 1, 1101, 1101,
    1101, 1101, 11101, 11101, 11101, 11101, 11101, 111101, 111101, 11111101,
    11111101, 11111101, 11111101, 111111101, 10111111101, 10111111101, 11111111101, 111111111101, 1111111111101, 1111111111101,
    1111111111101]

/-- `A290852` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 31) : A290852 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 31) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 31) : fz n = data[n.toNat]! := sorry

end A290852
