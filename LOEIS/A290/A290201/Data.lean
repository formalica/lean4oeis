  [1, 10, 101, 1100, 11011, 111001, 1110101, 11110010, 111101101, 1111100010,
    11111011101, 111111001010, 1111110100101, 11111110001010, 111111101100101, 1111111100011010, 11111111011100101, 111111111000000010, 1111111110101011101, 11111111110000001010]

/-- `A290201` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 20) : A290201 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 20) : fn n = data[n]! := sorry

