import LOEIS.A290.A290853.Defs

set_option linter.unusedVariables false

/-!
# A290853

Binary representation of the diagonal from the origin to the corner of the n-th stage of growth of the two-dimensional cellular automaton defined by "Rule 998", based on the 5-celled von Neumann neighborhood.

The 20 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A290853

/-- Known terms of `A290853`, starting at index `0`. -/
def data : List retType :=
  [1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 101100000, 1011000000,
    10110000000, 101100000000, 1011100000000, 10111000000000, 101110000000000, 1011100000000000, 10111000000000000, 101111000000000000, 1011110000000000000, 10111111000000000000]

/-- `A290853` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 20) : A290853 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 20) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 20) : fz n = data[n.toNat]! := sorry

end A290853
