/-!
# A238305

Triangle E(n,k), 1<=k<=n, giving the cardinality of optimal ternary covering codes of empty spheres of length n and radius k.

The 15 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A238305

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [2, 3, 3, 6, 4, 5, 14, 6, 5, 8,
    27, 12, 6, 7, 12]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 16) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 16) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 16) : flatFz n = flatData[n.toNat - 1]! := sorry

end A238305
