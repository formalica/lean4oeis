import LOEIS.A302.A302808.Defs

set_option linter.unusedVariables false

/-!
# A302808

T(n,k)=Number of nXk 0..1 arrays with every element equal to 0, 1, 2, 3 or 5 horizontally, diagonally or antidiagonally adjacent elements, with upper left element zero.

The 48 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A302808

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 2, 4, 8, 4, 8, 29, 32, 8,
    16, 105, 169, 128, 16, 32, 384, 934, 1010, 512,
    32, 64, 1405, 5117, 8718, 6084, 2048, 64, 128, 5135,
