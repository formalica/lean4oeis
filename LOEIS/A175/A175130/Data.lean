import LOEIS.A175.A175130.Defs

set_option linter.unusedVariables false

/-!
# A175130

Indices of Fibonacci numbers that are not cubefree.

The 56 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A175130

/-- Known terms of `A175130`, starting at index `1`. -/
def data : List retType :=
  [6, 12, 18, 24, 30, 36, 42, 48, 54, 60,
    66, 72, 78, 84, 90, 96, 102, 108, 114, 120,
    125, 126, 132, 138, 144, 150, 156, 162, 168, 174,
    180, 186, 192, 198, 204, 210, 216, 222, 228, 234,
    240, 246, 250, 252, 258, 264, 270, 276, 282, 288,
    294, 300, 306, 312, 318, 324]

/-- `A175130` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 57) : A175130 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 57) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 57) : fz n = data[n.toNat - 1]! := sorry

end A175130
