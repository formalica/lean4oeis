import LOEIS.A175.A175328.Defs

set_option linter.unusedVariables false

/-!
# A175328

a(n) is the number of terms in row n of irregular table A175327. For n >= 1, a(n) = number of runs (of both 0's and 1's) in the binary representation of A175326(n).

The 86 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A175328

/-- Known terms of `A175328`, starting at index `0`. -/
def data : List retType :=
  [0, 1, 2, 1, 2, 3, 2, 1, 2, 4,
    2, 2, 1, 2, 5, 2, 2, 2, 1, 2,
    3, 6, 2, 3, 2, 3, 2, 2, 1, 2,
    7, 2, 2, 2, 2, 2, 1, 2, 8, 2,
    4, 2, 2, 2, 2, 2, 1, 2, 3, 9,
    2, 3, 2, 3, 2, 3, 2, 3, 2, 2,
    2, 1, 2, 4, 10, 2, 5, 2, 2, 4,
    2, 2, 2, 2, 2, 1, 2, 11, 2, 2,
    2, 2, 2, 2, 2, 2]

/-- `A175328` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 86) : A175328 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 86) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 86) : fz n = data[n.toNat]! := sorry

end A175328
