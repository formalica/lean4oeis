import LOEIS.A100.A100678.Defs

set_option linter.unusedVariables false

/-!
# A100678

Number of Egyptian fractions in the representation of n/(n+1) via the greedy algorithm.

The 95 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A100678

/-- Known terms of `A100678`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 2, 3, 2, 3, 3, 3, 3, 4,
    3, 4, 4, 3, 4, 5, 3, 4, 4, 4,
    4, 5, 3, 4, 4, 4, 4, 5, 4, 6,
