/-- `A100678` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 96) : A100678 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 96) : fn n = data[n - 1]! := sorry

