import LOEIS.A100.A100002.Defs

set_option linter.unusedVariables false

/-!
# A100002

Start with a sequence of 1's, then replace every other 1 with a 2; then replace every third of the remaining 1's with a 3 and every third of the remaining 2's with a 3; then replace every fourth remaining 1, 2 or 3 with a 4; and so on. The limiting sequence is shown here.

The 90 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A100002

/-- Known terms of `A100002`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 1, 2, 3, 3, 1, 2, 4, 4,
    3, 4, 1, 2, 5, 5, 3, 5, 1, 2,
    4, 5, 3, 4, 6, 6, 1, 2, 6, 3,
    7, 7, 6, 4, 7, 7, 5, 6, 1, 2,
    5, 3, 8, 8, 7, 4, 8, 8, 1, 2,
    6, 7, 3, 6, 5, 8, 4, 8, 5, 6,
    9, 9, 1, 2, 9, 3, 10, 10, 9, 4,
    10, 10, 7, 8, 9, 5, 7, 10, 1, 2,
    9, 7, 3, 4, 9, 6, 11, 11, 10, 11]

/-- `A100002` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 91) : A100002 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 91) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 91) : fz n = data[n.toNat - 1]! := sorry

end A100002
