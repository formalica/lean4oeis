import LOEIS.A100.A100562.Defs

set_option linter.unusedVariables false

/-!
# A100562

Write down the numbers from 7 to infinity. Take next number, M say, that has not been crossed off and cross off all the numbers i*M - 1 for i >= 2. Repeat. The numbers that are left form the sequence.

The 62 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A100562

/-- Known terms of `A100562`, starting at index `1`. -/
def data : List retType :=
  [7, 8, 9, 10, 11, 12, 14, 16, 18, 22,
    24, 25, 28, 30, 33, 36, 37, 38, 40, 42,
    45, 46, 50, 51, 52, 56, 57, 58, 60, 61,
    64, 66, 67, 68, 70, 72, 77, 78, 81, 82,
    84, 85, 86, 88, 92, 93, 94, 96, 100, 102,
    105, 106, 108, 112, 114, 117, 122, 123, 126, 128,
    130, 136]

/-- `A100562` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 63) : A100562 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 63) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 63) : fz n = data[n.toNat - 1]! := sorry

end A100562
