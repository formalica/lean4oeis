import LOEIS.A100.A100000.Defs

set_option linter.unusedVariables false

/-!
# A100000

Middle column of marks found on the oldest object with logical carvings, the 22000-year-old Ishango bone from the Congo.

The 8 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A100000

/-- Known terms of `A100000`, starting at index `1`. -/
def data : List retType :=
  [3, 6, 4, 8, 10, 5, 5, 7]

/-- `A100000` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 9) : A100000 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 9) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 9) : fz n = data[n.toNat - 1]! := sorry

end A100000
