import LOEIS.A100.A100123.Defs

set_option linter.unusedVariables false

/-!
# A100123

Decimal expansion of limit of a power tower: t(2)^(t(3)^(t(4)^(t(5)^(...)))) where t(n)=n!^(1/n!) and n takes on consecutive integer values >=2.

The 100 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A100123

/-- Known terms of `A100123`, starting at index `1`. -/
def data : List retType :=
  [1, 6, 2, 9, 4, 9, 0, 2, 9, 9,
    5, 2, 2, 8, 0, 7, 7, 6, 9, 3,
    4, 7, 9, 5, 0, 1, 0, 1, 9, 5,
    7, 9, 5, 8, 6, 4, 8, 1, 6, 0,
    0, 1, 4, 5, 7, 0, 6, 7, 6, 7,
    1, 3, 7, 9, 3, 4, 6, 0, 9, 9,
    6, 2, 0, 7, 4, 2, 0, 6, 6, 8,
    3, 2, 8, 3, 6, 7, 7, 3, 3, 0,
    9, 3, 0, 5, 1, 3, 4, 6, 2, 5,
    3, 4, 1, 9, 3, 7, 6, 6, 4, 7]

/-- `A100123` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 101) : A100123 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 101) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 101) : fz n = data[n.toNat - 1]! := sorry

end A100123
