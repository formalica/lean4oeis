import LOEIS.A100.A100492.Defs

set_option linter.unusedVariables false

/-!
# A100492

Triangle read by rows giving the coefficients of general sum formulas of n-th Fibonacci numbers (A000045). The k-th row (k>=1) contains T(i,k) for i=1 to 2*k-1, where T(i,k) satisfies F(n) = Sum_{k=1..n} Sum_{i=1..2*k-1} T(i,k) * C(n-k,i-1) * n^(n-k) / (n-1)!.

The 39 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A100492

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, -1, -4, -3, 10, 49, 95, 83, 27, -90,
    -740, -2415, -4110, -3890, -1950, -405, 1320, 14054, 64116, 164059,
    258461, 257604, 159070, 55755, 8505, -23640, -318684, -1881532, -6452300, -14294605,
    -21442540, -22106669, -15496012, -7078575, -1905120, -229635, 523440, 8474100, 61424596]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 40) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 40) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
