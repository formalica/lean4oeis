import LOEIS.A100.A100247.Defs

set_option linter.unusedVariables false

/-!
# A100247

Slanted Catalan convolution table, read by rows of 2*n+1 terms in row n, where T(n,k) = C(n+2*k-[k/2],k)*(n-[k/2])/(n+2*k-[k/2]).

The 61 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A100247

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 0, 1, 2, 2, 5, 0, 1,
    3, 5, 14, 14, 42, 0, 1, 4, 9, 28,
    42, 132, 132, 429, 0, 1, 5, 14, 48, 90,
    297, 429, 1430, 1430, 4862, 0, 1, 6, 20, 75,
