import LOEIS.A100.A100199.Defs

set_option linter.unusedVariables false

/-!
# A100199

Decimal expansion of Pi^2/(12*log(2)), inverse of Levy's constant.

The 105 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A100199

/-- Known terms of `A100199`, starting at index `1`. -/
def data : List retType :=
  [1, 1, 8, 6, 5, 6, 9, 1, 1, 0,
    4, 1, 5, 6, 2, 5, 4, 5, 2, 8,
    2, 1, 7, 2, 2, 9, 7, 5, 9, 4,
    7, 2, 3, 7, 1, 2, 0, 5, 6, 8,
    3, 5, 6, 5, 3, 6, 4, 7, 2, 0,
    5, 4, 3, 3, 5, 9, 5, 4, 2, 5,
    4, 2, 9, 8, 6, 5, 2, 8, 0, 9,
