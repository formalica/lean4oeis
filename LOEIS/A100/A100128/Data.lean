import LOEIS.A100.A100128.Defs

set_option linter.unusedVariables false

/-!
# A100128

Decimal expansion of Sum_{n>0} 1/(n*prime(n)^n).

The 100 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A100128

/-- Known terms of `A100128`, starting at index `0`. -/
def data : List retType :=
  [5, 5, 8, 3, 2, 7, 6, 2, 2, 2,
    3, 1, 7, 6, 9, 1, 5, 8, 6, 1,
    4, 2, 7, 9, 1, 9, 6, 8, 0, 3,
