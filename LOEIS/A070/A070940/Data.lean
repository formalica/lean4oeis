import LOEIS.A070.A070940.Defs

set_option linter.unusedVariables false

/-!
# A070940

Number of digits that must be counted from left to right to reach the last 1 in the binary representation of n.

The 93 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A070940

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 2, 1, 3, 2, 3, 1, 4, 3,
    4, 2, 4, 3, 4, 1, 5, 4, 5, 3,
    5, 4, 5, 2, 5, 4, 5, 3, 5, 4,
    5, 1, 6, 5, 6, 4, 6, 5, 6, 3,
    6, 5, 6, 4, 6, 5, 6, 2, 6, 5,
    6, 4, 6, 5, 6, 3, 6, 5, 6, 4,
    6, 5, 6, 1, 7, 6, 7, 5, 7, 6,
    7, 4, 7, 6, 7, 5, 7, 6, 7, 3,
    7, 6, 7, 5, 7, 6, 7, 4, 7, 6,
    7, 5, 7]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 94) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 94) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 94) : flatFz n = flatData[n.toNat - 1]! := sorry

end A070940
