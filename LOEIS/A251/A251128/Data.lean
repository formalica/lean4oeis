import LOEIS.A251.A251128.Defs

set_option linter.unusedVariables false

/-!
# A251128

T(n,k)=Number of (n+1)X(k+1) 0..1 arrays with no 2X2 subblock having the sum of its diagonal elements greater than the maximum of its antidiagonal elements.

The 54 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A251128

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [10, 21, 21, 40, 40, 40, 72, 69, 69, 72,
    125, 117, 108, 117, 125, 212, 193, 173, 173, 193,
    212, 354, 315, 272, 266, 272, 315, 354, 585, 510,
    430, 401, 401, 430, 510, 585, 960, 823, 680, 612,
