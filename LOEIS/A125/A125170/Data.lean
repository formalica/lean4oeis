    41, 22, 12, 5, 1, 122, 63, 34, 17, 6,
    1, 365, 185, 97, 51, 23, 7, 1, 1094, 550,
    282, 148, 74, 30, 8, 1, 3281, 1644, 832, 430,
    222, 104, 38, 9, 1]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 45) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
