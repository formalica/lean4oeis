import LOEIS.A125.A125106.Defs

set_option linter.unusedVariables false

/-!
# A125106

Enumeration of partitions by binary representation: each 1 is a part; the part size is 1 more than the number of 0's in the rest of the number.

The 80 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A125106

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 1, 1, 3, 2, 1, 2, 2, 1,
    1, 1, 4, 3, 1, 3, 2, 2, 1, 1,
    3, 3, 2, 2, 1, 2, 2, 2, 1, 1,
    1, 1, 5, 4, 1, 4, 2, 3, 1, 1,
    4, 3, 3, 2, 1, 3, 2, 2, 2, 1,
    1, 1, 4, 4, 3, 3, 1, 3, 3, 2,
    2, 2, 1, 1, 3, 3, 3, 2, 2, 2,
    1, 2, 2, 2, 2, 1, 1, 1, 1, 1]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 81) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 81) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 81) : flatFz n = flatData[n.toNat - 1]! := sorry

end A125106
