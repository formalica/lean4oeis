import LOEIS.A253.A253580.Defs

set_option linter.unusedVariables false

/-!
# A253580

A fractal tree, read by rows: for n > 1: T(n,0) = T(n-1,0)+2, T(n,2*n) = T(n-1,0)+3, and for k=1..2*n-1: T(n,k) = T(n-1,k-1).

The 81 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A253580

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [0, 1, 0, 2, 3, 1, 0, 2, 4, 5,
    3, 1, 0, 2, 4, 6, 7, 5, 3, 1,
    0, 2, 4, 6, 8, 9, 7, 5, 3, 1,
    0, 2, 4, 6, 8, 10, 11, 9, 7, 5,
    3, 1, 0, 2, 4, 6, 8, 10, 12, 13,
    11, 9, 7, 5, 3, 1, 0, 2, 4, 6,
    8, 10, 12, 14, 15, 13, 11, 9, 7, 5,
    3, 1, 0, 2, 4, 6, 8, 10, 12, 14,
    16]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 81) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 81) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 81) : flatFz n = flatData[n.toNat]! := sorry

end A253580
