import LOEIS.A253.A253028.Defs

set_option linter.unusedVariables false

/-!
# A253028

A fractal array resembling the shape of a conifer tree read by rows. A mirror symmetric array of numbers where the n-th term is equal to the number of terms in the n-th row of the array.

The 75 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A253028

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 3, 4, 1, 5, 6, 2, 3, 7,
    8, 9, 4, 1, 5, 10, 11, 6, 2, 3,
    7, 12, 13, 14, 15, 8, 16, 17, 9, 4,
    1, 5, 10, 18, 19, 11, 6, 2, 3, 7,
    12, 20, 21, 13, 8, 4, 1, 5, 9, 14,
    22, 23, 15, 16, 24, 25, 26, 17, 10, 18,
    27, 28, 19, 11, 6, 2, 3, 7, 12, 20,
    29, 30, 21, 13, 8]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 76) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 76) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 76) : flatFz n = flatData[n.toNat - 1]! := sorry

end A253028
