import LOEIS.A303.A303151.Defs

set_option linter.unusedVariables false

/-!
# A303151

Lexicographically earliest sequence of distinct terms such that the successive quantities of digits between two successive 1s are given by the succession of the sequence's digits itself.

The 74 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A303151

/-- Known terms of `A303151`, starting at index `1`. -/
def data : List retType :=
