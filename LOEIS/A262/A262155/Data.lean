import LOEIS.A262.A262155.Defs

set_option linter.unusedVariables false

/-!
# A262155

Lexicographically earliest sequence of distinct positive integers such that for any n>0, n and a(n) have no common 1-bit in their binary representations, and no two successive terms have a common 1-bit in their binary representations.

The 61 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A262155

/-- Known terms of `A262155`, starting at index `1`. -/
def data : List retType :=
  [2, 1, 4, 3, 8, 16, 32, 5, 18, 33,
    20, 34, 64, 17, 96, 6, 40, 65, 12, 35,
    72, 128, 104, 7, 160, 68, 256, 66, 288, 129,
    320, 9, 22, 73, 132, 10, 80, 136, 272, 67,
    144, 69, 384, 19, 192, 257, 208, 11, 196, 264,
    512, 74, 640, 265, 576, 130, 260, 193, 516, 131,
    768]

/-- `A262155` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 62) : A262155 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 62) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 62) : fz n = data[n.toNat - 1]! := sorry

end A262155
