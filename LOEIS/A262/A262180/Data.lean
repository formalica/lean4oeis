import LOEIS.A262.A262180.Defs

set_option linter.unusedVariables false

/-!
# A262180

Irregular triangle read by rows: number of occurrences of monotonic lattice paths below diagonal formed from all lattice paths below diagonal via bubble-sort-like algorithm.

The 132 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A262180

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 2, 1, 1, 3, 3, 3, 1, 1,
    3, 2, 1, 1, 4, 4, 8, 4, 4, 6,
    6, 4, 1, 1, 4, 2, 1, 1, 6, 6,
    8, 3, 3, 4, 3, 1, 1, 4, 3, 2,
    1, 1, 5, 5, 10, 5, 5, 15, 15, 15,
    5, 5, 15, 10, 5, 5, 10, 10, 20, 10,
    10, 10, 10, 5, 1, 1, 5, 2, 1, 1,
    10, 10, 10, 3, 3, 5, 3, 1, 1, 5,
    3, 2, 1, 1, 10, 10, 20, 10, 10, 20,
    20, 15, 4, 4, 15, 8, 4, 4, 10, 10,
    15, 6, 6, 5, 4, 1, 1, 5, 4, 2,
    1, 1, 10, 10, 15, 6, 6, 10, 8, 3,
    3, 5, 4, 3, 1, 1, 5, 4, 3, 2,
    1, 1]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 133) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 133) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 133) : flatFz n = flatData[n.toNat - 1]! := sorry

end A262180
