import LOEIS.A262.A262115.Defs

set_option linter.unusedVariables false

/-!
# A262115

Irregular triangle read by rows: row b (b >= 2) gives periodic part of digits of the base-b expansion of 1/7.

The 91 terms known to OEIS, indexed from `2`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A262115

/-- Known terms of `flat`, starting at index `2`. -/
def flatData : List flatRetType :=
  [0, 0, 1, 0, 1, 0, 2, 1, 2, 0,
    2, 1, 0, 3, 2, 4, 1, 2, 0, 5,
    1, 1, 1, 2, 5, 1, 4, 2, 8, 5,
    7, 1, 6, 3, 1, 8, 6, 10, 3, 5,
    1, 11, 2, 2, 2, 4, 9, 2, 7, 4,
    14, 9, 12, 2, 10, 5, 2, 13, 10, 16,
    5, 8, 2, 17, 3, 3, 3, 6, 13, 3,
    10, 6, 20, 13, 17, 3, 14, 7, 3, 18,
    14, 22, 7, 11, 3, 23, 4, 4, 4, 8,
    17]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 93) : flat n = flatData[n.val - 2]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 2 ≤ n) (h : n < 93) : flatFn n = flatData[n - 2]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 2 ≤ n) (h : n < 93) : flatFz n = flatData[n.toNat - 2]! := sorry

end A262115
