import LOEIS.A262.A262160.Defs

set_option linter.unusedVariables false

/-!
# A262160

Expansion of psi(x^6) / psi(x) in powers of x where psi() is a Ramanujan theta function.

The 47 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A262160

/-- Known terms of `A262160`, starting at index `0`. -/
def data : List retType :=
  [1, -1, 1, -2, 3, -4, 6, -8, 11, -15,
    19, -25, 33, -42, 53, -68, 86, -107, 134, -166,
    205, -253, 309, -377, 460, -557, 672, -811, 974, -1166,
    1394, -1661, 1975, -2344, 2773, -3275, 3863, -4543, 5333, -6253,
    7316, -8544, 9964, -11600, 13484, -15653, 18140]

/-- `A262160` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 47) : A262160 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 47) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 47) : fz n = data[n.toNat]! := sorry

end A262160
