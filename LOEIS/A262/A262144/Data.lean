import LOEIS.A262.A262144.Defs

set_option linter.unusedVariables false

/-!
# A262144

Square array read by antidiagonals upwards: the n-th row o.g.f. is exp( Sum_{i >= 1} d(n,i+1)*x^i/i ) for n >= 1, where d(n,k) is Shanks's array of generalized Euler and class numbers.

The 35 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A262144

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 2, 1, 11, 10, 1, 46, 241, 108,
    1, 128, 2739, 10411, 2214, 1, 272, 16384, 265244, 836321,
    75708, 1, 522, 64964, 2883584, 45094565, 112567243, 3895236, 1, 904,
    212325, 18852096, 822083584, 12975204810, 22949214033]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 36) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 36) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 36) : flatFz n = flatData[n.toNat - 1]! := sorry

end A262144
