import LOEIS.A262.A262114.Defs

set_option linter.unusedVariables false

/-!
# A262114

Irregular triangle read by rows: row b (b >= 2) gives periodic part of digits of the base-b expansion of 1/5.

The 90 terms known to OEIS, indexed from `2`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A262114

/-- Known terms of `flat`, starting at index `2`. -/
def flatData : List flatRetType :=
  [0, 0, 1, 1, 0, 1, 2, 1, 0, 3,
    1, 1, 1, 2, 5, 4, 1, 4, 6, 3,
    1, 7, 2, 2, 2, 4, 9, 7, 2, 7,
    10, 5, 2, 11, 3, 3, 3, 6, 13, 10,
    3, 10, 14, 7, 3, 15, 4, 4, 4, 8,
