import LOEIS.A262.A262198.Defs

set_option linter.unusedVariables false

/-!
# A262198

Numbers such that the number of distinct palindromes contained as substring in their decimal representation differs from the length thereof.

The 44 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A262198

/-- Known terms of `A262198`, starting at index `1`. -/
def data : List retType :=
  [100, 200, 300, 400, 500, 600, 700, 800, 900, 1000,
    1001, 1002, 1003, 1004, 1005, 1006, 1007, 1008, 1009, 1010,
    1020, 1021, 1030, 1031, 1040, 1041, 1050, 1051, 1060, 1061,
    1070, 1071, 1080, 1081, 1090, 1091, 1100, 1200, 1201, 1231,
    1241, 1251, 1261, 1271]

/-- `A262198` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 45) : A262198 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 45) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 45) : fz n = data[n.toNat - 1]! := sorry

end A262198
