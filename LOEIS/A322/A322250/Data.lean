import LOEIS.A322.A322250.Defs

set_option linter.unusedVariables false

/-!
# A322250

Take binary expansion of 2n-1 and delete the trailing block of 1's, except if the number is 11...1, leave a single 1.

The 65 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A322250

/-- Known terms of `A322250`, starting at index `1`. -/
def data : List retType :=
  [1, 1, 2, 1, 4, 2, 6, 1, 8, 4,
    10, 2, 12, 6, 14, 1, 16, 8, 18, 4,
    20, 10, 22, 2, 24, 12, 26, 6, 28, 14,
    30, 1, 32, 16, 34, 8, 36, 18, 38, 4,
    40, 20, 42, 10, 44, 22, 46, 2, 48, 24,
    50, 12, 52, 26, 54, 6, 56, 28, 58, 14,
    60, 30, 62, 1, 64]

/-- `A322250` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 66) : A322250 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 66) : fn n = data[n - 1]! := sorry

