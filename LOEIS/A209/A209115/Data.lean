import LOEIS.A209.A209115.Defs

set_option linter.unusedVariables false

/-!
# A209115

T(n,k) = number of n-bead necklaces labeled with numbers -k..k not allowing reversal, with sum zero and avoiding the patterns z z+1 z+2 and z z-1 z-2.

The 63 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A209115

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 2, 1, 3, 1, 1, 4, 5, 5,
    1, 5, 11, 22, 5, 1, 6, 19, 55, 63,
    15, 1, 7, 29, 120, 261, 238, 25, 1, 8,
    41, 221, 741, 1373, 865, 68, 1, 9, 55, 362,
    1683, 5032, 7377, 3417, 139, 1, 10, 71, 559, 3325,
    14037, 35253, 41256, 13607, 354, 1, 11, 89, 816, 5935,
    32802, 121117, 255821]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 64) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 64) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 64) : flatFz n = flatData[n.toNat - 1]! := sorry

end A209115
