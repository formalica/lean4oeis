/-- `A280998` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 64) : A280998 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 64) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 64) : fz n = data[n.toNat - 1]! := sorry

end A280998
