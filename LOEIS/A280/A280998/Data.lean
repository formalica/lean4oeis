import LOEIS.A280.A280998.Defs

set_option linter.unusedVariables false

/-!
# A280998

Numbers with a prime number of 1's in their binary reflected Gray code representation.

The 63 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A280998

/-- Known terms of `A280998`, starting at index `1`. -/
def data : List retType :=
  [2, 4, 5, 6, 8, 9, 11, 12, 13, 14,
    16, 17, 19, 21, 23, 24, 25, 27, 28, 29,
    30, 32, 33, 35, 37, 39, 41, 43, 45, 47,
    48, 49, 51, 53, 55, 56, 57, 59, 60, 61,
    62, 64, 65, 67, 69, 71, 73, 75, 77, 79,
    81, 83, 85, 87, 89, 91, 93, 95, 96, 97,
