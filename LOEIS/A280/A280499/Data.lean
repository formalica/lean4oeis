def flatData : List flatRetType :=
  [1, 2, 1, 3, 0, 1, 4, 2, 0, 1,
    5, 0, 3, 0, 1, 6, 3, 2, 0, 0,
    1, 7, 0, 0, 0, 0, 0, 1, 8, 4,
