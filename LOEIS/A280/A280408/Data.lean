import LOEIS.A280.A280408.Defs

set_option linter.unusedVariables false

/-!
# A280408

Irregular triangle read by rows listing the prime numbers that appear from the trajectory of n in Collatz Problem.

The 87 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A280408

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [2, 2, 3, 5, 2, 2, 5, 2, 3, 5,
    2, 7, 11, 17, 13, 5, 2, 2, 7, 11,
    17, 13, 5, 2, 5, 2, 11, 17, 13, 5,
    2, 3, 5, 2, 13, 5, 2, 7, 11, 17,
    13, 5, 2, 23, 53, 5, 2, 2, 17, 13,
    5, 2, 7, 11, 17, 13, 5, 2, 19, 29,
    11, 17, 13, 5, 2, 5, 2, 2, 11, 17,
    13, 5, 2, 23, 53, 5, 2, 3, 5, 2,
    19, 29, 11, 17, 13, 5, 2]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 88) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 88) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 88) : flatFz n = flatData[n.toNat - 1]! := sorry

end A280408
