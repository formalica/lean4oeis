import LOEIS.A280.A280460.Defs

set_option linter.unusedVariables false

/-!
# A280460

Binary representation of the x-axis, from the origin to the right edge, of the n-th stage of growth of the two-dimensional cellular automaton defined by "Rule 267", based on the 5-celled von Neumann neighborhood.

The 20 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A280460

/-- Known terms of `A280460`, starting at index `0`. -/
def data : List retType :=
  [1, 10, 110, 101, 11100, 1011, 1011000, 11110111, 110000, 1101101111,
    111100000, 101001011111, 1110011000000, 100110111111, 101001110000000, 1110010101111111, 100101100000000, 100001011011111111, 1001011111000000000, 10011000010111111111]

/-- `A280460` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 20) : A280460 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 20) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 20) : fz n = data[n.toNat]! := sorry

end A280460
