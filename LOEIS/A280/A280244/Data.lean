import LOEIS.A280.A280244.Defs

set_option linter.unusedVariables false

/-!
# A280244

Lexicographically ordered list of sequences that meet the criteria for R. L. Graham's sequence: k = a_1 < a_2 < ... < a_t = A006255(k) and a_1*a_2*...*a_t is a square.

The 74 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A280244

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 3, 4, 6, 2, 3, 6, 3, 4,
    6, 8, 3, 6, 8, 4, 5, 8, 9, 10,
    5, 8, 10, 6, 8, 9, 12, 6, 8, 12,
    7, 8, 9, 14, 7, 8, 14, 8, 9, 10,
    12, 15, 8, 10, 12, 15, 9, 10, 12, 15,
    16, 18, 10, 12, 15, 18, 11, 12, 14, 16,
    21, 22, 11, 12, 14, 21, 22, 11, 12, 15,
    16, 18, 20, 22]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 75) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 75) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 75) : flatFz n = flatData[n.toNat - 1]! := sorry

end A280244
