import LOEIS.A207.A207324.Defs

set_option linter.unusedVariables false

/-!
# A207324

List of permutations of 1,2,3,...,n for n=1,2,3,..., in the order they are output by Steinhaus-Johnson-Trotter algorithm.

The 87 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A207324

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 2, 2, 1, 1, 2, 3, 1, 3,
    2, 3, 1, 2, 3, 2, 1, 2, 3, 1,
    2, 1, 3, 1, 2, 3, 4, 1, 2, 4,
    3, 1, 4, 2, 3, 4, 1, 2, 3, 4,
    1, 3, 2, 1, 4, 3, 2, 1, 3, 4,
    2, 1, 3, 2, 4, 3, 1, 2, 4, 3,
    1, 4, 2, 3, 4, 1, 2, 4, 3, 1,
    2, 4, 3, 2, 1, 3, 4, 2, 1, 3,
    2, 4, 1, 3, 2, 1, 4]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 88) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 88) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 88) : flatFz n = flatData[n.toNat - 1]! := sorry

end A207324
