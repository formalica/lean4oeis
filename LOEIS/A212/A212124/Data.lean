import LOEIS.A212.A212124.Defs

set_option linter.unusedVariables false

/-!
# A212124

Total number of states of the first n subshells of the nuclear shell model in which the subshells are ordered by energy level in increasing order.

The 29 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A212124

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [2, 6, 8, 14, 16, 20, 28, 32, 38, 40,
    50, 58, 64, 68, 70, 82, 92, 100, 106, 110,
    112, 126, 136, 142, 154, 162, 164, 168, 184]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 30) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 30) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 30) : flatFz n = flatData[n.toNat - 1]! := sorry

end A212124
