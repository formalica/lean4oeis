import LOEIS.A342.A342148.Defs

set_option linter.unusedVariables false

/-!
# A342148

Infinite square matrix A(m,n) = F(m) mod n, m,n >= 1, where F = Fibonacci = A000045, read by falling antidiagonals.

The 120 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A342148

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [0, 1, 0, 1, 1, 0, 1, 1, 0, 0,
    1, 1, 2, 1, 0, 1, 1, 2, 0, 1,
    0, 1, 1, 2, 3, 2, 0, 0, 1, 1,
    2, 3, 1, 2, 1, 0, 1, 1, 2, 3,
    0, 0, 1, 1, 0, 1, 1, 2, 3, 5,
    3, 1, 0, 0, 0, 1, 1, 2, 3, 5,
    2, 3, 1, 1, 1, 0, 1, 1, 2, 3,
    5, 1, 1, 1, 2, 1, 1, 0, 1, 1,
    2, 3, 5, 0, 6, 3, 4, 3, 2, 0,
    0, 1, 1, 2, 3, 5, 8, 5, 0, 4,
    0, 1, 0, 1, 0, 1, 1, 2, 3, 5,
    8, 4, 5, 6, 1, 4, 0, 2, 1, 0]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 121) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 121) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 121) : flatFz n = flatData[n.toNat - 1]! := sorry

end A342148
