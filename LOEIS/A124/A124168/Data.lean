import LOEIS.A124.A124168.Defs

set_option linter.unusedVariables false

/-!
# A124168

Union of all n-Fibonacci sequences, that is, all sequences s(0) = s(1) = ... = s(n-2) = 0, s(n-1) = 1 and for k >= n, s(k) = s(k-1) + ... + s(k-n).

The 58 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A124168

/-- Known terms of `A124168`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 3, 4, 5, 7, 8, 13, 15, 16,
    21, 24, 29, 31, 32, 34, 44, 55, 56, 61,
    63, 64, 81, 89, 108, 120, 125, 127, 128, 144,
    149, 208, 233, 236, 248, 253, 255, 256, 274, 377,
    401, 464, 492, 504, 509, 511, 512, 610, 773, 912,
    927, 976, 987, 1004, 1016, 1021, 1023, 1024]

/-- `A124168` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 59) : A124168 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 59) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 59) : fz n = data[n.toNat - 1]! := sorry

end A124168
