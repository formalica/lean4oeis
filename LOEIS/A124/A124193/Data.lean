/-!
# A124193

Points that add to make a shape, with each new shape enclosing the old shape. Also the creation of each shape must not copy any former shape's angle/points/length/name/ratios/etc. and the number of points as a whole for the series must be kept to a min. Only 3d shapes are used.

The 6 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A124193

/-- Known terms of `A124193`, starting at index `0`. -/
def data : List retType :=
  [0, 1, 4, 8, 5, 9]

/-- `A124193` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 6) : A124193 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 6) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 6) : fz n = data[n.toNat]! := sorry

end A124193
