    16, 9, 4, 1, 1, 4, 9, 16, 25, 36,
    49, 64, 81, 64, 49, 36, 25, 16, 9, 4,
    1, 1, 4, 9, 16]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 86) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 86) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 86) : flatFz n = flatData[n.toNat - 1]! := sorry

end A124258
