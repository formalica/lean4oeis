import LOEIS.A124.A124034.Defs

set_option linter.unusedVariables false

/-!
# A124034

Tri-antidiagonal matrices of central ones with upper negative one to give a triangular sequence: first element is negative one. k=1;m(n,m,d)=If[n + m - 1 == d && n > 1, k, If[n + m ==d, -1, If[n + m - 2 == d, -1, If[n == 1 && m == d, -k, 0]]]].

The 96 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A124034

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [-1, -1, -1, 2, 2, 1, 1, 1, 1, -1,
    1, 0, -1, 2, 1, 2, 0, 0, 4, 1,
    -1, -1, 0, -1, -6, -4, 2, 1, 1, 1,
    -1, -7, -3, 7, 1, -1, -2, -2, -1, 8,
    6, -12, -7, 2, 1, -1, -1, -2, 10, 3,
    -23, -6, 10, 1, -1, -1, 0, 2, -12, -7,
    34, 22, -18, -10, 2, 1, -2, 0, 0, -16,
    -4, 52, 16, -48, -9, 13, 1, -1, 1, 0,
    2, 20, 13, -70, -46, 78, 47, -24, -13, 2,
    1, -1, -1, 2, 22, 9]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 97) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 97) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 97) : flatFz n = flatData[n.toNat - 1]! := sorry

end A124034
