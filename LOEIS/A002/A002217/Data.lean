    1, 2, 1, 4, 4, 4, 1, 4, 1, 4,
    3, 2, 1, 4, 3, 5, 4, 2, 1, 3,
    1, 3, 5, 2, 3, 3, 1, 4, 5, 2,
    1, 3, 1, 5, 2, 4, 1, 2, 5, 3,
