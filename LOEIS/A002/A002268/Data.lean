import LOEIS.A002.A002268.Defs

set_option linter.unusedVariables false

/-!
# A002268

Dimensions of integral lattices that are irreducible modulo every prime (there may be missing terms!).

The 4 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A002268

/-- Known terms of `A002268`, starting at index `1`. -/
def data : List retType :=
  [1, 8, 24, 248]

/-- `A002268` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 5) : A002268 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 5) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 5) : fz n = data[n.toNat - 1]! := sorry

end A002268
