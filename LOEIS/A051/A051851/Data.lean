import LOEIS.A051.A051851.Defs

set_option linter.unusedVariables false

/-!
# A051851

Table in which n-th row gives all partitions of n interpreted in base n+1. (A subset of A051849 with each term having a non-descending digit-sequence in base n+1).

The 59 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A051851

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 4, 3, 6, 21, 4, 8, 12, 32,
    156, 5, 10, 15, 45, 50, 260, 1555, 6, 12,
    18, 24, 60, 66, 114, 402, 408, 2802, 19608, 7,
    14, 21, 28, 77, 84, 91, 147, 588, 595, 658,
