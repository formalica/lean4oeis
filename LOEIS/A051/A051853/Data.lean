import LOEIS.A051.A051853.Defs

set_option linter.unusedVariables false

/-!
# A051853

Table of solutions to all possible Chinese Remainder Equations x = a1 mod p1, x = a2 mod p2, ..., x = an mod pn, where p1 - pn are the first n primes and each a1 - an varies between 1 and (its respective) p-1, with the leftmost a varying fastest.

The 61 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A051853

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 5, 1, 11, 7, 17, 13, 23, 19,
    29, 1, 71, 127, 197, 43, 113, 169, 29, 121,
    191, 37, 107, 163, 23, 79, 149, 31, 101, 157,
    17, 73, 143, 199, 59, 151, 11, 67, 137, 193,
    53, 109, 179, 61, 131, 187, 47, 103, 173, 19,
    89, 181, 41, 97, 167, 13, 83, 139, 209, 1,
    1541]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 62) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 62) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 62) : flatFz n = flatData[n.toNat - 1]! := sorry

end A051853
