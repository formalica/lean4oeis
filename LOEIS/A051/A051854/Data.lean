import LOEIS.A051.A051854.Defs

set_option linter.unusedVariables false

/-!
# A051854

Table of solutions to all possible Chinese Remainder Equations x = a1 mod p1, x = a2 mod p2, ..., x = an mod pn, where p1 - pn are the first n primes and each a1 - an varies between 1 and (its respective) p-1, with the rightmost a (an) varying fastest.

The 62 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A051854

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 5, 1, 7, 13, 19, 11, 17, 23,
    29, 1, 121, 31, 151, 61, 181, 127, 37, 157,
    67, 187, 97, 43, 163, 73, 193, 103, 13, 169,
    79, 199, 109, 19, 139, 71, 191, 101, 11, 131,
    41, 197, 107, 17, 137, 47, 167, 113, 23, 143,
    53, 173, 83, 29, 149, 59, 179, 89, 209, 1,
    211, 421]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 63) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 63) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 63) : flatFz n = flatData[n.toNat - 1]! := sorry

end A051854
