import LOEIS.A393.A393113.Defs

set_option linter.unusedVariables false

/-!
# A393113

Lexicographically earliest infinite sequence of distinct positive numbers such that, for n > 2, a(n) shares a factor with digsum(a(n-1)), where digsum(k) is the sum of the digits of k.

The 68 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A393113

/-- Known terms of `A393113`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 4, 6, 3, 9, 12, 15, 8, 14,
    5, 20, 16, 7, 21, 18, 24, 22, 26, 28,
    25, 35, 30, 27, 33, 32, 40, 34, 42, 36,
    39, 38, 11, 44, 46, 45, 48, 50, 55, 52,
    49, 13, 54, 51, 56, 66, 57, 58, 65, 77,
    60, 62, 64, 68, 63, 69, 70, 84, 72, 75,
    74, 88, 76, 78, 80, 82, 85, 91]

/-- `A393113` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 69) : A393113 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 69) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 69) : fz n = data[n.toNat - 1]! := sorry

end A393113
