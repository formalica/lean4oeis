import LOEIS.A111.A111189.Defs

set_option linter.unusedVariables false

/-!
# A111189

Number of polyanygons (or Pollyannagons) with score n, with all symmetries removed.

The 7 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A111189

/-- Known terms of `A111189`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 3, 9, 20, 75, 255]

/-- `A111189` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 8) : A111189 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 8) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 8) : fz n = data[n.toNat - 1]! := sorry

end A111189
