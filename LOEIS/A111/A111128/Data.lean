import LOEIS.A111.A111128.Defs

set_option linter.unusedVariables false

/-!
# A111128

Scores for Part 2 of the n X n generalization of the Gordon Lee puzzle.

The 6 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A111128

/-- Known terms of `A111128`, starting at index `1`. -/
def data : List retType :=
  [2, 21, 72, 181, 390, 715]

/-- `A111128` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 7) : A111128 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 7) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 7) : fz n = data[n.toNat - 1]! := sorry

end A111128
