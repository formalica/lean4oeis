import LOEIS.A089.A089112.Defs

set_option linter.unusedVariables false

/-!
# A089112

Square array T(r,j) (r >= 1, j >= 1) read by antidiagonals, where T(r,j) is the sign twisted convoluted convolved Fibonacci number H_j^(r) (see the Moree paper).

The 78 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A089112

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 0, 1, 2, 0, 1, 3, 3,
    0, 1, 3, 5, 5, 0, 1, 3, 7, 11,
    8, 0, 1, 4, 10, 17, 19, 13, 0, 1,
    5, 13, 25, 37, 37, 21, 0, 1, 5, 16,
