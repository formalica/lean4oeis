import LOEIS.A339.A339275.Defs

set_option linter.unusedVariables false

/-!
# A339275

Irregular triangle read by rows: T(n,k), n >= 1, k >= 1, in which column k lists the terms of A040000: 1, 2, 2, 2, ... interleaved with k-1 zeros, and the first element of column k is in row k(k+1)/2.

The 101 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A339275

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 2, 1, 2, 0, 2, 2, 2, 0,
    1, 2, 2, 0, 2, 0, 0, 2, 2, 2,
    2, 0, 0, 1, 2, 2, 0, 0, 2, 0,
    2, 0, 2, 2, 0, 0, 2, 0, 0, 2,
    2, 2, 2, 0, 1, 2, 0, 0, 0, 0,
    2, 2, 0, 0, 0, 2, 0, 2, 2, 0,
    2, 2, 0, 0, 0, 2, 0, 0, 0, 2,
    2, 2, 2, 0, 0, 1, 2, 0, 0, 2,
    0, 0, 2, 2, 0, 0, 0, 0, 2, 0,
    2, 0, 0, 0, 2, 2, 0, 0, 2, 0,
    2]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 102) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 102) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 102) : flatFz n = flatData[n.toNat - 1]! := sorry

end A339275
