import LOEIS.A112.A112309.Defs

set_option linter.unusedVariables false

/-!
# A112309

Triangle read by rows: row n gives terms in lazy Fibonacci representation of n.

The 100 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A112309

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 1, 2, 1, 3, 2, 3, 1, 2,
    3, 2, 5, 1, 2, 5, 1, 3, 5, 2,
    3, 5, 1, 2, 3, 5, 1, 3, 8, 2,
    3, 8, 1, 2, 3, 8, 2, 5, 8, 1,
    2, 5, 8, 1, 3, 5, 8, 2, 3, 5,
    8, 1, 2, 3, 5, 8, 2, 5, 13, 1,
    2, 5, 13, 1, 3, 5, 13, 2, 3, 5,
    13, 1, 2, 3, 5, 13, 1, 3, 8, 13,
    2, 3, 8, 13, 1, 2, 3, 8, 13, 2,
    5, 8, 13, 1, 2, 5, 8, 13, 1, 3]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 101) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 101) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 101) : flatFz n = flatData[n.toNat - 1]! := sorry

end A112309
