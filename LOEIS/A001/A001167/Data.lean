import LOEIS.A001.A001167.Defs

set_option linter.unusedVariables false

/-!
# A001167

Smallest natural number requiring n words in English (as spoken in England).

The 26 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A001167

/-- Known terms of `A001167`, starting at index `1`. -/
def data : List retType :=
  [1, 21, 21000, 101, 121, 1101, 1121, 21121, 101101, 101121,
    121121, 1101121, 1121121, 21121121, 101101121, 101121121, 121121121, 1101121121, 1121121121, 21121121121,
    101101121121, 101121121121, 121121121121, 1101121121121, 1121121121121, 21121121121121]

/-- `A001167` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 27) : A001167 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 27) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 27) : fz n = data[n.toNat - 1]! := sorry

end A001167
