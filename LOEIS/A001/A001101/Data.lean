import LOEIS.A001.A001101.Defs

set_option linter.unusedVariables false

/-!
# A001101

Moran numbers: k such that k/(sum of digits of k) is prime.

The 45 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A001101

/-- Known terms of `A001101`, starting at index `1`. -/
def data : List retType :=
  [18, 21, 27, 42, 45, 63, 84, 111, 114, 117,
    133, 152, 153, 156, 171, 190, 195, 198, 201, 207,
    209, 222, 228, 247, 261, 266, 285, 333, 370, 372,
    399, 402, 407, 423, 444, 465, 481, 511, 516, 518,
    531, 555, 558, 592, 603]

/-- `A001101` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 46) : A001101 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 46) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 46) : fz n = data[n.toNat - 1]! := sorry

end A001101
