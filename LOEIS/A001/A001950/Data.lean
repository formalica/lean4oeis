import LOEIS.A001.A001950.Defs

set_option linter.unusedVariables false

/-!
# A001950

Upper Wythoff sequence (a Beatty sequence): a(n) = floor(n*phi^2), where phi = (1+sqrt(5))/2.

The 60 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A001950

/-- Known terms of `A001950`, starting at index `1`. -/
def data : List retType :=
  [2, 5, 7, 10, 13, 15, 18, 20, 23, 26,
    28, 31, 34, 36, 39, 41, 44, 47, 49, 52,
    54, 57, 60, 62, 65, 68, 70, 73, 75, 78,
    81, 83, 86, 89, 91, 94, 96, 99, 102, 104,
    107, 109, 112, 115, 117, 120, 123, 125, 128, 130,
    133, 136, 138, 141, 143, 146, 149, 151, 154, 157]

/-- `A001950` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 61) : A001950 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 61) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 61) : fz n = data[n.toNat - 1]! := sorry

end A001950
