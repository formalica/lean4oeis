import LOEIS.A067.A067433.Defs

set_option linter.unusedVariables false

/-!
# A067433

Triangle in which row n gives trajectory of n under the map k -> k/3 if k is divisible by 3, otherwise k -> next multiple of 3, stopping when reaching 1 (the initial term n is not included).

The 84 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A067433

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 3, 1, 1, 6, 2, 3, 1, 6, 2,
    3, 1, 2, 3, 1, 9, 3, 1, 9, 3,
    1, 3, 1, 12, 4, 6, 2, 3, 1, 12,
    4, 6, 2, 3, 1, 4, 6, 2, 3, 1,
    15, 5, 6, 2, 3, 1, 15, 5, 6, 2,
    3, 1, 5, 6, 2, 3, 1, 18, 6, 2,
    3, 1, 18, 6, 2, 3, 1, 6, 2, 3,
    1, 21, 7, 9, 3, 1, 21, 7, 9, 3,
    1, 7, 9, 3]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 85) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 85) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 85) : flatFz n = flatData[n.toNat - 1]! := sorry

end A067433
