import LOEIS.A097.A097351.Defs

set_option linter.unusedVariables false

/-!
# A097351

Rectangular array T(n,k) by antidiagonals; rows are generalized Fibonacci sequences and every relatively prime pair (i,j) satisfying 1 <= i < j occurs exactly once.

The 80 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A097351

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 1, 3, 3, 1, 5, 4, 4, 1,
    8, 7, 5, 5, 1, 13, 11, 9, 6, 6,
    2, 21, 18, 14, 11, 7, 5, 1, 34, 29,
    23, 17, 13, 7, 7, 1, 55, 47, 37, 28,
    20, 12, 8, 8, 2, 89, 76, 60, 45, 33,
    19, 15, 9, 7, 1, 144, 123, 97, 73, 53,
    31, 23, 17, 9, 9, 3, 233, 199, 157, 118,
    86, 50, 38, 26, 16, 10, 7, 1, 377, 322]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 81) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 81) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 81) : flatFz n = flatData[n.toNat - 1]! := sorry

end A097351
