/-!
# A097367

Fibonacci regression array: For n>=2 and 1<=k<=n-1, T(n,k) is the last term before the first nonpositive term in the sequence n, k, n-k, 2k-n, 2n-3k, 5k-3n, ...

The 95 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A097367

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 1, 3, 2, 2, 4, 3, 1, 3,
    5, 4, 3, 2, 4, 6, 5, 4, 2, 3,
    5, 7, 6, 5, 4, 1, 4, 6, 8, 7,
    6, 5, 3, 3, 5, 7, 9, 8, 7, 6,
    5, 2, 4, 6, 8, 10, 9, 8, 7, 6,
    4, 2, 5, 7, 9, 11, 10, 9, 8, 7,
    6, 3, 4, 6, 8, 10, 12, 11, 10, 9,
    8, 7, 5, 1, 5, 7, 9, 11, 13, 12,
    11, 10, 9, 8, 7, 4, 3, 6, 8, 10,
    12, 14, 13, 12, 11]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 96) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 96) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 96) : flatFz n = flatData[n.toNat - 1]! := sorry

end A097367
