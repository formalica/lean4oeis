import LOEIS.A180.A180234.Defs

set_option linter.unusedVariables false

/-!
# A180234

Demi-tribonacci numbers (rounding down): a(0)=a(1)=0, a(2)=2; a(n) = floor( (a(n-1)+a(n-2)+a(n-3))/2 ).

The 56 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A180234

/-- Known terms of `A180234`, starting at index `0`. -/
def data : List retType :=
  [0, 0, 2, 1, 1, 2, 2, 2, 3, 3,
    4, 5, 6, 7, 9, 11, 13, 16, 20, 24,
    30, 37, 45, 56, 69, 85, 105, 129, 159, 196,
    242, 298, 368, 454, 560, 691, 852, 1051, 1297, 1600,
    1974, 2435, 3004, 3706, 4572, 5641, 6959, 8586, 10593, 13069,
    16124, 19893, 24543, 30280, 37358, 46090]

/-- `A180234` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 56) : A180234 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 56) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 56) : fz n = data[n.toNat]! := sorry

end A180234
