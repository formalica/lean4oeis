import LOEIS.A180.A180603.Defs

set_option linter.unusedVariables false

/-!
# A180603

Number of "pieces" of the n-th Brillouin zone of a 2D square lattice.

The 13 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A180603

/-- Known terms of `A180603`, starting at index `1`. -/
def data : List retType :=
  [1, 4, 8, 12, 20, 20, 12, 12, 20, 28,
    44, 48, 48]

/-- `A180603` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 14) : A180603 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 14) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 14) : fz n = data[n.toNat - 1]! := sorry

end A180603
