import LOEIS.A180.A180604.Defs

set_option linter.unusedVariables false

/-!
# A180604

Number of "pieces" of the n-th Brillouin zone of a 2D hexagonal lattice.

The 16 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A180604

/-- Known terms of `A180604`, starting at index `1`. -/
def data : List retType :=
  [1, 6, 6, 6, 12, 18, 30, 30, 18, 18,
    36, 42, 54, 54, 42, 66]

/-- `A180604` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 17) : A180604 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 17) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 17) : fz n = data[n.toNat - 1]! := sorry

end A180604
