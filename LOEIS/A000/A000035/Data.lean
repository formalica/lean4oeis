/-- `A000035` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 105) : A000035 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 105) : fn n = data[n]! := sorry

