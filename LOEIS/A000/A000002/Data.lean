import LOEIS.A000.A000002.Defs

set_option linter.unusedVariables false

/-!
# A000002

Kolakoski sequence: a(n) is length of n-th run; a(1) = 1; sequence consists just of 1's and 2's.

The 108 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A000002

/-- Known terms of `A000002`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 2, 1, 1, 2, 1, 2, 2, 1,
    2, 2, 1, 1, 2, 1, 1, 2, 2, 1,
    2, 1, 1, 2, 1, 2, 2, 1, 1, 2,
    1, 1, 2, 1, 2, 2, 1, 2, 2, 1,
    1, 2, 1, 2, 2, 1, 2, 1, 1, 2,
    1, 1, 2, 2, 1, 2, 2, 1, 1, 2,
    1, 2, 2, 1, 2, 2, 1, 1, 2, 1,
    1, 2, 1, 2, 2, 1, 2, 1, 1, 2,
    2, 1, 2, 2, 1, 1, 2, 1, 2, 2,
    1, 2, 2, 1, 1, 2, 1, 1, 2, 2,
    1, 2, 1, 1, 2, 1, 2, 2]

/-- `A000002` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 109) : A000002 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 109) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 109) : fz n = data[n.toNat - 1]! := sorry

end A000002
