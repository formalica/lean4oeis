import LOEIS.A141.A141234.Defs

set_option linter.unusedVariables false

/-!
# A141234

Sequence of k such that starting with P(0)=11 then k(n)*P(n-1)*(k(n)*P(n-1)-1)-1 is the least prime = P(n).

The 10 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A141234

/-- Known terms of `A141234`, starting at index `1`. -/
def data : List retType :=
  [1, 5, 3, 11, 74, 93, 139, 511, 641, 1166]

/-- `A141234` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 11) : A141234 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 11) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 11) : fz n = data[n.toNat - 1]! := sorry

end A141234
