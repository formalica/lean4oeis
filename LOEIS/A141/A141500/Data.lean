import LOEIS.A141.A141500.Defs

set_option linter.unusedVariables false

/-!
# A141500

A triangular sequence of coefficients based on a skip prime prime power sequence: t(n,m)=Prime[m + 1]^n*Prime[m + 3]; qualified so the m=0 and n=0 terms are well-defined.

The 35 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A141500

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 3, 5, 7, 11, 40, 189, 1375, 4459,
    80, 567, 6875, 31213, 248897, 160, 1701, 34375, 218491, 2737867,
    7054567, 320, 5103, 171875, 1529437, 30116537, 91709371, 555164087, 640, 15309,
    859375, 10706059, 331281907, 1192221823, 9437789479]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 36) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 36) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 36) : flatFz n = flatData[n.toNat - 1]! := sorry

end A141500
