import LOEIS.A329.A329448.Defs

set_option linter.unusedVariables false

/-!
# A329448

Numbers n which appear twice in the sequence starting with n and subsequent terms given by 10c + d where c is the number of times (> 0) the least frequent digit d has appeared so far, smallest d in case of tie.

The 69 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A329448

/-- Known terms of `A329448`, starting at index `1`. -/
def data : List retType :=
  [10, 12, 13, 14, 15, 16, 17, 18, 19, 20,
    22, 23, 24, 25, 26, 27, 28, 29, 30, 34,
    35, 36, 37, 38, 39, 40, 44, 45, 46, 47,
    48, 49, 50, 55, 56, 57, 58, 59, 60, 66,
    67, 68, 69, 70, 77, 78, 79, 80, 88, 89,
    90, 99, 100, 102, 103, 104, 105, 106, 107, 108,
    109, 115, 122, 123, 124, 125, 126, 127, 128]

/-- `A329448` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 70) : A329448 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 70) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 70) : fz n = data[n.toNat - 1]! := sorry

end A329448
