import LOEIS.A003.A003603.Defs

set_option linter.unusedVariables false

/-!
# A003603

Fractal sequence obtained from Fibonacci numbers (or Wythoff array).

The 85 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A003603

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 2, 1, 3, 2, 1, 4, 3,
    2, 5, 1, 6, 4, 3, 7, 2, 8, 5,
    1, 9, 6, 4, 10, 3, 11, 7, 2, 12,
    8, 5, 13, 1, 14, 9, 6, 15, 4, 16,
    10, 3, 17, 11, 7, 18, 2, 19, 12, 8,
    20, 5, 21, 13, 1, 22, 14, 9, 23, 6,
    24, 15, 4, 25, 16, 10, 26, 3, 27, 17,
    11, 28, 7, 29, 18, 2, 30, 19, 12, 31,
    8, 32, 20, 5, 33]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 86) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 86) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 86) : flatFz n = flatData[n.toNat - 1]! := sorry

end A003603
