import LOEIS.A003.A003005.Defs

set_option linter.unusedVariables false

/-!
# A003005

Size of the largest subset of the numbers [1..n] which doesn't contain a 6-term arithmetic progression.

The 69 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A003005

/-- Known terms of `A003005`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 3, 4, 5, 5, 6, 7, 8, 9,
    9, 10, 11, 12, 13, 13, 14, 15, 16, 17,
    17, 18, 19, 20, 21, 22, 22, 22, 23, 23,
    23, 24, 25, 25, 26, 27, 28, 28, 29, 30,
