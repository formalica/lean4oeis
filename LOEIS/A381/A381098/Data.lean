set_option linter.unusedVariables false

/-!
# A381098

Irregular triangle read by rows: row 1 = (1, 2); row n+1 has length L = last element of row n, and consists of the L smallest positive integers not occurring earlier that share a factor with L.

The 63 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A381098

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 4, 6, 3, 8, 9, 10, 12, 14,
    7, 16, 18, 20, 21, 22, 24, 26, 28, 30,
    32, 34, 35, 36, 15, 27, 33, 38, 39, 40,
    42, 44, 45, 46, 48, 50, 51, 52, 54, 56,
    57, 58, 60, 62, 63, 64, 66, 68, 69, 70,
    72, 74, 75, 76, 78, 80, 81, 82, 84, 86,
