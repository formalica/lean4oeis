import LOEIS.A080.A080634.Defs

set_option linter.unusedVariables false

/-!
# A080634

Start with a(1)=1. Then, for n>1, choose a(n)=1 or 2 so as to minimize the longest arithmetic progression in either S1(n) or S2(n), where S1(n)={k|a(k)=1,1<=k<=n} and S2(n)={k|a(k)=2,1<=k<=n}.

The 105 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A080634

/-- Known terms of `A080634`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 1, 2, 2, 1, 2, 1, 2, 1,
    1, 2, 1, 2, 1, 2, 1, 2, 2, 1,
    2, 2, 1, 1, 2, 1, 2, 1, 2, 2,
    2, 1, 1, 1, 2, 2, 1, 2, 1, 1,
    2, 2, 2, 1, 1, 1, 2, 1, 1, 2,
    1, 2, 1, 2, 1, 2, 1, 1, 2, 2,
    2, 2, 2, 1, 2, 1, 1, 1, 2, 1,
    2, 2, 2, 1, 2, 2, 1, 2, 1, 2,
    1, 2, 1, 1, 2, 1, 2, 2, 2, 1,
    2, 1, 1, 2, 1, 2, 1, 1, 2, 2,
    2, 1, 2, 1, 2]

/-- `A080634` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 106) : A080634 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 106) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 106) : fz n = data[n.toNat - 1]! := sorry

end A080634
