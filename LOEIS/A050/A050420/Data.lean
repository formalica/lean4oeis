import LOEIS.A050.A050420.Defs

set_option linter.unusedVariables false

/-!
# A050420

Numbers for which in base 2 the least number of digits that can be removed to leave a palindrome (possibly beginning with 0) is 1.

The 62 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A050420

/-- Known terms of `A050420`, starting at index `1`. -/
def data : List retType :=
  [2, 4, 6, 8, 10, 11, 13, 14, 16, 18,
    19, 22, 23, 25, 29, 30, 32, 34, 35, 36,
    37, 41, 42, 43, 46, 47, 49, 53, 54, 55,
    59, 61, 62, 64, 66, 67, 69, 76, 77, 81,
    82, 83, 89, 90, 91, 94, 95, 97, 101, 102,
    103, 109, 111, 115, 123, 125, 126, 128, 130, 131,
    133, 136]

/-- `A050420` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 63) : A050420 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 63) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 63) : fz n = data[n.toNat - 1]! := sorry

end A050420
