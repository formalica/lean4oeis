import LOEIS.A050.A050252.Defs

set_option linter.unusedVariables false

/-!
# A050252

Number of digits in the prime factorization of n (counting terms of the form p^1 as p).

The 102 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A050252

/-- Known terms of `A050252`, starting at index `1`. -/
def data : List retType :=
  [1, 1, 1, 2, 1, 2, 1, 2, 2, 2,
    2, 3, 2, 2, 2, 2, 2, 3, 2, 3,
    2, 3, 2, 3, 2, 3, 2, 3, 2, 3,
    2, 2, 3, 3, 2, 4, 2, 3, 3, 3,
    2, 3, 2, 4, 3, 3, 2, 3, 2, 3,
    3, 4, 2, 3, 3, 3, 3, 3, 2, 4,
    2, 3, 3, 2, 3, 4, 2, 4, 3, 3,
    2, 4, 2, 3, 3, 4, 3, 4, 2, 3,
    2, 3, 2, 4, 3, 3, 3, 4, 2, 4,
    3, 4, 3, 3, 3, 3, 2, 3, 4, 4,
    3, 4]

/-- `A050252` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 103) : A050252 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 103) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 103) : fz n = data[n.toNat - 1]! := sorry

end A050252
