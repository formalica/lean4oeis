import LOEIS.A275.A275656.Defs

set_option linter.unusedVariables false

/-!
# A275656

Number of ordered ways to write n as 4^k*(1+x^2+y^2)+z^2, where k,x,y,z are nonnegative integers with x <= y <= z.

The 80 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A275656

/-- Known terms of `A275656`, starting at index `1`. -/
def data : List retType :=
  [1, 1, 1, 2, 2, 1, 1, 1, 2, 2,
    1, 2, 3, 1, 1, 2, 3, 2, 2, 3,
    2, 1, 1, 2, 2, 2, 2, 4, 2, 2,
    1, 1, 4, 2, 2, 3, 3, 1, 2, 3,
    3, 3, 1, 2, 3, 2, 1, 2, 4, 2,
    3, 5, 3, 2, 3, 2, 4, 2, 1, 4,
    2, 2, 2, 2, 5, 3, 3, 4, 4, 2,
    1, 3, 5, 2, 3, 4, 1, 2, 1, 3]

/-- `A275656` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 81) : A275656 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 81) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 81) : fz n = data[n.toNat - 1]! := sorry

end A275656
