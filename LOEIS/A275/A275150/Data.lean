def data : List retType :=
  [1, 2, 2, 2, 2, 2, 2, 2, 3, 4,
    3, 2, 3, 3, 2, 1, 2, 4, 3, 4,
    3, 2, 2, 3, 3, 3, 3, 4, 5, 2,
    3, 2, 3, 5, 4, 4, 5, 3, 4, 3,
    2, 3, 2, 2, 5, 5, 4, 2, 2, 5,
