import LOEIS.A143.A143808.Defs

set_option linter.unusedVariables false

/-!
# A143808

Triangle read by rows, first n terms of the sequence (1, 2, 4, 10, ...) followed by P(n), where (2, 4, 10, 12, ...) = twice Pell numbers.

The 55 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A143808

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 1, 2, 2, 1, 2, 4, 5,
    1, 2, 4, 10, 12, 1, 2, 4, 10, 24,
    29, 1, 2, 4, 10, 24, 58, 70, 1, 2,
    4, 10, 24, 58, 140, 169, 1, 2, 4, 10,
    24, 58, 140, 338, 408, 1, 2, 4, 10, 24,
    58, 140, 338, 816, 985]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 55) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 55) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 55) : flatFz n = flatData[n.toNat]! := sorry

end A143808
