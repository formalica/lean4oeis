set_option linter.unusedVariables false

/-!
# A143150

A triangle sequence based on the Folium of Descartes: x^3 + y^3 - 3*a*x*y.

The 55 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A143150

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [-1, 3, 4, 19, 17, 27, 53, 48, 55, 80,
    111, 103, 107, 129, 175, 199, 188, 189, 208, 251,
    324, 323, 309, 307, 323, 363, 433, 539, 489, 472,
