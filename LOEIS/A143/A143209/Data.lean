import LOEIS.A143.A143209.Defs

set_option linter.unusedVariables false

/-!
# A143209

A "completed" set of cyclotomic polynomial with coefficients that are a triangular sequence: ( filled out with powers of (x+1)^m) p(x,n)=If[PrimeQ[n], Cyclotomic[n, x]*(x + 1), Cyclotomic[n, x]*(x + 1)^(n + 1 - Length[CoefficientList[Cyclotomic[n, x], x]])];.

The 66 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A143209

/-- Known terms of `A143209`, starting at index `1`. -/
def data : List retType :=
  [1, -1, 1, 1, 2, 1, 1, 2, 2, 1,
    1, 2, 2, 2, 1, 1, 2, 2, 2, 2,
    1, 1, 3, 3, 2, 3, 3, 1, 1, 2,
    2, 2, 2, 2, 2, 1, 1, 4, 6, 4,
    2, 4, 6, 4, 1, 1, 3, 3, 2, 3,
    3, 2, 3, 3, 1, 1, 5, 10, 10, 5,
    2, 5, 10, 10, 5, 1]

/-- `A143209` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 67) : A143209 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 67) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 67) : fz n = data[n.toNat - 1]! := sorry

end A143209
