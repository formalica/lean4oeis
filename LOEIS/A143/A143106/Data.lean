/-- `A143106` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 6) : A143106 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 6) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 6) : fz n = data[n.toNat]! := sorry

end A143106
