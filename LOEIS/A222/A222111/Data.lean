import LOEIS.A222.A222111.Defs

set_option linter.unusedVariables false

/-!
# A222111

T(n,k)=Number of binary arrays indicating the locations of trailing edge maxima of a random length-n 0..k array extended with zeros and convolved with 1,2,2,1.

The 89 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A222111

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [2, 2, 3, 2, 3, 4, 2, 3, 4, 5,
    2, 3, 4, 5, 7, 2, 3, 4, 5, 8,
    10, 2, 3, 4, 5, 8, 12, 14, 2, 3,
