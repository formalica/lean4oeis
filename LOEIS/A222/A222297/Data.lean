import LOEIS.A222.A222297.Defs

set_option linter.unusedVariables false

/-!
# A222297

Irregular triangle of numbers first appearing in the Collatz (3x+1) iteration of n.

The 65 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A222297

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 3, 4, 5, 8, 10, 16, 6, 7,
    11, 13, 17, 20, 22, 26, 34, 40, 52, 9,
    14, 28, 12, 15, 23, 35, 46, 53, 70, 80,
    106, 160, 18, 19, 29, 44, 58, 88, 21, 32,
    64, 24, 25, 38, 76, 27, 31, 41, 47, 61,
    62, 71, 82, 91, 92, 94, 103, 107, 121, 122,
    124, 137, 142, 155, 161]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 66) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 66) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 66) : flatFz n = flatData[n.toNat - 1]! := sorry

end A222297
