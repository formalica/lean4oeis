/-- `A211099` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 80) : A211099 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 80) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
