def data : List retType :=
  [1, 2, 1, 12, 2, 2, 1, 112, 12, 122,
    2, 2, 2, 2, 1, 1112, 112, 1122, 12, 12,
    122, 1222, 2, 2, 2, 2, 2, 2, 2, 2,
