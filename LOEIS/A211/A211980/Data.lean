import LOEIS.A211.A211980.Defs

set_option linter.unusedVariables false

/-!
# A211980

Triangle read by rows: T(n,k) = total number of regions in the last n-k+1 shells of n.

The 69 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A211980

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 1, 3, 2, 1, 5, 4, 3, 2,
    7, 6, 5, 4, 2, 11, 10, 9, 8, 6,
    4, 15, 14, 13, 12, 10, 8, 4, 22, 21,
