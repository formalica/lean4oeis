Numbers m > 15 such that x^m + x^15 + 1 is irreducible over GF(2) while x^m + x^15 + x^10 + x^5 + 1 = x^m + (x^5 + 1)^3 is not.

The 10 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A344199

/-- Known terms of `A344199`, starting at index `1`. -/
def data : List retType :=
  [18, 36, 60, 252, 708, 834, 900, 2178, 7722, 7980]

/-- `A344199` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 11) : A344199 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 11) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 11) : fz n = data[n.toNat - 1]! := sorry

end A344199
