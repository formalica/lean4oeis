import LOEIS.A344.A344234.Defs

set_option linter.unusedVariables false

/-!
# A344234

Irregular triangle read by rows: row n gives the pairs of proper solutions (X, Y), with gcd(X, Y) = 1 and X >= 0, of the Diophantine equation 2*X^2 + 2*X*Y + 3*Y^2 = A344232(n), for n >= 1.

The 68 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A344234

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 0, 0, 1, 1, -1, 1, 1, 2, -1,
    1, -2, 2, 1, 3, -1, 1, 2, 3, -2,
    1, -3, 2, -3, 3, 1, 4, -1, 1, 3,
    4, -3, 1, -4, 3, 2, 3, -4, 5, -2,
    4, 1, 5, -1, 5, 2, 7, -2, 4, 3,
    7, -3, 1, 5, 6, 1, 6, -5, 7, -1,
    3, 4, 7, -4, 1, -6, 5, -6]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 69) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 69) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 69) : flatFz n = flatData[n.toNat - 1]! := sorry

end A344234
