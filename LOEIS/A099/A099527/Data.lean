  [1, 2, 3, 4, 12, 1, 8, 36, 13, 6,
    16, 96, 66, 63, 1, 32, 240, 248, 360, 33,
    9, 64, 576, 800, 1560, 321, 180, 1, 128, 1344,
    2352, 5760, 1970, 1683, 62, 12, 256, 3072, 6496, 19152,
    9420, 10836, 985, 390, 1, 512, 6912, 17152, 59136, 38472,
    55692, 8989, 5418, 100, 15]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 55) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
