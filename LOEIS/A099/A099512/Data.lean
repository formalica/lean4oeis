import LOEIS.A099.A099512.Defs

set_option linter.unusedVariables false

/-!
# A099512

Triangle, read by rows, of trinomial coefficients arranged so that there are n+1 terms in row n by setting T(n,k) equal to the coefficient of z^k in (1 + 3*z + z^2)^(n-[k/2]), for n>=k>=0, where [k/2] is the integer floor of k/2.

The 62 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A099512

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, 1, 3, 1, 6, 1, 1, 9, 11, 6,
    1, 12, 30, 45, 1, 1, 15, 58, 144, 30,
    9, 1, 18, 95, 330, 195, 144, 1, 1, 21,
    141, 630, 685, 873, 58, 12, 1, 24, 196, 1071,
    1770, 3258, 685, 330, 1, 1, 27, 260, 1680, 3801,
    9198, 3989, 3258, 95, 15, 1, 30, 333, 2484, 7210,
    21672, 15533]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 62) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 62) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 62) : flatFz n = flatData[n.toNat]! := sorry

end A099512
