import LOEIS.A099.A099509.Defs

set_option linter.unusedVariables false

/-!
# A099509

Triangle, read by rows, of trinomial coefficients arranged so that there are n+1 terms in row n by setting T(n,k) equal to the coefficient of z^k in (1 + z + z^2)^(n-[k/2]), for n>=k>=0, where [k/2] is the integer floor of k/2.

The 75 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A099509

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 1, 2, 1, 1, 3, 3, 2,
    1, 4, 6, 7, 1, 1, 5, 10, 16, 6,
    3, 1, 6, 15, 30, 19, 16, 1, 1, 7,
    21, 50, 45, 51, 10, 4, 1, 8, 28, 77,
    90, 126, 45, 30, 1, 1, 9, 36, 112, 161,
    266, 141, 126, 15, 5, 1, 10, 45, 156, 266,
    504, 357, 393, 90, 50, 1, 1, 11, 55, 210,
    414, 882, 784, 1016, 357]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 75) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 75) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 75) : flatFz n = flatData[n.toNat]! := sorry

end A099509
