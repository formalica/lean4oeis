def flatData : List flatRetType :=
  [1, 1, 1, 2, 1, 1, 2, 1, 1, 2,
    1, 3, 1, 2, 1, 1, 3, 2, 1, 1,
    2, 1, 3, 1, 4, 2, 1, 1, 3, 2,
