import LOEIS.A319.A319901.Defs

set_option linter.unusedVariables false

/-!
# A319901

List of elements whose electron configuration does not satisfy the Aufbau principle.

The 20 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A319901

/-- Known terms of `A319901`, starting at index `1`. -/
def data : List retType :=
  [24, 29, 41, 42, 44, 45, 46, 47, 57, 58,
    64, 78, 79, 89, 90, 91, 92, 93, 96, 103]

/-- `A319901` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 21) : A319901 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 21) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 21) : fz n = data[n.toNat - 1]! := sorry

end A319901
