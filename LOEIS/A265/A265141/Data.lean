/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 48) : flat n = flatData[n.val - 3]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 3 ≤ n) (h : n < 48) : flatFn n = flatData[n - 3]! := sorry

