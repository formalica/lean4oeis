import LOEIS.A227.A227452.Defs

set_option linter.unusedVariables false

/-!
# A227452

Irregular table where each row lists the partitions occurring on the main trunk of the Bulgarian Solitaire game tree (from the top to the root) for deck of n(n+1)/2 cards. Nonordered partitions are encoded in the runlengths of binary expansion of each term, in the manner explained in A129594.

The 56 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A227452

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [0, 1, 5, 7, 6, 18, 61, 8, 11, 58,
    28, 25, 77, 246, 66, 55, 36, 237, 226, 35,
    46, 116, 197, 115, 102, 306, 985, 265, 445, 200,
    155, 946, 905, 285, 220, 145, 475, 786, 925, 140,
    185, 465, 395, 826, 460, 409, 1229, 3942, 1062, 1782,
    1602, 823, 612, 3789, 3622, 1142]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 56) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
