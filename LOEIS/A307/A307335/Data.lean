    2, 4, 2, 2, 4, 4, 0, 4, 4, 4,
    4, 0]

/-- `A307335` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 113) : A307335 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
