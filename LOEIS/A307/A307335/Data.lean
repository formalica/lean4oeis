def data : List retType :=
  [4, 3, 2, 1, 0, 4, 4, 4, 4, 4,
    3, 2, 1, 0, 4, 4, 3, 2, 1, 4,
    4, 0, 3, 4, 4, 4, 2, 4, 1, 0,
    4, 3, 4, 2, 1, 3, 1, 2, 4, 4,
    0, 4, 4, 3, 4, 4, 4, 2, 0, 4,
    1, 0, 3, 3, 4, 4, 4, 2, 4, 1,
    3, 1, 4, 2, 4, 2, 0, 4, 4, 4,
