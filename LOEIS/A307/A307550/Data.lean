import LOEIS.A307.A307550.Defs

set_option linter.unusedVariables false

/-!
# A307550

Irregular array of distinct terms read by rows: for n > 0, row n = [r(1),...,r(k)] with r(1) = n^2 (mod prime(n)), r(2) = r(1)^2 (mod prime(n)), ..., r(k) = r(k-1)^2 (mod prime(n)), where r(k) is the last term of the cycle.

The 72 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A307550

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 4, 1, 2, 4, 3, 9, 4, 5,
    10, 9, 3, 15, 4, 16, 1, 7, 11, 12,
    6, 13, 8, 18, 2, 4, 16, 3, 9, 13,
    24, 25, 16, 28, 9, 19, 20, 33, 16, 34,
    9, 7, 12, 5, 25, 10, 18, 37, 16, 24,
    17, 31, 15, 10, 14, 37, 6, 36, 27, 24,
    12, 3, 9, 34, 28, 32, 44, 28, 42, 15,
    13, 10]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 73) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 73) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 73) : flatFz n = flatData[n.toNat - 1]! := sorry

end A307550
