import LOEIS.A307.A307333.Defs

set_option linter.unusedVariables false

/-!
# A307333

A fractal quaternary sequence: For all n >= 1, underline the term with index n + a(n) + 1; then the two subsequences of underlined terms and of non-underlined terms are both equal to the sequence itself.

The 113 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A307333

/-- Known terms of `A307333`, starting at index `1`. -/
def data : List retType :=
  [3, 2, 1, 0, 3, 3, 3, 3, 2, 1,
    0, 3, 3, 2, 1, 3, 3, 0, 1, 3,
    2, 3, 3, 0, 2, 3, 3, 1, 2, 3,
    3, 0, 2, 1, 3, 3, 1, 3, 3, 0,
    3, 2, 3, 3, 1, 0, 2, 3, 1, 3,
    2, 0, 3, 1, 3, 1, 3, 3, 3, 2,
    0, 3, 2, 3, 3, 3, 0, 3, 1, 0,
    3, 2, 2, 3, 1, 3, 0, 2, 3, 3,
    1, 1, 3, 1, 2, 3, 3, 3, 3, 2,
    0, 3, 2, 3, 0, 3, 2, 3, 1, 3,
    3, 0, 3, 1, 0, 2, 2, 3, 3, 1,
    3, 3, 0]

/-- `A307333` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 114) : A307333 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 114) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 114) : fz n = data[n.toNat - 1]! := sorry

end A307333
