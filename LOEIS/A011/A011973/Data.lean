import LOEIS.A011.A011973.Defs

set_option linter.unusedVariables false

/-!
# A011973

Irregular triangle read by rows: T(n,k) = binomial(n-k, k), n >= 0, 0 <= k <= floor(n/2); or, coefficients of (one version of) Fibonacci polynomials.

The 78 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A011973

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 1, 1, 2, 1, 3, 1, 1,
    4, 3, 1, 5, 6, 1, 1, 6, 10, 4,
    1, 7, 15, 10, 1, 1, 8, 21, 20, 5,
    1, 9, 28, 35, 15, 1, 1, 10, 36, 56,
    35, 6, 1, 11, 45, 84, 70, 21, 1, 1,
    12, 55, 120, 126, 56, 7, 1, 13, 66, 165,
    210, 126, 28, 1, 1, 14, 78, 220, 330, 252,
    84, 8, 1, 15, 91, 286, 495, 462]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 78) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 78) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 78) : flatFz n = flatData[n.toNat]! := sorry

end A011973
