import LOEIS.A049.A049456.Defs

set_option linter.unusedVariables false

/-!
# A049456

Triangle T(n,k) = denominator of fraction in k-th term of n-th row of variant of Farey series. This is also Stern's diatomic array read by rows (version 1).

The 92 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A049456

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 2, 1, 1, 3, 2, 3, 1,
    1, 4, 3, 5, 2, 5, 3, 4, 1, 1,
    5, 4, 7, 3, 8, 5, 7, 2, 7, 5,
    8, 3, 7, 4, 5, 1, 1, 6, 5, 9,
    4, 11, 7, 10, 3, 11, 8, 13, 5, 12,
    7, 9, 2, 9, 7, 12, 5, 13, 8, 11,
    3, 10, 7, 11, 4, 9, 5, 6, 1, 1,
    7, 6, 11, 5, 14, 9, 13, 4, 15, 11,
    18, 7, 17, 10, 13, 3, 14, 11, 19, 8,
    21, 13]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 93) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 93) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 93) : flatFz n = flatData[n.toNat - 1]! := sorry

end A049456
