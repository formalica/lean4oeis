/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 74) : flat n = flatData[n.val - 2]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 2 ≤ n) (h : n < 74) : flatFn n = flatData[n - 2]! := sorry

