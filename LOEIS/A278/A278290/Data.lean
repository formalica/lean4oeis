import LOEIS.A278.A278290.Defs

set_option linter.unusedVariables false

/-!
# A278290

Number of neighbors of each new term in a square array read by antidiagonals.

The 120 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A278290

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [0, 1, 2, 1, 4, 2, 1, 4, 4, 2,
    1, 4, 4, 4, 2, 1, 4, 4, 4, 4,
    2, 1, 4, 4, 4, 4, 4, 2, 1, 4,
    4, 4, 4, 4, 4, 2, 1, 4, 4, 4,
    4, 4, 4, 4, 2, 1, 4, 4, 4, 4,
    4, 4, 4, 4, 2, 1, 4, 4, 4, 4,
    4, 4, 4, 4, 4, 2, 1, 4, 4, 4,
    4, 4, 4, 4, 4, 4, 4, 2, 1, 4,
    4, 4, 4, 4, 4, 4, 4, 4, 4, 4,
    2, 1, 4, 4, 4, 4, 4, 4, 4, 4,
    4, 4, 4, 4, 2, 1, 4, 4, 4, 4,
    4, 4, 4, 4, 4, 4, 4, 4, 4, 2]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 121) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 121) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 121) : flatFz n = flatData[n.toNat - 1]! := sorry

end A278290
