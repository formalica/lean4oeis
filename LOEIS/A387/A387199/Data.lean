import LOEIS.A387.A387199.Defs

set_option linter.unusedVariables false

/-!
# A387199

Numbers which are not themselves palindromes, but a single swap of two digits creates a palindrome.

The 53 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A387199

/-- Known terms of `A387199`, starting at index `1`. -/
def data : List retType :=
  [110, 112, 113, 114, 115, 116, 117, 118, 119, 122,
    133, 144, 155, 166, 177, 188, 199, 211, 220, 221,
    223, 224, 225, 226, 227, 228, 229, 233, 244, 255,
    266, 277, 288, 299, 311, 322, 330, 331, 332, 334,
    335, 336, 337, 338, 339, 344, 355, 366, 377, 388,
