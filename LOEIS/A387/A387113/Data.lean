import LOEIS.A387.A387113.Defs

set_option linter.unusedVariables false

/-!
# A387113

Numbers whose prime indices do not have (strictly) choosable initial intervals.

The 58 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A387113

/-- Known terms of `A387113`, starting at index `1`. -/
def data : List retType :=
  [4, 8, 12, 16, 18, 20, 24, 27, 28, 32,
    36, 40, 44, 48, 52, 54, 56, 60, 64, 68,
    72, 76, 80, 81, 84, 88, 90, 92, 96, 100,
    104, 108, 112, 116, 120, 124, 126, 128, 132, 135,
    136, 140, 144, 148, 150, 152, 156, 160, 162, 164,
    168, 172, 176, 180, 184, 188, 189, 192]

/-- `A387113` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 59) : A387113 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 59) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 59) : fz n = data[n.toNat - 1]! := sorry

end A387113
