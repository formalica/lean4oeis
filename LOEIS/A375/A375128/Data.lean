import LOEIS.A375.A375128.Defs

set_option linter.unusedVariables false

/-!
# A375128

Irregular triangle read by rows where row n lists the minima of maximal strictly increasing runs in the weakly increasing prime indices of n.

The 84 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A375128

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 1, 1, 3, 1, 4, 1, 1, 1,
    2, 2, 1, 5, 1, 1, 6, 1, 2, 1,
    1, 1, 1, 7, 1, 2, 8, 1, 1, 2,
