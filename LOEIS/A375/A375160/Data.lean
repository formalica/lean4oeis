def flatData : List flatRetType :=
  [4, 8, 9, 16, 27, 33, 32, 135, 170, -1,
    64, 944, 1274, 603, -1, 128, 5264, 15470, 4023, 602,
    -1, 256, 29888, 33614, 57967, 12122, 2522, -1, 512, 50624,
