    3, 2, 2, 3, 3, 3, 2, 3, 3, 3,
    2, 3, 4, 3, 3, 1, 3, 4, 4, 3,
    3, 5, 5, 3, 2, 2, 3, 4, 2, 3,
    5, 5, 3, 4, 4, 5, 3, 5, 2, 3,
    4, 4, 4, 2, 6, 4, 3, 4, 3, 5,
    1, 5, 5, 5, 4, 2, 5, 4, 4, 2,
    4, 6, 5, 6, 3, 5, 5, 6, 5, 1,
    5, 3, 5, 3, 6, 4, 5, 7, 3, 5,
    3, 5, 5, 3, 7, 3, 9, 4, 6, 5]

/-- `A237130` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 101) : A237130 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
