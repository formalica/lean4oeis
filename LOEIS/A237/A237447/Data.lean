import LOEIS.A237.A237447.Defs

set_option linter.unusedVariables false

/-!
# A237447

Infinite square array: row 1 is the positive integers 1, 2, 3, ..., and on any subsequent row n, n is moved to the front: n, 1, ..., n-1, n+1, n+2, ...

The 120 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A237447

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 2, 3, 1, 3, 4, 3, 1, 4,
    5, 4, 2, 1, 5, 6, 5, 4, 2, 1,
    6, 7, 6, 5, 3, 2, 1, 7, 8, 7,
    6, 5, 3, 2, 1, 8, 9, 8, 7, 6,
    4, 3, 2, 1, 9, 10, 9, 8, 7, 6,
    4, 3, 2, 1, 10, 11, 10, 9, 8, 7,
    5, 4, 3, 2, 1, 11, 12, 11, 10, 9,
    8, 7, 5, 4, 3, 2, 1, 12, 13, 12,
    11, 10, 9, 8, 6, 5, 4, 3, 2, 1,
    13, 14, 13, 12, 11, 10, 9, 8, 6, 5,
    4, 3, 2, 1, 14, 15, 14, 13, 12, 11,
    10, 9, 7, 6, 5, 4, 3, 2, 1, 15]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 121) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 121) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 121) : flatFz n = flatData[n.toNat - 1]! := sorry

end A237447
