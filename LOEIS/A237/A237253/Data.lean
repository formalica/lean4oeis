import LOEIS.A237.A237253.Defs

set_option linter.unusedVariables false

/-!
# A237253

Number of ordered ways to write n = k + m with k > 0 and m > 0 such that phi(k) - 1, phi(k) + 1 and prime(prime(prime(m))) - 2 are all prime, where phi(.) is Euler's totient function.

The 80 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A237253

/-- Known terms of `A237253`, starting at index `1`. -/
def data : List retType :=
  [0, 0, 0, 0, 0, 1, 0, 2, 1, 2,
    2, 1, 2, 1, 2, 1, 1, 1, 2, 2,
    3, 4, 2, 2, 1, 2, 3, 3, 3, 2,
    4, 5, 4, 3, 4, 3, 5, 4, 4, 6,
    6, 7, 5, 5, 6, 3, 4, 3, 6, 5,
    6, 5, 3, 6, 5, 6, 3, 3, 5, 3,
    5, 4, 3, 4, 3, 6, 4, 3, 1, 1,
    4, 3, 4, 4, 4, 5, 6, 7, 3, 3]

/-- `A237253` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 81) : A237253 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 81) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 81) : fz n = data[n.toNat - 1]! := sorry

end A237253
