/-- `A151970` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 73) : A151970 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 73) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 73) : fz n = data[n.toNat - 1]! := sorry

end A151970
