import LOEIS.A151.A151970.Defs

set_option linter.unusedVariables false

/-!
# A151970

a(n) = smallest integer >= n which has only prime factors 3 and 5.

The 72 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A151970

/-- Known terms of `A151970`, starting at index `1`. -/
def data : List retType :=
  [1, 3, 3, 5, 5, 9, 9, 9, 9, 15,
    15, 15, 15, 15, 15, 25, 25, 25, 25, 25,
    25, 25, 25, 25, 25, 27, 27, 45, 45, 45,
    45, 45, 45, 45, 45, 45, 45, 45, 45, 45,
    45, 45, 45, 45, 45, 75, 75, 75, 75, 75,
    75, 75, 75, 75, 75, 75, 75, 75, 75, 75,
