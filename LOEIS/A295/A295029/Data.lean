def data : List retType :=
  [1, 2, 4, 3, 8, 6, 12, 5, 9, 16,
    24, 10, 18, 20, 36, 7, 32, 15, 48, 28,
    40, 60, 72, 14, 56, 30, 96, 44, 64, 84,
