    1, 2, 5, 1, 3, 4, 1, 1, 1, 4,
    5, 2, 3, 4, 5, 2, 3, 6, 5, 3,
    3, 8]

/-- `A174204` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 32) : A174204 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 32) : fn n = data[n]! := sorry

