import LOEIS.A041.A041000.Defs

set_option linter.unusedVariables false

/-!
# A041000

If decimal expansion of n-th prime is x1 x2 ... xk, sort the xi into nonincreasing order, y1 y2 ... yk; then a(n) = |y1-y2-y3...-yk|.

The 106 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A041000

/-- Known terms of `A041000`, starting at index `1`. -/
def data : List retType :=
  [2, 3, 5, 7, 0, 2, 6, 8, 1, 7,
    2, 4, 3, 1, 3, 2, 4, 5, 1, 6,
    4, 2, 5, 1, 2, 0, 2, 6, 8, 1,
    4, 1, 3, 5, 4, 3, 1, 2, 0, 3,
    1, 6, 7, 5, 1, 1, 0, 1, 3, 5,
    2, 4, 1, 2, 0, 1, 1, 4, 2, 5,
    3, 4, 4, 1, 1, 3, 1, 1, 0, 2,
    1, 1, 2, 1, 1, 2, 2, 1, 3, 5,
    4, 1, 0, 2, 2, 3, 1, 2, 1, 1,
    3, 2, 3, 4, 4, 2, 4, 2, 0, 0,
    2, 3, 2, 2, 1, 5]

/-- `A041000` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 107) : A041000 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 107) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 107) : fz n = data[n.toNat - 1]! := sorry

end A041000
