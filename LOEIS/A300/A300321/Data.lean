import LOEIS.A300.A300321.Defs

set_option linter.unusedVariables false

/-!
# A300321

T(n,k)=Number of nXk 0..1 arrays with every element equal to 0, 1, 3, 4, 5, 6, 7 or 8 king-move adjacent elements, with upper left element zero.

The 55 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A300321

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 2, 3, 4, 3, 5, 4, 4, 5,
    8, 16, 16, 16, 8, 13, 50, 61, 61, 50,
    13, 21, 112, 186, 735, 186, 112, 21, 34, 348,
