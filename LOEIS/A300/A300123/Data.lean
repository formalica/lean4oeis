import LOEIS.A300.A300123.Defs

set_option linter.unusedVariables false

/-!
# A300123

Number of ways to tile the diagram of the integer partition with Heinz number n using connected skew partitions.

The 50 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A300123

/-- Known terms of `A300123`, starting at index `1`. -/
def data : List retType :=
  [1, 1, 2, 2, 4, 4, 8, 4, 10, 8,
    16, 8, 32, 16, 20, 8, 64, 20, 128, 16,
    40, 32, 256, 16, 52, 64, 52, 32, 512, 40,
    1024, 16, 80, 128, 104, 40, 2048, 256, 160, 32,
    4096, 80, 8192, 64, 104, 512, 16384, 32, 272, 104]

/-- `A300123` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 51) : A300123 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 51) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 51) : fz n = data[n.toNat - 1]! := sorry

end A300123
