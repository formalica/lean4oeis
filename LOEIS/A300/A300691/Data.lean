import LOEIS.A300.A300691.Defs

set_option linter.unusedVariables false

/-!
# A300691

Square array T(n, k) (n >= 1, k >= 1) read by antidiagonals upwards: T(n, k) is the k-th positive number, say m, such that the binary representation of n appears as a substring in the binary representation of 1/m (ignoring the radix point and adding trailing zeros if necessary in case of a terminating expansion).

The 76 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A300691

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 2, 5, 2, 3, 1, 9, 3, 4,
    3, 2, 10, 4, 5, 5, 6, 4, 11, 5,
    6, 9, 9, 11, 5, 13, 6, 7, 1, 11,
    10, 12, 7, 17, 7, 8, 5, 2, 13, 11,
    13, 8, 18, 8, 9, 3, 7, 4, 17, 13,
    19, 9, 19, 9, 10, 11, 6, 10, 8, 18,
    17, 22, 10, 20, 10, 11, 5, 13, 11, 13,
    9, 19, 18, 23, 11, 21]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 77) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 77) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 77) : flatFz n = flatData[n.toNat - 1]! := sorry

end A300691
