import LOEIS.A300.A300302.Defs

set_option linter.unusedVariables false

/-!
# A300302

Square array T(n, k) (n >= 1, k >= 1) read by antidiagonals upwards: T(n, k) is the k-th positive number whose binary representation contains the binary representation of n as a substring.

The 72 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A300302

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 2, 3, 4, 3, 4, 6, 5, 4,
    5, 8, 7, 6, 5, 6, 10, 9, 11, 8,
    6, 7, 12, 11, 12, 12, 9, 7, 8, 14,
    13, 13, 16, 13, 10, 8, 9, 16, 15, 14,
    20, 17, 14, 11, 9, 10, 18, 17, 23, 22,
    21, 18, 15, 12, 10, 11, 20, 19, 24, 28,
    24, 22, 19, 19, 13, 11, 12, 22, 21, 25,
    32, 29]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 73) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 73) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 73) : flatFz n = flatData[n.toNat - 1]! := sorry

end A300302
