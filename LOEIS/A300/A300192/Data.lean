import LOEIS.A300.A300192.Defs

set_option linter.unusedVariables false

/-!
# A300192

Triangle read by rows: row n consists of the coefficients of the expansion of the polynomial (x^2 + 2*x + 1)^n + (x^2 - 1)*(x + 1)^n.

The 65 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A300192

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [0, 0, 1, 0, 1, 2, 1, 0, 2, 6,
    6, 2, 0, 3, 13, 22, 18, 7, 1, 0,
    4, 23, 56, 75, 60, 29, 8, 1, 0, 5,
    36, 115, 215, 261, 215, 121, 45, 10, 1, 0,
