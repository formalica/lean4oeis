import LOEIS.A300.A300653.Defs

set_option linter.unusedVariables false

/-!
# A300653

Square array T(n, k) (n >= 1, k >= 1) read by antidiagonals upwards: T(n, k) is the k-th positive number whose binary representation appears as a substring in the binary representation of 1/n (ignoring the radix point and adding trailing zeros if necessary in case of a terminating expansion).

The 73 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A300653

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 2, 1, 2, 4, 1, 2, 4, 8,
    1, 2, 5, 8, 16, 1, 2, 4, 10, 16,
    32, 1, 2, 3, 8, 21, 32, 64, 1, 2,
    5, 4, 16, 42, 64, 128, 1, 2, 4, 10,
    6, 32, 85, 128, 256, 1, 2, 4, 9, 21,
    9, 64, 170, 256, 512, 1, 2, 3, 8, 18,
    42, 12, 128, 341, 512, 1024, 1, 2, 3, 4,
    16, 36, 85]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 74) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 74) : flatFn n = flatData[n - 1]! := sorry

