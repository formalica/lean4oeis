set_option linter.unusedVariables false

/-!
# A078448

Triangle T(n,k) for 1 <= n, 1 <= k <= n read by rows: T(1,1) = 1; for n > 1: T(n,1) = T(n-1,n-1) + 1; for n > 1 and k <=n: T(n,k) = smallest number > T(n,k-1) which is relatively prime to T(n,j) for 1 <= j < k.

The 64 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A078448

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 3, 4, 5, 7, 8, 9, 11, 13,
    14, 15, 17, 19, 23, 24, 25, 29, 31, 37,
    41, 42, 43, 47, 53, 55, 59, 61, 62, 63,
