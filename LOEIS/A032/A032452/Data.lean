import LOEIS.A032.A032452.Defs

set_option linter.unusedVariables false

/-!
# A032452

Irregular triangle read by rows: row n >= 1 contains the sequence p(n), s(p(n)), p(s(p(n))), p(p(s(p(n)))), s(p(p(s(p(n))))), ..., repeatedly applying (p,s,p) to n, where p = phi (A000010), s = sigma = (A000203), stopping after the first 1 is reached. If 1 is never reached, row n contains -1.

The 80 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A032452

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 2, 3, 2, 1, 2, 3, 2, 1,
    4, 7, 6, 2, 3, 2, 1, 2, 3, 2,
    1, 6, 12, 4, 2, 3, 2, 1, 4, 7,
    6, 2, 3, 2, 1, 6, 12, 4, 2, 3,
    2, 1, 4, 7, 6, 2, 3, 2, 1, 10,
    18, 6, 2, 3, 2, 1, 4, 7, 6, 2,
    3, 2, 1, 12, 28, 12, 4, 7, 6, 2,
    3, 2, 1, 6, 12, 4, 2, 3, 2, 1]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 81) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 81) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 81) : flatFz n = flatData[n.toNat - 1]! := sorry

end A032452
