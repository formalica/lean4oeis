set_option linter.unusedVariables false

/-!
# A351993

Lexicographically earliest infinite sequence of distinct positive numbers such that, when they are written in binary and concatenated, every pair of digits starting from a(1) contains the digits 0 and 1.

The 66 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A351993

/-- Known terms of `A351993`, starting at index `1`. -/
def data : List retType :=
  [0, 1, 2, 4, 5, 9, 10, 18, 6, 20,
    12, 21, 37, 38, 41, 42, 74, 22, 76, 25,
    82, 26, 84, 44, 50, 52, 85, 149, 150, 153,
