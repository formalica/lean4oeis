import LOEIS.A351.A351986.Defs

set_option linter.unusedVariables false

/-!
# A351986

Four-column table read by rows, giving quadruples of integers [w,x,y,z] such that y^2 - y - x*z = 0 and x^2 = w*y with w*y != 0 and y != 1, sorted by the absolute value of y with the negatives first, then by x in ascending order.

The 80 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A351986

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [-4, -2, -1, -1, -1, -1, -1, -2, -1, 1,
    -1, 2, -4, 2, -1, 1, -18, -6, -2, -1,
    -2, -2, -2, -3, -2, 2, -2, 3, -18, 6,
    -2, 1, 2, -2, 2, -1, 2, 2, 2, 1,
    -48, -12, -3, -1, -12, -6, -3, -2, -3, -3,
    -3, -4, -3, 3, -3, 4, -12, 6, -3, 2,
    -48, 12, -3, 1, 12, -6, 3, -1, 3, -3,
    3, -2, 3, 3, 3, 2, 12, 6, 3, 1]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 81) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 81) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 81) : flatFz n = flatData[n.toNat - 1]! := sorry

end A351986
