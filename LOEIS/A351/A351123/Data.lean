import LOEIS.A351.A351123.Defs

set_option linter.unusedVariables false

/-!
# A351123

Irregular triangle read by rows: row n lists the partial sums of the number of divisions by 2 after each tripling step in the Collatz trajectory of 2n+1.

The 87 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A351123

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 5, 4, 1, 2, 4, 7, 11, 2, 3,
    4, 6, 9, 13, 1, 3, 6, 10, 3, 7,
    1, 2, 3, 8, 12, 2, 5, 9, 1, 4,
