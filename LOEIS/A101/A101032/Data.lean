import LOEIS.A101.A101032.Defs

set_option linter.unusedVariables false

/-!
# A101032

Table (read by rows) giving the coefficients of sum formulas of n-th Lucas numbers (A000204). The k-th row (k>=1) contains T(i,k) for i=1 to k, where k=[2*n+1+(-1)^(n-1)]/4 and T(i,k) satisfies L(n) = Sum_{i=1..k} T(i,k) * n^(k-i) / (k-1)!.

The 51 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A101032

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 1, -1, 2, 1, -6, 17, 6,
    1, -14, 83, -142, 24, 1, -25, 265, -1235, 2314,
    120, 1, -39, 655, -5565, 24184, -41556, 720, 1, -56,
    1372, -18200, 137599, -556304, 944628, 5040, 1, -76, 2562, -48664,
    560049, -3884524, 15021068, -24875376, 40320, 1, -99, 4398, -113022, 1829793,
    -19043451]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 52) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 52) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 52) : flatFz n = flatData[n.toNat - 1]! := sorry

end A101032
