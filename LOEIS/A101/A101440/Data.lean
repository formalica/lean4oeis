  [1, 2, 4, 8, 16, 32, 64, 128, 256, 512,
    5, 10, 20, 40, 80, 160, 320, 640, 1280, 2560,
    9, 18, 36, 72, 144, 288, 576, 1152, 2304, 4608,
    17, 34, 68, 136, 272, 544, 1088, 2176, 4352, 8704,
    33, 66, 132, 264, 528, 1056, 2112, 4224, 8448, 16896,
    65, 130, 260, 520, 1040]

/-- `A101440` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 55) : A101440 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
