/-!
# A215559

Smallest n-digit noncomposite number (written in base 2) with maximum base-2 digit sum.

The 20 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A215559

/-- Known terms of `A215559`, starting at index `1`. -/
def data : List retType :=
  [1, 11, 111, 1011, 11111, 101111, 1111111, 10111111, 101111111, 1111011111,
    11111110111, 110111111111, 1111111111111, 11101111111111, 100111111111111, 1111011111111111, 11111111111111111, 111011111111111111, 1111111111111111111, 10111111111111111111]

/-- `A215559` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 21) : A215559 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 21) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 21) : fz n = data[n.toNat - 1]! := sorry

end A215559
