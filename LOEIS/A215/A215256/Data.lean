import LOEIS.A215.A215256.Defs

set_option linter.unusedVariables false

/-!
# A215256

Longest palindromic factor of (n base 2); in case of tie choose largest; if it begins with 0 complement it.

The 46 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A215256

/-- Known terms of `A215256`, starting at index `0`. -/
def data : List retType :=
  [1, 1, 1, 11, 11, 101, 11, 111, 111, 1001,
    101, 101, 11, 101, 111, 1111, 1111, 10001, 1001, 1001,
    101, 10101, 1001, 111, 111, 1001, 101, 11011, 111, 111,
    1111, 11111, 11111, 100001, 10001, 10001, 11011, 1001, 1001, 1001,
    101, 1001, 10101, 10101, 1001, 101101]

/-- `A215256` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 46) : A215256 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 46) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 46) : fz n = data[n.toNat]! := sorry

end A215256
