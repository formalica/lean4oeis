import LOEIS.A215.A215121.Defs

set_option linter.unusedVariables false

/-!
# A215121

Strobogrammatic palindromic numbers in their Roman numeral representation.

The 7 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A215121

/-- Known terms of `A215121`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 3, 10, 19, 20, 30]

/-- `A215121` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 8) : A215121 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 8) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 8) : fz n = data[n.toNat - 1]! := sorry

end A215121
