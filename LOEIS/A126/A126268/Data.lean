import LOEIS.A126.A126268.Defs

set_option linter.unusedVariables false

/-!
# A126268

Triangle read by rows: row n gives lengths of Huffman codes with n (>= 3) symbols, where symbol[k] has frequency k (k=1,..,n), in increasing k.

The 33 terms known to OEIS, indexed from `3`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A126268

/-- Known terms of `flat`, starting at index `3`. -/
def flatData : List flatRetType :=
  [2, 2, 1, 3, 3, 2, 1, 3, 3, 2,
    2, 2, 4, 4, 3, 2, 2, 2, 4, 4,
    3, 3, 3, 2, 2, 5, 5, 4, 3, 3,
    3, 2, 2]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 36) : flat n = flatData[n.val - 3]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 3 ≤ n) (h : n < 36) : flatFn n = flatData[n - 3]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 3 ≤ n) (h : n < 36) : flatFz n = flatData[n.toNat - 3]! := sorry

end A126268
