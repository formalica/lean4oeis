theorem data_eq (n : argType) (h : n.val < 16) : A228253 n = data[n.val - 10]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 10 ≤ n) (h : n < 16) : fn n = data[n - 10]! := sorry

