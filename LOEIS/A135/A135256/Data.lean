import LOEIS.A135.A135256.Defs

set_option linter.unusedVariables false

/-!
# A135256

A triangular sequence based on a further generalization of the Cornelius-Schultz matrix polynomials to two sequences in i and j. a(n)=(n-1)!/f[n]: f[n]-> Fibonacci numbers; c(n)=1/n; B(i,j)=(-1)^(i + j)*a[j + 1]*c[i + 1]/(j!*(i - j)!) as a lower triangular matrix.

The 40 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A135256

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, -1, 12, -8, 1, 144, -108, 20, -1,
    3600, -2844, 608, -45, 1, 172800, -140112, 32028, -2768, 93,
    -1, 15724800, -12922992, 3054660, -283916, 11231, -184, 1, 2641766400, -2186787456,
    526105872, -50752548, 2170724, -42143, 352, -1, 808380518400, -671798727936, 163175184288, -16056385560]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 41) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 41) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 41) : flatFz n = flatData[n.toNat - 1]! := sorry

end A135256
