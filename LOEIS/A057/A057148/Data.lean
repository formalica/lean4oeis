import LOEIS.A057.A057148.Defs

set_option linter.unusedVariables false

/-!
# A057148

Palindromes only using 0 and 1 (i.e., base-2 palindromes).

The 32 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A057148

/-- Known terms of `A057148`, starting at index `1`. -/
def data : List retType :=
  [0, 1, 11, 101, 111, 1001, 1111, 10001, 10101, 11011,
    11111, 100001, 101101, 110011, 111111, 1000001, 1001001, 1010101, 1011101, 1100011,
    1101011, 1110111, 1111111, 10000001, 10011001, 10100101, 10111101, 11000011, 11011011, 11100111,
    11111111, 100000001]

/-- `A057148` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 33) : A057148 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 33) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 33) : fz n = data[n.toNat - 1]! := sorry

end A057148
