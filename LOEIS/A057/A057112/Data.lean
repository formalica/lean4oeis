import LOEIS.A057.A057112.Defs

set_option linter.unusedVariables false

/-!
# A057112

Sequence of 719 adjacent transpositions (a[n] a[n]+1), which, when starting from the identity permutation and applied successively, produce a Hamiltonian circuit/path through all 720 permutations of S_6, in such a way that S_{n-1} is always traversed before the rest of S_n.

The 119 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A057112

/-- Known terms of `A057112`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 1, 2, 1, 3, 1, 2, 3, 2,
    1, 2, 3, 2, 1, 2, 3, 1, 3, 2,
    3, 2, 3, 4, 1, 2, 1, 2, 1, 3,
    1, 2, 3, 2, 1, 2, 3, 2, 1, 2,
    3, 1, 3, 2, 3, 2, 3, 4, 1, 2,
    1, 2, 1, 3, 1, 2, 3, 2, 1, 2,
    3, 2, 1, 2, 3, 1, 3, 2, 3, 2,
    3, 4, 1, 2, 1, 2, 1, 3, 1, 2,
    3, 2, 1, 2, 3, 2, 1, 2, 3, 1,
    3, 2, 3, 2, 3, 4, 1, 2, 1, 2,
    1, 3, 1, 2, 3, 2, 1, 2, 3, 2,
    1, 2, 3, 1, 3, 2, 3, 2, 3]

/-- `A057112` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 120) : A057112 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 120) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 120) : fz n = data[n.toNat - 1]! := sorry

end A057112
