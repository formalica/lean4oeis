import LOEIS.A256.A256659.Defs

set_option linter.unusedVariables false

/-!
# A256659

Rectangular array by antidiagonals:  row n consists of numbers k such that -F(n+1) is the trace of the minimal alternating Fibonacci representation of k, where F = A000045 (Fibonacci numbers).

The 60 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A256659

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [4, 7, 6, 12, 11, 10, 20, 19, 18, 16,
    25, 32, 31, 29, 26, 33, 40, 52, 50, 47,
    42, 38, 53, 65, 84, 81, 76, 68, 41, 61,
    86, 105, 136, 131, 123, 110, 46, 66, 99, 139,
    170, 220, 212, 199, 178, 54, 74, 107, 160, 225,
    275, 356, 343, 322, 288, 59, 87, 120, 173, 259]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 61) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 61) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 61) : flatFz n = flatData[n.toNat - 1]! := sorry

end A256659
