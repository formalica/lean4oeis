import LOEIS.A256.A256696.Defs

set_option linter.unusedVariables false

/-!
# A256696

R(k), the minimal alternating binary representation of k, concatenated for k = 0, 1, 2,....

The 69 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A256696

/-- Known terms of `A256696`, starting at index `0`. -/
def data : List retType :=
  [0, 1, 2, 4, -1, 4, 8, -4, 1, 8,
    -2, 8, -1, 8, 16, -8, 1, 16, -8, 2,
    16, -8, 4, -1, 16, -4, 16, -4, 1, 16,
    -2, 16, -1, 16, 32, -16, 1, 32, -16, 2,
    32, -16, 4, -1, 32, -16, 4, 32, -16, 8,
    -4, 1, 32, -16, 8, -2, 32, -16, 8, -1,
    32, -8, 32, -8, 1, 32, -8, 2, 32]

/-- `A256696` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 69) : A256696 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 69) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 69) : fz n = data[n.toNat]! := sorry

end A256696
