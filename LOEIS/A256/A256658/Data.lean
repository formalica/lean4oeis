import LOEIS.A256.A256658.Defs

set_option linter.unusedVariables false

/-!
# A256658

Rectangular array by antidiagonals:  row n consists of numbers k such that F(n+1) is the trace of the minimal alternating Fibonacci representation of k, where F = A000045 (Fibonacci numbers).

The 61 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A256658

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 9, 2, 14, 15, 3, 17, 23, 24, 5,
    22, 28, 37, 39, 8, 27, 36, 45, 60, 63,
    13, 30, 44, 58, 73, 97, 102, 21, 35, 49,
    71, 94, 118, 157, 165, 34, 43, 57, 79, 115,
    152, 191, 254, 267, 55, 48, 70, 92, 128, 186,
    246, 309, 411, 432, 89, 51, 78, 113, 149, 207,
    301]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 62) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 62) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 62) : flatFz n = flatData[n.toNat - 1]! := sorry

end A256658
