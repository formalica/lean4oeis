import LOEIS.A256.A256641.Defs

set_option linter.unusedVariables false

/-!
# A256641

a(n) is the total number of free ends of 5 line segments expansion at n iterations (see Comments lines for definition).

The 20 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A256641

/-- Known terms of `A256641`, starting at index `1`. -/
def data : List retType :=
  [5, 10, 10, 20, 40, 40, 20, 20, 40, 60,
    70, 70, 100, 100, 40, 20, 40, 60, 80, 120]

/-- `A256641` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 21) : A256641 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 21) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 21) : fz n = data[n.toNat - 1]! := sorry

end A256641
