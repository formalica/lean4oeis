import LOEIS.A256.A256250.Defs

set_option linter.unusedVariables false

/-!
# A256250

Total number of ON states after n generations of a cellular automaton on the square grid.

The 64 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A256250

/-- Known terms of `A256250`, starting at index `1`. -/
def data : List retType :=
  [1, 5, 9, 21, 25, 37, 57, 85, 89, 101,
    121, 149, 185, 229, 281, 341, 345, 357, 377, 405,
    441, 485, 537, 597, 665, 741, 825, 917, 1017, 1125,
    1241, 1365, 1369, 1381, 1401, 1429, 1465, 1509, 1561, 1621,
    1689, 1765, 1849, 1941, 2041, 2149, 2265, 2389, 2521, 2661,
    2809, 2965, 3129, 3301, 3481, 3669, 3865, 4069, 4281, 4501,
    4729, 4965, 5209, 5461]

/-- `A256250` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 65) : A256250 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 65) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 65) : fz n = data[n.toNat - 1]! := sorry

end A256250
