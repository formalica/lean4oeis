import LOEIS.A256.A256999.Defs

set_option linter.unusedVariables false

/-!
# A256999

a(n)=n for n <= 1; for n >= 2, a(n) = largest number that can be obtained by rotating non-msb bits of binary expansion of n (with A080541 or A080542).

The 83 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A256999

/-- Known terms of `A256999`, starting at index `0`. -/
def data : List retType :=
  [0, 1, 2, 3, 4, 6, 6, 7, 8, 12,
    12, 14, 12, 14, 14, 15, 16, 24, 24, 28,
    24, 26, 28, 30, 24, 28, 26, 30, 28, 30,
    30, 31, 32, 48, 48, 56, 48, 52, 56, 60,
    48, 52, 52, 58, 56, 58, 60, 62, 48, 56,
    52, 60, 52, 58, 58, 62, 56, 60, 58, 62,
    60, 62, 62, 63, 64, 96, 96, 112, 96, 104,
    112, 120, 96, 100, 104, 114, 112, 116, 120, 124,
    96, 104, 100]

/-- `A256999` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 83) : A256999 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 83) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 83) : fz n = data[n.toNat]! := sorry

end A256999
