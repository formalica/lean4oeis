import LOEIS.A256.A256160.Defs

set_option linter.unusedVariables false

/-!
# A256160

Index of the n-th 9 in the first occurrence of a string of exactly n 9's in the decimal expansion of Pi.

The 14 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A256160

/-- Known terms of `A256160`, starting at index `1`. -/
def data : List retType :=
  [6, 46, 2952, 17992, 19451, 768, 1722783, 36356650, 564665215, 20148132320,
    27014073315, 897831316568, 10542036048463, 5758910552723]

/-- `A256160` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 15) : A256160 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 15) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 15) : fz n = data[n.toNat - 1]! := sorry

end A256160
