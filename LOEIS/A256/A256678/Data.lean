import LOEIS.A256.A256678.Defs

set_option linter.unusedVariables false

/-!
# A256678

Coefficients of L-series for elliptic curve "34a1": y^2 + x*y = x^3 - 3*x + 1.

The 76 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A256678

/-- Known terms of `A256678`, starting at index `1`. -/
def data : List retType :=
  [1, 1, -2, 1, 0, -2, -4, 1, 1, 0,
    6, -2, 2, -4, 0, 1, -1, 1, -4, 0,
    8, 6, 0, -2, -5, 2, 4, -4, 0, 0,
    -4, 1, -12, -1, 0, 1, -4, -4, -4, 0,
