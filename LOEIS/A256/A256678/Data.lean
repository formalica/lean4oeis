/-- `A256678` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 77) : A256678 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 77) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 77) : fz n = data[n.toNat - 1]! := sorry

end A256678
