import LOEIS.A256.A256113.Defs

set_option linter.unusedVariables false

/-!
# A256113

Table read by rows: T(1,1) = 1, for n > 1: row n = union of distinct prime factors occurring in terms of n-th row of Pascal's triangle, cf. A007318.

The 79 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A256113

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 3, 2, 3, 2, 5, 2, 3, 5,
    3, 5, 7, 2, 5, 7, 2, 3, 7, 2,
    3, 5, 7, 2, 3, 5, 7, 11, 2, 3,
    5, 7, 11, 2, 3, 5, 11, 13, 2, 3,
    7, 11, 13, 3, 5, 7, 11, 13, 2, 3,
    5, 7, 11, 13, 2, 5, 7, 11, 13, 17,
    2, 3, 5, 7, 11, 13, 17, 2, 3, 7,
    11, 13, 17, 19, 2, 3, 5, 11, 13]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 80) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 80) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 80) : flatFz n = flatData[n.toNat - 1]! := sorry

end A256113
