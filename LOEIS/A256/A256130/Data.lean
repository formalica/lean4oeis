import LOEIS.A256.A256130.Defs

set_option linter.unusedVariables false

/-!
# A256130

Number T(n,k) of partitions of n into parts of exactly k sorts which are introduced in ascending order; triangle T(n,k), n>=0, 0<=k<=n, read by rows.

The 66 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A256130

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, 0, 1, 0, 2, 1, 0, 3, 4, 1,
    0, 5, 12, 7, 1, 0, 7, 30, 33, 11,
    1, 0, 11, 72, 130, 77, 16, 1, 0, 15,
    160, 463, 438, 157, 22, 1, 0, 22, 351, 1557,
