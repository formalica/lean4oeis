import LOEIS.A256.A256256.Defs

set_option linter.unusedVariables false

/-!
# A256256

Total number of ON cells after n generations of cellular automaton on triangular grid, starting from a node, in which every 60-degree wedge looks like the Sierpiński's triangle.

The 65 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A256256

/-- Known terms of `A256256`, starting at index `0`. -/
def data : List retType :=
  [0, 6, 18, 30, 54, 66, 90, 114, 162, 174,
    198, 222, 270, 294, 342, 390, 486, 498, 522, 546,
    594, 618, 666, 714, 810, 834, 882, 930, 1026, 1074,
    1170, 1266, 1458, 1470, 1494, 1518, 1566, 1590, 1638, 1686,
    1782, 1806, 1854, 1902, 1998, 2046, 2142, 2238, 2430, 2454,
    2502, 2550, 2646, 2694, 2790, 2886, 3078, 3126, 3222, 3318,
    3510, 3606, 3798, 3990, 4374]

/-- `A256256` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 65) : A256256 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 65) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 65) : fz n = data[n.toNat]! := sorry

end A256256
