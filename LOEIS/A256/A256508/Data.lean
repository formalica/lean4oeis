import LOEIS.A256.A256508.Defs

set_option linter.unusedVariables false

/-!
# A256508

Lexicographically earliest sequence of distinct terms, with a unique fixed point, such that a^n(n)=n, for any n>0 (where a^n denotes the n-th iterate of a).

The 66 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A256508

/-- Known terms of `A256508`, starting at index `1`. -/
def data : List retType :=
  [1, 4, 6, 2, 10, 9, 14, 12, 3, 15,
    22, 8, 26, 21, 20, 18, 34, 16, 38, 25,
    28, 33, 46, 27, 5, 39, 30, 35, 58, 24,
    62, 36, 44, 51, 42, 32, 74, 57, 52, 45,
    82, 49, 86, 55, 50, 69, 94, 54, 7, 60,
    68, 65, 106, 48, 66, 63, 76, 87, 118, 70,
    122, 93, 77, 72, 78, 88]

/-- `A256508` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 67) : A256508 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 67) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 67) : fz n = data[n.toNat - 1]! := sorry

end A256508
