import LOEIS.A256.A256185.Defs

set_option linter.unusedVariables false

/-!
# A256185

Second of two variations by Per Nørgård of his "infinity sequence", cf. A004718: v(0) = 0; v(3*n) = -v(n); v(3*n+1) = v(n) - 3; v(3*n+2) = -2 - v(n).

The 73 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A256185

/-- Known terms of `A256185`, starting at index `0`. -/
def data : List retType :=
  [0, -3, -2, 3, -6, 1, 2, -5, 0, -3,
    0, -5, 6, -9, 4, -1, -2, -3, -2, -1,
    -4, 5, -8, 3, 0, -3, -2, 3, -6, 1,
    0, -3, -2, 5, -8, 3, -6, 3, -8, 9,
    -12, 7, -4, 1, -6, 1, -4, -1, 2, -5,
    0, 3, -6, 1, 2, -5, 0, 1, -4, -1,
    4, -7, 2, -5, 2, -7, 8, -11, 6, -3,
    0, -5, 0]

/-- `A256185` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 73) : A256185 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 73) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 73) : fz n = data[n.toNat]! := sorry

end A256185
