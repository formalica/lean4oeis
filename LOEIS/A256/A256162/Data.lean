import LOEIS.A256.A256162.Defs

set_option linter.unusedVariables false

/-!
# A256162

Positive integers a(n) such that number of digits in decimal expansion of a(n)^a(n) is divisible by a(n).

The 27 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A256162

/-- Known terms of `A256162`, starting at index `1`. -/
def data : List retType :=
  [1, 8, 9, 98, 99, 998, 999, 9998, 9999, 99998,
    99999, 999998, 999999, 9999998, 9999999, 99999998, 99999999, 999999998, 999999999, 9999999998,
    9999999999, 99999999998, 99999999999, 999999999998, 999999999999, 9999999999998, 9999999999999]

/-- `A256162` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 28) : A256162 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 28) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 28) : fz n = data[n.toNat - 1]! := sorry

end A256162
