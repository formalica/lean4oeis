import LOEIS.A256.A256262.Defs

set_option linter.unusedVariables false

/-!
# A256262

Number of successive odd numbers that are not twin primes and number of successive twin primes, interleaved.

The 80 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A256262

/-- Known terms of `A256262`, starting at index `1`. -/
def data : List retType :=
  [1, 3, 1, 2, 1, 2, 4, 2, 4, 2,
    7, 2, 4, 2, 13, 2, 1, 2, 13, 2,
    4, 2, 13, 2, 4, 2, 1, 2, 13, 2,
    4, 2, 13, 2, 4, 2, 13, 2, 16, 2,
    34, 2, 4, 2, 13, 2, 28, 2, 22, 2,
    13, 2, 7, 2, 10, 2, 7, 2, 73, 2,
    4, 2, 1, 2, 13, 2, 10, 2, 67, 2,
    4, 2, 7, 2, 4, 2, 13, 2, 28, 2]

/-- `A256262` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 81) : A256262 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 81) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 81) : fz n = data[n.toNat - 1]! := sorry

end A256262
