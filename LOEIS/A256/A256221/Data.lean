/-!
# A256221

Number of distinct nonzero Fibonacci numbers in the numerator of the 2^n sums generated from the set 1, 1/2, 1/3, ..., 1/n.

The 32 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A256221

/-- Known terms of `A256221`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 3, 4, 5, 6, 8, 8, 8, 12,
    12, 13, 13, 13, 13, 15, 15, 15, 17, 17,
    17, 19, 21, 21, 23, 24, 25, 25, 25, 25,
    25, 27]

/-- `A256221` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 33) : A256221 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 33) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 33) : fz n = data[n.toNat - 1]! := sorry

end A256221
