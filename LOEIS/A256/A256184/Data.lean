def data : List retType :=
  [0, -2, -1, 2, -4, -3, 1, -3, -2, -2,
    0, 1, 4, -6, -5, 3, -5, -4, -1, -1,
    0, 3, -5, -4, 2, -4, -3, 2, -4, -3,
    0, -2, -1, -1, -1, 0, -4, 2, 3, 6,
    -8, -7, 5, -7, -6, -3, 1, 2, 5, -7,
    -6, 4, -6, -5, 1, -3, -2, 1, -3, -2,
