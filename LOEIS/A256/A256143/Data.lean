import LOEIS.A256.A256143.Defs

set_option linter.unusedVariables false

/-!
# A256143

Fibonacci Mutant Bunnies. Start at 1,1,1 and, at each step, either add the last three elements or take the difference of the last two. a(n) is equal to the minimum number of steps to get to n.

The 82 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A256143

/-- Known terms of `A256143`, starting at index `0`. -/
def data : List retType :=
  [1, 0, 2, 1, 4, 2, 3, 6, 5, 3,
    4, 4, 5, 7, 6, 6, 6, 4, 5, 5,
    6, 8, 6, 7, 7, 8, 7, 7, 7, 6,
    8, 5, 8, 7, 6, 8, 6, 8, 7, 10,
    8, 10, 9, 9, 8, 9, 9, 10, 8, 9,
    8, 8, 9, 7, 9, 9, 7, 6, 8, 7,
    9, 8, 7, 11, 9, 8, 7, 9, 8, 10,
    10, 11, 8, 10, 10, 9, 9, 10, 10, 11,
    10, 10]

/-- `A256143` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 82) : A256143 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
