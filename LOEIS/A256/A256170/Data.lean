import LOEIS.A256.A256170.Defs

set_option linter.unusedVariables false

/-!
# A256170

Irregular triangle where the n-th row contains the binary representations of the factors of the member of GF(2)[x] whose binary representation is n.

The 76 terms known to OEIS, indexed from `2`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A256170

/-- Known terms of `flat`, starting at index `2`. -/
def flatData : List flatRetType :=
  [2, 3, 2, 2, 3, 3, 2, 3, 7, 2,
    2, 2, 3, 7, 2, 3, 3, 11, 2, 2,
    3, 13, 2, 7, 3, 3, 3, 2, 2, 2,
    2, 3, 3, 3, 3, 2, 3, 7, 19, 2,
    2, 3, 3, 7, 7, 2, 11, 3, 13, 2,
    2, 2, 3, 25, 2, 13, 3, 3, 7, 2,
    2, 7, 3, 11, 2, 3, 3, 3, 31, 2,
    2, 2, 2, 2, 3, 31]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 78) : flat n = flatData[n.val - 2]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 2 ≤ n) (h : n < 78) : flatFn n = flatData[n - 2]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 2 ≤ n) (h : n < 78) : flatFz n = flatData[n.toNat - 2]! := sorry

end A256170
