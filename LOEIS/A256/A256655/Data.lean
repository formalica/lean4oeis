import LOEIS.A256.A256655.Defs

set_option linter.unusedVariables false

/-!
# A256655

R(k), the minimal alternating Fibonacci representation of k, concatenated for k = 0, 1, 2,....

The 69 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A256655

/-- Known terms of `A256655`, starting at index `0`. -/
def data : List retType :=
  [0, 1, 2, 3, 5, -1, 5, 8, -2, 8,
    -1, 8, 13, -5, 1, 13, -3, 13, -2, 13,
    -1, 13, 21, -8, 1, 21, -8, 2, 21, -5,
    21, -5, 1, 21, -3, 21, -2, 21, -1, 21,
    34, -13, 1, 34, -13, 2, 34, -13, 3, 34,
    -13, 5, -1, 34, -8, 34, -8, 1, 34, -8,
    2, 34, -5, 34, -5, 1, 34, -3, 34]

/-- `A256655` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 69) : A256655 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 69) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 69) : fz n = data[n.toNat]! := sorry

end A256655
