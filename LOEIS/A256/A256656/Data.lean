import LOEIS.A256.A256656.Defs

set_option linter.unusedVariables false

/-!
# A256656

Numbers for which the minimal alternating Fibonacci representation has positive trace.

The 63 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A256656

/-- Known terms of `A256656`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 3, 5, 8, 9, 13, 14, 15, 17,
    21, 22, 23, 24, 27, 28, 30, 34, 35, 36,
    37, 39, 43, 44, 45, 48, 49, 51, 55, 56,
    57, 58, 60, 63, 64, 69, 70, 71, 73, 77,
    78, 79, 82, 83, 85, 89, 90, 91, 92, 94,
    97, 98, 102, 103, 104, 106, 111, 112, 113, 115,
    118, 119, 124]

/-- `A256656` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 64) : A256656 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 64) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 64) : fz n = data[n.toNat - 1]! := sorry

end A256656
