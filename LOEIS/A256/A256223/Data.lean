import LOEIS.A256.A256223.Defs

set_option linter.unusedVariables false

/-!
# A256223

Smallest Fibonacci number not occurring in the numerator of the 2^n sums generated from the set 1, 1/2, 1/3,..., 1/n.

The 48 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A256223

/-- Known terms of `A256223`, starting at index `0`. -/
def data : List retType :=
  [1, 2, 2, 2, 2, 2, 21, 21, 21, 21,
    34, 34, 144, 144, 144, 144, 144, 144, 144, 144,
    144, 144, 987, 987, 987, 987, 987, 987, 987, 987,
    987, 987, 46368, 46368, 46368, 46368, 46368, 46368, 46368, 46368,
    46368, 832040, 832040, 832040, 832040, 832040, 832040, 832040]

/-- `A256223` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 48) : A256223 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 48) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 48) : fz n = data[n.toNat]! := sorry

end A256223
