import LOEIS.A256.A256128.Defs

set_option linter.unusedVariables false

/-!
# A256128

Decimal expansion of the third Malmsten integral: int_{x=1..infinity} log(log(x))/(1 - x + x^2) dx, negated.

The 105 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A256128

/-- Known terms of `A256128`, starting at index `0`. -/
def data : List retType :=
  [6, 7, 1, 7, 1, 9, 6, 0, 1, 8,
    8, 5, 8, 7, 4, 5, 4, 2, 3, 5,
    4, 4, 0, 5, 0, 6, 9, 2, 8, 8,
    7, 7, 9, 8, 8, 4, 0, 0, 8, 8,
    0, 2, 0, 6, 6, 2, 1, 9, 3, 5,
    6, 3, 3, 2, 0, 5, 3, 6, 1, 6,
    7, 3, 3, 7, 5, 1, 2, 5, 1, 2,
    1, 7, 1, 7, 5, 8, 6, 1, 9, 0,
    2, 1, 8, 3, 2, 6, 7, 1, 2, 6,
    8, 6, 2, 9, 3, 2, 3, 7, 2, 3,
    5, 5, 0, 3, 6]

/-- `A256128` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 105) : A256128 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 105) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 105) : fz n = data[n.toNat]! := sorry

end A256128
