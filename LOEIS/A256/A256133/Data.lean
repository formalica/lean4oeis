import LOEIS.A256.A256133.Defs

set_option linter.unusedVariables false

/-!
# A256133

Numbers that have unique expansion with minimal digit sum in terms of Fibonacci numbers F_k (k > 1).

The 65 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A256133

/-- Known terms of `A256133`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 3, 5, 7, 8, 9, 11, 13, 14,
    15, 18, 20, 21, 22, 23, 24, 29, 30, 32,
    34, 35, 36, 37, 39, 41, 47, 48, 49, 52,
    54, 55, 56, 57, 58, 60, 62, 63, 64, 66,
    76, 77, 78, 79, 84, 85, 87, 89, 90, 91,
    92, 94, 96, 97, 98, 100, 102, 103, 104, 107,
    109, 123, 124, 125, 126]

/-- `A256133` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 66) : A256133 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 66) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 66) : fz n = data[n.toNat - 1]! := sorry

end A256133
