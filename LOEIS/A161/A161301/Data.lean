    105, 116, 118, 130, 134, 144, 147, 160]

/-- `A161301` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 89) : A161301 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 89) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 89) : fz n = data[n.toNat - 1]! := sorry

end A161301
