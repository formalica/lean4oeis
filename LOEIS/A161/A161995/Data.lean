import LOEIS.A161.A161995.Defs

set_option linter.unusedVariables false

/-!
# A161995

a(n) represents the minimum number k, not already present in the sequence, whose digit sum is equal to the digital root of Sum_{j=0..n-1} a(j), with a(0)=0 and a(1)=1.

The 55 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A161995

/-- Known terms of `A161995`, starting at index `0`. -/
def data : List retType :=
  [0, 1, 10, 2, 4, 8, 7, 5, 100, 11,
    13, 17, 16, 14, 1000, 20, 22, 26, 25, 23,
    10000, 101, 31, 35, 34, 32, 100000, 110, 40, 44,
    43, 41, 1000000, 200, 103, 53, 52, 50, 10000000, 1001,
    112, 62, 61, 104, 100000000, 1010, 121, 71, 70, 113,
    1000000000, 1100, 130, 80, 106]

/-- `A161995` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 55) : A161995 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 55) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 55) : fz n = data[n.toNat]! := sorry

end A161995
