/-!
# A161324

Let b(m,k) be the k-th binary digit (starting at k=1, reading right to left) in the base-2 representation of m. (So: n = Sum_{k>=0} b(k+1)*2^k.) A positive integer m is included in this sequence if and only if m = Product_{k>=1} k^b(m,k).

The 5 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A161324

/-- Known terms of `A161324`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 6, 12, 576000]

/-- `A161324` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 6) : A161324 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 6) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 6) : fz n = data[n.toNat - 1]! := sorry

end A161324
