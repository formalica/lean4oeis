/-!
# A161904

Array read by rows in which row n list the divisors of n, but if n is a square then the square root of n appears repeated. Also, the divisors appear as pairs (a,b), where a <= b, such that a*b = n.

The 74 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A161904

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 2, 1, 3, 1, 4, 2, 2,
    1, 5, 1, 6, 2, 3, 1, 7, 1, 8,
    2, 4, 1, 9, 3, 3, 1, 10, 2, 5,
    1, 11, 1, 12, 2, 6, 3, 4, 1, 13,
    1, 14, 2, 7, 1, 15, 3, 5, 1, 16,
    2, 8, 4, 4, 1, 17, 1, 18, 2, 9,
    3, 6, 1, 19, 1, 20, 2, 10, 4, 5,
    1, 21, 3, 7]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 75) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
