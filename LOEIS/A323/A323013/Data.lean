import LOEIS.A323.A323013.Defs

set_option linter.unusedVariables false

/-!
# A323013

Form of Zorach additive triangle T(n,k) (see A035312) where each number is sum of west and northwest numbers, with the additional condition that the first element T(n,1) is a Fibonacci number.

The 55 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A323013

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 3, 5, 7, 10, 8, 13, 20, 30,
    21, 29, 42, 62, 92, 34, 55, 84, 126, 188,
    280, 89, 123, 178, 262, 388, 576, 856, 144, 233,
    356, 534, 796, 1184, 1760, 2616, 377, 521, 754, 1110,
    1644, 2440, 3624, 5384, 8000, 610, 987, 1508, 2262, 3372,
    5016, 7456, 11080, 16464, 24464]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 56) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 56) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 56) : flatFz n = flatData[n.toNat - 1]! := sorry

end A323013
