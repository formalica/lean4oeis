import LOEIS.A220.A220354.Defs

set_option linter.unusedVariables false

/-!
# A220354

Irregular triangle T(n,k), read by rows; row n gives coefficients in expansion of P_n(x), which is defined by: P_0(x) = 1, P_n(x) = P_(n-1)(x)+x if n odd, P_n(x) = P_(n-1)(x)*x if n even.

The 87 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A220354

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 0, 1, 1, 0, 2, 1, 0,
    0, 2, 1, 0, 1, 2, 1, 0, 0, 1,
    2, 1, 0, 1, 1, 2, 1, 0, 0, 1,
    1, 2, 1, 0, 1, 1, 1, 2, 1, 0,
    0, 1, 1, 1, 2, 1, 0, 1, 1, 1,
    1, 2, 1, 0, 0, 1, 1, 1, 1, 2,
    1, 0, 1, 1, 1, 1, 1, 2, 1, 0,
    0, 1, 1, 1, 1, 1, 2, 1, 0, 1,
    1, 1, 1, 1, 1, 2, 1]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 87) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 87) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 87) : flatFz n = flatData[n.toNat]! := sorry

end A220354
