def data : List retType :=
  [0, 3, 9, 7, 17, 23, 34, 15, 33, 39,
    55, 47, 66, 88, 72, 31, 65, 71, 103, 79,
    133, 111, 152, 95, 130, 136, 215, 176, 277, 144,
