import LOEIS.A220.A220406.Defs

set_option linter.unusedVariables false

/-!
# A220406

T(n,k)=Equals two maps: number of nXk binary arrays indicating the locations of corresponding elements equal to exactly two of their horizontal, diagonal and antidiagonal neighbors in a random 0..1 nXk array.

The 49 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A220406

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 2, 6, 1, 4, 17, 23, 1,
    7, 40, 122, 78, 1, 12, 93, 908, 720, 292,
    1, 21, 206, 6013, 10989, 4304, 1066, 1, 37, 431,
