import LOEIS.A085.A085143.Defs

set_option linter.unusedVariables false

/-!
# A085143

Triangle table from number wall of reversion of Fibonacci numbers.

The 59 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A085143

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, -1, -1, -1, -1, -1, 1, 0, 2, 1,
    1, -2, 4, 3, 1, -1, 3, -11, -5, -5,
    -1, -1, -1, -34, 10, -20, -8, -1, 1, 11,
    106, -116, 96, 44, 13, 1, 1, 15, 368, -328,
    716, 86, 125, 21, 1, -1, 13, -1324, -1344, -5634,
    1866, -1063, -316, -34, -1, -1, 77, -4811, -17235]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 60) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 60) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 60) : flatFz n = flatData[n.toNat - 1]! := sorry

end A085143
