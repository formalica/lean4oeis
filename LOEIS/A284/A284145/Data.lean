import LOEIS.A284.A284145.Defs

set_option linter.unusedVariables false

/-!
# A284145

Triangle read by rows T(n,k) in which each term is the least positive integer not yet appearing in the triangle that is coprime to all the terms in its associated row, column, diagonal and antidiagonal.

The 66 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A284145

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 3, 5, 7, 4, 9, 11, 13, 17,
    19, 8, 21, 23, 25, 29, 31, 37, 16, 27,
    41, 43, 47, 53, 35, 59, 61, 67, 49, 71,
    73, 33, 79, 83, 85, 89, 97, 101, 95, 103,
    14, 107, 109, 113, 121, 127, 131, 137, 139, 143,
