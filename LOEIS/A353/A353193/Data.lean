import LOEIS.A353.A353193.Defs

set_option linter.unusedVariables false

/-!
# A353193

The row numbers of the Trithoff (tribonacci) array that don't correspond to difference sequences of other rows of the Trithoff array.

The 72 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A353193

/-- Known terms of `A353193`, starting at index `1`. -/
def data : List retType :=
  [1, 5, 6, 8, 9, 10, 13, 14, 15, 18,
    22, 23, 24, 27, 31, 32, 36, 37, 39, 40,
    41, 44, 48, 49, 53, 54, 56, 57, 58, 62,
    63, 65, 66, 67, 70, 71, 72, 75, 79, 80,
    84, 85, 87, 88, 89, 93, 94, 96, 97, 98,
