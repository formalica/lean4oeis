import LOEIS.A353.A353322.Defs

set_option linter.unusedVariables false

/-!
# A353322

A variant of Van Eck's sequence where we only consider powers of 2: for n >= 0, if a(n) = a(n-2^e) for some e, take the least such e and set a(n+1) = 2^e; otherwise a(n+1) = 0. Start with a(1) = 0.

The 87 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A353322

/-- Known terms of `A353322`, starting at index `1`. -/
def data : List retType :=
  [0, 0, 1, 0, 2, 0, 2, 2, 1, 0,
    4, 0, 2, 8, 0, 0, 1, 8, 4, 8,
    2, 8, 2, 2, 1, 8, 4, 8, 2, 8,
    2, 2, 1, 8, 4, 8, 2, 8, 2, 2,
    1, 8, 4, 8, 2, 8, 2, 2, 1, 8,
    4, 8, 2, 8, 2, 2, 1, 8, 4, 8,
    2, 8, 2, 2, 1, 8, 4, 8, 2, 8,
    2, 2, 1, 8, 4, 8, 2, 8, 2, 2,
    1, 8, 4, 8, 2, 8, 2]

/-- `A353322` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 88) : A353322 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 88) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 88) : fz n = data[n.toNat - 1]! := sorry

end A353322
