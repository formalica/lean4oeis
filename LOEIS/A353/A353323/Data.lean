import LOEIS.A353.A353323.Defs

set_option linter.unusedVariables false

/-!
# A353323

A variant of Van Eck's sequence where we only consider powers of 3: for n >= 0, if a(n) = a(n-3^e) for some e, take the least such e and set a(n+1) = 3^e; otherwise a(n+1) = 0. Start with a(1) = 0.

The 84 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A353323

/-- Known terms of `A353323`, starting at index `1`. -/
def data : List retType :=
  [0, 0, 1, 0, 3, 0, 0, 1, 0, 3,
    0, 9, 0, 9, 0, 9, 0, 0, 1, 0,
    3, 0, 9, 9, 1, 0, 9, 3, 0, 3,
    9, 0, 3, 3, 1, 27, 0, 0, 1, 0,
    3, 0, 27, 0, 27, 9, 0, 3, 27, 0,
    3, 3, 1, 0, 0, 1, 3, 9, 27, 0,
    0, 1, 9, 0, 3, 0, 0, 1, 0, 3,
    0, 27, 27, 1, 0, 9, 0, 27, 0, 0,
    1, 0, 3, 0]

/-- `A353323` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 85) : A353323 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 85) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 85) : fz n = data[n.toNat - 1]! := sorry

end A353323
