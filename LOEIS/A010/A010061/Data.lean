import LOEIS.A010.A010061.Defs

set_option linter.unusedVariables false

/-!
# A010061

Binary self or Colombian numbers: numbers that cannot be expressed as the sum of distinct terms of the form 2^k+1 (k>=0), or equivalently, numbers not of form m + sum of binary digits of m.

The 58 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A010061

/-- Known terms of `A010061`, starting at index `1`. -/
def data : List retType :=
  [1, 4, 6, 13, 15, 18, 21, 23, 30, 32,
    37, 39, 46, 48, 51, 54, 56, 63, 71, 78,
    80, 83, 86, 88, 95, 97, 102, 104, 111, 113,
    116, 119, 121, 128, 130, 133, 135, 142, 144, 147,
    150, 152, 159, 161, 166, 168, 175, 177, 180, 183,
    185, 192, 200, 207, 209, 212, 215, 217]

/-- `A010061` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 59) : A010061 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 59) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 59) : fz n = data[n.toNat - 1]! := sorry

end A010061
