def flatData : List flatRetType :=
  [2, 1, 4, 8, 12, 16, 3, 9, 10, 11,
    18, 24, 26, 32, 34, 17, 25, 33, 40, 41,
    48, 56, 64, 72, 80, 88, 96, 104, 5, 6,
