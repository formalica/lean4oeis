    8, 16, 16, 32, 32, 1, 1, 2, 2, 4,
    4, 8, 8, 16, 16, 32, 32, 64]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 88) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 88) : flatFn n = flatData[n]! := sorry

