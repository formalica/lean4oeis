set_option linter.unusedVariables false

/-!
# A113453

Triangle giving maximal permanent P(n,k) of an n X n lower Hessenberg (0,1)-matrix with exactly k 1's for 2 <= n <= k <= 2n, read by rows.

The 88 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A113453

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, 1, 2, 1, 1, 2, 2, 1, 1, 2,
    2, 4, 1, 1, 2, 2, 4, 4, 1, 1,
    2, 2, 4, 4, 8, 1, 1, 2, 2, 4,
    4, 8, 8, 1, 1, 2, 2, 4, 4, 8,
    8, 16, 1, 1, 2, 2, 4, 4, 8, 8,
