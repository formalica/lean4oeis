import LOEIS.A007.A007886.Defs

set_option linter.unusedVariables false

/-!
# A007886

Number of cycles induced by iterating the Gray-coding of an n-bit number: a(n+1) = a(n) + 2^n/C_n, where C_n = least power of 2 >= n (C_n is the length of the cycle), with a(0) = 1.

The 36 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A007886

/-- Known terms of `A007886`, starting at index `0`. -/
def data : List retType :=
  [1, 2, 3, 4, 6, 8, 12, 20, 36, 52,
    84, 148, 276, 532, 1044, 2068, 4116, 6164, 10260, 18452,
    34836, 67604, 133140, 264212, 526356, 1050644, 2099220, 4196372, 8390676, 16779284,
    33556500, 67110932, 134219796, 201328660, 335546388, 603981844]

/-- `A007886` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 36) : A007886 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 36) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 36) : fz n = data[n.toNat]! := sorry

end A007886
