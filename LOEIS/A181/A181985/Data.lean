    1, 1, 19, 61, 1, 1, 1, 69, 1513, 1385,
    1, 1, 1, 251, 33661, 315523, 50521, 1, 1, 1,
    923, 750751, 60376809, 136085041, 2702765, 1, 1, 1, 3431, 17116009,
