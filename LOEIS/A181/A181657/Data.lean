def flatData : List flatRetType :=
  [1, 1, 1, 1, 1, 1, 3, 2, 1, 1,
    3, 2, 1, 1, 1, 7, 5, 3, 2, 1,
    1, 7, 5, 3, 2, 1, 1, 1, 17, 12,
    7, 5, 3, 2, 1, 1, 17, 12, 7, 5,
    3, 2, 1, 1, 1, 41, 29, 17, 12, 7,
