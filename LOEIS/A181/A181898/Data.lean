  [10, 19, 92, 417, 851, 4237, 14771, 73237, 298609]

/-- `A181898` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 9) : A181898 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 9) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 9) : fz n = data[n.toNat]! := sorry

end A181898
