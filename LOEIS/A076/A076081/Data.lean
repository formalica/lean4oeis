import LOEIS.A076.A076081.Defs

set_option linter.unusedVariables false

/-!
# A076081

Rearrange numbers from 1 to n: start with the divisors of n in ascending order followed by numbers in ascending order which leave a remainder 1 on dividing by n, followed by those leaving remainder 2 ... up to remainder [(n-1)/2].

The 99 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A076081

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 2, 1, 3, 2, 1, 2, 4, 3,
    1, 5, 2, 4, 3, 1, 2, 3, 6, 5,
    4, 1, 7, 2, 3, 6, 5, 4, 1, 2,
    4, 8, 7, 3, 6, 5, 1, 3, 9, 2,
    4, 8, 7, 6, 5, 1, 2, 5, 10, 3,
    9, 4, 8, 7, 6, 1, 11, 2, 5, 10,
    3, 9, 4, 8, 7, 6, 1, 2, 3, 4,
    6, 12, 11, 5, 10, 9, 8, 7, 1, 13,
    2, 3, 4, 6, 12, 11, 5, 10, 9, 8,
    7, 1, 2, 7, 14, 13, 3, 4, 6]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 100) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 100) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 100) : flatFz n = flatData[n.toNat - 1]! := sorry

end A076081
