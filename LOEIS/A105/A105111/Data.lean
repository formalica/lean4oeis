import LOEIS.A105.A105111.Defs

set_option linter.unusedVariables false

/-!
# A105111

Triangle read by rows, based on the morphism f: 1->2, 2->3, 3->{3,5,4}, 4->5, 5->6, 6->{6,2,1}. First row is 1. If current row is a,b,c,..., then the next row is a,b,c,...,f(a),f(b),f(c),...

The 105 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A105111

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, 1, 2, 1, 2, 2, 3, 1, 2, 2,
    3, 2, 3, 3, 3, 5, 4, 1, 2, 2,
    3, 2, 3, 3, 3, 5, 4, 2, 3, 3,
    3, 5, 4, 3, 3, 5, 4, 3, 5, 4,
    3, 5, 4, 6, 5, 1, 2, 2, 3, 2,
    3, 3, 3, 5, 4, 2, 3, 3, 3, 5,
    4, 3, 3, 5, 4, 3, 5, 4, 3, 5,
    4, 6, 5, 2, 3, 3, 3, 5, 4, 3,
    3, 5, 4, 3, 5, 4, 3, 5, 4, 6,
    5, 3, 3, 5, 4, 3, 5, 4, 3, 5,
    4, 6, 5, 3, 5]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 105) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 105) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 105) : flatFz n = flatData[n.toNat]! := sorry

end A105111
