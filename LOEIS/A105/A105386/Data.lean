The 26 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A105386

/-- Known terms of `A105386`, starting at index `1`. -/
def data : List retType :=
  [1, 8, 10, 4, 0, 2, 6, 0, 0, 7,
    5, 4, 3, 2, 7, 6, 13, 2, 0, 1,
    1, 1, 3, 9, 11, 12]

/-- `A105386` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 27) : A105386 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 27) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 27) : fz n = data[n.toNat - 1]! := sorry

end A105386
