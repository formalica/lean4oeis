    2, 1, 4, 2, 4]

/-- `A105256` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 105) : A105256 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
