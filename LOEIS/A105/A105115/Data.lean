import LOEIS.A105.A105115.Defs

set_option linter.unusedVariables false

/-!
# A105115

Numbers k such that the decimal representation of 1/k is neither terminating nor purely repeating.

The 64 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A105115

/-- Known terms of `A105115`, starting at index `1`. -/
def data : List retType :=
  [6, 12, 14, 15, 18, 22, 24, 26, 28, 30,
    34, 35, 36, 38, 42, 44, 45, 46, 48, 52,
    54, 55, 56, 58, 60, 62, 65, 66, 68, 70,
    72, 74, 75, 76, 78, 82, 84, 85, 86, 88,
    90, 92, 94, 95, 96, 98, 102, 104, 105, 106,
    108, 110, 112, 114, 115, 116, 118, 120, 122, 124,
    126, 130, 132, 134]

/-- `A105115` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 65) : A105115 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 65) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 65) : fz n = data[n.toNat - 1]! := sorry

end A105115
