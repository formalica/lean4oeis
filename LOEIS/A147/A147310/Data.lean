import LOEIS.A147.A147310.Defs

set_option linter.unusedVariables false

/-!
# A147310

A golden mean based polynomials set that behaves like an even powered Pascal triangle: p(x,n) = (x - phi)^floor(n/2)*(x + phi)^floor(n/2).

The 61 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A147310

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 0, -1, 1, 0, -1, 1, 0,
    -2, 0, 1, 1, 0, -2, 0, 1, 1, 0,
    -3, 0, 3, 0, -1, 1, 0, -3, 0, 3,
    0, -1, 1, 0, -4, 0, 6, 0, -4, 0,
    1, 1, 0, -4, 0, 6, 0, -4, 0, 1,
    1, 0, -5, 0, 10, 0, -10, 0, 5, 0,
    -1]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 61) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 61) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 61) : flatFz n = flatData[n.toNat]! := sorry

end A147310
