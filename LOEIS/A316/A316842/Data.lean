import LOEIS.A316.A316842.Defs

set_option linter.unusedVariables false

/-!
# A316842

Three-column table read by rows giving primitive integer sides of proper triangles (i,j,k) with i >= j >= k >= 1, j+k > i, gcd(i,j,k) = 1.

The 120 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A316842

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 2, 2, 1, 3, 2, 2, 3,
    3, 1, 3, 3, 2, 4, 3, 2, 4, 3,
    3, 4, 4, 1, 4, 4, 3, 5, 3, 3,
    5, 4, 2, 5, 4, 3, 5, 4, 4, 5,
