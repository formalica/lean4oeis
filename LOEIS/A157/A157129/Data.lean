import LOEIS.A157.A157129.Defs

set_option linter.unusedVariables false

/-!
# A157129

An analog of the Kolakoski sequence  A000002, only now a(n) = (length of n-th run divided by 2) using 1 and 2 and starting with 1,1.

The 105 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A157129

/-- Known terms of `A157129`, starting at index `1`. -/
def data : List retType :=
  [1, 1, 2, 2, 1, 1, 1, 1, 2, 2,
    2, 2, 1, 1, 2, 2, 1, 1, 2, 2,
    1, 1, 1, 1, 2, 2, 2, 2, 1, 1,
    1, 1, 2, 2, 2, 2, 1, 1, 2, 2,
    1, 1, 1, 1, 2, 2, 2, 2, 1, 1,
    2, 2, 1, 1, 1, 1, 2, 2, 2, 2,
    1, 1, 2, 2, 1, 1, 2, 2, 1, 1,
    1, 1, 2, 2, 2, 2, 1, 1, 1, 1,
    2, 2, 2, 2, 1, 1, 2, 2, 1, 1,
    2, 2, 1, 1, 1, 1, 2, 2, 2, 2,
    1, 1, 1, 1, 2]

/-- `A157129` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 106) : A157129 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 106) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 106) : fz n = data[n.toNat - 1]! := sorry

end A157129
