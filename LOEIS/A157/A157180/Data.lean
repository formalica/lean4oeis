import LOEIS.A157.A157180.Defs

set_option linter.unusedVariables false

/-!
# A157180

A new general triangle sequence based on the Eulerian form in three parts ( subtraction):m=2; t0(n,k)=If[n*k == 0, 1, Sum[(-1)^j Binomial[n + 1, j](k + 1 - j)^n, {j, 0, k + 1}]] t(n,k,m)=If[n == 0, 1, ( m*(n - k) + 1)*t0(n - 1 + 1, k - 1) + (m*k + 1)*t0(n - 1 + 1, k) - m*k*(n - k)*t0(n - 2 + 1, k - 1)].

The 53 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A157180

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 1, 4, 1, 1, 13, 13, 1,
    1, 34, 78, 34, 1, 1, 79, 380, 380, 79,
    1, 1, 172, 1607, 3040, 1607, 172, 1, 1, 361,
    6135, 20383, 20383, 6135, 361, 1, 1, 742, 21796, 120826,
    203830, 120826, 21796, 742, 1, 1, 1507, 73654, 652994, 1751524,
    1751524, 652994, 73654]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 53) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 53) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 53) : flatFz n = flatData[n.toNat]! := sorry

end A157180
