/-!
# A142147

Irregular triangle read by rows: first row is 1, and the n-th row gives the coefficients in the expansion of (1/2*x)*(1 - 2*x*(1 - x))^(n + 1)*Li(-n, 2*x*(1 - x)), where Li(n, z) is the polylogarithm.

The 53 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A142147

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, 1, -1, 1, 1, -4, 2, 1, 7, -12,
    -4, 12, -4, 1, 21, 0, -102, 100, 4, -32,
    8, 1, 51, 160, -532, -24, 904, -672, 48, 80,
    -16, 1, 113, 980, -1094, -5128, 8760, -736, -6224, 3920,
    -432, -192, 32, 1, 239, 4284, 5276, -43964, 19764, 90272,
    -114080, 19824, 36304]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 53) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
