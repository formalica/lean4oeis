import LOEIS.A033.A033186.Defs

set_option linter.unusedVariables false

/-!
# A033186

Remove all 2's from decimal expansion of Pi, then all 3's, ..., then all 11's, ... (running through primes in order) with the restriction that only digits contiguous in the original expansion are removed.

The 87 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A033186

/-- Known terms of `A033186`, starting at index `1`. -/
def data : List retType :=
  [1, 9, 6, 9, 8, 4, 6, 6, 4, 8,
    9, 0, 8, 8, 4, 1, 6, 9, 9, 9,
    1, 0, 8, 0, 9, 4, 9, 4, 4, 9,
    0, 8, 1, 6, 4, 0, 6, 8, 6, 0,
    9, 8, 6, 8, 0, 4, 8, 4, 0, 6,
    9, 8, 1, 4, 8, 0, 8, 6, 1, 8,
    0, 6, 6, 4, 0, 9, 0, 8, 1, 9,
    4, 0, 8, 1, 8, 4, 8, 1, 4, 0,
    8, 0, 0, 8, 0, 9, 6]

/-- `A033186` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 88) : A033186 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 88) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 88) : fz n = data[n.toNat - 1]! := sorry

end A033186
