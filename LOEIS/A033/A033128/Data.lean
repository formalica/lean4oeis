import LOEIS.A033.A033128.Defs

set_option linter.unusedVariables false

/-!
# A033128

Decimal expansion of a(n) is given by the first n terms of the periodic sequence with initial period 1,0,1.

The 20 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A033128

/-- Known terms of `A033128`, starting at index `1`. -/
def data : List retType :=
  [1, 10, 101, 1011, 10110, 101101, 1011011, 10110110, 101101101, 1011011011,
    10110110110, 101101101101, 1011011011011, 10110110110110, 101101101101101, 1011011011011011, 10110110110110110, 101101101101101101, 1011011011011011011, 10110110110110110110]

/-- `A033128` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 21) : A033128 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 21) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 21) : fz n = data[n.toNat - 1]! := sorry

end A033128
