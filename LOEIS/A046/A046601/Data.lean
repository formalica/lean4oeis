/-!
# A046601

First numerator and then denominator of the 1/5-Pascal triangle (by row). To get a 1/5-Pascal triangle, replace "2" in the third row of the Pascal triangle with "1/5" and calculate all other rows as in the Pascal triangle.

The 86 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A046601

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 1, 1, 1, 1, 1, 1, 5,
    1, 1, 1, 1, 6, 5, 6, 5, 1, 1,
    1, 1, 11, 5, 12, 5, 11, 5, 1, 1,
    1, 1, 16, 5, 23, 5, 23, 5, 16, 5,
    1, 1, 1, 1, 21, 5, 39, 5, 46, 5,
    39, 5, 21, 5, 1, 1, 1, 1, 26, 5,
    12, 1, 17, 1, 17, 1, 12, 1, 26, 5,
    1, 1, 1, 1, 31, 5, 86, 5, 29, 1,
    34, 1, 29, 1, 86, 5]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 87) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 87) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
