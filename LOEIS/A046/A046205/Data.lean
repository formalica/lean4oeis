/-!
# A046205

In Leibniz's Harmonic Triangle, write numerator first and then denominator of each element.

The 85 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A046205

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 2, 1, 2, 1, 3, 1, 6,
    1, 3, 1, 4, 1, 12, 1, 12, 1, 4,
    1, 5, 1, 20, 1, 30, 1, 20, 1, 5,
    1, 6, 1, 30, 1, 60, 1, 60, 1, 30,
    1, 6, 1, 7, 1, 42, 1, 105, 1, 140,
    1, 105, 1, 42, 1, 7, 1, 8, 1, 56,
    1, 168, 1, 280, 1, 280, 1, 168, 1, 56,
    1, 8, 1, 9, 1, 72, 1, 252, 1, 504,
    1, 630, 1, 504, 1]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 86) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 86) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 86) : flatFz n = flatData[n.toNat - 1]! := sorry

end A046205
