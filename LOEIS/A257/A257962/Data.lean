import LOEIS.A257.A257962.Defs

set_option linter.unusedVariables false

/-!
# A257962

List of successive permutations of the numbers [0,F(n)) achieved by writing the numbers in the Fibonacci/Zeckendorf radix in the form of an (n-2)-bit string, reversing that string, and extracting the numerical value according to Fibonacci/Zeckendorf radix.

The 77 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A257962

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [0, 0, 1, 0, 2, 1, 0, 3, 2, 1,
    4, 0, 5, 3, 2, 7, 1, 6, 4, 0,
    8, 5, 3, 11, 2, 10, 7, 1, 9, 6,
    4, 12, 0, 13, 8, 5, 18, 3, 16, 11,
    2, 15, 10, 7, 20, 1, 14, 9, 6, 19,
    4, 17, 12, 0, 21, 13, 8, 29, 5, 26,
    18, 3, 24, 16, 11, 32, 2, 23, 15, 10,
    31, 7, 28, 20, 1, 22, 14]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 77) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 77) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 77) : flatFz n = flatData[n.toNat]! := sorry

end A257962
