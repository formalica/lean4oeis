import LOEIS.A257.A257339.Defs

set_option linter.unusedVariables false

/-!
# A257339

Arrange numbers in a single clockwise spiral so that each number is relatively prime to its eight neighbors.

The 66 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A257339

/-- Known terms of `A257339`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 3, 5, 4, 7, 6, 11, 9, 13,
    17, 19, 8, 23, 29, 21, 25, 31, 37, 41,
    35, 43, 47, 10, 49, 12, 53, 14, 15, 59,
    27, 55, 39, 16, 61, 22, 51, 67, 18, 65,
    24, 71, 26, 33, 32, 57, 73, 79, 83, 77,
    85, 89, 97, 101, 28, 95, 34, 91, 38, 103,
    107, 45, 109, 113, 20, 121]

/-- `A257339` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 67) : A257339 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 67) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 67) : fz n = data[n.toNat - 1]! := sorry

end A257339
