import LOEIS.A025.A025634.Defs

set_option linter.unusedVariables false

/-!
# A025634

Numbers of form 8^i*10^j, with i, j >= 0.

The 35 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A025634

/-- Known terms of `A025634`, starting at index `1`. -/
def data : List retType :=
  [1, 8, 10, 64, 80, 100, 512, 640, 800, 1000,
    4096, 5120, 6400, 8000, 10000, 32768, 40960, 51200, 64000, 80000,
    100000, 262144, 327680, 409600, 512000, 640000, 800000, 1000000, 2097152, 2621440,
    3276800, 4096000, 5120000, 6400000, 8000000]

/-- `A025634` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 36) : A025634 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 36) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 36) : fz n = data[n.toNat - 1]! := sorry

end A025634
