/-!
# A317948

An example of a morphic word: the sorted (by length, then alphabetically) sequence of words of the form a*b* under the action of a finite automaton defined as follows: start state is 0; a and b map states [0, 1, 2, 3] to states [1, 2, 3, 0] and [0, 3, 1, 2], respectively.

The 87 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A317948

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [0, 1, 0, 2, 3, 0, 3, 1, 2, 0,
    0, 2, 3, 1, 0, 1, 0, 1, 2, 3,
    0, 2, 3, 0, 3, 1, 2, 0, 3, 1,
    2, 0, 2, 3, 1, 0, 0, 2, 3, 1,
    0, 1, 2, 3, 0, 1, 0, 1, 2, 3,
    0, 3, 1, 2, 0, 2, 3, 0, 3, 1,
    2, 0, 2, 3, 1, 0, 3, 1, 2, 0,
    2, 3, 1, 0, 1, 2, 3, 0, 0, 2,
    3, 1, 0, 1, 2, 3, 0]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 88) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 88) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 88) : flatFz n = flatData[n.toNat - 1]! := sorry

end A317948
