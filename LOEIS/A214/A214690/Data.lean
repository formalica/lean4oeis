import LOEIS.A214.A214690.Defs

set_option linter.unusedVariables false

/-!
# A214690

Triangle, read by rows of n^2 terms, where row n equals the coefficients in the series reversion of the function G(y,n)-1 such that: y = Sum_{m>=1} 1/G(y,n)^(2*n*m) * Product_{k=1..m} (1 - 1/G(y,n)^(2*k-1)).

The 48 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A214690

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, -2, -3, -1, 1, -4, -2, 22, 49,
    49, 27, 8, 1, 1, -6, 3, 61, 15, -567,
    -1946, -3607, -4489, -4015, -2640, -1274, -441, -104, -15, -1,
    1, -8, 12, 108, -218, -1938, -834, 27124, 136919, 393601,
    809873, 1288950, 1646268, 1720788, 1487263, 1067345, 635682, 312646]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 49) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 49) : flatFn n = flatData[n - 1]! := sorry

