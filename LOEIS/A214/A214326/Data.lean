import LOEIS.A214.A214326.Defs

set_option linter.unusedVariables false

/-!
# A214326

Square array read by antidiagonals in which T(n,b) gives the n-th Fibonacci number written in base b with n,b >= 1.

The 54 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A214326

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 1, 1, 11, 1, 1, 10, 111,
    1, 1, 2, 11, 11111, 1, 1, 2, 10, 101,
    11111111, 1, 1, 2, 3, 12, 1000, 1111111111111, 1, 1,
    2, 3, 11, 22, 1101, 111111111111111111111, 1, 1, 2, 3,
    10, 20, 111, 10101, 1111111111111111111111111111111111, 1, 1, 2, 3, 5,
    13, 31, 210, 100010]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 55) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 55) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 55) : flatFz n = flatData[n.toNat - 1]! := sorry

end A214326
