import LOEIS.A208.A208805.Defs

set_option linter.unusedVariables false

/-!
# A208805

T(n,k) = number of n-bead necklaces labeled with numbers -k..k allowing reversal, with sum zero and three times sum of squares <= n*k*(k+1).

The 65 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A208805

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 1, 2, 2, 1, 3, 4, 3,
    1, 3, 5, 11, 3, 1, 4, 8, 24, 33,
    15, 1, 4, 12, 50, 99, 105, 22, 1, 5,
    17, 84, 239, 518, 395, 38, 1, 5, 22, 136,
