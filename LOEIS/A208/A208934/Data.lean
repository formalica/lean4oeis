    1000000000000000000000000000000000000000000000000, 11, 1000000, 1, 1000000, 1000000000000000000000000000000000000000000, 1000000000000000000000000, 3, 1, 8,
    9, 4, 2, 1000000000000000000000000000000000000, -1, 2, -1, 12, 5, 30]

/-- `A208934` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 31) : A208934 n = data[n.val - 1]! := sorry

