import LOEIS.A260.A260312.Defs

set_option linter.unusedVariables false

/-!
# A260312

Palindromic beastly primes that begin and end with digit '1'.

The 3 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A260312

/-- Known terms of `A260312`, starting at index `1`. -/
def data : List retType :=
  [16661, 1000000000000066600000000000001, 10000000000000000000000000000000000000000006660000000000000000000000000000000000000000001]

/-- `A260312` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 4) : A260312 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 4) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 4) : fz n = data[n.toNat - 1]! := sorry

end A260312
