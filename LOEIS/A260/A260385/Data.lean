  [1, 2, 4, 5, 10, 12, 15, 20, 24, 25,
    30, 32, 40, 50, 56, 58, 59, 60, 69, 75,
    100, 112, 120, 125, 150, 170, 175, 200, 220, 240,
    250, 275, 276, 300, 320, 325, 366, 399, 400, 440,
