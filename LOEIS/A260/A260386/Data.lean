import LOEIS.A260.A260386.Defs

set_option linter.unusedVariables false

/-!
# A260386

Numbers n which divide A260521(n), the concatenation of the positions of the digits 9, 8, ..., 0 in the decimal representation of n, where positions are counted from the right, and 0 if a given digit does not occur.

The 50 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A260386

/-- Known terms of `A260386`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 4, 5, 8, 12, 15, 19, 21, 24,
    25, 48, 68, 75, 96, 123, 228, 231, 275, 312,
    321, 375, 451, 484, 712, 726, 768, 868, 1234, 1324,
    2143, 2341, 3412, 3421, 4123, 4231, 4312, 4321, 4544, 11425,
    12345, 13425, 14235, 14325, 21354, 23451, 24153, 24351, 31524, 32541]

/-- `A260386` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 51) : A260386 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 51) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 51) : fz n = data[n.toNat - 1]! := sorry

end A260386
