import LOEIS.A260.A260520.Defs

set_option linter.unusedVariables false

/-!
# A260520

Concatenate the positions of digits 0, 1, ..., 9 in the decimal representation of n, using 1 for the leftmost digit etc., and 0 when the digit does not occur.

The 30 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A260520

/-- Known terms of `A260520`, starting at index `0`. -/
def data : List retType :=
  [1000000000, 100000000, 10000000, 1000000, 100000, 10000, 1000, 100, 10, 1,
    2100000000, 1200000000, 120000000, 102000000, 100200000, 100020000, 100002000, 100000200, 100000020, 100000002,
    2010000000, 210000000, 120000000, 12000000, 10200000, 10020000, 10002000, 10000200, 10000020, 10000002]

/-- `A260520` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 30) : A260520 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 30) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 30) : fz n = data[n.toNat]! := sorry

end A260520
