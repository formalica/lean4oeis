import LOEIS.A260.A260264.Defs

set_option linter.unusedVariables false

/-!
# A260264

a(n+1) = a(n) + largest digit not in a(n), starting with a(0) = 0.

The 56 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A260264

/-- Known terms of `A260264`, starting at index `0`. -/
def data : List retType :=
  [0, 9, 17, 26, 35, 44, 53, 62, 71, 80,
    89, 96, 104, 113, 122, 131, 140, 149, 157, 166,
    175, 184, 193, 201, 210, 219, 227, 236, 245, 254,
    263, 272, 281, 290, 298, 305, 314, 323, 332, 341,
    350, 359, 367, 376, 385, 394, 402, 411, 420, 429,
    437, 446, 455, 464, 473, 482]

/-- `A260264` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 56) : A260264 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 56) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 56) : fz n = data[n.toNat]! := sorry

end A260264
