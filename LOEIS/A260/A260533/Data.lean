def flatData : List flatRetType :=
  [1, 1, 1, 1, 2, 1, 1, 3, 1, 2,
    1, 1, 4, 3, 3, 2, 2, 1, 1, 5,
    6, 4, 1, 6, 3, 1, 2, 2, 1, 1,
