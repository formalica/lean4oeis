import LOEIS.A260.A260522.Defs

set_option linter.unusedVariables false

/-!
# A260522

Concatenate the positions of digits 9, 8,..., 0 in the decimal representation of n, using 1 for the leftmost digit etc., and 0 when the digit does not occur.

The 30 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A260522

/-- Known terms of `A260522`, starting at index `0`. -/
def data : List retType :=
  [1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000, 1000000000,
    12, 120, 210, 2010, 20010, 200010, 2000010, 20000010, 200000010, 2000000010,
    102, 120, 1200, 2100, 20100, 200100, 2000100, 20000100, 200000100, 2000000100]

/-- `A260522` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 30) : A260522 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 30) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 30) : fz n = data[n.toNat]! := sorry

end A260522
