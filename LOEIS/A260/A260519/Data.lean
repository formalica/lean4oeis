import LOEIS.A260.A260519.Defs

set_option linter.unusedVariables false

/-!
# A260519

Concatenate the positions of digits 0, 1,..., 9 in the decimal representation of n, using 1 for the rightmost digit etc., and 0 when the digit does not occur.

The 30 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A260519

/-- Known terms of `A260519`, starting at index `0`. -/
def data : List retType :=
  [1000000000, 100000000, 10000000, 1000000, 100000, 10000, 1000, 100, 10, 1,
    1200000000, 1200000000, 210000000, 201000000, 200100000, 200010000, 200001000, 200000100, 200000010, 200000001,
    1020000000, 120000000, 120000000, 21000000, 20100000, 20010000, 20001000, 20000100, 20000010, 20000001]

/-- `A260519` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 30) : A260519 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 30) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 30) : fz n = data[n.toNat]! := sorry

end A260519
