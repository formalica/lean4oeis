import LOEIS.A260.A260521.Defs

set_option linter.unusedVariables false

/-!
# A260521

Concatenate the positions of digits 9, 8,..., 0 in the decimal representation of n, using 1 for the rightmost digit etc., and 0 when the digit does not occur.

The 30 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A260521

/-- Known terms of `A260521`, starting at index `0`. -/
def data : List retType :=
  [1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000, 1000000000,
    21, 120, 120, 1020, 10020, 100020, 1000020, 10000020, 100000020, 1000000020,
    201, 210, 1200, 1200, 10200, 100200, 1000200, 10000200, 100000200, 1000000200]

/-- `A260521` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 30) : A260521 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 30) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 30) : fz n = data[n.toNat]! := sorry

end A260521
