import LOEIS.A260.A260258.Defs

set_option linter.unusedVariables false

/-!
# A260258

T(n,k) is the array read by rows, n>0 and k=1..q (with q = number of prime distinct divisors of n^2+1) giving the number of occurrences of the k-th prime divisor of n^2+1 counted from the prime divisors of m^2+1 for m=1..n.

The 80 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A260258

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 2, 2, 1, 3, 1, 1, 4, 3,
    4, 2, 5, 1, 1, 6, 1, 5, 1, 7,
    6, 2, 1, 8, 1, 1, 9, 7, 2, 8,
    3, 10, 1, 1, 11, 4, 3, 9, 1, 12,
    10, 1, 1, 13, 1, 1, 14, 11, 1, 12,
    1, 15, 1, 4, 2, 16, 5, 2, 13, 2,
    17, 14, 1, 6, 1, 18, 1, 1, 19, 15,
    1, 16, 5, 20, 1, 1, 21, 3, 17, 1]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 81) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 81) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 81) : flatFz n = flatData[n.toNat - 1]! := sorry

end A260258
