import LOEIS.A235.A235262.Defs

set_option linter.unusedVariables false

/-!
# A235262

Lexicographically earliest sequence of distinct positive integers such that the derived sequence (b(n)) = (a(n) XOR a(n+1)) contains only distinct terms (XOR stands for the binary XOR operator).

The 67 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A235262

/-- Known terms of `A235262`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 3, 4, 6, 8, 5, 9, 12, 7,
    13, 11, 15, 16, 10, 17, 24, 14, 18, 26,
    21, 32, 19, 33, 22, 34, 20, 36, 25, 35,
    27, 37, 28, 39, 48, 23, 38, 50, 29, 49,
    31, 52, 30, 51, 42, 55, 41, 56, 40, 58,
    47, 60, 64, 43, 65, 44, 66, 45, 53, 67,
    54, 68, 57, 70, 46, 71, 61]

/-- `A235262` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 68) : A235262 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 68) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 68) : fz n = data[n.toNat - 1]! := sorry

end A235262
