set_option linter.unusedVariables false

/-!
# A258118

Triangle T(n,k) in which the n-th row lists in increasing order the Heinz numbers of all complete partitions of n.

The 70 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A258118

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, 2, 4, 6, 8, 12, 16, 18, 20, 24,
    32, 30, 36, 40, 48, 64, 42, 54, 56, 60,
    72, 80, 96, 128, 84, 90, 100, 108, 112, 120,
    144, 160, 192, 256, 126, 132, 140, 150, 162, 168,
    176, 180, 200, 216, 224, 240, 288, 320, 384, 512,
