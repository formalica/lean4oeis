import LOEIS.A132.A132144.Defs

set_option linter.unusedVariables false

/-!
# A132144

Numbers that can't be expressed as the sum of a prime number and a Fibonacci number (0 is considered to be a Fibonacci number).

The 50 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A132144

/-- Known terms of `A132144`, starting at index `1`. -/
def data : List retType :=
  [1, 35, 119, 125, 177, 208, 209, 221, 255, 287,
    299, 329, 363, 416, 485, 515, 519, 535, 539, 551,
    561, 567, 637, 697, 705, 718, 755, 768, 779, 784,
    793, 815, 869, 875, 899, 925, 926, 933, 935, 951,
    995, 1037, 1045, 1075, 1079, 1107, 1139, 1145, 1147, 1149]

/-- `A132144` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 51) : A132144 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 51) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 51) : fz n = data[n.toNat - 1]! := sorry

end A132144
