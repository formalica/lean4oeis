import LOEIS.A132.A132146.Defs

set_option linter.unusedVariables false

/-!
# A132146

Numbers that can't be presented as a sum of a prime number and a Fibonacci number (0 is not considered to be a Fibonacci number).

The 54 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A132146

/-- Known terms of `A132146`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 17, 29, 35, 59, 83, 89, 119, 125,
    127, 177, 179, 208, 209, 221, 239, 255, 269, 287,
    299, 329, 331, 353, 359, 363, 389, 416, 419, 449,
    479, 485, 509, 515, 519, 535, 539, 547, 551, 561,
    567, 569, 599, 637, 659, 673, 697, 705, 718, 733,
    739, 755, 768, 779]

/-- `A132146` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 55) : A132146 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 55) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 55) : fz n = data[n.toNat - 1]! := sorry

end A132146
