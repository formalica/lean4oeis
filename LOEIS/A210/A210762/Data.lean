def flatData : List flatRetType :=
  [2, 2, 4, 5, 4, 5, 4, 5, 4, 5,
    8, 9, 10, 11, 12, 4, 5, 8, 9, 10,
    11, 12, 14, 15, 16, 17, 18, 19, 4, 5,
