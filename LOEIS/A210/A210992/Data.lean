import LOEIS.A210.A210992.Defs

set_option linter.unusedVariables false

/-!
# A210992

Square array read by antidiagonals, in which column k starts with k plateaus of lengths k+1, k, k-1, k-2, k-3,..2 and of levels A000124: 1, 2, 4, 7, 11..., if k >= 1, connected by consecutive integers. After the last plateau the length remains 1.

The 84 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A210992

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, 2, 1, 3, 1, 1, 4, 2, 1, 1,
    5, 3, 1, 1, 1, 6, 4, 2, 1, 1,
    1, 7, 5, 2, 1, 1, 1, 1, 8, 6,
    3, 2, 1, 1, 1, 1, 9, 7, 4, 2,
    1, 1, 1, 1, 1, 10, 8, 5, 2, 2,
    1, 1, 1, 1, 1, 11, 9, 6, 3, 2,
    1, 1, 1, 1, 1, 1, 12, 10, 7, 4,
    2, 2, 1, 1, 1, 1, 1, 1, 13, 11,
    8, 4, 2, 2]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 84) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 84) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 84) : flatFz n = flatData[n.toNat]! := sorry

end A210992
