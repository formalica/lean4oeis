def data : List retType :=
  [4, 4, 5, 6, 5, 7]

/-- `A202151` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 8) : A202151 n = data[n.val - 2]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 2 ≤ n) (h : n < 8) : fn n = data[n - 2]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 2 ≤ n) (h : n < 8) : fz n = data[n.toNat - 2]! := sorry

end A202151
