namespace A121056

/-- Known terms of `A121056`, starting at index `-3`. -/
def data : List retType :=
  [7, 9, 12, 16, 24, 36, 56, 90]

/-- `A121056` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 5) : A121056 n = data[(n.val - (-3)).toNat]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : -3 ≤ n) (h : n < 5) : fz n = data[(n - (-3)).toNat]! := sorry

end A121056
