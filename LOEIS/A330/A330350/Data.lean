    8, 7, 9, 0, 9, 1, 9, 2, 9, 3,
    9, 4, 9, 5, 9, 6, 9, 7, 9, 8]

/-- `A330350` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 101) : A330350 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 101) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 101) : fz n = data[n.toNat - 1]! := sorry

end A330350
