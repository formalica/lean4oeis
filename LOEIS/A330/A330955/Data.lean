import LOEIS.A330.A330955.Defs

set_option linter.unusedVariables false

/-!
# A330955

For any n >= 0: consider all pairs of numbers (x, y) whose binary representations can be interleaved (or shuffled) to produce the binary representation of n (possibly with leading zeros); a(n) is the greatest possible value of x AND y (where AND denotes the bitwise AND operator).

The 87 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A330955

/-- Known terms of `A330955`, starting at index `0`. -/
def data : List retType :=
  [0, 0, 0, 1, 0, 1, 0, 1, 0, 1,
    2, 2, 2, 2, 2, 3, 0, 1, 2, 2,
    2, 2, 2, 3, 0, 1, 2, 3, 2, 2,
    2, 3, 0, 1, 2, 2, 4, 4, 4, 4,
    4, 4, 4, 5, 4, 5, 4, 5, 4, 4,
    4, 5, 4, 5, 6, 6, 4, 4, 6, 6,
    6, 6, 6, 7, 0, 1, 2, 2, 4, 4,
    4, 4, 4, 4, 4, 5, 4, 5, 4, 5,
    4, 4, 4, 5, 4, 5, 6]

/-- `A330955` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 87) : A330955 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
