  [0, 1, 1, 1, 1, 1, 3, 3, 1, 1,
    2, 3, 2, 3, 3, 3, 1, 1, 2, 3,
    2, 3, 3, 3, 3, 3, 3, 3, 6, 7,
    7, 7, 1, 1, 2, 3, 2, 3, 3, 3,
    3, 3, 3, 3, 5, 5, 7, 7, 3, 3,
