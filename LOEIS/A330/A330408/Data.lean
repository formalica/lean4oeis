import LOEIS.A330.A330408.Defs

set_option linter.unusedVariables false

/-!
# A330408

Table of A(n,k) read by antidiagonals, where A(1,k)=k; A(n,k) is the least multiple of n >= A(n-1,k).

The 76 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A330408

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 2, 3, 2, 3, 4, 4, 3, 4,
    5, 4, 6, 4, 5, 6, 6, 6, 8, 5,
    6, 7, 6, 6, 8, 10, 6, 7, 8, 8,
