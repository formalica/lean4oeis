import LOEIS.A330.A330240.Defs

set_option linter.unusedVariables false

/-!
# A330240

Square array T(n,k): concatenate the absolute differences of the digits of n and k (the smaller one padded with leading zeros), read by antidiagonals, n, k >= 0.

The 120 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A330240

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [0, 1, 1, 2, 0, 2, 3, 1, 1, 3,
    4, 2, 0, 2, 4, 5, 3, 1, 1, 3,
    5, 6, 4, 2, 0, 2, 4, 6, 7, 5,
