import LOEIS.A140.A140408.Defs

set_option linter.unusedVariables false

/-!
# A140408

Irregular triangle T(n,k) read by rows: n repetitions of -1 followed by (n+1) repetitions of n+1.

The 100 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A140408

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, -1, 2, 2, -1, -1, 3, 3, 3, -1,
    -1, -1, 4, 4, 4, 4, -1, -1, -1, -1,
    5, 5, 5, 5, 5, -1, -1, -1, -1, -1,
    6, 6, 6, 6, 6, 6, -1, -1, -1, -1,
