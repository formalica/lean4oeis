import LOEIS.A140.A140324.Defs

set_option linter.unusedVariables false

/-!
# A140324

A new way to compute polynomial triangles from matrices of a Folium Implicit type: M={{0, -w[1], -w[2]}, {w[1], 0, -w[1]}, {w[2], w[1], 0}} that gives even only monomials as w[1]=x, others as one.

The 36 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A140324

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 0, 0, 1, 1, -2, -1, 2, 1, 1,
    -8, 22, -22, 1, 6, 1, 0, 0, 9, -54,
    117, -102, 18, 12, 1, 1, -6, 3, 48, -101,
    -32, 291, -294, 70, 20, 1]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 37) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 37) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 37) : flatFz n = flatData[n.toNat - 1]! := sorry

end A140324
