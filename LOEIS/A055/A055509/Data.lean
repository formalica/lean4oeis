import LOEIS.A055.A055509.Defs

set_option linter.unusedVariables false

/-!
# A055509

Number of odd primes in sequence obtained in 3x+1 (or Collatz) problem starting at n.

The 95 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A055509

/-- Known terms of `A055509`, starting at index `1`. -/
def data : List retType :=
  [0, 0, 2, 0, 1, 2, 5, 0, 5, 1,
    4, 2, 2, 5, 3, 0, 3, 5, 6, 1,
    0, 4, 3, 2, 6, 2, 24, 5, 5, 3,
    23, 0, 6, 3, 2, 5, 6, 6, 10, 1,
    24, 0, 7, 4, 3, 3, 22, 2, 6, 6,
    5, 2, 2, 24, 23, 5, 7, 5, 10, 3,
    4, 23, 19, 0, 6, 6, 8, 3, 2, 2,
    21, 5, 24, 6, 1, 6, 5, 10, 10, 1,
    4, 24, 23, 0, 0, 7, 8, 4, 9, 3,
    19, 3, 2, 22, 19]

/-- `A055509` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 96) : A055509 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 96) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 96) : fz n = data[n.toNat - 1]! := sorry

end A055509
