import LOEIS.A354.A354267.Defs

set_option linter.unusedVariables false

/-!
# A354267

A Fibonacci-Pascal triangle read by rows: T(n, n) = 1, T(n, n-1) = n - 1, T(n, 0) = T(n-1, 1) and T(n, k) = T(n-1, k-1) + T(n-1, k) for 0 < k < n-1.

The 78 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A354267

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, 0, 1, 1, 1, 1, 1, 2, 2, 1,
    2, 3, 4, 3, 1, 3, 5, 7, 7, 4,
    1, 5, 8, 12, 14, 11, 5, 1, 8, 13,
    20, 26, 25, 16, 6, 1, 13, 21, 33, 46,
    51, 41, 22, 7, 1, 21, 34, 54, 79, 97,
    92, 63, 29, 8, 1, 34, 55, 88, 133, 176,
    189, 155, 92, 37, 9, 1, 55, 89, 143, 221,
    309, 365, 344, 247, 129, 46, 10, 1]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 78) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 78) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 78) : flatFz n = flatData[n.toNat]! := sorry

end A354267
