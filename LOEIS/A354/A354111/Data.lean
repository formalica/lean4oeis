import LOEIS.A354.A354111.Defs

set_option linter.unusedVariables false

/-!
# A354111

Lexicographically earliest sequence of distinct nonnegative terms on a square spiral such that for any 2 X 2 square of numbers both the sum of those numbers and the sum of the digits of those numbers add up to a square. Start with a(0) = 0.

The 69 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A354111

/-- Known terms of `A354111`, starting at index `0`. -/
def data : List retType :=
  [0, 1, 2, 6, 3, 7, 4, 5, 19, 8,
    141, 25, 9, 133, 28, 132, 10, 24, 135, 23,
    11, 131, 29, 91, 26, 12, 98, 378, 32, 78,
    13, 44, 39, 124, 157, 230, 14, 275, 220, 105,
    178, 229, 15, 69, 365, 51, 54, 153, 385, 16,
    163, 303, 62, 104, 227, 123, 17, 43, 476, 66,
    212, 83, 106, 134, 18, 30, 210, 195, 56]

/-- `A354111` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 69) : A354111 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 69) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 69) : fz n = data[n.toNat]! := sorry

end A354111
