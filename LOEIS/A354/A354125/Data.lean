import LOEIS.A354.A354125.Defs

set_option linter.unusedVariables false

/-!
# A354125

Lexicographically earliest sequence of distinct nonnegative integers such that for any n >= 0, the binary expansions of a(n) and a(n + a(n)) have no 1's in common.

The 67 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A354125

/-- Known terms of `A354125`, starting at index `0`. -/
def data : List retType :=
  [0, 1, 2, 3, 4, 5, 8, 6, 9, 7,
    10, 11, 12, 16, 17, 13, 24, 18, 14, 15,
    20, 19, 32, 21, 33, 22, 23, 25, 34, 35,
    26, 36, 48, 27, 64, 37, 28, 29, 30, 31,
