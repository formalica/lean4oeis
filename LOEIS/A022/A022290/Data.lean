import LOEIS.A022.A022290.Defs

set_option linter.unusedVariables false

/-!
# A022290

Replace 2^k in binary expansion of n with Fibonacci(k+2).

The 71 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A022290

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [0, 1, 2, 3, 3, 4, 5, 6, 5, 6,
    7, 8, 8, 9, 10, 11, 8, 9, 10, 11,
    11, 12, 13, 14, 13, 14, 15, 16, 16, 17,
    18, 19, 13, 14, 15, 16, 16, 17, 18, 19,
    18, 19, 20, 21, 21, 22, 23, 24, 21, 22,
    23, 24, 24, 25, 26, 27, 26, 27, 28, 29,
    29, 30, 31, 32, 21, 22, 23, 24, 24, 25,
    26]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 71) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 71) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 71) : flatFz n = flatData[n.toNat]! := sorry

end A022290
