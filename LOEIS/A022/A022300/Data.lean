import LOEIS.A022.A022300.Defs

set_option linter.unusedVariables false

/-!
# A022300

The sequence a of 1's and 2's starting with (1,1,2,1) such that a(n) is the length of the (n+2)nd run of a.

The 108 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A022300

/-- Known terms of `A022300`, starting at index `1`. -/
def data : List retType :=
  [1, 1, 2, 1, 2, 1, 1, 2, 1, 1,
    2, 1, 2, 2, 1, 2, 1, 1, 2, 1,
    1, 2, 2, 1, 2, 2, 1, 2, 1, 1,
    2, 1, 2, 2, 1, 1, 2, 1, 1, 2,
    2, 1, 2, 2, 1, 2, 1, 1, 2, 1,
    1, 2, 2, 1, 2, 1, 1, 2, 1, 2,
    2, 1, 1, 2, 1, 1, 2, 2, 1, 2,
    2, 1, 2, 1, 1, 2, 1, 2, 2, 1,
    1, 2, 1, 1, 2, 1, 2, 2, 1, 2,
    2, 1, 1, 2, 1, 2, 2, 1, 2, 1,
    1, 2, 2, 1, 2, 2, 1, 1]

/-- `A022300` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 109) : A022300 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 109) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 109) : fz n = data[n.toNat - 1]! := sorry

end A022300
