import LOEIS.A020.A020906.Defs

set_option linter.unusedVariables false

/-!
# A020906

Triangle where n-th row is the first n terms of the sequence in reverse order, starting with a(1) = 1 and a(2) = 2.

The 89 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A020906

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 1, 1, 2, 1, 1, 1, 2, 1,
    2, 1, 1, 2, 1, 1, 2, 1, 1, 2,
    1, 1, 1, 2, 1, 1, 2, 1, 1, 1,
    1, 2, 1, 1, 2, 1, 2, 1, 1, 1,
    2, 1, 1, 2, 1, 1, 2, 1, 1, 1,
    2, 1, 1, 2, 1, 2, 1, 2, 1, 1,
    1, 2, 1, 1, 2, 1, 1, 2, 1, 2,
    1, 1, 1, 2, 1, 1, 2, 1, 1, 1,
    2, 1, 2, 1, 1, 1, 2, 1, 1]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 90) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 90) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 90) : flatFz n = flatData[n.toNat - 1]! := sorry

end A020906
