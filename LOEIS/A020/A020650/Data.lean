import LOEIS.A020.A020650.Defs

set_option linter.unusedVariables false

/-!
# A020650

Numerators in recursive bijection from positive integers to positive rationals (the bijection is f(1) = 1, f(2n) = f(n)+1, f(2n+1) = 1/(f(n)+1)).

The 94 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A020650

/-- Known terms of `A020650`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 1, 3, 1, 3, 2, 4, 1, 4,
    3, 5, 2, 5, 3, 5, 1, 5, 4, 7,
    3, 7, 4, 7, 2, 7, 5, 8, 3, 8,
    5, 6, 1, 6, 5, 9, 4, 9, 5, 10,
    3, 10, 7, 11, 4, 11, 7, 9, 2, 9,
    7, 12, 5, 12, 7, 11, 3, 11, 8, 13,
    5, 13, 8, 7, 1, 7, 6, 11, 5, 11,
    6, 13, 4, 13, 9, 14, 5, 14, 9, 13,
    3, 13, 10, 17, 7, 17, 10, 15, 4, 15,
    11, 18, 7, 18]

/-- `A020650` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 95) : A020650 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 95) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 95) : fz n = data[n.toNat - 1]! := sorry

end A020650
