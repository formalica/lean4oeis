import LOEIS.A194.A194859.Defs

set_option linter.unusedVariables false

/-!
# A194859

Triangular array (and fractal sequence):  row n is the permutation of (1,2,...,n) obtained from the increasing ordering of fractional parts {e}, {2e}, ..., {ne}.

The 94 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A194859

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 1, 3, 2, 1, 3, 2, 1, 4,
    3, 2, 5, 1, 4, 3, 6, 2, 5, 1,
    4, 7, 3, 6, 2, 5, 1, 4, 7, 3,
    6, 2, 5, 1, 8, 4, 7, 3, 6, 2,
    9, 5, 1, 8, 4, 7, 3, 10, 6, 2,
    9, 5, 1, 8, 4, 7, 3, 10, 6, 2,
    9, 5, 1, 8, 4, 11, 7, 3, 10, 6,
    2, 9, 5, 12, 1, 8, 4, 11, 7, 3,
    10, 6, 13, 2, 9, 5, 12, 1, 8, 4,
    11, 7, 14, 3]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 95) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 95) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 95) : flatFz n = flatData[n.toNat - 1]! := sorry

end A194859
