import LOEIS.A194.A194899.Defs

set_option linter.unusedVariables false

/-!
# A194899

Triangular array (and fractal sequence):  row n is the permutation of (1,2,...,n) obtained from the increasing ordering of fractional parts {r}, {2r}, ..., {nr}, where r=sqrt(12).

The 91 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A194899

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 2, 3, 1, 2, 3, 1, 4, 2,
    5, 3, 1, 4, 2, 5, 3, 1, 6, 4,
    2, 7, 5, 3, 1, 6, 4, 2, 7, 5,
    3, 1, 8, 6, 4, 2, 9, 7, 5, 3,
    1, 8, 6, 4, 2, 9, 7, 5, 3, 1,
    10, 8, 6, 4, 2, 11, 9, 7, 5, 3,
