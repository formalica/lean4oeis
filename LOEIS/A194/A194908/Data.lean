import LOEIS.A194.A194908.Defs

set_option linter.unusedVariables false

/-!
# A194908

Triangular array (and fractal sequence):  row n is the permutation of (1,2,...,n) obtained from the increasing ordering of fractional parts {r}, {2r}, ..., {nr}, where r=-Pi.

The 94 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A194908

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 1, 3, 2, 1, 4, 3, 2, 1,
    5, 4, 3, 2, 1, 6, 5, 4, 3, 2,
    1, 7, 6, 5, 4, 3, 2, 1, 7, 6,
    5, 4, 3, 2, 1, 8, 7, 6, 5, 4,
    3, 2, 9, 1, 8, 7, 6, 5, 4, 3,
    10, 2, 9, 1, 8, 7, 6, 5, 4, 11,
    3, 10, 2, 9, 1, 8, 7, 6, 5, 12,
    4, 11, 3, 10, 2, 9, 1, 8, 7, 6,
    13, 5, 12, 4, 11, 3, 10, 2, 9, 1,
    8, 7, 14, 6]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 95) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 95) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 95) : flatFz n = flatData[n.toNat - 1]! := sorry

end A194908
