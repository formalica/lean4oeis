import LOEIS.A179.A179806.Defs

set_option linter.unusedVariables false

/-!
# A179806

Irregular triangle by rows, M*Q. M = triangle with (1,2,3,...) in every column, with the leftmost column shifted upwards one row. Q = a diagonalized variant of odd-indexed Fibonacci numbers.

The 46 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A179806

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 3, 2, 4, 4, 5, 5, 6, 10,
    13, 6, 8, 15, 26, 34, 7, 10, 20, 39,
    68, 89, 8, 12, 25, 52, 102, 178, 233, 9,
    14, 30, 65, 136, 267, 466, 610, 10, 16, 35,
    78, 170, 356, 699, 1220, 1597]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 47) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 47) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 47) : flatFz n = flatData[n.toNat - 1]! := sorry

end A179806
