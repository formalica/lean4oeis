import LOEIS.A201.A201651.Defs

set_option linter.unusedVariables false

/-!
# A201651

Bit-interleaved number addition table (cf. A054240) as triangle read by rows: T(n,k) = n and k added in binary representation, where carries shift 2 instead of 1, 0 <= k <= n.

The 70 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A201651

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [0, 1, 4, 2, 3, 8, 3, 6, 9, 12,
    4, 5, 6, 7, 16, 5, 16, 7, 18, 17,
    20, 6, 7, 12, 13, 18, 19, 24, 7, 18,
    13, 24, 19, 22, 25, 28, 8, 9, 10, 11,
    12, 13, 14, 15, 32, 9, 12, 11, 14, 13,
    24, 15, 26, 33, 36, 10, 11, 32, 33, 14,
    15, 36, 37, 34, 35, 40, 11, 14, 33, 36]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 70) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 70) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 70) : flatFz n = flatData[n.toNat]! := sorry

end A201651
