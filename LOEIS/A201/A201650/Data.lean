import LOEIS.A201.A201650.Defs

set_option linter.unusedVariables false

/-!
# A201650

Allan Johnson's set of 48 squarefree numbers whose reciprocals add to 1, with the property that each number has exactly two distinct prime factors.

The 48 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A201650

/-- Known terms of `A201650`, starting at index `1`. -/
def data : List retType :=
  [6, 10, 14, 15, 21, 22, 26, 33, 34, 35,
    38, 39, 46, 51, 55, 57, 58, 62, 65, 69,
    77, 82, 85, 86, 87, 91, 93, 95, 115, 119,
    123, 133, 155, 187, 203, 209, 215, 221, 247, 265,
    287, 299, 319, 323, 391, 689, 731, 901]

/-- `A201650` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 49) : A201650 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 49) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 49) : fz n = data[n.toNat - 1]! := sorry

end A201650
