import LOEIS.A052.A052017.Defs

set_option linter.unusedVariables false

/-!
# A052017

Primes with digits in ascending order that differ exactly by 1.

The 9 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A052017

/-- Known terms of `A052017`, starting at index `1`. -/
def data : List retType :=
  [2, 3, 5, 7, 23, 67, 89, 4567, 23456789]

/-- `A052017` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 10) : A052017 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 10) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 10) : fz n = data[n.toNat - 1]! := sorry

end A052017
