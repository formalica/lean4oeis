set_option linter.unusedVariables false

/-!
# A058213

Triangular arrangement of solutions of phi(x) = 2^n (n >= 0), where phi=A000010 is Euler's totient function. Each row corresponds to a particular n and its length is n+2 for 0 <= n <= 31, 32 for n >= 32. (This assumes that there are only 5 Fermat primes.)

The 58 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A058213

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, 2, 3, 4, 6, 5, 8, 10, 12, 15,
    16, 20, 24, 30, 17, 32, 34, 40, 48, 60,
    51, 64, 68, 80, 96, 102, 120, 85, 128, 136,
    160, 170, 192, 204, 240, 255, 256, 272, 320, 340,
    384, 408, 480, 510, 257, 512, 514, 544, 640, 680,
    768, 816, 960, 1020, 771, 1024, 1028, 1088]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 58) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 58) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
