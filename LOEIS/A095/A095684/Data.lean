import LOEIS.A095.A095684.Defs

set_option linter.unusedVariables false

/-!
# A095684

Triangle read by rows. There are 2^(m-1) rows of length m, for m = 1, 2, 3, ... The rows are in lexicographic order. The rows have the property that the first entry is 1, the second distinct entry (reading from left to right) is 2, the third distinct entry is 3, etc.

The 104 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A095684

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 1, 2, 1, 1, 1, 1, 1,
    2, 1, 2, 2, 1, 2, 3, 1, 1, 1,
    1, 1, 1, 1, 2, 1, 1, 2, 2, 1,
    1, 2, 3, 1, 2, 2, 2, 1, 2, 2,
    3, 1, 2, 3, 3, 1, 2, 3, 4, 1,
    1, 1, 1, 1, 1, 1, 1, 1, 2, 1,
    1, 1, 2, 2, 1, 1, 1, 2, 3, 1,
    1, 2, 2, 2, 1, 1, 2, 2, 3, 1,
    1, 2, 3, 3, 1, 1, 2, 3, 4, 1,
    2, 2, 2, 2, 1, 2, 2, 2, 3, 1,
    2, 2, 3, 3]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 105) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 105) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 105) : flatFz n = flatData[n.toNat - 1]! := sorry

end A095684
