def data : List retType :=
  [1, 2, -1, 3, 1, -2, -1, 4, 1, 2,
    -1, -3, 1, -2, -1, 5, 1, 2, -1, 3,
    1, -2, -1, -4, 1, 2, -1, -3, 1, -2,
    -1, 6, 1, 2, -1, 3, 1, -2, -1, 4,
    1, 2, -1, -3, 1, -2, -1, -5, 1, 2,
    -1, 3, 1, -2, -1, -4, 1, 2, -1, -3,
    1, -2, -1, 7, 1, 2, -1, 3, 1, -2,
    -1, 4, 1, 2, -1, -3, 1, -2, -1, 5]

/-- `A164677` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 81) : A164677 n = data[n.val - 1]! := sorry

