def flatData : List flatRetType :=
  [1, 2, 2, 3, 1, 3, 4, 1, 1, 4,
    5, 2, 1, 2, 5, 6, 2, 1, 1, 2,
    6, 7, 3, 1, 1, 1, 3, 7, 8, 3,
