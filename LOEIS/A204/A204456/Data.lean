import LOEIS.A204.A204456.Defs

set_option linter.unusedVariables false

/-!
# A204456

Coefficient array of numerator polynomials of the o.g.f.s for the sequence of odd numbers not divisible by a given prime.

The 100 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A204456

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 4, 1, 1, 2, 4, 2, 1,
    1, 2, 2, 4, 2, 2, 1, 1, 2, 2,
    2, 2, 4, 2, 2, 2, 2, 1, 1, 2,
    2, 2, 2, 2, 4, 2, 2, 2, 2, 2,
    1, 1, 2, 2, 2, 2, 2, 2, 2, 4,
    2, 2, 2, 2, 2, 2, 2, 1, 1, 2,
    2, 2, 2, 2, 2, 2, 2, 4, 2, 2,
    2, 2, 2, 2, 2, 2, 1, 1, 2, 2,
    2, 2, 2, 2, 2, 2, 2, 2, 4, 2,
    2, 2, 2, 2, 2, 2, 2, 2, 2, 1]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 101) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 101) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 101) : flatFz n = flatData[n.toNat - 1]! := sorry

end A204456
