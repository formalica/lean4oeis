import LOEIS.A204.A204178.Defs

set_option linter.unusedVariables false

/-!
# A204178

Array:  row n shows the coefficients of the characteristic polynomial of the n-th principal submatrix of (f(i,j)), where f(i,j)=(1 if i=1 or j=1 or i=j, and 0 otherwise) as in A204177.

The 60 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A204178

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, -1, 0, -2, 1, -1, -1, 3, -1, -2,
    2, 3, -4, 1, -3, 7, -2, -6, 5, -1,
    -4, 14, -15, 0, 10, -6, 1, -5, 23, -39,
