import LOEIS.A204.A204026.Defs

set_option linter.unusedVariables false

/-!
# A204026

Symmetric matrix based on f(i,j)=min(F(i+1),F(j+1)), where F=A000045 (Fibonacci numbers), by antidiagonals.

The 96 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A204026

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 1, 2, 1, 1, 2, 2, 1,
    1, 2, 3, 2, 1, 1, 2, 3, 3, 2,
    1, 1, 2, 3, 5, 3, 2, 1, 1, 2,
    3, 5, 5, 3, 2, 1, 1, 2, 3, 5,
    8, 5, 3, 2, 1, 1, 2, 3, 5, 8,
    8, 5, 3, 2, 1, 1, 2, 3, 5, 8,
    13, 8, 5, 3, 2, 1, 1, 2, 3, 5,
    8, 13, 13, 8, 5, 3, 2, 1, 1, 2,
    3, 5, 8, 13, 21, 13, 8, 5, 3, 2,
    1, 1, 2, 3, 5, 8]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 97) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 97) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 97) : flatFz n = flatData[n.toNat - 1]! := sorry

end A204026
