import LOEIS.A082.A082002.Defs

set_option linter.unusedVariables false

/-!
# A082002

Square array read by antidiagonals, alternating upwards and downwards: T(1, 1) = 1 and every other entry is the smallest number not already used that has a common factor with every number in its row and column, not including the 1.

The 69 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A082002

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 3, 6, 12, 4, 8, 18, 10, 9,
    15, 24, 14, 30, 16, 20, 36, 22, 42, 40,
    21, 27, 28, 48, 54, 26, 45, 32, 34, 60,
    50, 66, 70, 56, 72, 33, 39, 44, 78, 84,
    80, 75, 38, 51, 46, 52, 69, 68, 90, 96,
    98, 102, 88, 104, 57, 63, 76, 108, 110, 114,
    105, 100, 120, 92, 117, 58, 62, 87, 126]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 70) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 70) : flatFn n = flatData[n - 1]! := sorry

