import LOEIS.A082.A082011.Defs

set_option linter.unusedVariables false

/-!
# A082011

Square array read by antidiagonals, alternating upwards and downwards: T(1,1) = 2 and every other entry is the smallest prime not already used such that the n-th antidiagonal sum is a multiple of n.

The 59 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A082011

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [2, 3, 5, 7, 13, 19, 11, 17, 23, 29,
    31, 37, 41, 43, 53, 47, 59, 61, 67, 71,
    73, 79, 83, 89, 97, 101, 103, 113, 107, 109,
    127, 131, 137, 139, 149, 157, 151, 163, 167, 173,
    179, 181, 191, 197, 227, 193, 199, 211, 223, 229,
    233, 239, 241, 251, 271, 257, 263, 269, 277]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 60) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 60) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 60) : flatFz n = flatData[n.toNat - 1]! := sorry

end A082011
