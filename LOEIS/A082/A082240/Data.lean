import LOEIS.A082.A082240.Defs

set_option linter.unusedVariables false

/-!
# A082240

Break up the cyclic concatenation 1234567890123456789023... into parts nontrivially (a(n) is not equal to n) such that the n-th part is a multiple of n.

The 11 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A082240

/-- Known terms of `A082240`, starting at index `1`. -/
def data : List retType :=
  [12, 34, 567, 8, 90, 12, 34567890, 123456, 789012, 34567890,
    123456789012345678901]

/-- `A082240` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 12) : A082240 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 12) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 12) : fz n = data[n.toNat - 1]! := sorry

end A082240
