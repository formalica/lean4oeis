import LOEIS.A221.A221999.Defs

set_option linter.unusedVariables false

/-!
# A221999

T(n,k)=Number of binary arrays indicating the locations of trailing edge maxima of a random length-n 0..k array extended with zeros and convolved with 1,4,6,4,1.

The 85 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A221999

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [2, 2, 3, 2, 3, 4, 2, 3, 4, 6,
    2, 3, 4, 6, 10, 2, 3, 4, 6, 10,
    15, 2, 3, 4, 6, 10, 15, 22, 2, 3,
