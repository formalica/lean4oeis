import LOEIS.A182.A182129.Defs

set_option linter.unusedVariables false

/-!
# A182129

Number of iterations of the orbit n -> (sum of the decimal digits of n)^n starting with n, needed to stabilize.

The 80 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A182129

/-- Known terms of `A182129`, starting at index `1`. -/
def data : List retType :=
  [0, 5, 3, 3, 5, 3, 3, 5, 5, 1,
    6, 6, 2, 6, 9, 5, 2, 6, 2, 7,
    5, 5, 6, 6, 6, 3, 5, 2, 9, 7,
    6, 13, 12, 9, 5, 9, 2, 10, 9, 7,
    15, 9, 7, 4, 7, 2, 6, 3, 7, 12,
