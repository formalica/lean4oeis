import LOEIS.A182.A182128.Defs

set_option linter.unusedVariables false

/-!
# A182128

Number of iterations of the map n -> (sum of the decimal digits of n)^3 before reaching the last number of the cycle.

The 87 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A182128

/-- Known terms of `A182128`, starting at index `0`. -/
def data : List retType :=
  [0, 0, 2, 3, 3, 2, 3, 3, 1, 2,
    1, 2, 3, 3, 2, 3, 3, 1, 2, 2,
    2, 3, 3, 2, 3, 3, 1, 2, 2, 2,
    3, 3, 2, 3, 3, 1, 2, 2, 2, 2,
    3, 2, 3, 3, 1, 2, 2, 2, 2, 3,
    2, 3, 3, 1, 2, 2, 2, 2, 3, 2,
    3, 3, 1, 2, 2, 2, 2, 3, 2, 2,
    3, 1, 2, 2, 2, 2, 3, 2, 2, 3,
    1, 2, 2, 2, 2, 3, 2]

/-- `A182128` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 87) : A182128 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 87) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 87) : fz n = data[n.toNat]! := sorry

end A182128
