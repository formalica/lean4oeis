    1000000, 110, 10000000, 10001, 1010, 100000000, 1000000000, 100001, 10000000000, 1100,
    10010, 1000001, 100000000000, 111, 1000000000000, 10000001, 100010, 10100, 10000000000000, 1011,
    100000000000000, 100000001, 1000010, 1000000001, 11000, 100100]

/-- `A182979` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 37) : A182979 n = data[n.val - 1]! := sorry

