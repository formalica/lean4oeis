import LOEIS.A182.A182309.Defs

set_option linter.unusedVariables false

/-!
# A182309

Triangle T(n,k) with 2 <= k <= floor(2(n+1)/3) gives the number of length-n binary sequences with exactly k zeros and with length two for the longest run of zeros.

The 64 terms known to OEIS, indexed from `2`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A182309

/-- Known terms of `flat`, starting at index `2`. -/
def flatData : List flatRetType :=
  [1, 2, 3, 2, 4, 6, 1, 5, 12, 6,
    6, 20, 18, 3, 7, 30, 40, 16, 1, 8,
    42, 75, 50, 10, 9, 56, 126, 120, 45, 4,
    10, 72, 196, 245, 140, 30, 1, 11, 90, 288,
    448, 350, 126, 15, 12, 110, 405, 756, 756, 392,
    90, 5, 13, 132, 550, 1200, 1470, 1008, 357, 50,
    1, 14, 156, 726]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 66) : flat n = flatData[n.val - 2]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 2 ≤ n) (h : n < 66) : flatFn n = flatData[n - 2]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 2 ≤ n) (h : n < 66) : flatFz n = flatData[n.toNat - 2]! := sorry

end A182309
