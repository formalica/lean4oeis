import LOEIS.A266.A266381.Defs

set_option linter.unusedVariables false

/-!
# A266381

Binary representation of the n-th iteration of the "Rule 22" elementary cellular automaton starting with a single ON (black) cell.

The 15 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A266381

/-- Known terms of `A266381`, starting at index `0`. -/
def data : List retType :=
  [1, 111, 10001, 1110111, 100000001, 11100000111, 1000100010001, 111011101110111, 10000000000000001, 1110000000000000111,
    100010000000000010001, 11101110000000001110111, 1000000010000000100000001, 111000001110000011100000111, 10001000100010001000100010001]

/-- `A266381` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 15) : A266381 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 15) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 15) : fz n = data[n.toNat]! := sorry

end A266381
