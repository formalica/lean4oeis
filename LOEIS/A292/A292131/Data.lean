import LOEIS.A292.A292131.Defs

set_option linter.unusedVariables false

/-!
# A292131

Square array A(n,k), n>=0, k>=0, read by antidiagonals, where column k is the expansion of Product_{j>=1} (1 - k*x^j).

The 73 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A292131

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, 1, 0, 1, -1, 0, 1, -2, -1, 0,
    1, -3, -2, 0, 0, 1, -4, -3, 2, 0,
    0, 1, -5, -4, 6, 2, 1, 0, 1, -6,
    -5, 12, 6, 6, 0, 0, 1, -7, -6, 20,
    12, 15, -2, 1, 0, 1, -8, -7, 30, 20,
    28, -12, 2, 0, 0, 1, -9, -8, 42, 30,
    45, -36, -3, -6, 0, 0, 1, -10, -9, 56,
    42, 66, -80]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 73) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 73) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 73) : flatFz n = flatData[n.toNat]! := sorry

end A292131
