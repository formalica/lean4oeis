import LOEIS.A034.A034254.Defs

set_option linter.unusedVariables false

/-!
# A034254

Triangle read by rows giving T(n,k) = number of inequivalent indecomposable linear [ n,k ] binary codes without 0 columns (n >= 2, 1 <= k <= n).

The 78 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A034254

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 1, 1, 1, 1, 2, 2, 1,
    1, 3, 5, 3, 1, 1, 4, 10, 10, 4,
    1, 1, 5, 18, 28, 18, 5, 1, 1, 7,
