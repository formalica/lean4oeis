import LOEIS.A069.A069323.Defs

set_option linter.unusedVariables false

/-!
# A069323

Triangle in which n-th row gives ascending sequence of numbers derived from the (3x+1) problem, beginning with n. Numbers in one row share the same number of iteration steps required to reach the value of '1' when applying the (3x+1) algorithm. Each row terminates with a power of 2.

The 54 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A069323

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 3, 20, 128, 4, 5, 32, 6, 40,
    256, 7, 44, 272, 1664, 10240, 65536, 8, 9, 56,
    352, 2176, 13312, 81920, 524288, 10, 64, 11, 68, 416,
    2560, 16384, 12, 80, 512, 13, 80, 512, 14, 88,
    544, 3328, 20480, 131072, 15, 92, 560, 3392, 20480, 131072,
    16, 17, 104, 640]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 55) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 55) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
