import LOEIS.A069.A069800.Defs

set_option linter.unusedVariables false

/-!
# A069800

Triangular array in which n-th row consists of zeroless numbers with digit sum n arranged in increasing numerical order.

The 63 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A069800

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 11, 3, 12, 21, 111, 4, 13, 22,
    31, 112, 121, 211, 1111, 5, 14, 23, 32, 41,
    113, 122, 131, 212, 221, 311, 1112, 1121, 1211, 2111,
    11111, 6, 15, 24, 33, 42, 51, 114, 123, 132,
    141, 213, 222, 231, 312, 321, 411, 1113, 1122, 1131,
