-/

namespace A119984

/-- Known terms of `A119984`, starting at index `1`. -/
def data : List retType :=
  [2, 3, 4, 5, 6, 7, 9, 10, 14, 15,
    23, 32, 33, 72, 83, 84, 87, 97, 104, 105,
