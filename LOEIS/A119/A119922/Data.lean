import LOEIS.A119.A119922.Defs

set_option linter.unusedVariables false

/-!
# A119922

Continued fraction expansion of the value of Minkowski's question mark function at 6/Pi^2.

The 100 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A119922

/-- Known terms of `A119922`, starting at index `0`. -/
def data : List retType :=
  [0, 1, 1, 1, 2, 2, 4, 4, 1, 2,
    1, 3, 1, 1, 11, 1, 1, 1, 1, 5,
    1, 4, 2, 3, 2, 5, 34, 1, 1, 1,
    1, 1, 7, 5, 7, 2, 71, 1, 57, 5,
    3, 7, 1, 9, 1, 8, 1, 5, 2, 1,
    2, 1, 2, 2, 14, 34, 1, 1, 7, 14,
    1, 1, 2, 1, 19, 1, 1, 8, 1, 6,
    1, 3, 1, 3, 1, 9, 1, 9, 3, 1,
    6, 1, 1, 6, 3, 1, 3, 3, 4, 2,
    42, 21, 1, 1, 1, 2, 8, 3, 1, 5]

/-- `A119922` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 100) : A119922 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 100) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 100) : fz n = data[n.toNat]! := sorry

end A119922
