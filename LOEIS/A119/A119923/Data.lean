import LOEIS.A119.A119923.Defs

set_option linter.unusedVariables false

/-!
# A119923

Decimal expansion of the value of Minkowski's question mark function at 6/Pi^2.

The 105 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A119923

/-- Known terms of `A119923`, starting at index `0`. -/
def data : List retType :=
  [6, 3, 0, 9, 8, 0, 9, 4, 5, 2,
    5, 0, 4, 5, 2, 2, 2, 9, 7, 8,
    4, 7, 4, 7, 7, 9, 7, 6, 1, 9,
    1, 8, 3, 3, 5, 3, 9, 4, 3, 0,
    8, 6, 0, 6, 6, 4, 0, 7, 6, 1,
    3, 2, 1, 3, 1, 9, 4, 4, 3, 4,
    6, 2, 9, 4, 7, 8, 8, 0, 6, 6,
    4, 0, 0, 7, 7, 0, 9, 8, 6, 3,
    0, 3, 1, 6, 5, 2, 9, 5, 3, 7,
    3, 0, 0, 2, 7, 4, 8, 5, 6, 3,
    6, 1, 9, 7, 1]

/-- `A119923` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 105) : A119923 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 105) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 105) : fz n = data[n.toNat]! := sorry

end A119923
