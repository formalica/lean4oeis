The 30 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A119917

/-- Known terms of `A119917`, starting at index `1`. -/
def data : List retType :=
  [1, 3, 9, 21, 51, 105, 231, 471, 975, 1965,
    4011, 8031, 16221, 32475, 65205, 130485, 261555, 523131, 1047417, 2094957,
