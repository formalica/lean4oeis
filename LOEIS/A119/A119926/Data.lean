import LOEIS.A119.A119926.Defs

set_option linter.unusedVariables false

/-!
# A119926

Continued fraction expansion of the value of Minkowski's question mark function at 1/Pi.

The 46 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A119926

/-- Known terms of `A119926`, starting at index `0`. -/
def data : List retType :=
  [0, 4, 31, 1, 3, 127, 1, 2, 1, 31,
    4, 369609730464587576881796108788303489874280580713009640661874741394877821854816844, 1, 1, 2, 2, 61, 4, 8, 1,
    1, 1, 1, 4, 3, 1, 2, 1, 9, 2,
    5, 1, 3, 3, 10, 2, 1, 1, 1, 1,
    1, 8, 5, 1, 12, 3]

/-- `A119926` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 46) : A119926 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 46) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 46) : fz n = data[n.toNat]! := sorry

end A119926
