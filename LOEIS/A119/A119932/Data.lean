import LOEIS.A119.A119932.Defs

set_option linter.unusedVariables false

/-!
# A119932

Triangle of denominators of the cube of a certain lower triangular matrix.

The 32 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A119932

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 8, 8, 108, 108, 27, 576, 576, 576, 64,
    18000, 18000, 18000, 2000, 125, 21600, 21600, 21600, 21600, 5400,
    216, 1234800, 1234800, 1234800, 1234800, 308700, 12348, 343, 5644800, 5644800,
    5644800, 5644800]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 33) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 33) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 33) : flatFz n = flatData[n.toNat - 1]! := sorry

end A119932
