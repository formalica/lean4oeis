set_option linter.unusedVariables false

/-!
# A119937

Triangle of numbers related to the spectrum of the hydrogen (H) atom.

The 35 terms known to OEIS, indexed from `2`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A119937

/-- Known terms of `flat`, starting at index `2`. -/
def flatData : List flatRetType :=
  [3, 32, 5, 135, 27, 7, 3456, 756, 256, 81,
    3500, 800, 300, 125, 44, 172800, 40500, 16000, 7425, 3456,
    1300, 694575, 165375, 67375, 33075, 17199, 8575, 3375, 6272000, 1509200,
