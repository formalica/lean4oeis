set_option linter.unusedVariables false

/-!
# A119946

Final digit sum of numerical values of German names of the nonnegative numbers.

The 81 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A119946

/-- Known terms of `A119946`, starting at index `0`. -/
def data : List retType :=
  [5, 2, 9, 9, 9, 7, 9, 9, 5, 9,
    8, 5, 6, 8, 8, 6, 8, 7, 4, 8,
    7, 2, 1, 1, 1, 8, 1, 1, 6, 1,
