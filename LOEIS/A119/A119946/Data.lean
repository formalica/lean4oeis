/-- `A119946` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 81) : A119946 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 81) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 81) : fz n = data[n.toNat]! := sorry

end A119946
