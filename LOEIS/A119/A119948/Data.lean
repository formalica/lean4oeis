import LOEIS.A119.A119948.Defs

set_option linter.unusedVariables false

/-!
# A119948

Triangle of denominators in the square of the matrix with A[i,j] = 1/i for j <= i, 0 otherwise.

The 42 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A119948

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 4, 4, 18, 18, 9, 48, 48, 48, 16,
    300, 300, 300, 100, 25, 120, 120, 120, 360, 180,
    36, 980, 980, 980, 2940, 1470, 294, 49, 2240, 2240,
    2240, 6720, 6720, 1344, 448, 64, 22680, 22680, 22680, 22680,
    22680, 4536]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 43) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 43) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 43) : flatFz n = flatData[n.toNat - 1]! := sorry

end A119948
