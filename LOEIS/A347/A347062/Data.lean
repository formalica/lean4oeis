import LOEIS.A347.A347062.Defs

set_option linter.unusedVariables false

/-!
# A347062

Record the number of zero terms having a following term, then the number of terms equal to 1 having a following term, then 2, 3, etc. until recording a zero, whereupon the count is reset.

The 86 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A347062

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [0, 0, 1, 0, 2, 1, 1, 0, 3, 3,
    1, 2, 0, 4, 4, 2, 2, 2, 0, 5,
    4, 5, 2, 3, 2, 0, 6, 4, 7, 3,
    4, 2, 1, 1, 0, 7, 6, 8, 4, 5,
    2, 2, 2, 1, 0, 8, 7, 11, 4, 6,
    3, 3, 3, 2, 0, 9, 7, 12, 7, 7,
    3, 3, 6, 2, 1, 0, 10, 8, 13, 9,
    7, 3, 4, 7, 3, 2, 1, 1, 1, 1,
    0, 11, 12, 14, 11, 8]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 86) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 86) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 86) : flatFz n = flatData[n.toNat]! := sorry

end A347062
