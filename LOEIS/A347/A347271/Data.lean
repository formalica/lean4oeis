import LOEIS.A347.A347271.Defs

set_option linter.unusedVariables false

/-!
# A347271

Irregular triangle T(n,k) read by rows in which row n lists the terms of the 3x+1 trajectory of n, but the row ends when a term is a power of 2 or when a term is less than n, with n >= 1 and k >= 0.

The 73 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A347271

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 3, 10, 5, 16, 4, 5, 16, 6,
    3, 7, 22, 11, 34, 17, 52, 26, 13, 40,
    20, 10, 5, 8, 9, 28, 14, 7, 10, 5,
    11, 34, 17, 52, 26, 13, 40, 20, 10, 12,
    6, 13, 40, 20, 10, 14, 7, 15, 46, 23,
    70, 35, 106, 53, 160, 80, 40, 20, 10, 16,
    17, 52, 26, 13, 18, 9, 19, 58, 29, 88,
    44, 22, 11]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 74) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 74) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 74) : flatFz n = flatData[n.toNat - 1]! := sorry

end A347271
