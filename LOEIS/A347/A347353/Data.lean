import LOEIS.A347.A347353.Defs

set_option linter.unusedVariables false

/-!
# A347353

Lexicographically earliest sequence of distinct positive terms such that the rightmost digit of a(n) concatenated with the leftmost digit of a(n+1) form an integer that is the sum of the digits of a(n) and a(n+1).

The 35 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A347353

/-- Known terms of `A347353`, starting at index `1`. -/
def data : List retType :=
  [1, 19, 1899999999, 29, 1799999999, 119, 1889999999, 128, 169999999, 1299,
    178999999, 1389, 179899999, 1398, 15999999, 13999, 16899999, 14899, 16989999, 14989,
    16998999, 14998, 1499999, 149999, 1589999, 158999, 1598999, 159899, 1599899, 159989,
    1599989, 159998, 139999, 1599999, 148999]

/-- `A347353` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 36) : A347353 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 36) : fn n = data[n - 1]! := sorry

