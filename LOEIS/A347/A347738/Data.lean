import LOEIS.A347.A347738.Defs

set_option linter.unusedVariables false

/-!
# A347738

A variant of the inventory sequence: record the number of terms >= 0 thus far in the sequence, then the number of terms >= 1 thus far, then the number of terms >= 2 thus far, and so on, until a zero is recorded; the inventory then starts again, recording the number of terms >= 0, etc.

The 77 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A347738

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [0, 1, 1, 0, 4, 3, 2, 2, 1, 0,
    10, 8, 6, 5, 5, 5, 3, 2, 2, 1,
    1, 0, 22, 19, 15, 12, 11, 11, 9, 9,
    10, 10, 9, 6, 4, 3, 3, 3, 2, 2,
    2, 2, 1, 1, 1, 0, 46, 42, 35, 28,
    24, 23, 21, 20, 21, 21, 19, 17, 16, 16,
    17, 18, 18, 17, 15, 13, 11, 10, 7, 6,
    5, 4, 4, 4, 4, 3, 3]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 77) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 77) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 77) : flatFz n = flatData[n.toNat]! := sorry

end A347738
