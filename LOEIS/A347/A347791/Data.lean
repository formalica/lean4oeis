import LOEIS.A347.A347791.Defs

set_option linter.unusedVariables false

/-!
# A347791

Inventory sequence using prime divisors (with multiplicity): Record the number of terms thus far which are divisible by every prime, then the number of terms thus far not divisible by any prime, then the number divisible (once) by a single prime, then 2 (including with multiplicity), then 3 etc until a zero is recorded. Repeat after every zero term.

The 81 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A347791

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [0, 1, 1, 0, 2, 2, 2, 0, 3, 2,
    5, 0, 4, 2, 7, 1, 0, 5, 3, 10,
    2, 0, 6, 3, 12, 3, 1, 0, 7, 4,
    14, 5, 1, 0, 8, 5, 16, 5, 2, 1,
    0, 9, 6, 18, 7, 3, 1, 0, 10, 7,
    21, 9, 3, 1, 0, 11, 8, 23, 10, 4,
    1, 0, 12, 9, 24, 13, 5, 2, 0, 13,
    9, 28, 14, 6, 2, 0, 14, 9, 29, 18,
    7]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 81) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 81) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 81) : flatFz n = flatData[n.toNat]! := sorry

end A347791
