import LOEIS.A347.A347358.Defs

set_option linter.unusedVariables false

/-!
# A347358

The prime numbers visited on a square spiral when starting at 1 and then stepping to the smallest unvisited prime number that is visible from the current number.

The 66 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A347358

/-- Known terms of `A347358`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 3, 11, 5, 13, 29, 17, 7, 19,
    31, 23, 37, 53, 41, 61, 43, 59, 47, 71,
    83, 67, 89, 73, 101, 79, 107, 127, 97, 131,
