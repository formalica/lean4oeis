import LOEIS.A120.A120255.Defs

set_option linter.unusedVariables false

/-!
# A120255

Array read by rows, where the n-th row (of A120256(n) terms) lists the positive divisors, not occurring earlier in the array, of the n-th Fibonacci number.

The 62 terms known to OEIS, indexed from `2`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A120255

/-- Known terms of `flat`, starting at index `2`. -/
def flatData : List flatRetType :=
  [1, 2, 3, 5, 4, 8, 13, 7, 21, 17,
    34, 11, 55, 89, 6, 9, 12, 16, 18, 24,
    36, 48, 72, 144, 233, 29, 377, 10, 61, 122,
    305, 610, 47, 141, 329, 987, 1597, 19, 38, 68,
    76, 136, 152, 323, 646, 1292, 2584, 37, 113, 4181,
    15, 33, 41, 123, 165, 205, 451, 615, 1353, 2255,
    6765, 26]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 64) : flat n = flatData[n.val - 2]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 2 ≤ n) (h : n < 64) : flatFn n = flatData[n - 2]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 2 ≤ n) (h : n < 64) : flatFz n = flatData[n.toNat - 2]! := sorry

end A120255
