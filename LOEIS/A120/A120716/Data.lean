/-!
# A120716

a(1)=1, a(p)=p if p is a prime. Otherwise, start with n and iterate the map (k -> concatenation of nontrivial divisors of k) until we reach a prime q; then a(n) = q. If we never reach a prime, a(n) = -1.

The 7 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A120716

/-- Known terms of `A120716`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 3, 2, 5, 23, 7]

/-- `A120716` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 8) : A120716 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 8) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 8) : fz n = data[n.toNat - 1]! := sorry

end A120716
