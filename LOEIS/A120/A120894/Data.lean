import LOEIS.A120.A120894.Defs

set_option linter.unusedVariables false

/-!
# A120894

Cascadence of 1+x+x^2; a triangle, read by rows of 2n+1 terms, that retains its original form upon convolving each row with [1,1,1] and then letting excess terms spill over from each row into the initial positions of the next row such that only 2n+1 terms remain in row n for n>=0.

The 67 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A120894

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 1, 2, 3, 2, 1, 2, 5,
    7, 6, 5, 3, 2, 5, 12, 18, 18, 14,
    10, 10, 7, 5, 12, 30, 48, 50, 42, 34,
    27, 22, 24, 17, 12, 30, 78, 128, 140, 126,
    103, 83, 73, 63, 53, 59, 42, 30, 78, 206,
    346, 394, 369, 312, 259, 219, 189, 175, 154, 131,
    150, 108, 78, 206, 552, 946, 1109]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 67) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 67) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 67) : flatFz n = flatData[n.toNat]! := sorry

end A120894
