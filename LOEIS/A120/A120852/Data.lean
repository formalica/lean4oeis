import LOEIS.A120.A120852.Defs

set_option linter.unusedVariables false

/-!
# A120852

Triangle read by rows, where t(n,1) = 1, t(n,m) = t(n,m-1) + (largest noncomposite {1 or prime} in row {n-1}).

The 66 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A120852

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 2, 1, 3, 5, 1, 6, 11, 16,
    1, 12, 23, 34, 45, 1, 24, 47, 70, 93,
    116, 1, 48, 95, 142, 189, 236, 283, 1, 284,
    567, 850, 1133, 1416, 1699, 1982, 1, 1700, 3399, 5098,
