import LOEIS.A120.A120898.Defs

set_option linter.unusedVariables false

/-!
# A120898

Cascadence of 1+2x+x^2; a triangle, read by rows of 2n+1 terms, that retains its original form upon convolving each row with [1,2,1] and then letting excess terms spill over from each row into the initial positions of the next row such that only 2n+1 terms remain in row n for n>=0.

The 58 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A120898

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, 2, 1, 2, 5, 6, 5, 2, 5, 16,
    22, 18, 14, 12, 5, 16, 54, 78, 72, 58,
    43, 38, 37, 16, 54, 186, 282, 280, 231, 182,
    156, 128, 123, 124, 54, 186, 654, 1030, 1073, 924,
    751, 622, 535, 498, 425, 418, 426, 186, 654, 2338,
    3787, 4100, 3672, 3048, 2530, 2190, 1956, 1766]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 58) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 58) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 58) : flatFz n = flatData[n.toNat]! := sorry

end A120898
