import LOEIS.A120.A120094.Defs

set_option linter.unusedVariables false

/-!
# A120094

Rows of Pascal's triangle which contain no terms numerically adjacent to odd primes (the 1's at either end are of course numerically adjacent to the even prime 2).

The 13 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A120094

/-- Known terms of `A120094`, starting at index `1`. -/
def data : List retType :=
  [7, 15, 31, 63, 81, 127, 239, 255, 470, 511,
    1023, 2047, 4095]

/-- `A120094` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 14) : A120094 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 14) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 14) : fz n = data[n.toNat - 1]! := sorry

end A120094
