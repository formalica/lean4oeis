import LOEIS.A120.A120442.Defs

set_option linter.unusedVariables false

/-!
# A120442

P-positions of John H. Conway's "Digit Deletions" game from "On Numbers and Games". Each number is the smallest positive integer that cannot be reduced to an earlier number in the sequence, by performing one of the following two operations: (1) changing one digit to a smaller digit (but not changing the leading digit to 0), or (2) deleting a 0 and all subsequent digits.

The 50 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A120442

/-- Known terms of `A120442`, starting at index `1`. -/
def data : List retType :=
  [1, 11, 20, 32, 43, 54, 65, 76, 87, 98,
    111, 120, 132, 143, 154, 165, 176, 187, 198, 201,
    210, 222, 233, 244, 255, 266, 277, 288, 299, 300,
    312, 321, 334, 345, 353, 367, 378, 386, 402, 413,
    424, 431, 440, 456, 468, 475, 489, 497, 503, 514]

/-- `A120442` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 51) : A120442 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 51) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 51) : fz n = data[n.toNat - 1]! := sorry

end A120442
