set_option linter.unusedVariables false

/-!
# A062129

In base 2: start with n; add to itself with digits reversed; if palindrome, stop; otherwise repeat; a(n) gives palindrome at which it stops, or -1 if no palindrome is ever reached.

The 43 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A062129

/-- Known terms of `A062129`, starting at index `0`. -/
def data : List retType :=
  [0, 11, 11, 1001, 101, 1111, 1001, 10101, 1001, 11011,
    1111, 11011, 1111, 11011, 10101, 101101, 10001, 110011, 11011, 1100011,
    1100011, 111111, -1, 111111, 11011, 1100011, -1, 11111111, -1, 111111,
    101101, 1011101, 100001, 1100011, 110011, -1, 101101, -1, 111111, 1100011,
    101101, -1, 111111]

/-- `A062129` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 43) : A062129 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 43) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
