import LOEIS.A062.A062128.Defs

set_option linter.unusedVariables false

/-!
# A062128

In base 2: start with n; if palindrome, stop; otherwise add to itself with digits reversed; a(n) gives palindrome at which it stops, or -1 if no palindrome is ever reached.

The 45 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A062128

/-- Known terms of `A062128`, starting at index `0`. -/
def data : List retType :=
  [0, 1, 11, 11, 101, 101, 1001, 111, 1001, 1001,
    1111, 11011, 1111, 11011, 10101, 1111, 10001, 10001, 11011, 1100011,
    1100011, 10101, -1, 111111, 11011, 1100011, -1, 11011, -1, 111111,
    101101, 11111, 100001, 100001, 110011, -1, 101101, -1, 111111, 1100011,
    101101, -1, 111111, 1100011, 1100011]

/-- `A062128` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 45) : A062128 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 45) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 45) : fz n = data[n.toNat]! := sorry

end A062128
