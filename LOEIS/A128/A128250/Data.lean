import LOEIS.A128.A128250.Defs

set_option linter.unusedVariables false

/-!
# A128250

LCG periods: periods of the output sequences produced by multiplicative linear congruential generators (LCGs) with prime moduli, for all valid combinations of multiplier and modulus.

The 69 terms known to OEIS, indexed from `2`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A128250

/-- Known terms of `flat`, starting at index `2`. -/
def flatData : List flatRetType :=
  [1, 1, 2, 1, 4, 4, 2, 1, 3, 6,
    3, 6, 2, 1, 10, 5, 5, 5, 10, 10,
    10, 5, 2, 1, 12, 3, 6, 4, 12, 12,
    4, 3, 6, 12, 2, 1, 8, 16, 4, 16,
    16, 16, 8, 8, 16, 16, 16, 4, 16, 8,
    2, 1, 18, 18, 9, 9, 9, 3, 6, 9,
    18, 3, 6, 18, 18, 18, 9, 9, 2]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 71) : flat n = flatData[n.val - 2]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 2 ≤ n) (h : n < 71) : flatFn n = flatData[n - 2]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 2 ≤ n) (h : n < 71) : flatFz n = flatData[n.toNat - 2]! := sorry

end A128250
