/-!
# A128716

Triangle where the n-th row, of n terms in order, contains consecutive multiples of n. The smallest term of row n is the smallest integer greater than or equal to the largest term of row (n-1), for n >= 2.

The 59 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A128716

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 4, 6, 9, 12, 12, 16, 20, 24,
    25, 30, 35, 40, 45, 48, 54, 60, 66, 72,
    78, 84, 91, 98, 105, 112, 119, 126, 128, 136,
    144, 152, 160, 168, 176, 184, 189, 198, 207, 216,
    225, 234, 243, 252, 261, 270, 280, 290, 300, 310,
    320, 330, 340, 350, 360, 363, 374, 385, 396]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 60) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
