set_option linter.unusedVariables false

/-!
# A128384

a(n) = numerator of r(n): r(n) is such that the continued fraction (of rational terms) [r(1);r(2),...,r(n)] = b(n) for every positive integer n, where b(1) = 1 and b(n+1) = 1 + 1/b(n)^2 for.every positive integer n.

The 9 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A128384

/-- Known terms of `A128384`, starting at index `1`. -/
def data : List retType :=
  [1, 1, 1, 9, 91, 1110627, 2340346013551, 1153990596161360976412397283, 4046008078695782327150934410204261346038863974869654053]

/-- `A128384` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 10) : A128384 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 10) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 10) : fz n = data[n.toNat - 1]! := sorry

end A128384
