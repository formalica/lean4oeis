import LOEIS.A128.A128505.Defs

set_option linter.unusedVariables false

/-!
# A128505

Irregular triangular array a(n,m) for third (k=3) convolution of Chebyshev's S(n,x) = U(n,x/2) polynomials, read by rows (n >=0, 0 <= m <= floor(n/2)).

The 53 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A128505

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, 4, 10, -4, 20, -20, 35, -60, 10, 56,
    -140, 60, 84, -280, 210, -20, 120, -504, 560, -140,
    165, -840, 1260, -560, 35, 220, -1320, 2520, -1680, 280,
    286, -1980, 4620, -4200, 1260, -56, 364, -2860, 7920, -9240,
    4200, -504, 455, -4004, 12870, -18480, 11550, -2520, 84, 560,
    -5460, 20020, -34320]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 53) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 53) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 53) : flatFz n = flatData[n.toNat]! := sorry

end A128505
