import LOEIS.A213.A213126.Defs

set_option linter.unusedVariables false

/-!
# A213126

Rows of triangle formed using Pascal's rule, except sums in the n-th row are modulo n: T(n,0) = T(n,n) = 1 and T(n,k) = (T(n-1,k-1) + T(n-1,k)) mod n.

The 86 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A213126

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 1, 0, 1, 1, 1, 1, 1,
    1, 2, 2, 2, 1, 1, 3, 4, 4, 3,
    1, 1, 4, 1, 2, 1, 4, 1, 1, 5,
    5, 3, 3, 5, 5, 1, 1, 6, 2, 0,
    6, 0, 2, 6, 1, 1, 7, 8, 2, 6,
    6, 2, 8, 7, 1, 1, 8, 5, 0, 8,
    2, 8, 0, 5, 8, 1, 1, 9, 2, 5,
    8, 10, 10, 8, 5, 2, 9, 1, 1, 10,
    11, 7, 1, 6, 8, 6]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 86) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 86) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 86) : flatFz n = flatData[n.toNat]! := sorry

end A213126
