set_option linter.unusedVariables false

/-!
# A359999

Most common cycle length in the 2-Fibonacci digraph of order n. In case of ties, choose the largest length.

The 10 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A359999

/-- Known terms of `A359999`, starting at index `1`. -/
def data : List retType :=
  [2, 3, 4, 5, 11, 11, 24, 32, 59, 92]

/-- `A359999` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 11) : A359999 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 11) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 11) : fz n = data[n.toNat - 1]! := sorry

end A359999
