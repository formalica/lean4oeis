import LOEIS.A359.A359010.Defs

set_option linter.unusedVariables false

/-!
# A359010

Variant of the inventory sequence: Record the number of terms whose value occurs once thus far in the sequence, then the number of terms whose value occurs twice thus far, and so on; a row ends when a 0 that would repeat infinitely is reached.

The 86 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A359010

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [0, 1, 0, 1, 4, 0, 1, 0, 3, 4,
    0, 1, 2, 0, 4, 0, 2, 2, 6, 4,
    0, 2, 0, 0, 12, 0, 3, 2, 0, 8,
    5, 0, 4, 2, 0, 4, 0, 12, 0, 3,
    2, 3, 8, 0, 6, 7, 0, 2, 6, 3,
    4, 5, 0, 7, 8, 0, 0, 6, 3, 8,
    0, 6, 7, 8, 0, 0, 4, 3, 4, 10,
    0, 7, 8, 9, 0, 2, 4, 0, 8, 5,
    0, 14, 0, 9, 10, 0]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 87) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 87) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 87) : flatFz n = flatData[n.toNat - 1]! := sorry

end A359010
