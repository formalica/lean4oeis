import LOEIS.A035.A035517.Defs

set_option linter.unusedVariables false

/-!
# A035517

Triangular array read by rows, formed from Zeckendorf expansion of integers: repeatedly subtract the largest Fibonacci number you can until nothing remains. Row n give Z. expansion of n.

The 90 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A035517

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [0, 1, 2, 3, 1, 3, 5, 1, 5, 2,
    5, 8, 1, 8, 2, 8, 3, 8, 1, 3,
    8, 13, 1, 13, 2, 13, 3, 13, 1, 3,
    13, 5, 13, 1, 5, 13, 2, 5, 13, 21,
    1, 21, 2, 21, 3, 21, 1, 3, 21, 5,
    21, 1, 5, 21, 2, 5, 21, 8, 21, 1,
    8, 21, 2, 8, 21, 3, 8, 21, 1, 3,
    8, 21, 34, 1, 34, 2, 34, 3, 34, 1,
    3, 34, 5, 34, 1, 5, 34, 2, 5, 34]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 90) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 90) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 90) : flatFz n = flatData[n.toNat]! := sorry

end A035517
