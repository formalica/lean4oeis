import LOEIS.A035.A035306.Defs

set_option linter.unusedVariables false

/-!
# A035306

List prime factors of each number in order (each prime factor is followed by its power). Start with 1 = {1,1}.

The 97 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A035306

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 2, 1, 3, 1, 2, 2, 5, 1,
    2, 1, 3, 1, 7, 1, 2, 3, 3, 2,
    2, 1, 5, 1, 11, 1, 2, 2, 3, 1,
    13, 1, 2, 1, 7, 1, 3, 1, 5, 1,
    2, 4, 17, 1, 2, 1, 3, 2, 19, 1,
    2, 2, 5, 1, 3, 1, 7, 1, 2, 1,
    11, 1, 23, 1, 2, 3, 3, 1, 5, 2,
    2, 1, 13, 1, 3, 3, 2, 2, 7, 1,
    29, 1, 2, 1, 3, 1, 5, 1, 31, 1,
    2, 5, 3, 1, 11, 1, 2]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 98) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 98) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 98) : flatFz n = flatData[n.toNat - 1]! := sorry

end A035306
