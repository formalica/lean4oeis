import LOEIS.A114.A114994.Defs

set_option linter.unusedVariables false

/-!
# A114994

Numbers whose binary representation has monotonically decreasing sizes of groups of zeros (including zero-length groups between adjacent ones).

The 65 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A114994

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [0, 1, 2, 3, 4, 5, 7, 8, 9, 10,
    11, 15, 16, 17, 18, 19, 21, 23, 31, 32,
    33, 34, 35, 36, 37, 39, 42, 43, 47, 63,
    64, 65, 66, 67, 68, 69, 71, 73, 74, 75,
    79, 85, 87, 95, 127, 128, 129, 130, 131, 132,
    133, 135, 136, 137, 138, 139, 143, 146, 147, 149,
    151, 159, 170, 171, 175]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 65) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 65) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 65) : flatFz n = flatData[n.toNat]! := sorry

end A114994
