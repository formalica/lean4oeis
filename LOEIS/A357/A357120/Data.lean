import LOEIS.A357.A357120.Defs

set_option linter.unusedVariables false

/-!
# A357120

Irregular triangle T(n, k), n > 0, k = 1..A278043(n); the n-th row contains, in ascending order, the terms in the greedy tribonacci representation of n.

The 81 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A357120

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 1, 2, 4, 1, 4, 2, 4, 7,
    1, 7, 2, 7, 1, 2, 7, 4, 7, 1,
    4, 7, 13, 1, 13, 2, 13, 1, 2, 13,
    4, 13, 1, 4, 13, 2, 4, 13, 7, 13,
    1, 7, 13, 2, 7, 13, 1, 2, 7, 13,
    24, 1, 24, 2, 24, 1, 2, 24, 4, 24,
    1, 4, 24, 2, 4, 24, 7, 24, 1, 7,
    24, 2, 7, 24, 1, 2, 7, 24, 4, 7,
    24]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 82) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 82) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 82) : flatFz n = flatData[n.toNat - 1]! := sorry

end A357120
