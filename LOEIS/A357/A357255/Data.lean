import LOEIS.A357.A357255.Defs

set_option linter.unusedVariables false

/-!
# A357255

Triangular array: row n gives the recurrence coefficients for the sequence (c(k) = number of subsets of {1,2,...,n} that have at least k-1 elements) for k >= 1.

The 55 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A357255

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [2, 3, -2, 4, -5, 2, 5, -9, 7, -2,
    6, -14, 16, -9, 2, 7, -20, 30, -25, 11,
    -2, 8, -27, 50, -55, 36, -13, 2, 9, -35,
    77, -105, 91, -49, 15, -2, 10, -44, 112, -182,
    196, -140, 64, -17, 2, 11, -54, 156, -294, 378,
    -336, 204, -81, 19, -2]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 56) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 56) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 56) : flatFz n = flatData[n.toNat - 1]! := sorry

end A357255
