import LOEIS.A357.A357121.Defs

set_option linter.unusedVariables false

/-!
# A357121

Irregular triangle T(n, k), n > 0, k = 1..A352104(n); the n-th row contains, in ascending order, the terms in the lazy tribonacci representation of n.

The 82 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A357121

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 1, 2, 4, 1, 4, 2, 4, 1,
    2, 4, 1, 7, 2, 7, 1, 2, 7, 4,
    7, 1, 4, 7, 2, 4, 7, 1, 2, 4,
    7, 2, 13, 1, 2, 13, 4, 13, 1, 4,
    13, 2, 4, 13, 1, 2, 4, 13, 1, 7,
    13, 2, 7, 13, 1, 2, 7, 13, 4, 7,
    13, 1, 4, 7, 13, 2, 4, 7, 13, 1,
    2, 4, 7, 13, 4, 24, 1, 4, 24, 2,
    4, 24]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 83) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 83) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 83) : flatFz n = flatData[n.toNat - 1]! := sorry

end A357121
