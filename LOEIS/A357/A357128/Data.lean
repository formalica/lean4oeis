def data : List retType :=
  [6, 4, 10, 16, 32, 468, 464, 3576, 14954, 96000,
    403200]

/-- `A357128` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 11) : A357128 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 11) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 11) : fz n = data[n.toNat]! := sorry

end A357128
