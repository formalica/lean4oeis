import LOEIS.A255.A255381.Defs

set_option linter.unusedVariables false

/-!
# A255381

Number of strings of k+n decimal digits that contain one string of exactly k consecutive "0" digits, where k >= n.

The 20 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A255381

/-- Known terms of `A255381`, starting at index `0`. -/
def data : List retType :=
  [1, 18, 261, 3420, 42300, 504000, 5850000, 66600000, 747000000, 8280000000,
    90900000000, 990000000000, 10710000000000, 115200000000000, 1233000000000000, 13140000000000000, 139500000000000000, 1476000000000000000, 15570000000000000000, 163800000000000000000]

/-- `A255381` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 20) : A255381 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 20) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 20) : fz n = data[n.toNat]! := sorry

end A255381
