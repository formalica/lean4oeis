/-!
# A255602

Numbers k which are odd and squarefree and have the property that k is either a prime number or for every prime p dividing k, p+1 is not divisible by any of the other prime factors of k.

The 52 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A255602

/-- Known terms of `A255602`, starting at index `1`. -/
def data : List retType :=
  [1, 3, 5, 7, 11, 13, 17, 19, 21, 23,
    29, 31, 35, 37, 39, 41, 43, 47, 53, 55,
    57, 59, 61, 65, 67, 71, 73, 77, 79, 83,
    85, 89, 93, 97, 101, 103, 107, 109, 111, 113,
    115, 119, 127, 129, 131, 133, 137, 139, 143, 149,
    151, 155]

/-- `A255602` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 53) : A255602 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 53) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
