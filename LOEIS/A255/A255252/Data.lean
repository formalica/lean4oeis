import LOEIS.A255.A255252.Defs

set_option linter.unusedVariables false

/-!
# A255252

Expansion of psi(x) * psi(-x)^2 in powers of x where psi() is a Ramanujan theta function.

The 75 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A255252

/-- Known terms of `A255252`, starting at index `0`. -/
def data : List retType :=
  [1, -1, -1, 0, -2, 3, 2, 1, -1, -1,
    1, -2, 1, -3, -2, -2, 3, 1, -1, 4,
    3, -1, -1, 2, -4, 4, 1, 0, -1, -2,
    -3, -3, -4, 2, 3, -3, 0, 0, 5, 2,
    0, -3, 2, -1, 4, 1, 0, 1, 3, 0,
    -2, 2, -1, -2, -4, -5, 2, 0, -7, 3,
    -4, 3, 1, 5, 2, -5, -1, -1, -3, 4,
    -1, 3, 4, 1, 4]

/-- `A255252` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 75) : A255252 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 75) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 75) : fz n = data[n.toNat]! := sorry

end A255252
