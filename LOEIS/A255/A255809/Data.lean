import LOEIS.A255.A255809.Defs

set_option linter.unusedVariables false

/-!
# A255809

Infinite tree (flattened) generated as follows:  generation g(1) = (1); thereafter, putting h = 2^n, each (1,x(2),...,x(h)) in generation g(n) has 1st and 2nd offspring, namely (1,x(2),...,x(h),x(h)+1) and (1,x(2),...,x(h),x(h)+2).

The 86 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A255809

/-- Known terms of `A255809`, starting at index `1`. -/
def data : List retType :=
  [1, 1, 2, 1, 3, 1, 2, 3, 1, 2,
    4, 1, 3, 4, 1, 3, 5, 1, 2, 3,
    4, 1, 2, 3, 5, 1, 2, 4, 5, 1,
    2, 4, 6, 1, 3, 4, 5, 1, 3, 4,
    6, 1, 3, 5, 6, 1, 3, 5, 7, 1,
    2, 3, 4, 5, 1, 2, 3, 4, 6, 1,
    2, 3, 5, 6, 1, 2, 3, 5, 7, 1,
    2, 4, 5, 6, 1, 2, 4, 5, 7, 1,
    2, 4, 6, 7, 1, 2]

/-- `A255809` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 87) : A255809 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 87) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 87) : fz n = data[n.toNat - 1]! := sorry

end A255809
