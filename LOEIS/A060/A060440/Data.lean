/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 16) : flatFz n = flatData[n.toNat - 1]! := sorry

end A060440
