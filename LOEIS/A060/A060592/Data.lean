import LOEIS.A060.A060592.Defs

set_option linter.unusedVariables false

/-!
# A060592

Square table by antidiagonals of minimum number of moves between two positions in the Tower of Hanoi (with three pegs: 0,1,2), where with position n written in base 3, xyz means smallest disk is on peg z, second smallest is on peg y, third smallest on peg x, etc. and leading zeros indicate largest disks are all on peg 0.

The 105 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A060592

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [0, 1, 1, 1, 0, 1, 3, 1, 1, 3,
    3, 3, 0, 3, 3, 2, 3, 2, 2, 3,
    2, 3, 2, 2, 0, 2, 2, 3, 2, 2,
    1, 1, 1, 1, 2, 2, 3, 1, 3, 1,
    0, 1, 3, 1, 3, 7, 2, 2, 1, 1,
    1, 1, 2, 2, 7, 6, 6, 3, 2, 2,
    0, 2, 2, 3, 6, 6, 7, 5, 7, 2,
    3, 2, 2, 3, 2, 7, 5, 7, 6, 6,
    6, 6, 3, 3, 0, 3, 3, 6, 6, 6,
    6, 7, 5, 7, 5, 5, 3, 1, 1, 3,
    5, 5, 7, 5, 7]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 105) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 105) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 105) : flatFz n = flatData[n.toNat]! := sorry

end A060592
