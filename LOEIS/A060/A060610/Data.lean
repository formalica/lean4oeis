import LOEIS.A060.A060610.Defs

set_option linter.unusedVariables false

/-!
# A060610

Repeatedly apply Euler phi to the n-th prime; a(n) is the number of terms in the resulting iteration chain which are not powers of 2 (number of initial iterations until reaching the first power of 2).

The 105 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A060610

/-- Known terms of `A060610`, starting at index `1`. -/
def data : List retType :=
  [0, 1, 1, 2, 2, 2, 1, 3, 3, 3,
    2, 3, 2, 3, 4, 3, 4, 2, 3, 3,
    3, 3, 3, 3, 2, 3, 2, 4, 4, 3,
    4, 3, 2, 4, 4, 3, 3, 5, 4, 4,
    4, 3, 4, 2, 4, 3, 3, 4, 4, 4,
    4, 3, 2, 4, 1, 4, 4, 4, 4, 3,
    5, 4, 3, 3, 3, 4, 3, 3, 5, 4,
    3, 5, 3, 3, 5, 5, 3, 3, 3, 2,
    4, 3, 4, 4, 4, 3, 3, 4, 4, 3,
    5, 4, 6, 4, 4, 5, 5, 3, 4, 4,
    4, 5, 4, 4, 4]

/-- `A060610` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 106) : A060610 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 106) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 106) : fz n = data[n.toNat - 1]! := sorry

end A060610
