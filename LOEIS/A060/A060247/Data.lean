import LOEIS.A060.A060247.Defs

set_option linter.unusedVariables false

/-!
# A060247

Triangle whose rows are the degrees of the irreducible representations of the groups PSL(2,q) as q runs through the primes and prime powers.

The 84 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A060247

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 2, 1, 1, 1, 3, 1, 3, 3,
    4, 5, 1, 3, 3, 4, 5, 1, 3, 3,
    6, 7, 8, 1, 7, 7, 7, 7, 8, 9,
    9, 9, 1, 5, 5, 8, 8, 9, 10, 1,
    5, 5, 10, 10, 11, 12, 12, 1, 7, 7,
    12, 12, 12, 13, 14, 14, 1, 15, 15, 15,
    15, 15, 15, 15, 15, 16, 17, 17, 17, 17,
    17, 17, 17, 1, 9, 9, 16, 16, 16, 16,
    17, 18, 18, 18]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 85) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 85) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 85) : flatFz n = flatData[n.toNat - 1]! := sorry

end A060247
