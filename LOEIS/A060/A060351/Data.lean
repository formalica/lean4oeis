import LOEIS.A060.A060351.Defs

set_option linter.unusedVariables false

/-!
# A060351

If the binary expansion of n has k bits, let S be the subset of [k-1] such that i is in S if the i-th bit of n is a 1 (with the first bit being the least significant bit); a(n) is the number of permutations of [k] with descent set S.

The 65 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A060351

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 1, 1, 2, 2, 1, 1, 3,
    5, 3, 3, 5, 3, 1, 1, 4, 9, 6,
    9, 16, 11, 4, 4, 11, 16, 9, 6, 9,
    4, 1, 1, 5, 14, 10, 19, 35, 26, 10,
    14, 40, 61, 35, 26, 40, 19, 5, 5, 19,
    40, 26, 35, 61, 40, 14, 10, 26, 35, 19,
    10, 14, 5, 1, 1]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 65) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 65) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
