import LOEIS.A306.A306196.Defs

set_option linter.unusedVariables false

/-!
# A306196

Irregular triangle read by rows where row n lists the primes 2n - k, with 1 < k < 2n-1, and if k is composite also 2n - p has to be prime for some prime divisor p of k.

The 80 terms known to OEIS, indexed from `2`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A306196

/-- Known terms of `flat`, starting at index `2`. -/
def flatData : List flatRetType :=
  [2, 3, 2, 3, 5, 3, 5, 7, 2, 5,
    7, 2, 3, 5, 7, 11, 3, 5, 7, 11,
    13, 3, 5, 7, 11, 13, 2, 3, 5, 7,
    11, 13, 17, 2, 3, 5, 7, 11, 13, 17,
    19, 2, 3, 5, 7, 11, 13, 17, 19, 2,
    3, 5, 7, 11, 13, 17, 19, 23, 3, 5,
    11, 13, 17, 23, 2, 7, 11, 13, 17, 19,
    23, 2, 3, 5, 11, 13, 17, 19, 23, 29]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 82) : flat n = flatData[n.val - 2]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 2 ≤ n) (h : n < 82) : flatFn n = flatData[n - 2]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 2 ≤ n) (h : n < 82) : flatFz n = flatData[n.toNat - 2]! := sorry

end A306196
