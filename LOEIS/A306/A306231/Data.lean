import LOEIS.A306.A306231.Defs

set_option linter.unusedVariables false

/-!
# A306231

Lexicographically earliest sequence of distinct positive terms such that for any n > 0 and any k > 0, floor((2^k) / a(n)) AND floor((2^k) / a(n+1)) = 0 (where AND denotes the bitwise AND operator).

The 62 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A306231

/-- Known terms of `A306231`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 3, 6, 4, 5, 20, 8, 9, 72,
    16, 7, 14, 21, 78, 32, 11, 352, 64, 10,
    40, 15, 24, 12, 30, 35, 390, 48, 96, 51,
    102, 60, 13, 832, 117, 144, 18, 168, 42, 28,
    39, 180, 56, 84, 63, 70, 780, 120, 26, 128,
    19, 504, 36, 288, 126, 45, 112, 151, 896, 156,
    720, 224]

/-- `A306231` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 63) : A306231 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 63) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 63) : fz n = data[n.toNat - 1]! := sorry

end A306231
