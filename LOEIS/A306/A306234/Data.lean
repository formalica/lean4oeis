import LOEIS.A306.A306234.Defs

set_option linter.unusedVariables false

/-!
# A306234

Number T(n,k) of occurrences of k in a (signed) displacement set of a permutation of [n] divided by |k|!; triangle T(n,k), n>=1, 1-n<=k<=n-1, read by rows.

The 64 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A306234

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 1, 1, 3, 4, 3, 1, 1,
    5, 13, 15, 13, 5, 1, 1, 7, 28, 67,
    76, 67, 28, 7, 1, 1, 9, 49, 179, 411,
    455, 411, 179, 49, 9, 1, 1, 11, 76, 375,
