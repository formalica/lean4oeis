import LOEIS.A015.A015135.Defs

set_option linter.unusedVariables false

/-!
# A015135

Consider Fibonacci-type sequences f(0)=X, f(1)=Y, f(k)=f(k-1)+f(k-2) mod n; all are periodic; sequence gives number of distinct periods.

The 103 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A015135

/-- Known terms of `A015135`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 2, 3, 3, 4, 2, 4, 3, 6,
    3, 5, 2, 4, 5, 5, 2, 4, 3, 7,
    3, 6, 2, 6, 4, 4, 4, 5, 3, 10,
    3, 6, 5, 3, 5, 5, 2, 4, 4, 7,
    2, 6, 2, 7, 7, 3, 2, 6, 3, 8,
    4, 5, 2, 5, 5, 6, 5, 6, 3, 11,
    2, 4, 5, 7, 5, 10, 2, 4, 3, 10,
    3, 6, 2, 4, 7, 5, 5, 8, 3, 9,
    5, 4, 2, 7, 5, 4, 5, 9, 2, 10,
    4, 4, 5, 4, 7, 7, 2, 6, 7, 9,
    3, 6, 2]

/-- `A015135` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 104) : A015135 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 104) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 104) : fz n = data[n.toNat - 1]! := sorry

end A015135
