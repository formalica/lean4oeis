import LOEIS.A267.A267690.Defs

set_option linter.unusedVariables false

/-!
# A267690

Numbers n such that replacing any single decimal digit d with d/3 produces a prime (obviously n can contain only digits 3, 6 or 9).

The 5 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A267690

/-- Known terms of `A267690`, starting at index `1`. -/
def data : List retType :=
  [6, 9, 33, 63, 633]

/-- `A267690` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 6) : A267690 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 6) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 6) : fz n = data[n.toNat - 1]! := sorry

end A267690
