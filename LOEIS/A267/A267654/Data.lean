import LOEIS.A267.A267654.Defs

set_option linter.unusedVariables false

/-!
# A267654

Irregular triangle of palindromic subsequences. Every row has 2*n+1 terms. From the second row, there are only two alternated numbers: 2*n+4 and 2*n+2.

The 64 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A267654

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [2, 4, 2, 4, 6, 4, 6, 4, 6, 8,
    6, 8, 6, 8, 6, 8, 10, 8, 10, 8,
    10, 8, 10, 8, 10, 12, 10, 12, 10, 12,
    10, 12, 10, 12, 10, 12, 14, 12, 14, 12,
    14, 12, 14, 12, 14, 12, 14, 12, 14, 16,
    14, 16, 14, 16, 14, 16, 14, 16, 14, 16,
    14, 16, 14, 16]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 64) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 64) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 64) : flatFz n = flatData[n.toNat]! := sorry

end A267654
