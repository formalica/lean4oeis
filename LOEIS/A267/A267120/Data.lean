import LOEIS.A267.A267120.Defs

set_option linter.unusedVariables false

/-!
# A267120

Triangle of coefficients of Gaussian polynomials [2n+3,3]_q represented as finite sum of terms (1+q^2)^k*q^(g-k), where k = 0,1,...,g with g=3n.

The 70 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A267120

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, 0, -1, 1, 1, -1, 0, 5, -2, -4,
    1, 1, 0, 2, -2, -15, 7, 17, -5, -7,
    1, 1, 1, 0, -15, 6, 53, -23, -67, 22,
    38, -8, -10, 1, 1, 0, -3, 3, 55, -28,
    -189, 81, 261, -90, -182, 46, 68, -11, -13, 1,
    1, -1, 0, 30, -12, -229, 106, 691, -292, -1010,
    359, 817, -229, -387, 79, 107, -14, -16, 1, 1]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 70) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 70) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 70) : flatFz n = flatData[n.toNat]! := sorry

end A267120
