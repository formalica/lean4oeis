def flatData : List flatRetType :=
  [1, 2, 2, 3, 1, 1, 4, 3, 3, 1,
    5, 4, 2, 2, 1, 6, 5, 4, 4, 2,
    1, 7, 6, 5, 5, 5, 2, 1, 8, 7,
    6, 3, 3, 3, 2, 1, 9, 8, 7, 6,
