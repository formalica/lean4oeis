import LOEIS.A367.A367292.Defs

set_option linter.unusedVariables false

/-!
# A367292

An inventory sequence: the first row contains the value 1, subsequent rows contains the number of terms in prior rows whose binary expansions contain 2^0 (provided this number is nonzero), then the number of terms for 2^1 (provided it is > 0), then for 2^2, etc.

The 76 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A367292

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 2, 2, 1, 3, 2, 4, 4, 4,
    4, 2, 4, 5, 4, 5, 5, 7, 8, 6,
    10, 8, 8, 11, 2, 9, 10, 11, 5, 12,
    12, 12, 8, 12, 12, 15, 12, 13, 13, 19,
