/-- `A341984` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 57) : A341984 n = data[n.val - 5]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 5 ≤ n) (h : n < 57) : fn n = data[n - 5]! := sorry

