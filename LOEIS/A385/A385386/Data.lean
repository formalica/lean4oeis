import LOEIS.A385.A385386.Defs

set_option linter.unusedVariables false

/-!
# A385386

Triangle read by rows: T(n,k) is the number of polysticks, i.e., connected nonempty subsets of edges, of the n X k flat torus, up to cyclic shifts and reflections of rows and columns; 1 <= k <= n.

The 10 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A385386

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [3, 7, 40, 14, 225, 6432, 26, 1768, 255451, 43918404]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 11) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 11) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 11) : flatFz n = flatData[n.toNat - 1]! := sorry

end A385386
