import LOEIS.A385.A385661.Defs

set_option linter.unusedVariables false

/-!
# A385661

Lexicographically earliest sequence of distinct positive integers that can be partitioned into runs of pairwise coprime integers, the n-th such run having a(n) terms.

The 69 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A385661

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 3, 4, 5, 7, 6, 11, 13, 17,
    8, 9, 19, 23, 25, 10, 21, 29, 31, 37,
    41, 43, 12, 35, 47, 53, 59, 61, 14, 15,
    67, 71, 73, 79, 83, 89, 97, 101, 103, 16,
    27, 49, 55, 107, 109, 113, 127, 131, 137, 139,
    149, 151, 18, 65, 77, 157, 163, 167, 173, 179,
    181, 191, 193, 197, 199, 211, 223, 227, 229]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 70) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 70) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 70) : flatFz n = flatData[n.toNat - 1]! := sorry

end A385661
