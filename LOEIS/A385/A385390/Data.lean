import LOEIS.A385.A385390.Defs

set_option linter.unusedVariables false

/-!
# A385390

Irregular triangle read by rows: T(n,k) is the number of polysticks of size k, i.e., connected subsets of k edges, of the n X n flat torus, up to cyclic shifts and reflections of rows and columns, as well as interchange of rows and columns; 1 <= k <= 2*n^2.

The 60 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A385390

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 2, 3, 7, 4, 4, 1, 1,
    1, 2, 5, 14, 38, 111, 261, 500, 654, 648,
    486, 305, 144, 61, 19, 6, 1, 1, 1, 2,
    5, 16, 52, 199, 759, 2921, 10668, 36761, 115231, 322237,
    778242, 1576259, 2591721, 3412285, 3671098, 3320276, 2565917, 1717088, 996355, 503860,
    220074, 83408, 26783, 7438, 1678, 351, 52, 11, 1, 1]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 61) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 61) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 61) : flatFz n = flatData[n.toNat - 1]! := sorry

end A385390
