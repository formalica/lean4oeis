import LOEIS.A385.A385383.Defs

set_option linter.unusedVariables false

/-!
# A385383

Irregular triangle read by rows: T(n,k) is the number of polyominoes of size k, i.e., connected subsets of k square cells (or vertices), of the n X n flat torus, up to cyclic shifts and reflections of rows and columns; 1 <= k <= n^2.

The 55 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A385383

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 2, 1, 1, 1, 2, 3, 5, 6,
    6, 3, 1, 1, 1, 2, 3, 9, 17, 44,
    81, 150, 163, 161, 88, 56, 16, 8, 1, 1,
    1, 2, 3, 9, 21, 62, 168, 490, 1324, 3370,
    7433, 13905, 20961, 24927, 23008, 16766, 9825, 4669, 1831, 576,
    157, 32, 8, 1, 1]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 56) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 56) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
