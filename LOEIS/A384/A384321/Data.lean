/-- `A384321` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 64) : A384321 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 64) : fn n = data[n - 1]! := sorry

