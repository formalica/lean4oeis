import LOEIS.A384.A384160.Defs

set_option linter.unusedVariables false

/-!
# A384160

Consecutive states of the linear congruential pseudo-random number generator for 36-bit WATFOR/WATFIV when started at 1.

The 21 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A384160

/-- Known terms of `A384160`, starting at index `1`. -/
def data : List retType :=
  [1, 131069, 17179082761, 17183408101, 34345582673, 53083917, 16988766937, 17848727413, 32066509217, 7739650845,
    25740764841, 33596591109, 30610037745, 12186659885, 12166953849, 6296898965, 7334844225, 19577928253, 5497393481, 14152584229,
    20226775953]

/-- `A384160` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 22) : A384160 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 22) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 22) : fz n = data[n.toNat - 1]! := sorry

end A384160
