import LOEIS.A225.A225243.Defs

set_option linter.unusedVariables false

/-!
# A225243

Irregular triangle read by rows, where row n contains the distinct primes that are contained in the binary representation of n as substrings; first row = [1] by convention.

The 82 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A225243

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 3, 2, 2, 5, 2, 3, 3, 7,
    2, 2, 2, 5, 2, 3, 5, 11, 2, 3,
    2, 3, 5, 13, 2, 3, 7, 3, 7, 2,
    2, 17, 2, 2, 3, 19, 2, 5, 2, 5,
    2, 3, 5, 11, 2, 3, 5, 7, 11, 23,
    2, 3, 2, 3, 2, 3, 5, 13, 2, 3,
    5, 11, 13, 2, 3, 7, 2, 3, 5, 7,
    13, 29, 2, 3, 7, 3, 7, 31, 2, 2,
    2, 17]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 83) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 83) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 83) : flatFz n = flatData[n.toNat - 1]! := sorry

end A225243
