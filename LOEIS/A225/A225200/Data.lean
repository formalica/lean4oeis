import LOEIS.A225.A225200.Defs

set_option linter.unusedVariables false

/-!
# A225200

Triangle (read by rows) of coefficients of the polynomials (in ascending order) of the denominators of the generalized sequence of fractions f(n) defined recursively by f(1) = m/1; f(n+1) is chosen so that the sum and the product of the first n terms of the sequence are equal.

The 70 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A225200

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, -1, 1, 1, -1, 1, 1, -2, 2, -1,
    1, 1, -4, 8, -10, 9, -6, 3, -1, 1,
    1, -8, 32, -84, 162, -244, 298, -302, 258, -188,
    118, -64, 30, -12, 4, -1, 1, 1, -16, 128,
    -680, 2692, -8456, 21924, -48204, 91656, -152952, 226580, -300664, 359992,
    -391232, 387820, -352074, 293685, -225696, 160120, -105024, 63750, -35832, 18654,
    -8994, 4014, -1656, 630, -220, 70, -20, 5, -1, 1]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 71) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 71) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 71) : flatFz n = flatData[n.toNat - 1]! := sorry

end A225200
