/-!
# A225226

Odd primes p or q with the properties that max(p,q) is Wieferich prime 1093 or 3511 and that binomial(p*q-1,(p*q-1)/2) == binomial(p-1,(p-1)/2)*binomial(q-1,(q-1)/2) (mod (p*q)^2).

The 6 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A225226

/-- Known terms of `A225226`, starting at index `1`. -/
def data : List retType :=
  [3, 5, 7, 13, 1093, 3511]

/-- `A225226` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 7) : A225226 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 7) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 7) : fz n = data[n.toNat - 1]! := sorry

end A225226
