/-!
# A219932

Number of n X n arrays of the minimum value of corresponding elements and their horizontal or diagonal neighbors in a random, but sorted with lexicographically nondecreasing rows and nonincreasing columns, 0..3 n X n array.

The 6 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A219932

/-- Known terms of `A219932`, starting at index `1`. -/
def data : List retType :=
  [4, 23, 368, 21512, 3773045, 2574187888]

/-- `A219932` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 7) : A219932 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 7) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 7) : fz n = data[n.toNat - 1]! := sorry

end A219932
