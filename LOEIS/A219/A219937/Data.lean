set_option linter.unusedVariables false

/-!
# A219937

Number of nX6 arrays of the minimum value of corresponding elements and their horizontal or diagonal neighbors in a random, but sorted with lexicographically nondecreasing rows and nonincreasing columns, 0..3 nX6 array.

The 10 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A219937

/-- Known terms of `A219937`, starting at index `1`. -/
def data : List retType :=
  [56, 918, 30558, 1301292, 59049705, 2574187888, 105577880961, 4099221855602, 151893106036504, 5400918703380817]

/-- `A219937` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 11) : A219937 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 11) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 11) : fz n = data[n.toNat - 1]! := sorry

end A219937
