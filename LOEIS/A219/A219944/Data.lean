import LOEIS.A219.A219944.Defs

set_option linter.unusedVariables false

/-!
# A219944

Number of 6Xn arrays of the minimum value of corresponding elements and their horizontal or diagonal neighbors in a random, but sorted with lexicographically nondecreasing rows and nonincreasing columns, 0..3 6Xn array.

The 6 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A219944

/-- Known terms of `A219944`, starting at index `1`. -/
def data : List retType :=
  [84, 1212, 53712, 2225355, 78522914, 2574187888]

/-- `A219944` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 7) : A219944 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 7) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 7) : fz n = data[n.toNat - 1]! := sorry

end A219944
