import LOEIS.A219.A219120.Defs

set_option linter.unusedVariables false

/-!
# A219120

Triangle, read by rows, where T(n,k) is defined for n>=1, k=1..2*n-1, by a formula analogous to the second-order Eulerian triangle A008517.

The 65 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A219120

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 1, -1, 1, 5, -2, -2, 1, 1,
    15, 13, -19, 3, 3, -1, 1, 37, 128, -26,
    -74, 46, -4, -4, 1, 1, 83, 679, 755, -654,
    -68, 230, -90, 5, 5, -1, 1, 177, 2866, 9048,
    2091, -5741, 1856, 498, -545, 155, -6, -6, 1, 1,
    367, 10721, 67541, 98069, -24675, -35027, 22717, -3773, -1673, 1099,
    -245, 7, 7, -1, 1]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 66) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 66) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 66) : flatFz n = flatData[n.toNat - 1]! := sorry

end A219120
