import LOEIS.A219.A219923.Defs

set_option linter.unusedVariables false

/-!
# A219923

Number of ways to write n=x+y (x>0, y>0) with x-1, x+1 and 2*x*y+1 all prime.

The 100 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A219923

/-- Known terms of `A219923`, starting at index `1`. -/
def data : List retType :=
  [0, 0, 0, 0, 0, 1, 1, 0, 2, 0,
    1, 1, 1, 1, 3, 2, 0, 1, 2, 2,
    3, 2, 1, 0, 2, 2, 0, 1, 3, 2,
    2, 1, 3, 4, 2, 2, 3, 0, 4, 3,
    3, 1, 1, 3, 0, 3, 2, 1, 1, 3,
    3, 1, 1, 5, 3, 1, 2, 1, 3, 3,
    5, 3, 1, 2, 4, 3, 3, 2, 4, 3,
    2, 2, 0, 3, 5, 4, 1, 3, 6, 2,
    6, 2, 2, 4, 5, 5, 2, 3, 3, 4,
    1, 2, 0, 1, 4, 2, 4, 1, 6, 6]

/-- `A219923` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 101) : A219923 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 101) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 101) : fz n = data[n.toNat - 1]! := sorry

end A219923
