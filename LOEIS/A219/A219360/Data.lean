import LOEIS.A219.A219360.Defs

set_option linter.unusedVariables false

/-!
# A219360

Starting from a(1)=1, for any n the sum of the next a(n) numbers is a prime. No repetition of numbers is allowed. At any step the minimum integer not yet used and not leading to a contradiction is chosen.

The 68 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A219360

/-- Known terms of `A219360`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 3, 4, 5, 8, 6, 10, 7, 12,
    9, 11, 18, 16, 13, 22, 15, 14, 17, 23,
    19, 20, 34, 21, 24, 25, 26, 33, 27, 40,
    32, 42, 29, 28, 30, 46, 31, 37, 35, 39,
    36, 38, 41, 43, 45, 44, 47, 48, 65, 49,
    52, 50, 54, 51, 53, 66, 72, 55, 56, 57,
    73, 68, 63, 58, 59, 61, 60, 82]

/-- `A219360` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 69) : A219360 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 69) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 69) : fz n = data[n.toNat - 1]! := sorry

end A219360
