import LOEIS.A362.A362372.Defs

set_option linter.unusedVariables false

/-!
# A362372

Inventory of powers. Initialize the sequence with '1'. Then record the number of powers of 1 thus far, then do the same for powers of 2 (2, 4, 8, ...), powers of 3, etc. When the count is zero, do not record a zero; rather start the inventory again with the powers of 1.

The 80 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A362372

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, 1, 2, 1, 3, 1, 1, 5, 1, 1,
    7, 1, 1, 9, 1, 2, 10, 2, 2, 10,
    4, 2, 1, 1, 12, 6, 2, 1, 1, 1,
    1, 16, 8, 2, 2, 1, 1, 1, 1, 1,
    2, 21, 12, 2, 2, 1, 1, 1, 1, 1,
    2, 26, 15, 2, 2, 1, 1, 1, 1, 1,
    2, 31, 18, 2, 2, 1, 1, 1, 1, 1,
    2, 36, 21, 2, 2, 1, 2, 1, 1, 1]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 80) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 80) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 80) : flatFz n = flatData[n.toNat]! := sorry

end A362372
