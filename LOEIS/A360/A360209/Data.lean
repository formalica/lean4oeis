import LOEIS.A360.A360209.Defs

set_option linter.unusedVariables false

/-!
# A360209

Lexicographically earliest infinite sequence of distinct positive numbers such that, for n > 2, a(n) shares a factor with a(n-2) + a(n-1) but shares no factor with a(n-2).

The 74 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A360209

/-- Known terms of `A360209`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 3, 5, 4, 6, 15, 7, 8, 9,
    17, 10, 12, 11, 23, 14, 37, 27, 16, 43,
    59, 18, 21, 13, 20, 22, 33, 25, 26, 24,
    35, 295, 32, 36, 51, 29, 28, 19, 47, 30,
    44, 259, 39, 34, 73, 107, 38, 40, 45, 119,
    41, 46, 42, 55, 97, 48, 50, 49, 57, 52,
    109, 63, 54, 65, 77, 56, 76, 69, 75, 58,
    91, 149, 60, 66]

/-- `A360209` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 75) : A360209 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 75) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 75) : fz n = data[n.toNat - 1]! := sorry

end A360209
