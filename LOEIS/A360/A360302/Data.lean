    29, 30, 31, 0, 1, 2, 7, 3, 8, 12,
    22, 4, 9, 13, 23, 16]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 76) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 76) : flatFn n = flatData[n]! := sorry

