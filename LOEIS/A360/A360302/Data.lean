import LOEIS.A360.A360302.Defs

set_option linter.unusedVariables false

/-!
# A360302

T(n,k) is the position of the set encoded in the binary expansion of k within the shortlex order for the powerset of [n]; triangle T(n,k), n>=0, 0<=k<=2^n-1, read by rows.

The 76 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A360302

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [0, 0, 1, 0, 1, 2, 3, 0, 1, 2,
    4, 3, 5, 6, 7, 0, 1, 2, 5, 3,
    6, 8, 11, 4, 7, 9, 12, 10, 13, 14,
    15, 0, 1, 2, 6, 3, 7, 10, 16, 4,
