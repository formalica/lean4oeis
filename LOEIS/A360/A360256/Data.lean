import LOEIS.A360.A360256.Defs

set_option linter.unusedVariables false

/-!
# A360256

Number of ways to tile an n X n square using rectangles with distinct height X width dimensions.

The 7 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A360256

/-- Known terms of `A360256`, starting at index `1`. -/
def data : List retType :=
  [1, 1, 33, 513, 14409, 693025, 50447161]

/-- `A360256` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 8) : A360256 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 8) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 8) : fz n = data[n.toNat - 1]! := sorry

end A360256
