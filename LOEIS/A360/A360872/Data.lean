import LOEIS.A360.A360872.Defs

set_option linter.unusedVariables false

/-!
# A360872

Irregular triangle read by rows of the length of runs in intermediate solutions to the light switch problem.

The 87 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A360872

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 1, 3, 2, 1, 2, 5, 2,
    1, 1, 1, 2, 1, 1, 3, 1, 2, 1,
    1, 1, 5, 3, 1, 4, 2, 1, 2, 4,
    1, 3, 5, 1, 1, 1, 2, 1, 3, 1,
    1, 2, 2, 1, 2, 1, 2, 2, 1, 4,
