import LOEIS.A160.A160078.Defs

set_option linter.unusedVariables false

/-!
# A160078

Positive integers which apparently never result in a palindrome under repeated applications of the function f(x) = x + (x with digits in binary expansion reversed). Binary analog of Lychrel numbers.

The 40 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A160078

/-- Known terms of `A160078`, starting at index `1`. -/
def data : List retType :=
  [22, 26, 28, 35, 37, 41, 45, 46, 47, 49,
    60, 61, 67, 75, 77, 78, 84, 86, 89, 90,
    93, 94, 95, 97, 105, 106, 108, 110, 116, 120,
    122, 124, 125, 131, 135, 139, 141, 147, 149, 152]

/-- `A160078` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 41) : A160078 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 41) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 41) : fz n = data[n.toNat - 1]! := sorry

end A160078
