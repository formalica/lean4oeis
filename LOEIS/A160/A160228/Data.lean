import LOEIS.A160.A160228.Defs

set_option linter.unusedVariables false

/-!
# A160228

Write Pi-3 in binary and report the number of zeros in the first 10^n decimal places.

The 8 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A160228

/-- Known terms of `A160228`, starting at index `1`. -/
def data : List retType :=
  [8, 60, 512, 5015, 49923, 500279, 4997393, 49999921]

/-- `A160228` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 9) : A160228 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 9) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 9) : fz n = data[n.toNat - 1]! := sorry

end A160228
