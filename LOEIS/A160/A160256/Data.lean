import LOEIS.A160.A160256.Defs

set_option linter.unusedVariables false

/-!
# A160256

a(1)=1, a(2)=2. For n >=3, a(n) = the smallest positive integer not occurring earlier in the sequence such that a(n)*a(n-1)/a(n-2) is an integer.

The 58 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A160256

/-- Known terms of `A160256`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 3, 4, 6, 8, 9, 16, 18, 24,
    12, 10, 30, 5, 36, 15, 48, 20, 60, 7,
    120, 14, 180, 21, 240, 28, 300, 35, 360, 42,
    420, 11, 840, 22, 1260, 33, 1680, 44, 2100, 55,
    2520, 66, 2940, 77, 3360, 88, 3780, 110, 378, 165,
    126, 220, 63, 440, 189, 880, 567, 1760]

/-- `A160256` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 59) : A160256 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 59) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 59) : fz n = data[n.toNat - 1]! := sorry

end A160256
