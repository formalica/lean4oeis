import LOEIS.A160.A160403.Defs

set_option linter.unusedVariables false

/-!
# A160403

Primes starting and ending respectively with 23 and 57, and with either no space or only 0's in between.

The 7 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A160403

/-- Known terms of `A160403`, starting at index `1`. -/
def data : List retType :=
  [2357, 23057, 2300057, 230000000057, 2300000000000000000000057, 230000000000000000000000000000000057, 2300000000000000000000000000000000057]

/-- `A160403` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 8) : A160403 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 8) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 8) : fz n = data[n.toNat - 1]! := sorry

end A160403
