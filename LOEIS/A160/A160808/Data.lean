import LOEIS.A160.A160808.Defs

set_option linter.unusedVariables false

/-!
# A160808

Toothpick sequence in Fibonacci spiral (see Comments lines for definition).

The 48 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A160808

/-- Known terms of `A160808`, starting at index `0`. -/
def data : List retType :=
  [0, 1, 3, 7, 11, 15, 23, 35, 39, 40,
    42, 45, 48, 52, 59, 67, 68, 70, 73, 76,
    80, 85, 92, 97, 100, 105, 112, 120, 131, 144,
    161, 173, 177, 182, 190, 197, 206, 211, 218, 227,
    235, 239, 247, 255, 262, 270, 283, 297]

/-- `A160808` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 48) : A160808 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 48) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 48) : fz n = data[n.toNat]! := sorry

end A160808
