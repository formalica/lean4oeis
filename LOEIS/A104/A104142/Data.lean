/-!
# A104142

Take any three consecutive terms and write them down (in English): their letters sum up to a square number. This is the slowest strictly increasing such sequence.

The 11 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A104142

/-- Known terms of `A104142`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 6, 10, 24, 73, 104, 200, 300, 401,
    473]

/-- `A104142` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 12) : A104142 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 12) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 12) : fz n = data[n.toNat - 1]! := sorry

end A104142
