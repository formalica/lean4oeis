import LOEIS.A104.A104143.Defs

set_option linter.unusedVariables false

/-!
# A104143

Take any three consecutive terms and write them down (in French): their letters sum up to a square number. This is the slowest strictly increasing such sequence.

The 15 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A104143

/-- Known terms of `A104143`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 6, 21, 43, 44, 50, 52, 53, 103,
    121, 123, 197, 203, 204]

/-- `A104143` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 16) : A104143 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 16) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 16) : fz n = data[n.toNat - 1]! := sorry

end A104143
