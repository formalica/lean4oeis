import LOEIS.A104.A104177.Defs

set_option linter.unusedVariables false

/-!
# A104177

A variation on Flavius's sieve (A000960): Start with the natural numbers; at the k-th sieving step, remove every f-th term of the sequence remaining after the (k-1)-st sieving step, where f is the (k+2)-nd Fibonacci number, f=F(k+2); iterate.

The 58 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A104177

/-- Known terms of `A104177`, starting at index `1`. -/
def data : List retType :=
  [1, 3, 7, 9, 15, 19, 21, 31, 33, 37,
    39, 45, 51, 61, 63, 67, 69, 75, 79, 81,
    93, 97, 99, 109, 111, 121, 123, 127, 129, 135,
    139, 141, 151, 157, 165, 169, 171, 181, 183, 189,
    195, 199, 201, 211, 213, 219, 225, 229, 231, 241,
    243, 247, 249, 255, 261, 271, 277, 279]

/-- `A104177` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 59) : A104177 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 59) : fn n = data[n - 1]! := sorry

