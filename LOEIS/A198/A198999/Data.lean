import LOEIS.A198.A198999.Defs

set_option linter.unusedVariables false

/-!
# A198999

Decimal expansion of x>0 satisfying 4*x^2-3*cos(x)=4.

The 99 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A198999

/-- Known terms of `A198999`, starting at index `1`. -/
def data : List retType :=
  [1, 1, 4, 4, 5, 8, 2, 7, 1, 5,
    8, 1, 0, 2, 6, 2, 2, 5, 8, 7,
    5, 2, 4, 8, 4, 7, 8, 6, 5, 5,
    3, 2, 6, 9, 1, 6, 3, 1, 7, 5,
    0, 6, 3, 0, 6, 4, 9, 6, 1, 6,
    0, 6, 2, 2, 9, 9, 0, 1, 9, 0,
    9, 7, 6, 1, 1, 7, 9, 6, 5, 6,
    1, 5, 7, 5, 0, 6, 9, 0, 2, 6,
    3, 5, 6, 9, 8, 9, 4, 2, 2, 2,
    8, 7, 0, 5, 2, 7, 2, 5, 4]

/-- `A198999` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 100) : A198999 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 100) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 100) : fz n = data[n.toNat - 1]! := sorry

end A198999
