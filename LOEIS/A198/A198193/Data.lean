import LOEIS.A198.A198193.Defs

set_option linter.unusedVariables false

/-!
# A198193

Replace 2^k in the binary representation of n with n+(k-L) where L = floor(log(n)/log(2)).

The 60 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A198193

/-- Known terms of `A198193`, starting at index `0`. -/
def data : List retType :=
  [0, 1, 2, 5, 4, 8, 11, 18, 8, 15,
    18, 28, 23, 35, 39, 54, 16, 30, 33, 50,
    38, 57, 61, 83, 47, 70, 74, 100, 81, 109,
    114, 145, 32, 61, 64, 96, 69, 103, 107, 144,
    78, 116, 120, 161, 127, 170, 175, 221, 95, 141,
    145, 194, 152, 203, 208, 262, 165, 220, 225, 283]

/-- `A198193` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 60) : A198193 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 60) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 60) : fz n = data[n.toNat]! := sorry

end A198193
