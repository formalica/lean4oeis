import LOEIS.A198.A198790.Defs

set_option linter.unusedVariables false

/-!
# A198790

Irregular table T(n,k) read by rows: Last survivor positions in Josephus problem for n numbers and a count of k, n >= 1, lcm(1, 2, 3, ..., n) >= k >= 1.

The 87 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A198790

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 1, 3, 3, 2, 2, 1, 1, 4,
    1, 1, 2, 2, 3, 2, 3, 3, 4, 4,
    1, 5, 3, 4, 1, 2, 4, 4, 1, 2,
    4, 5, 3, 2, 5, 1, 3, 4, 1, 1,
    3, 4, 1, 2, 5, 4, 2, 3, 5, 1,
