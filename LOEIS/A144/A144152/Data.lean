import LOEIS.A144.A144152.Defs

set_option linter.unusedVariables false

/-!
# A144152

Triangle read by rows: A128174 * X; X = an infinite lower triangular matrix with a shifted Fibonacci sequence: (1, 1, 1, 2, 3, 5, 8, ...) in the main diagonal and the rest zeros.

The 67 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A144152

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 0, 1, 1, 0, 1, 0, 1, 0, 2,
    1, 0, 1, 0, 3, 0, 1, 0, 2, 0,
    5, 1, 0, 1, 0, 3, 0, 8, 0, 1,
    0, 2, 0, 5, 0, 13, 1, 0, 1, 0,
    3, 0, 8, 0, 21, 0, 1, 0, 2, 0,
    0, 5, 0, 13, 0, 34, 1, 0, 1, 0,
    3, 0, 8, 0, 21, 0, 55]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 68) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 68) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 68) : flatFz n = flatData[n.toNat - 1]! := sorry

end A144152
