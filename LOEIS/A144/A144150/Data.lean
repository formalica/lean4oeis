import LOEIS.A144.A144150.Defs

set_option linter.unusedVariables false

/-!
# A144150

Square array A(n,k), n >= 0, k >= 0, read by antidiagonals, where the e.g.f. of column k is 1+g^(k+1)(x) with g = x-> exp(x)-1.

The 70 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A144150

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 1, 1, 1, 1, 1, 2, 1,
    1, 1, 3, 5, 1, 1, 1, 4, 12, 15,
    1, 1, 1, 5, 22, 60, 52, 1, 1, 1,
    6, 35, 154, 358, 203, 1, 1, 1, 7, 51,
    315, 1304, 2471, 877, 1, 1, 1, 8, 70, 561,
