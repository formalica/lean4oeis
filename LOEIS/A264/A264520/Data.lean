import LOEIS.A264.A264520.Defs

set_option linter.unusedVariables false

/-!
# A264520

T(n,k)=Number of (n+1)X(k+1) arrays of permutations of 0..(n+1)*(k+1)-1 with each element having directed index change -1,0 0,2 -1,-2 or 1,0.

The 60 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A264520

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 0, 1, 0, 1, 2, 1, 3, 0,
    4, 2, 9, 0, 1, 6, 4, 42, 36, 12,
