import LOEIS.A264.A264614.Defs

set_option linter.unusedVariables false

/-!
# A264614

Irregular triangle read by rows: T(n,k) = number of unsigned unichromosonal genomes with n genes at 3-break distance k from a fixed genome, 0 <= k <= floor(n/2).

The 55 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A264614

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 0, 1, 1, 1, 4, 1, 1, 10,
    13, 1, 20, 75, 24, 1, 35, 287, 397, 1,
    56, 854, 3112, 1017, 1, 84, 2142, 16196, 21897, 1,
    120, 4746, 64520, 222573, 70920, 1, 165, 9570, 212498, 1486749,
    1919817, 1, 220, 17919, 606584, 7503815, 24312636, 7475625, 1, 286,
    31603, 1548404, 30891575, 200350670, 246179061]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 56) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 56) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 56) : flatFz n = flatData[n.toNat - 1]! := sorry

end A264614
