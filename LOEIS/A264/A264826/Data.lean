import LOEIS.A264.A264826.Defs

set_option linter.unusedVariables false

/-!
# A264826

Primitive Eisenstein triples: (a,b,c) in lexicographic order such that a^2 + b^2 - a*b - c^2 = 0, a < b < c, and gcd(a, b) = 1.

The 63 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A264826

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [3, 7, 8, 5, 7, 8, 5, 19, 21, 7,
    13, 15, 7, 37, 40, 8, 13, 15, 9, 61,
    65, 11, 31, 35, 11, 91, 96, 13, 43, 48,
    13, 127, 133, 15, 169, 176, 16, 19, 21, 16,
