import LOEIS.A264.A264128.Defs

set_option linter.unusedVariables false

/-!
# A264128

T(n,k)=Number of (n+1)X(k+1) arrays of permutations of 0..(n+1)*(k+1)-1 with each element having index change +-(.,.) 0,0 1,-2 or 2,-1.

The 44 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A264128

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 2, 4, 9, 4, 8, 45, 45, 8,
    16, 200, 576, 200, 16, 32, 845, 5733, 5733, 845,
    32, 64, 3549, 53361, 108045, 53361, 3549, 64, 128, 14994,
    533610, 1995525, 1995525, 533610, 14994, 128, 256, 63525, 5336100, 39592980,
    79655625, 39592980, 5336100, 63525]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 45) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 45) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 45) : flatFz n = flatData[n.toNat - 1]! := sorry

end A264128
