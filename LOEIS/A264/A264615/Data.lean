import LOEIS.A264.A264615.Defs

set_option linter.unusedVariables false

/-!
# A264615

Irregular triangle read by rows: T(n,k) = number of signed unichromosonal genomes with n genes at 3-break distance k from a fixed genome, 0 <= k <= floor(n/2).

The 48 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A264615

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 1, 7, 1, 22, 25, 1, 50,
    333, 1, 95, 1851, 1893, 1, 161, 6839, 39079, 1,
    252, 19782, 323580, 301505, 1, 372, 48510, 1706180, 8566857, 1,
    525, 105546, 6792650, 95942613, 82953225, 1, 715, 209682, 22248446, 668057885,
    3025374471, 1, 946, 387783, 63055388, 3435912383, 43154349714, 35095900185]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 49) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 49) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 49) : flatFz n = flatData[n.toNat - 1]! := sorry

end A264615
