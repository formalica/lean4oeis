import LOEIS.A264.A264550.Defs

set_option linter.unusedVariables false

/-!
# A264550

T(n,k)=Number of (n+1)X(k+1) arrays of permutations of 0..(n+1)*(k+1)-1 with each element having directed index change -1,1 -1,2 1,0 or 0,-1.

The 59 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A264550

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [0, 1, 1, 1, 2, 0, 1, 6, 5, 0,
    1, 16, 16, 10, 1, 3, 40, 36, 45, 21,
    0, 3, 96, 172, 216, 133, 44, 0, 4, 240,
    764, 1528, 1160, 400, 93, 1, 6, 608, 2728, 11728,
    14852, 4640, 1204, 196, 0, 9, 1536, 9880, 66372, 163744,
    105081, 23140, 3561, 413, 0, 12, 3840, 38818, 403920]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 60) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 60) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 60) : flatFz n = flatData[n.toNat - 1]! := sorry

end A264550
