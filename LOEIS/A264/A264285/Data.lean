import LOEIS.A264.A264285.Defs

set_option linter.unusedVariables false

/-!
# A264285

T(n,k)=Number of (n+1)X(k+1) arrays of permutations of 0..(n+1)*(k+1)-1 with each element having directed index change 0,0 0,1 1,0 or -1,-2.

The 49 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A264285

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 4, 1, 8, 10, 1, 16, 32, 26, 1,
    33, 102, 132, 69, 1, 69, 360, 675, 556, 181,
    1, 145, 1228, 4189, 4484, 2324, 476, 1, 300, 4156,
    23852, 47492, 29742, 9724, 1252, 1, 624, 14148, 134432, 448821,
    537057, 197283, 40692, 3292, 1, 1300, 48188, 768664, 4227024]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 50) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 50) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 50) : flatFz n = flatData[n.toNat - 1]! := sorry

end A264285
