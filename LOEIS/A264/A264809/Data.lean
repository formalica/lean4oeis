import LOEIS.A264.A264809.Defs

set_option linter.unusedVariables false

/-!
# A264809

Irregular array read by rows: row n contains the invariant factors of every (up to isomorphism) abelian group of order n for n>=2.

The 69 terms known to OEIS, indexed from `2`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A264809

/-- Known terms of `flat`, starting at index `2`. -/
def flatData : List flatRetType :=
  [2, 3, 4, 2, 2, 5, 6, 7, 8, 4,
    2, 2, 2, 2, 9, 3, 3, 10, 11, 12,
    6, 2, 13, 14, 15, 16, 8, 2, 4, 4,
