import LOEIS.A264.A264616.Defs

set_option linter.unusedVariables false

/-!
# A264616

Irregular triangle read by rows: T(n,k) = number of unsigned unichromosonal genomes with n genes at 4-break distance k from a fixed genome, 0 <= k <= floor((n+1)/3).

The 49 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A264616

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 0, 1, 1, 1, 5, 1, 15, 8,
    1, 35, 84, 1, 70, 649, 1, 126, 3585, 1328,
    1, 210, 14949, 25160, 1, 330, 50421, 312128, 1, 495,
    144903, 2621465, 861936, 1, 715, 367983, 16015637, 23532464, 1, 1001,
    847275, 76717355, 401435968, 1, 1365, 1801943, 304775471, 4519766436, 1400675584]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 50) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 50) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 50) : flatFz n = flatData[n.toNat - 1]! := sorry

end A264616
