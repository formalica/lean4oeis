import LOEIS.A172.A172008.Defs

set_option linter.unusedVariables false

/-!
# A172008

Number of minimal SNUSP programs using +, @ and # that yield n.

The 103 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A172008

/-- Known terms of `A172008`, starting at index `1`. -/
def data : List retType :=
  [1, 1, 2, 2, 2, 2, 2, 2, 4, 4,
    4, 4, 2, 4, 2, 2, 4, 2, 6, 2,
    2, 2, 8, 8, 4, 2, 2, 2, 2, 2,
    2, 6, 2, 2, 10, 10, 4, 2, 8, 8,
    2, 2, 4, 8, 2, 2, 2, 6, 14, 2,
