    355477406146830706663807382201012685829049871, 215421112450033407479085892668138597831784081541979]

/-- `A199657` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 13) : A199657 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 13) : fn n = data[n - 1]! := sorry

