Palindromic primes in the sense of A007500 with digits '0', '1' and '4' only.

The 28 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A199304

/-- Known terms of `A199304`, starting at index `1`. -/
def data : List retType :=
  [11, 101, 11411, 100411, 101141, 114001, 114041, 140411, 141101, 1004141,
    1010411, 1040141, 1041041, 1100441, 1114111, 1140101, 1144441, 1401401, 1410401, 1411141,
    1414001, 1440011, 1444411, 1444441, 10010411, 10011101, 10041011, 10044011]

/-- `A199304` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 29) : A199304 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 29) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 29) : fz n = data[n.toNat - 1]! := sorry

end A199304
