import LOEIS.A199.A199381.Defs

set_option linter.unusedVariables false

/-!
# A199381

Decimal expansion of x>0 satisfying 2*x^2+x*sin(x)=3.

The 99 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A199381

/-- Known terms of `A199381`, starting at index `1`. -/
def data : List retType :=
  [1, 0, 2, 9, 1, 2, 4, 9, 2, 1,
    9, 6, 6, 9, 0, 6, 9, 8, 6, 1,
    7, 1, 3, 5, 9, 2, 3, 7, 7, 8,
    9, 1, 1, 6, 4, 0, 8, 4, 8, 1,
    1, 7, 1, 1, 8, 4, 1, 1, 8, 6,
    4, 2, 6, 8, 0, 4, 2, 9, 8, 1,
    5, 5, 2, 1, 4, 5, 3, 3, 8, 7,
    2, 1, 8, 6, 1, 3, 6, 2, 0, 6,
    4, 7, 3, 3, 0, 4, 8, 4, 2, 2,
    9, 1, 5, 4, 8, 2, 8, 3, 0]

/-- `A199381` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 100) : A199381 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 100) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 100) : fz n = data[n.toNat - 1]! := sorry

end A199381
