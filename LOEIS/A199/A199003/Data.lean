import LOEIS.A199.A199003.Defs

set_option linter.unusedVariables false

/-!
# A199003

Decimal expansion of x>0 satisfying 4*x^2-4*cos(x)=3.

The 99 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A199003

/-- Known terms of `A199003`, starting at index `1`. -/
def data : List retType :=
  [1, 0, 9, 7, 9, 2, 6, 6, 5, 0,
    3, 7, 1, 5, 9, 9, 4, 3, 3, 1,
    4, 4, 0, 9, 4, 9, 0, 9, 6, 7,
