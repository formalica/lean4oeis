import LOEIS.A199.A199203.Defs

set_option linter.unusedVariables false

/-!
# A199203

Decimal expansion of f(0) where f is the functional square root (half-iterate) of exponent, f(f(x))=exp(x).

The 6 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A199203

/-- Known terms of `A199203`, starting at index `0`. -/
def data : List retType :=
  [4, 9, 8, 5, 6, 3]

/-- `A199203` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 6) : A199203 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 6) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 6) : fz n = data[n.toNat]! := sorry

end A199203
