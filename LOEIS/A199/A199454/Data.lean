/-- `A199454` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 100) : A199454 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 100) : fn n = data[n - 1]! := sorry

