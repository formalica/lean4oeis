    6, 5, 2, 6, 0, 1, 1, 2, 4, 7,
    4, 7, 6, 1, 7, 3, 2, 6, 5]

/-- `A199503` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 100) : A199503 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 100) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 100) : fz n = data[n.toNat - 1]! := sorry

end A199503
