import LOEIS.A199.A199503.Defs

set_option linter.unusedVariables false

/-!
# A199503

Decimal expansion of x>0 satisfying 2*x^2-2*x*sin(x)=cos(x).

The 99 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A199503

/-- Known terms of `A199503`, starting at index `1`. -/
def data : List retType :=
  [1, 0, 9, 7, 7, 0, 6, 0, 7, 3,
    0, 6, 5, 1, 9, 0, 4, 2, 9, 4,
    0, 1, 6, 2, 8, 9, 5, 8, 2, 9,
    1, 9, 3, 9, 0, 1, 3, 0, 0, 5,
    9, 7, 8, 9, 1, 0, 4, 8, 2, 8,
    7, 5, 8, 9, 8, 9, 3, 4, 7, 3,
    6, 4, 0, 5, 3, 3, 8, 2, 8, 7,
