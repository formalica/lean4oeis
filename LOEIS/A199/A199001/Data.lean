import LOEIS.A199.A199001.Defs

set_option linter.unusedVariables false

/-!
# A199001

Decimal expansion of x>0 satisfying 4*x^2-4*cos(x)=-1.

The 99 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A199001

/-- Known terms of `A199001`, starting at index `0`. -/
def data : List retType :=
  [7, 1, 2, 0, 5, 4, 2, 4, 6, 3,
    1, 4, 6, 4, 9, 9, 4, 1, 7, 2,
    1, 2, 6, 8, 9, 9, 4, 5, 6, 1,
    0, 4, 2, 6, 0, 4, 9, 6, 5, 7,
    7, 1, 0, 1, 1, 5, 1, 6, 9, 5,
    8, 0, 7, 3, 8, 3, 0, 0, 9, 8,
    8, 9, 4, 8, 7, 9, 5, 0, 0, 2,
    4, 2, 0, 8, 9, 7, 4, 7, 7, 6,
    1, 4, 2, 7, 9, 1, 7, 4, 3, 9,
    5, 6, 5, 0, 5, 9, 6, 9, 0]

/-- `A199001` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 99) : A199001 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 99) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 99) : fz n = data[n.toNat]! := sorry

end A199001
