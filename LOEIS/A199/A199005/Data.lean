import LOEIS.A199.A199005.Defs

set_option linter.unusedVariables false

/-!
# A199005

Number of inequivalent cocyclic Hadamard matrices of order 4n.

The 9 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A199005

/-- Known terms of `A199005`, starting at index `1`. -/
def data : List retType :=
  [1, 1, 1, 5, 3, 16, 6, 100, 35]

/-- `A199005` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 10) : A199005 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 10) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 10) : fz n = data[n.toNat - 1]! := sorry

end A199005
