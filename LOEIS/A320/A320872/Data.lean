import LOEIS.A320.A320872.Defs

set_option linter.unusedVariables false

/-!
# A320872

For all possible 3 X 3 magic squares made of primes, in order of increasing magic sum, list the lexicographically smallest representative of each equivalence class (modulo symmetries of the square), as a row of the 9 elements (3 rows of 3 elements each).

The 63 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A320872

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [17, 89, 71, 113, 59, 5, 47, 29, 101, 41,
    89, 83, 113, 71, 29, 59, 53, 101, 37, 79,
    103, 139, 73, 7, 43, 67, 109, 29, 131, 107,
    167, 89, 11, 71, 47, 149, 43, 127, 139, 199,
    103, 7, 67, 79, 163, 37, 151, 139, 211, 109,
    7, 79, 67, 181, 43, 181, 157, 241, 127, 13,
    97, 73, 211]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 64) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 64) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 64) : flatFz n = flatData[n.toNat - 1]! := sorry

end A320872
