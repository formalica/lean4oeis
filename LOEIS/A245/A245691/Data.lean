import LOEIS.A245.A245691.Defs

set_option linter.unusedVariables false

/-!
# A245691

Irregular triangle of Collatz like iteration, x -> 3x, then repeat (x -> ceiling(x/2) if divisible by 3, otherwise x -> 3x) while x != 6.

The 72 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A245691

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 3, 2, 6, 2, 6, 3, 9, 5, 15,
    8, 24, 12, 6, 4, 12, 6, 5, 15, 8,
    24, 12, 6, 6, 18, 9, 5, 15, 8, 24,
    12, 6, 7, 21, 11, 33, 17, 51, 26, 78,
    39, 20, 60, 30, 15, 8, 24, 12, 6, 8,
    24, 12, 6, 9, 27, 14, 42, 21, 11, 33,
    17, 51, 26, 78, 39, 20, 60, 30, 15, 8,
    24, 12]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 73) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 73) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 73) : flatFz n = flatData[n.toNat - 1]! := sorry

end A245691
