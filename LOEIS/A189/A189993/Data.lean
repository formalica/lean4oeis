import LOEIS.A189.A189993.Defs

set_option linter.unusedVariables false

/-!
# A189993

Length of the longest run of Ramanujan primes that are consecutive primes < 10^n.

The 9 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A189993

/-- Known terms of `A189993`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 5, 13, 13, 20, 21, 26, 31]

/-- `A189993` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 10) : A189993 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 10) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 10) : fz n = data[n.toNat - 1]! := sorry

end A189993
