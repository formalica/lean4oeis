import LOEIS.A189.A189994.Defs

set_option linter.unusedVariables false

/-!
# A189994

Length of the longest run of consecutive primes < 10^n that are not Ramanujan primes.

The 9 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A189994

/-- Known terms of `A189994`, starting at index `1`. -/
def data : List retType :=
  [3, 4, 7, 13, 20, 36, 47, 47, 65]

/-- `A189994` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 10) : A189994 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 10) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 10) : fz n = data[n.toNat - 1]! := sorry

end A189994
