/-!
# A137696

Triangular sequence of coefficients from a polynomial recursion: p(x,n)=p(x,Floor[(n-1)/2])-x^2*p(x,n-3)+x.

The 51 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A137696

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 0, 1, 0, 1, 1, 0, 2, -1, 0,
    2, 0, -1, 0, 2, 1, -1, -1, 0, 2,
    1, -2, 1, 0, 3, -1, -2, 0, 1, 0,
    3, -1, -2, -1, 1, 1, 0, 3, 0, -3,
    -1, 2, -1, 0, 3, 0, -4, 1, 2, 0,
    -1]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 52) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 52) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 52) : flatFz n = flatData[n.toNat - 1]! := sorry

end A137696
