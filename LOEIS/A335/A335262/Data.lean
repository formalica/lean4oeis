import LOEIS.A335.A335262.Defs

set_option linter.unusedVariables false

/-!
# A335262

Triangle of triangular numbers, read by rows, constructed like this: Given a sequence t, start row 0 with t(0). Compute row n for n > 0 by reversing row n-1 and prepending t(n). The sequence t is here chosen as the triangular numbers.

The 78 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A335262

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [0, 1, 0, 3, 0, 1, 6, 1, 0, 3,
    10, 3, 0, 1, 6, 15, 6, 1, 0, 3,
    10, 21, 10, 3, 0, 1, 6, 15, 28, 15,
    6, 1, 0, 3, 10, 21, 36, 21, 10, 3,
    0, 1, 6, 15, 28, 45, 28, 15, 6, 1,
    0, 3, 10, 21, 36, 55, 36, 21, 10, 3,
    0, 1, 6, 15, 28, 45, 66, 45, 28, 15,
    6, 1, 0, 3, 10, 21, 36, 55]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 78) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 78) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 78) : flatFz n = flatData[n.toNat]! := sorry

end A335262
