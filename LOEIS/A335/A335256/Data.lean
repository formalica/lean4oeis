import LOEIS.A335.A335256.Defs

set_option linter.unusedVariables false

/-!
# A335256

Irregular triangle read by rows: row n gives the coefficients of the n-th complete exponential Bell polynomial B_n(x_1, x_2, ..., x_n) with monomials sorted into standard order.

The 66 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A335256

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 1, 3, 1, 1, 6, 4, 3,
    1, 1, 10, 10, 15, 5, 10, 1, 1, 15,
    20, 45, 15, 60, 15, 6, 15, 10, 1, 1,
    21, 35, 105, 35, 210, 105, 21, 105, 70, 105,
    7, 21, 35, 1, 1, 28, 56, 210, 70, 560,
    420, 56, 420, 280, 840, 105, 28, 168, 280, 210,
    280, 8, 28, 56, 35, 1]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 67) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 67) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 67) : flatFz n = flatData[n.toNat - 1]! := sorry

end A335256
