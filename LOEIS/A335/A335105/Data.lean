import LOEIS.A335.A335105.Defs

set_option linter.unusedVariables false

/-!
# A335105

Irregular triangle read by rows in which row n lists the partial sums of shell numbers and respective number of electrons for all occupied shells of the n-th element of the periodic table of the elements.

The 84 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A335105

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 1, 3, 1, 3, 5, 6, 1, 3,
    5, 7, 1, 3, 5, 7, 9, 10, 1, 3,
    5, 7, 9, 11, 1, 3, 5, 7, 9, 12,
    1, 3, 5, 7, 9, 13, 1, 3, 5, 7,
    9, 14, 1, 3, 5, 7, 9, 15, 1, 3,
    5, 7, 9, 15, 18, 19, 1, 3, 5, 7,
    9, 15, 18, 20, 1, 3, 5, 7, 9, 15,
    18, 20, 23, 24, 1, 3, 5, 7, 9, 15,
    18, 20, 23, 25]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 85) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 85) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 85) : flatFz n = flatData[n.toNat - 1]! := sorry

end A335105
