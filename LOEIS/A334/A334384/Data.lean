import LOEIS.A334.A334384.Defs

set_option linter.unusedVariables false

/-!
# A334384

Lexicographically earliest sequence of distinct positive integers such that for any n > 0, a(3*n-2), a(3*n-1) and a(3*n) are in geometric progression.

The 66 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A334384

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 4, 3, 6, 12, 5, 10, 20, 7,
    14, 28, 8, 16, 32, 9, 15, 25, 11, 22,
    44, 13, 26, 52, 17, 34, 68, 18, 30, 50,
