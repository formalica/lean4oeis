set_option linter.unusedVariables false

/-!
# A005652

Lexicographically least increasing sequence, starting with 1, such that the sum of 2 distinct terms is never a Fibonacci number.

The 65 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A005652

/-- Known terms of `A005652`, starting at index `1`. -/
def data : List retType :=
  [1, 3, 6, 8, 9, 11, 14, 16, 17, 19,
    21, 22, 24, 27, 29, 30, 32, 35, 37, 40,
    42, 43, 45, 48, 50, 51, 53, 55, 56, 58,
    61, 63, 64, 66, 69, 71, 74, 76, 77, 79,
    82, 84, 85, 87, 90, 92, 95, 97, 98, 100,
