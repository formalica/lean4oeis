import LOEIS.A005.A005653.Defs

set_option linter.unusedVariables false

/-!
# A005653

Lexicographically least increasing sequence, starting with 2, such that the sum of two distinct terms of the sequence is never a Fibonacci number.

The 65 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A005653

/-- Known terms of `A005653`, starting at index `1`. -/
def data : List retType :=
  [2, 4, 5, 7, 10, 12, 13, 15, 18, 20,
    23, 25, 26, 28, 31, 33, 34, 36, 38, 39,
    41, 44, 46, 47, 49, 52, 54, 57, 59, 60,
    62, 65, 67, 68, 70, 72, 73, 75, 78, 80,
    81, 83, 86, 88, 89, 91, 93, 94, 96, 99,
    101, 102, 104, 107, 109, 112, 114, 115, 117, 120,
    122, 123, 125, 127, 128]

/-- `A005653` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 66) : A005653 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 66) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 66) : fz n = data[n.toNat - 1]! := sorry

end A005653
