import LOEIS.A030.A030454.Defs

set_option linter.unusedVariables false

/-!
# A030454

Make a table giving binary expansion of zeta(m) for m = 2, 3, ...; a(n) = number of 1's in n-th column of table (after decimal point).

The 65 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A030454

/-- Known terms of `A030454`, starting at index `1`. -/
def data : List retType :=
  [1, 0, 2, 2, 1, 3, 2, 5, 2, 3,
    5, 6, 4, 2, 7, 6, 3, 3, 8, 5,
    7, 6, 9, 6, 8, 6, 12, 5, 11, 11,
    9, 15, 12, 8, 14, 9, 10, 12, 10, 14,
    13, 15, 15, 13, 19, 16, 11, 19, 13, 17,
    16, 19, 16, 17, 20, 17, 15, 24, 25, 22,
    16, 12, 19, 17, 31]

/-- `A030454` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 66) : A030454 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 66) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 66) : fz n = data[n.toNat - 1]! := sorry

end A030454
