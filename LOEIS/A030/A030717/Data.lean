import LOEIS.A030.A030717.Defs

set_option linter.unusedVariables false

/-!
# A030717

The first list after the following procedure: starting with a list [1] and an empty list, repeatedly add the distinct values already in the first list in ascending order to the second list and add the corresponding frequencies of those values to the first list.

The 84 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A030717

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 2, 2, 1, 3, 2, 3, 3, 1,
    4, 3, 3, 4, 3, 5, 1, 5, 3, 6,
    2, 1, 6, 4, 7, 2, 2, 1, 7, 6,
    7, 3, 2, 2, 1, 8, 8, 8, 3, 2,
    3, 3, 8, 9, 11, 3, 2, 3, 3, 3,
    8, 10, 15, 3, 2, 3, 3, 4, 1, 1,
    10, 11, 18, 4, 2, 3, 3, 5, 1, 1,
    1, 1, 14, 12, 20, 5, 3, 3, 3, 5,
    1, 2, 2, 1]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 85) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 85) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 85) : flatFz n = flatData[n.toNat - 1]! := sorry

end A030717
