import LOEIS.A030.A030413.Defs

set_option linter.unusedVariables false

/-!
# A030413

Write (n+1)st Fibonacci number in base 4 and juxtapose.

The 90 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A030413

/-- Known terms of `A030413`, starting at index `1`. -/
def data : List retType :=
  [1, 2, 3, 1, 1, 2, 0, 3, 1, 1,
    1, 1, 2, 0, 2, 3, 1, 3, 1, 1,
    2, 1, 2, 1, 0, 0, 3, 2, 2, 1,
    1, 1, 3, 2, 1, 2, 1, 2, 0, 2,
    3, 3, 1, 2, 3, 1, 2, 0, 3, 3,
    1, 2, 2, 0, 1, 2, 0, 1, 0, 0,
    1, 1, 1, 1, 1, 2, 2, 1, 2, 3,
    1, 2, 2, 2, 3, 0, 0, 2, 1, 0,
    1, 1, 0, 2, 3, 3, 1, 2, 3, 3]

/-- `A030413` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 91) : A030413 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 91) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 91) : fz n = data[n.toNat - 1]! := sorry

end A030413
