import LOEIS.A030.A030351.Defs

set_option linter.unusedVariables false

/-!
# A030351

Write n in base 3, then complement each digit (d -> 2-d) and juxtapose.

The 90 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A030351

/-- Known terms of `A030351`, starting at index `1`. -/
def data : List retType :=
  [1, 0, 1, 2, 1, 1, 1, 0, 0, 2,
    0, 1, 0, 0, 1, 2, 2, 1, 2, 1,
    1, 2, 0, 1, 1, 2, 1, 1, 1, 1,
    1, 0, 1, 0, 2, 1, 0, 1, 1, 0,
    0, 0, 2, 2, 0, 2, 1, 0, 2, 0,
    0, 1, 2, 0, 1, 1, 0, 1, 0, 0,
    0, 2, 0, 0, 1, 0, 0, 0, 1, 2,
    2, 2, 1, 2, 2, 1, 1, 2, 2, 0,
    1, 2, 1, 2, 1, 2, 1, 1, 1, 2]

/-- `A030351` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 91) : A030351 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 91) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 91) : fz n = data[n.toNat - 1]! := sorry

end A030351
