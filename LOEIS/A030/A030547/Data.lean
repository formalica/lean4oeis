import LOEIS.A030.A030547.Defs

set_option linter.unusedVariables false

/-!
# A030547

Number of terms (including the initial term) needed to reach a palindrome when the Reverse Then Add! map (x -> x + (x-with-digits-reversed)) is repeatedly applied to n, or -1 if a palindrome is never reached.

The 98 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A030547

/-- Known terms of `A030547`, starting at index `1`. -/
def data : List retType :=
  [1, 1, 1, 1, 1, 1, 1, 1, 1, 2,
    1, 2, 2, 2, 2, 2, 2, 2, 3, 2,
    2, 1, 2, 2, 2, 2, 2, 3, 2, 2,
    2, 2, 1, 2, 2, 2, 3, 2, 3, 2,
    2, 2, 2, 1, 2, 3, 2, 3, 3, 2,
    2, 2, 2, 2, 1, 2, 3, 3, 4, 2,
    2, 2, 2, 3, 2, 1, 3, 4, 5, 2,
    2, 2, 3, 2, 3, 3, 1, 5, 7, 2,
    2, 3, 2, 3, 3, 4, 5, 1, 25, 2,
    3, 2, 3, 3, 4, 5, 7, 25]

/-- `A030547` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 99) : A030547 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 99) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 99) : fz n = data[n.toNat - 1]! := sorry

end A030547
