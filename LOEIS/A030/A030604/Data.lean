/-!
# A030604

Write the Fibonacci numbers in base 6 and juxtapose.

The 92 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A030604

/-- Known terms of `A030604`, starting at index `0`. -/
def data : List retType :=
  [0, 1, 1, 2, 3, 5, 1, 2, 2, 1,
    3, 3, 5, 4, 1, 3, 1, 2, 2, 5,
    4, 0, 0, 1, 0, 2, 5, 1, 4, 2,
    5, 2, 4, 5, 4, 4, 3, 2, 3, 1,
    1, 2, 2, 1, 1, 5, 5, 4, 4, 3,
    1, 2, 0, 5, 5, 1, 1, 5, 3, 1,
    2, 2, 4, 0, 2, 2, 1, 3, 5, 5,
    5, 3, 4, 0, 4, 0, 1, 5, 5, 4,
    4, 0, 0, 1, 3, 3, 5, 2, 0, 1,
    2, 3]

/-- `A030604` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 92) : A030604 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 92) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 92) : fz n = data[n.toNat]! := sorry

end A030604
