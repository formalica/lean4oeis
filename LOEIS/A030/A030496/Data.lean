import LOEIS.A030.A030496.Defs

set_option linter.unusedVariables false

/-!
# A030496

Permutations of 1,2,...,n for n=1,2,3,..., arranged antilexicographically.

The 90 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A030496

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 2, 1, 1, 2, 3, 2, 1, 3, 1,
    2, 2, 3, 1, 2, 1, 3, 1, 3, 2,
    1, 2, 3, 4, 3, 2, 1, 4, 3, 1,
    2, 4, 2, 3, 1, 4, 2, 1, 3, 4,
    1, 3, 2, 4, 1, 2, 3, 3, 4, 2,
    1, 3, 4, 1, 2, 3, 2, 4, 1, 3,
    2, 1, 4, 3, 1, 4, 2, 3, 1, 2,
    4, 2, 4, 3, 1, 2, 4, 1, 3, 2,
    3, 4, 1, 2, 3, 1, 4, 2, 1, 4]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 91) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 91) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 91) : flatFz n = flatData[n.toNat - 1]! := sorry

end A030496
