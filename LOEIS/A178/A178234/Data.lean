import LOEIS.A178.A178234.Defs

set_option linter.unusedVariables false

/-!
# A178234

A triangle sequence derived from setting an Euler numbers A122045 generalization equal to the MacMahon numbers A060187 to get a generating function expansion: p(x,t) = (exp(t)* (1 - exp(x))* x)/(exp(2 t + t x) + exp(t)* x - exp(t*x)* x).

The 50 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A178234

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, -1, -2, 1, 1, 7, 1, -7, 2, -1,
    -22, -30, 44, 25, -30, 6, 1, 69, 244, -106,
    -495, 193, 242, -156, 24, -1, -216, -1575, -1010, 4695,
    1884, -5429, 270, 2190, -960, 120, 1, 671, 9251, 19283,
    -28295, -59839, 50065, 56385, -52318, -9660, 20640, -6840, 720, -1]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 50) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 50) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 50) : flatFz n = flatData[n.toNat]! := sorry

end A178234
