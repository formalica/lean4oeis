    2, 3, 1, 0, 6, 1, 0, 2, 3, 1,
    0, 4, 1, 0, 2, 9]

/-- `A178245` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 77) : A178245 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 77) : fn n = data[n - 1]! := sorry

