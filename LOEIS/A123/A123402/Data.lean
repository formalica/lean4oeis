import LOEIS.A123.A123402.Defs

set_option linter.unusedVariables false

/-!
# A123402

Combining the conditional divide-by-two concept from Collatz sequences with Pascal's triangle, one can construct a new kind of triangle. Start with an initial row of just 4. To compute subsequent rows, start by appending a zero to the beginning and end of the previous row. Like Pascal's triangle, add adjacent terms of the previous row to create each of the subsequent terms. The only change is that each new term is divided by two if it is even.

The 97 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A123402

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [4, 2, 2, 1, 2, 1, 1, 3, 3, 1,
    1, 2, 3, 2, 1, 1, 3, 5, 5, 3,
    1, 1, 2, 4, 5, 4, 2, 1, 1, 3,
    3, 9, 9, 3, 3, 1, 1, 2, 3, 6,
    9, 6, 3, 2, 1, 1, 3, 5, 9, 15,
    15, 9, 5, 3, 1, 1, 2, 4, 7, 12,
    15, 12, 7, 4, 2, 1, 1, 3, 3, 11,
    19, 27, 27, 19, 11, 3, 3, 1, 1, 2,
    3, 7, 15, 23, 27, 23, 15, 7, 3, 2,
    1, 1, 3, 5, 5, 11, 19]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 97) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 97) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 97) : flatFz n = flatData[n.toNat]! := sorry

end A123402
