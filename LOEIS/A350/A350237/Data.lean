import LOEIS.A350.A350237.Defs

set_option linter.unusedVariables false

/-!
# A350237

Minimum number of 1's in an n X n binary matrix with no zero 3 X 3 submatrix.

The 16 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A350237

/-- Known terms of `A350237`, starting at index `1`. -/
def data : List retType :=
  [0, 0, 1, 3, 5, 10, 16, 22, 32, 40,
    52, 64, 77, 91, 105, 128]

/-- `A350237` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 17) : A350237 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 17) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 17) : fz n = data[n.toNat - 1]! := sorry

end A350237
