import LOEIS.A350.A350775.Defs

set_option linter.unusedVariables false

/-!
# A350775

The balanced ternary expansion of a(n) is obtained by multiplying adjacent digits in the balanced ternary expansion of n: a(Sum_{k >= 0} t_k * 3^k) = Sum_{k >= 0} t_k * t_{k+1} * 3^k (with -1 <= t_k <= 1 for any k >= 0).

The 64 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A350775

/-- Known terms of `A350775`, starting at index `0`. -/
def data : List retType :=
  [0, 0, -1, 0, 1, -2, -3, -4, 0, 0,
    0, 2, 3, 4, -5, -6, -7, -9, -9, -9,
    -13, -12, -11, 1, 0, -1, 0, 0, 0, -1,
    0, 1, 7, 6, 5, 9, 9, 9, 11, 12,
    13, -14, -15, -16, -18, -18, -18, -22, -21, -20,
    -26, -27, -28, -27, -27, -27, -28, -27, -26, -38,
    -39, -40, -36, -36]

/-- `A350775` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 64) : A350775 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 64) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 64) : fz n = data[n.toNat]! := sorry

end A350775
