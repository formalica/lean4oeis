import LOEIS.A350.A350710.Defs

set_option linter.unusedVariables false

/-!
# A350710

Triangle read by rows formed from the coefficients in ascending order of the characteristic polynomial of the n X n matrix M(n) with entries M(n)[i,j] = i*j mod n+1.

The 55 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A350710

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, -1, 1, -3, -2, 1, -16, -16, -2, 1,
    0, 100, -10, -10, 1, -1296, 0, 324, -24, -13,
    1, 0, 0, 4116, 392, -175, -14, 1, 0, -131072,
    16384, 12288, -512, -352, -12, 1, 0, 0, -708588, 0,
