import LOEIS.A350.A350674.Defs

set_option linter.unusedVariables false

/-!
# A350674

Irregular table read by rows; the n-th row contains, in weakly decreasing order, the positive squares summing to n as obtained by the greedy algorithm.

The 83 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A350674

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 1, 1, 1, 4, 4, 1, 4,
    1, 1, 4, 1, 1, 1, 4, 4, 9, 9,
    1, 9, 1, 1, 9, 1, 1, 1, 9, 4,
    9, 4, 1, 9, 4, 1, 1, 16, 16, 1,
    16, 1, 1, 16, 1, 1, 1, 16, 4, 16,
    4, 1, 16, 4, 1, 1, 16, 4, 1, 1,
    1, 16, 4, 4, 25, 25, 1, 25, 1, 1,
    25, 1, 1, 1, 25, 4, 25, 4, 1, 25,
    4, 1, 1]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 84) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 84) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 84) : flatFz n = flatData[n.toNat - 1]! := sorry

end A350674
