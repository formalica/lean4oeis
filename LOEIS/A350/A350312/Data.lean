import LOEIS.A350.A350312.Defs

set_option linter.unusedVariables false

/-!
# A350312

Narayana weighted representation of n (the bottom version). Also binary representation of numbers not containing 00 or 010 as a substring.

The 36 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A350312

/-- Known terms of `A350312`, starting at index `0`. -/
def data : List retType :=
  [0, 1, 10, 11, 101, 110, 111, 1011, 1101, 1110,
    1111, 10110, 10111, 11011, 11101, 11110, 11111, 101101, 101110, 101111,
    110110, 110111, 111011, 111101, 111110, 111111, 1011011, 1011101, 1011110, 1011111,
    1101101, 1101110, 1101111, 1110110, 1110111, 1111011]

/-- `A350312` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 36) : A350312 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 36) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 36) : fz n = data[n.toNat]! := sorry

end A350312
