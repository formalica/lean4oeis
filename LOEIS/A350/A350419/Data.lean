import LOEIS.A350.A350419.Defs

set_option linter.unusedVariables false

/-!
# A350419

Irregular table read by rows, where row k lists the semiprimes, s*t (s<=t) in increasing order, where s and t are the smaller and larger parts of the partitions of m = 2k+2 into two parts.

The 61 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A350419

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [4, 9, 15, 9, 21, 25, 35, 33, 49, 15,
    39, 55, 65, 77, 51, 91, 21, 57, 85, 121,
    95, 119, 143, 25, 69, 133, 169, 115, 187, 161,
    209, 221, 87, 247, 33, 93, 145, 253, 289, 35,
    155, 203, 299, 323, 217, 361, 39, 111, 319, 391,
    185, 341, 377, 437, 123, 259, 403, 129, 205, 493,
    529]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 62) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 62) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 62) : flatFz n = flatData[n.toNat - 1]! := sorry

end A350419
