import LOEIS.A350.A350351.Defs

set_option linter.unusedVariables false

/-!
# A350351

Array read by antidiagonals: T(n,k) is the determinant of the Hankel matrix of the 2*n-1 consecutive terms of A350330 starting at the k-th term, n >= 0, k >= 1.

The 66 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A350351

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 1, 1, 1, 1, 2, -3, -4,
    1, 1, 1, -4, -4, 1, 1, 1, -3, 3,
    -1, 1, 2, -2, -3, -3, -5, 13, 1, 2,
    -2, -5, 8, 14, -27, -40, 1, 1, 3, -3,
    2, 4, 13, -22, -68, 1, 2, -3, -3, -1,
    3, -3, 10, 48, 96, 1, 1, 1, -4, -4,
    3, 3, 2, -48, 96, 80]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 66) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 66) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 66) : flatFz n = flatData[n.toNat]! := sorry

end A350351
