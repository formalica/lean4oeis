import LOEIS.A350.A350365.Defs

set_option linter.unusedVariables false

/-!
# A350365

Array read by antidiagonals: T(n,k) is the number of sequences of length 2*n+1 with terms in 0..k such that the Hankel matrix of the sequence is singular, but the Hankel matrix of any proper subsequence with an odd number of consecutive terms is invertible, n, k >= 0.

The 55 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A350365

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, 1, 0, 1, 1, 0, 1, 2, 0, 0,
    1, 3, 2, 0, 0, 1, 6, 6, 10, 0,
    0, 1, 7, 16, 52, 0, 0, 0, 1, 8,
    36, 148, 116, 8, 0, 0, 1, 9, 58, 448,
    644, 528, 12, 0, 0, 1, 12, 82, 885, 2932,
    4032, 1326, 0, 0, 0]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 55) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 55) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 55) : flatFz n = flatData[n.toNat]! := sorry

end A350365
