import LOEIS.A350.A350330.Defs

set_option linter.unusedVariables false

/-!
# A350330

Lexicographically earliest sequence of positive integers such that the Hankel matrix of any odd number of consecutive terms is invertible.

The 87 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A350330

/-- Known terms of `A350330`, starting at index `1`. -/
def data : List retType :=
  [1, 1, 2, 1, 1, 2, 2, 1, 2, 1,
    1, 2, 1, 2, 3, 1, 1, 2, 1, 1,
    2, 2, 1, 2, 1, 1, 2, 2, 3, 2,
    2, 1, 1, 2, 2, 3, 1, 1, 2, 1,
    1, 2, 2, 1, 2, 1, 1, 2, 1, 2,
    3, 1, 1, 2, 1, 1, 2, 2, 1, 2,
    1, 1, 2, 2, 3, 2, 2, 1, 1, 2,
    3, 1, 1, 2, 1, 1, 2, 2, 1, 2,
    1, 1, 2, 1, 2, 3, 1]

/-- `A350330` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 88) : A350330 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 88) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 88) : fz n = data[n.toNat - 1]! := sorry

end A350330
