import LOEIS.A350.A350240.Defs

set_option linter.unusedVariables false

/-!
# A350240

Number of representations of n as a sum of distinct Fibonacci numbers where 1 can be included twice.

The 83 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A350240

/-- Known terms of `A350240`, starting at index `0`. -/
def data : List retType :=
  [1, 1, 2, 2, 2, 3, 2, 3, 3, 3,
    4, 3, 3, 4, 3, 5, 4, 4, 5, 3,
    4, 4, 4, 6, 5, 5, 6, 4, 6, 5,
    5, 6, 4, 4, 5, 4, 7, 6, 6, 8,
    5, 7, 6, 6, 8, 6, 6, 7, 5, 8,
    6, 6, 7, 4, 5, 5, 5, 8, 7, 7,
    9, 6, 9, 8, 8, 10, 7, 7, 8, 6,
    10, 8, 8, 10, 6, 8, 7, 7, 10, 8,
    8, 9, 6]

/-- `A350240` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n < 83) : A350240 n = data[n]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h : n < 83) : fn n = data[n]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 83) : fz n = data[n.toNat]! := sorry

end A350240
