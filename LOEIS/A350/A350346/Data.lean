import LOEIS.A350.A350346.Defs

set_option linter.unusedVariables false

/-!
# A350346

Binary numbers such that when read from right to left, the number of 0's never exceeds the number of 1's.

The 35 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A350346

/-- Known terms of `A350346`, starting at index `1`. -/
def data : List retType :=
  [0, 1, 11, 101, 111, 1011, 1101, 1111, 10011, 10101,
    10111, 11011, 11101, 11111, 100111, 101011, 101101, 101111, 110011, 110101,
    110111, 111011, 111101, 111111, 1000111, 1001011, 1001101, 1001111, 1010011, 1010101,
    1010111, 1011011, 1011101, 1011111, 1100111]

/-- `A350346` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 36) : A350346 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 36) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 36) : fz n = data[n.toNat - 1]! := sorry

end A350346
