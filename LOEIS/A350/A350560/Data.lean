import LOEIS.A350.A350560.Defs

set_option linter.unusedVariables false

/-!
# A350560

Denominators of the fractional, multiplicative Van Eck Sequence f(n): for n >= 2, if there exists an m < n such that f(m) = f(n), take the largest such m. If f(n)=1, set f(n+1) = 1/(n-m); otherwise, if f(n) != 1, set f(n+1) = f(n)+f(m)*(n-m). If no m exists such that f(m) = f(n), then set f(n+1)=1. Start with f(1)=1 and f(2)=0. a(n) = denominator(f(n)).

The 87 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A350560

/-- Known terms of `A350560`, starting at index `1`. -/
def data : List retType :=
  [1, 1, 1, 2, 1, 2, 2, 1, 3, 1,
    2, 1, 1, 3, 1, 1, 3, 3, 1, 3,
    3, 3, 1, 4, 1, 2, 1, 1, 3, 3,
    1, 3, 3, 3, 1, 4, 4, 1, 3, 3,
    1, 3, 3, 3, 1, 4, 4, 1, 3, 3,
    3, 1, 4, 1, 1, 1, 4, 4, 1, 3,
    1, 1, 3, 3, 3, 1, 1, 5, 1, 2,
    2, 1, 3, 3, 1, 3, 3, 3, 1, 4,
    1, 1, 3, 3, 3, 1, 4]

/-- `A350560` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 88) : A350560 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 88) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 88) : fz n = data[n.toNat - 1]! := sorry

end A350560
