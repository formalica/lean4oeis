import LOEIS.A350.A350200.Defs

set_option linter.unusedVariables false

/-!
# A350200

Array read by antidiagonals: T(n,k) is the determinant of the Hankel matrix of the 2*n-1 consecutive primes starting at the k-th prime, n >= 0, k >= 1.

The 55 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A350200

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, 1, 2, 1, 3, 1, 1, 5, -4, -2,
    1, 7, 6, 12, 0, 1, 11, -30, -72, 144,
    288, 1, 13, 18, 72, 0, 576, -1728, 1, 17,
    -42, -72, 288, 1152, -7104, -26240, 1, 19, 30, -96,
    144, -1248, -11712, 45248, 222272, 1, 23, 22, -188, 488,
    -112, -11360, 21184, 450432, 1636864]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 55) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 55) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 55) : flatFz n = flatData[n.toNat]! := sorry

end A350200
