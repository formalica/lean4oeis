import LOEIS.A350.A350350.Defs

set_option linter.unusedVariables false

/-!
# A350350

Lexicographically earliest nondecreasing sequence of positive integers such that the Hankel matrix of any odd number of consecutive terms is invertible.

The 69 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A350350

/-- Known terms of `A350350`, starting at index `1`. -/
def data : List retType :=
  [1, 1, 2, 2, 3, 3, 5, 5, 6, 6,
    7, 7, 9, 9, 11, 11, 12, 12, 14, 14,
    15, 15, 16, 16, 18, 18, 19, 19, 21, 21,
    24, 24, 25, 25, 26, 26, 28, 28, 29, 29,
    30, 30, 32, 32, 34, 34, 35, 35, 37, 37,
    38, 38, 39, 39, 41, 41, 43, 43, 46, 46,
    48, 48, 50, 50, 51, 51, 52, 52, 55]

/-- `A350350` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 70) : A350350 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 70) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 70) : fz n = data[n.toNat - 1]! := sorry

end A350350
