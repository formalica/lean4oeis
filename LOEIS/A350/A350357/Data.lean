def flatData : List flatRetType :=
  [1, 1, 2, 1, 1, 2, 3, 1, 1, 1,
    3, 1, 4, 2, 2, 1, 1, 1, 1, 2,
    4, 1, 2, 1, 5, 3, 2, 1, 1, 1,
