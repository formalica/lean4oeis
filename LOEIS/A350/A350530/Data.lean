import LOEIS.A350.A350530.Defs

set_option linter.unusedVariables false

/-!
# A350530

Square array read by antidiagonals downwards: T(n,k) is the number of sequences of length n with terms in 0..k such that the (n-1)-st difference is zero, but no earlier iterated difference is zero, n, k >= 1.

The 78 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A350530

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 0, 1, 1, 0, 1, 2, 0, 0,
    1, 3, 0, 0, 0, 1, 4, 2, 0, 0,
    0, 1, 5, 4, 0, 0, 0, 0, 1, 6,
    8, 0, 0, 0, 0, 0, 1, 7, 12, 4,
    0, 0, 0, 0, 0, 1, 8, 18, 12, 8,
    4, 0, 0, 0, 0, 1, 9, 24, 28, 36,
    28, 4, 0, 0, 0, 0, 1, 10, 32, 52,
    84, 116, 48, 16, 0, 0, 0, 0]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 79) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 79) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 79) : flatFz n = flatData[n.toNat - 1]! := sorry

end A350530
