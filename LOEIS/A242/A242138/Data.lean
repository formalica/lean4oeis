import LOEIS.A242.A242138.Defs

set_option linter.unusedVariables false

/-!
# A242138

Binary representation of periodic binary numbers, ordered by their decimal values.

The 30 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A242138

/-- Known terms of `A242138`, starting at index `1`. -/
def data : List retType :=
  [101, 1001, 1010, 10001, 10010, 10101, 11011, 100001, 100010, 100100,
    101010, 101101, 110011, 110110, 1000001, 1000010, 1000100, 1001001, 1010101, 1100011,
    1100110, 1110111, 10000001, 10000010, 10000100, 10001000, 10010010, 10011001, 10100101, 10101010]

/-- `A242138` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 31) : A242138 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 31) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 31) : fz n = data[n.toNat - 1]! := sorry

end A242138
