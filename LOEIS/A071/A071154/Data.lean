import LOEIS.A071.A071154.Defs

set_option linter.unusedVariables false

/-!
# A071154

Totally balanced decimal numbers: if we assign the weight w(d) = d-1 to each digit d (i.e., w(0) = -1, w(1) = 0, ..., w(9) = 8) and then read the digits of the term from left to right, the partial sum of the weights is never negative and the total weighted sum is zero.

The 39 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A071154

/-- Known terms of `A071154`, starting at index `1`. -/
def data : List retType :=
  [1, 11, 20, 111, 120, 201, 210, 300, 1111, 1120,
    1201, 1210, 1300, 2011, 2020, 2101, 2110, 2200, 3001, 3010,
    3100, 4000, 11111, 11120, 11201, 11210, 11300, 12011, 12020, 12101,
    12110, 12200, 13001, 13010, 13100, 14000, 20111, 20120, 20201]

/-- `A071154` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 40) : A071154 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 40) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 40) : fz n = data[n.toNat - 1]! := sorry

end A071154
