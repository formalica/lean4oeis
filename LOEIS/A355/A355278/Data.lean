import LOEIS.A355.A355278.Defs

set_option linter.unusedVariables false

/-!
# A355278

Lower left of the Cayley table for the primes when made into a group using the bijection (2, 3, 5, 7, ...) -> (0, +1, -1, +2, ...) into (Z, +); read by rows.

The 69 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A355278

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [2, 3, 7, 5, 2, 11, 7, 13, 3, 19,
    11, 5, 17, 2, 23, 13, 19, 7, 29, 3,
    37, 17, 11, 23, 5, 31, 2, 41, 19, 29,
    13, 37, 7, 43, 3, 53, 23, 17, 31, 11,
    41, 5, 47, 2, 59, 29, 37, 19, 43, 13,
    53, 7, 61, 3, 71, 31, 23, 41, 17, 47,
    11, 59, 5, 67, 2, 73, 37, 43, 29]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 70) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 70) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 70) : flatFz n = flatData[n.toNat - 1]! := sorry

end A355278
