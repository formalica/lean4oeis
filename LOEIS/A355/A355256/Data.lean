import LOEIS.A355.A355256.Defs

set_option linter.unusedVariables false

/-!
# A355256

a(n) is the number of n-th order n X n magic arrays composed of the numbers from 1 to n^2 in which each 2 X 2 subsquare has the same sum, counted up to rotations and reflections.

The 6 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A355256

/-- Known terms of `A355256`, starting at index `1`. -/
def data : List retType :=
  [1, 3, 47, 2544, 6480, 5510592]

/-- `A355256` agrees with `data` on the known range. -/
@[simp]
theorem data_eq (n : argType) (h : n.val < 7) : A355256 n = data[n.val - 1]! := sorry

/-- `fn` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 7) : fn n = data[n - 1]! := sorry

/-- `fz` agrees with `data` on the known range. -/
@[simp]
theorem data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 7) : fz n = data[n.toNat - 1]! := sorry

end A355256
