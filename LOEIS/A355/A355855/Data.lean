import LOEIS.A355.A355855.Defs

set_option linter.unusedVariables false

/-!
# A355855

A family of triangles T(m), m > 0, read by triangles and then by rows; triangle T(1) is [1; 1, 1]; for m > 0, triangle T(m+1) is obtained by replacing each subtriangle [t; u, v] in T(m) by [t; t+u, t+v; u, u+v, v].

The 90 terms known to OEIS, indexed from `1`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A355855

/-- Known terms of `flat`, starting at index `1`. -/
def flatData : List flatRetType :=
  [1, 1, 1, 1, 2, 2, 1, 2, 1, 1,
    3, 3, 2, 4, 2, 3, 4, 4, 3, 1,
    3, 2, 3, 1, 1, 4, 4, 3, 6, 3,
    5, 7, 7, 5, 2, 6, 4, 6, 2, 5,
    6, 8, 8, 6, 5, 3, 7, 4, 8, 4,
    7, 3, 4, 6, 7, 6, 6, 7, 6, 4,
    1, 4, 3, 5, 2, 5, 3, 4, 1, 1,
    5, 5, 4, 8, 4, 7, 10, 10, 7, 3,
    9, 6, 9, 3, 8, 10, 13, 13, 10, 8]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n.val < 91) : flat n = flatData[n.val - 1]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h0 : 0 < n) (h : n < 91) : flatFn n = flatData[n - 1]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 1 ≤ n) (h : n < 91) : flatFz n = flatData[n.toNat - 1]! := sorry

end A355855
