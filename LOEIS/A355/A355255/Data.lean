import LOEIS.A355.A355255.Defs

set_option linter.unusedVariables false

/-!
# A355255

Irregular table read by rows: a(n,k) gives the number of distinct necklaces that appear in the following procedure: starting with the n-bead, (0,1)-necklace given by k written in binary, repeatedly take the first differences (mod 2) of the beads. 0 <= k < 2^n.

The 127 terms known to OEIS, indexed from `0`.

Skeleton generated by `lake exe oeis-gen`; every declaration is a `sorry` placeholder.
-/

namespace A355255

/-- Known terms of `flat`, starting at index `0`. -/
def flatData : List flatRetType :=
  [1, 1, 2, 1, 3, 3, 2, 1, 2, 2,
    1, 2, 1, 1, 2, 1, 5, 5, 4, 5,
    3, 4, 5, 5, 4, 3, 5, 4, 5, 5,
    2, 1, 4, 4, 3, 4, 3, 3, 4, 4,
    3, 3, 4, 3, 4, 4, 3, 4, 3, 3,
    4, 3, 4, 4, 3, 3, 4, 4, 3, 4,
    3, 3, 2, 1, 4, 4, 3, 4, 2, 3,
    3, 4, 2, 2, 4, 3, 4, 3, 2, 4,
    2, 2, 4, 2, 3, 4, 3, 3, 4, 4,
    1, 3, 3, 2, 4, 4, 3, 2, 3, 2,
    4, 4, 2, 2, 4, 3, 3, 4, 1, 3,
    4, 3, 3, 4, 2, 4, 3, 1, 4, 3,
    2, 3, 4, 2, 4, 4, 2]

/-- `flat` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq (n : flatArgType) (h : n < 127) : flat n = flatData[n]! := sorry

/-- `flatFn` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fn (n : Nat) (h : n < 127) : flatFn n = flatData[n]! := sorry

/-- `flatFz` agrees with `flatData` on the known range. -/
@[simp]
theorem flat_data_eq_fz (n : Int) (h0 : 0 ≤ n) (h : n < 127) : flatFz n = flatData[n.toNat]! := sorry

end A355255
